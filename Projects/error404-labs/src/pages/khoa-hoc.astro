<style>
    /* Nền "bản đồ" trang trí: đường phố bằng gradient, không tải bản đồ ngoài */
    .info-map {
        background-image:
            linear-gradient(90deg, transparent 47%, #ffffff 47%, #ffffff 53%, transparent 53%),
            linear-gradient(0deg, transparent 47%, #ffffff 47%, #ffffff 53%, transparent 53%),
            linear-gradient(32deg, transparent 48.5%, #fde68a 48.5%, #fde68a 51.5%, transparent 51.5%),
            linear-gradient(90deg, rgba(148, 163, 184, 0.18) 1px, transparent 1px),
            linear-gradient(0deg, rgba(148, 163, 184, 0.18) 1px, transparent 1px);
        background-size:
            180px 180px,
            180px 180px,
            100% 100%,
            30px 30px,
            30px 30px;
    }
    .info-float {
        animation: info-float 4s ease-in-out infinite;
    }
    @keyframes info-float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-8px);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .info-float {
            animation: none;
        }
    }
</style>

<script>
    // Thanh CTA dưới cùng (mobile): hiện khi nút CTA ở hero đã cuộn qua, ẩn khi tới footer
    const bar = document.getElementById('courseCtaBar')
    const heroCta = document.getElementById('courseHeroCta')
    const footer = document.querySelector('footer')

    if (bar && heroCta && 'IntersectionObserver' in window) {
        let heroVisible = true
        let footerVisible = false
        const HIDDEN = [
            'translate-y-full',
            'opacity-0',
            'invisible',
        ]

        const update = () => {
            const show = !heroVisible && !footerVisible
            HIDDEN.forEach((c) => bar.classList.toggle(c, !show))
        }

        new IntersectionObserver(([entry]) => {
            // Chỉ coi là "đã qua" khi CTA nằm phía trên màn hình
            heroVisible = entry.isIntersecting || entry.boundingClientRect.top > 0
            update()
        }).observe(heroCta)

        if (footer) {
            new IntersectionObserver(([entry]) => {
                footerVisible = entry.isIntersecting
                update()
            }).observe(footer)
        }
    }
</script>
