---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'
---

<MainLayout title={`Khóa học | ${TC_TITLE}`}>
    <section
        class="min-h-[calc(100vh-168px)] flex flex-col justify-center items-center py-4 md:py-6 px-2 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden"
    >
        <!-- Đồ họa chìm (Background decorative) -->
        <div class="absolute top-0 left-0 w-full h-full pointer-events-none overflow-hidden z-0">
            <div class="absolute -top-[20%] -right-[10%] w-[50%] h-[50%] bg-[#185c69]/5 rounded-full blur-[100px]">
            </div>
            <div class="absolute -bottom-[20%] -left-[10%] w-[50%] h-[50%] bg-[#ffbd0a]/10 rounded-full blur-[100px]">
            </div>
        </div>

        <div
            class="bg-white p-1 md:p-2 rounded-3xl shadow-2xl shadow-[#185c69]/10 max-w-6xl w-full border border-gray-100 relative z-10 transition-all duration-500 flex flex-col h-full"
        >
            <!-- Header Group -->
            <div
                class="bg-gradient-to-br from-[#124b56] to-[#185c69] rounded-t-[1.3rem] rounded-b-2xl md:rounded-t-[1.3rem] py-6 md:py-8 px-4 relative overflow-hidden text-center shadow-inner group shrink-0"
            >
                <!-- Ánh sáng chìm bên trong header -->
                <div class="absolute inset-0 pointer-events-none">
                    <div
                        class="absolute -top-32 -left-32 w-64 h-64 bg-[#2f92a4] rounded-full mix-blend-screen filter blur-[80px] opacity-40 group-hover:opacity-60 transition-opacity duration-700"
                    >
                    </div>
                    <div
                        class="absolute bottom-[-100px] right-[-100px] w-80 h-80 bg-[#092930] rounded-full mix-blend-multiply filter blur-[80px] opacity-50"
                    >
                    </div>
                </div>

                <div class="relative z-10 max-w-4xl mx-auto space-y-4">
                    <h1
                        class="text-2xl md:text-3xl lg:text-5xl font-black text-white uppercase tracking-wide drop-shadow-lg lg:leading-tight"
                    >
                        Tư duy sáng tạo<br class="hidden md:block" /> qua lập trình Web & Game
                    </h1>
                    <div
                        class="inline-block bg-gradient-to-r from-[#ffbd0a] to-[#f4a100] text-[#0b2f36] font-extrabold px-5 py-2 md:px-6 md:py-3 rounded-full text-xs md:text-sm lg:text-base shadow-xl transform transition hover:scale-105 hover:shadow-2xl border border-[#fbca3a]"
                    >
                        HTML, CSS & JAVASCRIPT – Hành trình sáng tạo công nghệ
                    </div>
                </div>
            </div>

            <!-- Body Area -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 md:gap-6 p-3 md:p-5 flex-1 min-h-0">
                <!-- Left Column -->
                <div class="lg:col-span-5 flex flex-col gap-4 justify-between h-full">
                    <!-- Mục tiêu -->
                    <div
                        class="bg-gradient-to-b from-[#f7fbfb] to-white rounded-2xl p-4 md:p-5 border-2 border-dashed border-[#c5e1e5] shadow-sm relative overflow-hidden group hover:border-[#86bcc6] transition-colors duration-300 flex-1"
                    >
                        <div
                            class="absolute top-0 right-0 w-24 h-24 bg-[#e8f3f4] rounded-bl-full -z-10 group-hover:scale-110 transition-transform duration-500"
                        >
                        </div>
                        <h3 class="text-lg md:text-xl font-black text-[#185c69] mb-4 flex items-center gap-3 uppercase">
                            Mục tiêu khóa học <span class="text-xl">🎯</span>
                        </h3>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <div class="bg-[#fef8e6] p-1.5 rounded-lg shrink-0 mt-0.5 shadow-sm">
                                    <span class="text-[#f4a100] text-xl leading-none">★</span>
                                </div>
                                <span class="font-bold text-gray-700 text-sm md:text-base leading-snug"
                                    >Hiểu cơ chế hoạt động của Web & Game</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <div class="bg-[#fef8e6] p-1.5 rounded-lg shrink-0 mt-0.5 shadow-sm">
                                    <span class="text-[#f4a100] text-xl leading-none">★</span>
                                </div>
                                <span class="font-bold text-gray-700 text-sm md:text-base leading-snug"
                                    >Tự tay xây dựng Website & Game từ con số 0</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <div class="bg-[#fef8e6] p-1.5 rounded-lg shrink-0 mt-0.5 shadow-sm">
                                    <span class="text-[#f4a100] text-xl leading-none">★</span>
                                </div>
                                <span class="font-bold text-gray-700 text-sm md:text-base leading-snug"
                                    >Nâng cao tư duy logic & thiết kế hệ thống</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <div class="bg-[#fef8e6] p-1.5 rounded-lg shrink-0 mt-0.5 shadow-sm">
                                    <span class="text-[#f4a100] text-xl leading-none">★</span>
                                </div>
                                <span class="font-bold text-gray-700 text-sm md:text-base leading-snug"
                                    >Học qua dự án thực tế, không học thuộc lòng</span
                                >
                            </li>
                        </ul>
                    </div>

                    <!-- Quy mô -->
                    <div
                        class="bg-white p-4 md:p-5 border-2 border-solid border-[#ecf4f5] rounded-2xl shadow-[0_4px_20px_-4px_rgba(24,92,105,0.05)] hover:shadow-lg hover:-translate-y-1 transition-all duration-300 shrink-0"
                    >
                        <h3 class="text-lg md:text-xl font-black text-[#185c69] mb-4 flex items-center gap-3 uppercase">
                            Quy mô lớp học <span class="text-xl ml-1">👨‍🏫</span>
                        </h3>
                        <div class="space-y-3">
                            <div
                                class="bg-gradient-to-r from-[#f7fbfb] to-white px-4 py-3 rounded-xl border-l-[4px] border-[#185c69] flex flex-col xl:flex-row xl:items-center text-sm shadow-sm hover:shadow-md transition-shadow"
                            >
                                <span class="font-black text-[#185c69] mb-1 xl:mb-0 mr-3 uppercase shrink-0"
                                    >Offline</span
                                >
                                <span class="text-gray-700 font-bold md:text-sm mt-1 xl:mt-0"
                                    >3 - 5 học sinh / lớp (kèm sát)</span
                                >
                            </div>
                            <div
                                class="bg-gradient-to-r from-[#fefbf0] to-white px-4 py-3 rounded-xl border-l-[4px] border-[#ffbd0a] flex flex-col xl:flex-row xl:items-center text-sm shadow-sm hover:shadow-md transition-shadow"
                            >
                                <span class="font-black text-[#eb9700] mb-1 xl:mb-0 mr-3 uppercase shrink-0"
                                    >Online</span
                                >
                                <span class="text-gray-700 font-bold md:text-sm mt-1 xl:mt-0"
                                    >1 kèm 1 trực tiếp (tương tác cao)</span
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column -->
                <div
                    class="lg:col-span-7 flex flex-col justify-between h-full bg-[#fcfdfe] rounded-2xl p-4 md:p-5 lg:border border-gray-100"
                >
                    <div class="flex-1 flex flex-col justify-center">
                        <h3
                            class="text-lg md:text-xl font-black text-[#185c69] mb-4 flex items-center gap-3 uppercase px-2"
                        >
                            Lộ trình học tập sáng tạo <span class="text-xl">🚀</span>
                        </h3>
                        <div class="space-y-3 px-1 md:px-2 flex-1 flex flex-col justify-center">
                            <!-- Step 1 -->
                            <div
                                class="flex flex-row items-center gap-4 bg-white border border-gray-100/80 rounded-xl p-3 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 group"
                            >
                                <div
                                    class="bg-gradient-to-br from-[#185c69] to-[#114b56] text-white font-black text-xl md:text-2xl rounded-lg w-12 h-12 md:w-14 md:h-14 flex items-center justify-center shrink-0 shadow-lg group-hover:scale-105 transition-transform duration-300 relative overflow-hidden"
                                >
                                    <div
                                        class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity"
                                    >
                                    </div>
                                    01
                                </div>
                                <div class="flex-1">
                                    <h4 class="font-black text-[#124b56] text-base md:text-lg uppercase mb-0.5">
                                        Nền tảng Web sáng tạo
                                    </h4>
                                    <p class="text-gray-500 text-xs md:text-sm font-medium leading-relaxed">
                                        Xây dựng cấu trúc web: văn bản, hình ảnh, liên kết
                                    </p>
                                </div>
                            </div>

                            <!-- Step 2 -->
                            <div
                                class="flex flex-row items-center gap-4 bg-white border border-gray-100/80 rounded-xl p-3 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 group"
                            >
                                <div
                                    class="bg-gradient-to-br from-[#185c69] to-[#114b56] text-white font-black text-xl md:text-2xl rounded-lg w-12 h-12 md:w-14 md:h-14 flex items-center justify-center shrink-0 shadow-lg group-hover:scale-105 transition-transform duration-300 relative overflow-hidden"
                                >
                                    <div
                                        class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity"
                                    >
                                    </div>
                                    02
                                </div>
                                <div class="flex-1">
                                    <h4 class="font-black text-[#124b56] text-base md:text-lg uppercase mb-0.5">
                                        Thiết kế Game tương tác
                                    </h4>
                                    <p class="text-gray-500 text-xs md:text-sm font-medium leading-relaxed">
                                        Sáng tạo logic, cơ chế game và trải nghiệm
                                    </p>
                                </div>
                            </div>

                            <!-- Step 3 -->
                            <div
                                class="flex flex-row items-center gap-4 bg-white border border-gray-100/80 rounded-xl p-3 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 group"
                            >
                                <div
                                    class="bg-gradient-to-br from-[#185c69] to-[#114b56] text-white font-black text-xl md:text-2xl rounded-lg w-12 h-12 md:w-14 md:h-14 flex items-center justify-center shrink-0 shadow-lg group-hover:scale-105 transition-transform duration-300 relative overflow-hidden"
                                >
                                    <div
                                        class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity"
                                    >
                                    </div>
                                    03
                                </div>
                                <div class="flex-1">
                                    <h4 class="font-black text-[#124b56] text-base md:text-lg uppercase mb-0.5">
                                        Dự án Web & Game
                                    </h4>
                                    <p class="text-gray-500 text-xs md:text-sm font-medium leading-relaxed">
                                        Hiện thực hóa ý tưởng qua dự án tương tác cá nhân
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Info Grid -->
                    <div
                        class="flex flex-col md:flex-row justify-between items-center mt-4 p-4 md:p-5 bg-white border border-[#ecf4f5] rounded-2xl shadow-[0_4px_20px_-4px_rgba(24,92,105,0.08)] gap-4 w-full shrink-0"
                    >
                        <!-- Fee -->
                        <div class="flex flex-col text-center md:text-left flex-1 group">
                            <div
                                class="text-gray-400 text-[10px] font-black uppercase tracking-[0.2em] mb-1 flex justify-center md:justify-start"
                            >
                                Học phí
                            </div>
                            <div
                                class="flex flex-col items-center md:items-start transition-transform group-hover:scale-105"
                            >
                                <span class="text-[#e35d2d] font-black text-xl md:text-2xl leading-none drop-shadow-sm"
                                    >120.000đ<span class="text-base font-bold text-gray-400 mx-1">/</span></span
                                >
                                <span
                                    class="text-gray-600 font-extrabold text-sm md:text-base leading-none mt-1 uppercase"
                                    >Buổi</span
                                >
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="hidden md:block w-px h-10 bg-gray-200"></div>
                        <div class="md:hidden h-px w-full bg-gray-100"></div>

                        <!-- Schedule -->
                        <div class="flex flex-col text-center md:text-left flex-1 group">
                            <div
                                class="text-gray-400 text-[10px] font-black uppercase tracking-[0.2em] mb-1 flex justify-center md:justify-start"
                            >
                                Lịch học
                            </div>
                            <div
                                class="flex flex-col items-center md:items-start group-hover:scale-105 transition-transform"
                            >
                                <span class="font-black text-gray-800 text-xl md:text-2xl leading-none">2 Buổi</span>
                                <span
                                    class="text-gray-600 font-extrabold text-sm md:text-base leading-none mt-1 uppercase"
                                    >/ Tuần</span
                                >
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="hidden md:block w-px h-10 bg-gray-200"></div>
                        <div class="md:hidden h-px w-full bg-gray-100"></div>

                        <!-- Contact -->
                        <div
                            class="flex flex-col justify-center items-center md:items-end text-center md:text-right w-full md:w-auto mt-2 md:mt-0"
                        >
                            <div
                                class="flex items-center gap-2 font-black text-[#185c69] text-lg md:text-xl drop-shadow-sm hover:text-[#e35d2d] transition-colors cursor-pointer"
                            >
                                <span class="text-red-500 text-lg animate-pulse">📞</span> 0373.306.966
                            </div>
                            <div
                                class="text-gray-500 text-[11px] md:text-xs font-medium max-w-[180px] leading-relaxed mt-1 flex items-start justify-center md:justify-end gap-1.5"
                            >
                                <span class="text-red-500 shrink-0 text-xs">📍</span>
                                <span class="text-left md:text-right">308 Đ. TX 25, Thạnh Xuân, Q.12, TP.HCM</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 mt-auto px-4 pb-4">
                <a
                    href="https://zalo.me/0373306966"
                    target="_blank"
                    class="md:col-span-12 lg:col-span-7 bg-gradient-to-r from-[#185c69] to-[#134954] hover:from-[#134954] hover:to-[#0f3942] transition-all duration-300 text-white font-black text-sm md:text-base py-3 px-6 rounded-xl flex items-center justify-center gap-3 shadow-[0_8px_30px_rgb(24,92,105,0.3)] hover:shadow-[0_8px_30px_rgb(24,92,105,0.5)] hover:-translate-y-1 w-full"
                >
                    ĐĂNG KÝ QUA ZALO: 0373.306.966
                </a>
                <div
                    class="md:col-span-12 lg:col-span-5 flex items-center justify-center gap-2 bg-gradient-to-b from-[#fff5f5] to-[#fef2f2] text-[#c53232] font-extrabold text-[11px] md:text-xs px-4 py-3 rounded-xl border border-[#fbd5d5] w-full shadow-sm"
                >
                    <span class="text-xl animate-bounce">⚠️</span>
                    <span class="tracking-wide"
                        >HỌC SINH CÓ MÁY TÍNH RIÊNG <span class="text-[10px] md:text-[11px] opacity-80 md:ml-1"
                            >(BẮT BUỘC)</span
                        ></span
                    >
                </div>
            </div>
        </div>
    </section>
</MainLayout>
