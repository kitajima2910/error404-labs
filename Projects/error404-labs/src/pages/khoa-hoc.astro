---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'
import { DATA_DEMO } from '../data/dataTestDemo.js'
import InfoIcon from '../components/info/InfoIcon.astro'
import InfoHeading from '../components/info/InfoHeading.astro'

// Thông tin liên hệ (giữ nguyên số điện thoại / Zalo / địa chỉ thật)
const ZALO_URL = 'https://zalo.me/0373306966'
const PHONE_URL = 'tel:0373306966'
const PHONE_TEXT = '0373.306.966'
const ADDRESS = '308 Đ. TX 25, Thạnh Xuân, Q.12, TP.HCM'
const MAPS_URL = 'https://www.google.com/maps/search/?api=1&query=308+Đ.+TX+25,+Thạnh+Xuân,+Q.12,+TP.HCM'

const facts = [
    { icon: 'users', value: '3 – 5 HS', label: 'mỗi lớp Offline' },
    { icon: 'desktop', value: '1 kèm 1', label: 'Online trực tiếp' },
    { icon: 'calendar', value: '2 buổi', label: 'mỗi tuần' },
    { icon: 'pin', value: 'Q.12', label: 'TP.HCM' },
] as const

const goals = [
    {
        icon: 'bulb',
        text: 'Hiểu cơ chế hoạt động của Web & Game',
        tone: 'bg-blue-50 text-blue-600 ring-blue-100',
    },
    {
        icon: 'rocket',
        text: 'Tự tay xây dựng Website & Game từ con số 0',
        tone: 'bg-emerald-50 text-emerald-600 ring-emerald-100',
    },
    {
        icon: 'puzzle',
        text: 'Nâng cao tư duy logic & thiết kế hệ thống',
        tone: 'bg-violet-50 text-violet-600 ring-violet-100',
    },
    {
        icon: 'beaker',
        text: 'Học qua dự án thực tế, không học thuộc lòng',
        tone: 'bg-amber-50 text-amber-600 ring-amber-100',
    },
] as const

const techs = [
    { name: 'HTML', role: 'Cấu trúc & nội dung', tone: 'bg-orange-50 text-orange-700 border-orange-200' },
    { name: 'CSS', role: 'Giao diện & màu sắc', tone: 'bg-sky-50 text-sky-700 border-sky-200' },
    { name: 'JavaScript', role: 'Logic & tương tác', tone: 'bg-amber-50 text-amber-800 border-amber-200' },
]

const roadmap = [
    {
        no: '01',
        title: 'Nền tảng Web sáng tạo',
        desc: 'Xây dựng cấu trúc web: văn bản, hình ảnh, liên kết',
        icon: 'document',
    },
    {
        no: '02',
        title: 'Thiết kế Game tương tác',
        desc: 'Sáng tạo logic, cơ chế game và trải nghiệm',
        icon: 'sparkles',
    },
    {
        no: '03',
        title: 'Dự án Web & Game',
        desc: 'Hiện thực hóa ý tưởng qua dự án tương tác cá nhân',
        icon: 'rocket',
    },
] as const

// 6 sản phẩm tiêu biểu lấy từ dữ liệu thật của trang Thử nghiệm (ưu tiên game HTML5 thuần + web đơn giản)
const SHOWCASE_NAMES = [
    '2. Bắt Quả',
    '4. Xếp Gạch',
    '10. Nổ Bóng',
    '12. Bảo Vệ Tháp',
    'Pet404-Labs',
    'Fox Robot Slider',
]
const picked = SHOWCASE_NAMES.map((n) => DATA_DEMO.find((d) => d.name === n)).filter(Boolean) as typeof DATA_DEMO
const showcase = (picked.length === 6 ? picked : DATA_DEMO.slice(0, 6)).map((d) => ({
    ...d,
    kind: d.link.startsWith('/thu-nghiem/web/') ? 'Web' : 'Game',
    // Mở thẳng đúng sản phẩm ở trang Thử nghiệm (trang đó đọc tham số ?demo=)
    href: `/thu-nghiem?demo=${encodeURIComponent(d.name)}`,
}))
const heroDemo = DATA_DEMO.find((d) => d.name === '5. Bắn Vịt') ?? DATA_DEMO[0]

const faqs = [
    {
        q: 'Lớp học ở đâu?',
        a: `Lớp Offline học tại ${ADDRESS}. Nếu ở xa, con có thể chọn hình thức Online 1 kèm 1 trực tiếp.`,
    },
    {
        q: 'Lịch học như thế nào?',
        a: `Lớp học 2 buổi / tuần. Khung giờ cụ thể vui lòng liên hệ Zalo ${PHONE_TEXT} để được sắp xếp phù hợp.`,
    },
    {
        q: 'Có những hình thức học nào?',
        a: 'Offline: 3 - 5 học sinh / lớp (kèm sát). Online: 1 kèm 1 trực tiếp (tương tác cao).',
    },
    {
        q: 'Con cần chuẩn bị gì trước khi học?',
        a: 'Học sinh cần có máy tính riêng (bắt buộc) để tự tay viết code, chạy thử và lưu lại sản phẩm của mình.',
    },
    {
        q: 'Học phí bao nhiêu?',
        a: `Vui lòng liên hệ Zalo ${PHONE_TEXT} để được tư vấn.`,
    },
    {
        q: 'Đăng ký cho con như thế nào?',
        a: `Phụ huynh nhắn Zalo hoặc gọi số ${PHONE_TEXT} để đăng ký và được tư vấn hình thức học phù hợp.`,
    },
]
---

<MainLayout
    title={`Khóa học | ${TC_TITLE}`}
    description="Lớp học Tư duy sáng tạo qua lập trình Web & Game (HTML, CSS & JavaScript) cho học sinh: Offline 3 - 5 học sinh / lớp tại Q.12 TP.HCM hoặc Online 1 kèm 1. Đăng ký qua Zalo 0373.306.966."
>
    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-navy-950 text-white">
        <div class="absolute inset-0 bg-grid-dark opacity-60 pointer-events-none" aria-hidden="true"></div>
        <div
            class="absolute -top-40 -right-32 w-[520px] h-[520px] rounded-full bg-blue-600/30 blur-[130px] pointer-events-none"
            aria-hidden="true"
        >
        </div>
        <div
            class="absolute -bottom-48 -left-24 w-[420px] h-[420px] rounded-full bg-sun-400/10 blur-[130px] pointer-events-none"
            aria-hidden="true"
        >
        </div>

        <div
            class="relative container-site pt-10 pb-24 md:pt-16 md:pb-32 grid lg:grid-cols-12 gap-12 lg:gap-10 items-center"
        >
            <div class="lg:col-span-7">
                <nav aria-label="Breadcrumb" class="text-sm text-slate-400 mb-6">
                    <a href="/" class="hover:text-white no-underline">Trang chủ</a>
                    <span class="mx-2" aria-hidden="true">/</span>
                    <span class="text-slate-200">Khóa học</span>
                </nav>

                <p
                    class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-sun-400 text-xs font-bold px-3 py-1.5 rounded-full mb-6 uppercase tracking-wider"
                >
                    <span class="w-1.5 h-1.5 rounded-full bg-sun-400"></span>
                    Lớp học Offline &amp; Online
                </p>

                <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.15] text-balance">
                    Tư duy sáng tạo qua lập trình
                    <span class="text-sun-400">Web &amp; Game</span>
                </h1>

                <p
                    class="mt-5 inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-sm md:text-base font-bold text-white"
                >
                    <span class="inline-flex gap-1" aria-hidden="true">
                        <span class="w-2.5 h-2.5 rounded-full bg-orange-400"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-sun-400"></span>
                    </span>
                    HTML, CSS &amp; JAVASCRIPT – Hành trình sáng tạo công nghệ
                </p>

                <p class="mt-4 text-slate-300 text-base md:text-lg leading-relaxed max-w-2xl">
                    Lớp học giúp học sinh tự tay làm ra website và game của riêng mình — học qua dự án thực tế, lớp nhỏ
                    kèm sát, không học thuộc lòng.
                </p>

                <div id="courseHeroCta" class="mt-8 flex flex-col sm:flex-row sm:flex-wrap gap-3">
                    <a href={ZALO_URL} target="_blank" rel="noopener" class="btn btn-sun btn-lg">
                        <InfoIcon name="chat" class="w-5 h-5" strokeWidth={2} />
                        Đăng ký qua Zalo
                    </a>
                    <a href={PHONE_URL} class="btn btn-ghost-light btn-lg">
                        <InfoIcon name="phone" class="w-5 h-5" strokeWidth={2} />
                        Gọi {PHONE_TEXT}
                    </a>
                </div>

                <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-300">
                    {
                        ['Lớp nhỏ, kèm sát', 'Học qua dự án thực tế', 'Học phí: liên hệ để được tư vấn'].map((t) => (
                            <li class="flex items-center gap-2">
                                <svg
                                    class="w-4 h-4 text-emerald-400 shrink-0"
                                    viewBox="0 0 20 20"
                                    fill="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                                        clip-rule="evenodd"
                                    />
                                </svg>
                                {t}
                            </li>
                        ))
                    }
                </ul>
            </div>

            {/* Minh họa: khung trình duyệt với một game làm bằng HTML5 */}
            <div class="lg:col-span-5 relative max-w-xl w-full mx-auto lg:mx-0">
                <div
                    class="rounded-2xl bg-white/5 border border-white/10 shadow-[0_30px_80px_rgba(0,0,0,0.45)] overflow-hidden lg:rotate-1"
                >
                    <div class="flex items-center gap-2 px-4 py-3 bg-navy-900 border-b border-white/10">
                        <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
                        <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
                        <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
                        <span
                            class="ml-2 flex-1 min-w-0 truncate text-[11px] font-mono text-slate-400 bg-white/5 px-3 py-1 rounded-md"
                        >
                            error404-labs.info.vn/thu-nghiem
                        </span>
                    </div>
                    <img
                        src={heroDemo.image}
                        alt={`Ảnh minh họa game ${heroDemo.name} làm bằng HTML5`}
                        width="640"
                        height="360"
                        class="block w-full aspect-video object-cover"
                    />
                </div>

                <div
                    class="hidden md:block absolute -left-6 -bottom-12 w-[290px] rounded-xl bg-[#1e1e2e] border border-white/10 shadow-2xl p-4 font-mono text-[12px] leading-6 info-float"
                >
                    <p class="text-slate-500">// Ví dụ: game Bắn Vịt</p>
                    <p>
                        <span class="text-orange-300">&lt;canvas</span>
                        <span class="text-sky-300">id</span>=<span class="text-emerald-300">"game"</span><span
                            class="text-orange-300">&gt;</span
                        >
                    </p>
                    <p>
                        <span class="text-violet-300">if</span> (trungVit) diem<span class="text-sky-300">++</span>
                    </p>
                </div>
                <div
                    class="hidden md:flex absolute -right-3 -top-5 items-center gap-2 bg-sun-400 text-navy-950 rounded-xl shadow-xl px-4 py-2.5 font-extrabold text-sm info-float [animation-delay:1.2s]"
                >
                    🎮 Game HTML5
                </div>
            </div>
        </div>
    </section>

    {/* ── KEY FACTS ───────────────────────────────────────────────── */}
    <section class="relative z-10 -mt-12 container-site" aria-label="Thông tin nhanh về lớp học">
        <ul
            class="max-w-6xl mx-auto bg-white rounded-2xl shadow-[0_20px_50px_rgba(15,23,42,0.08)] border border-slate-200 grid grid-cols-2 lg:grid-cols-4 [&>li:nth-child(odd)]:border-r [&>li:nth-child(-n+2)]:border-b lg:[&>li:nth-child(-n+2)]:border-b-0 lg:[&>li:not(:last-child)]:border-r"
        >
            {
                facts.map((f) => (
                    <li class="p-4 md:p-6 flex flex-col sm:flex-row items-center sm:items-center gap-2 sm:gap-4 text-center sm:text-left border-slate-100">
                        <span class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                            <InfoIcon name={f.icon} class="w-6 h-6" />
                        </span>
                        <span>
                            <span class="block text-xl md:text-2xl font-extrabold text-slate-900 tracking-tight">
                                {f.value}
                            </span>
                            <span class="block text-xs md:text-sm text-slate-500 font-medium">{f.label}</span>
                        </span>
                    </li>
                ))
            }
        </ul>
    </section>

    {/* ── MỤC TIÊU ────────────────────────────────────────────────── */}
    <section id="muc-tieu" class="bg-white py-16 md:py-24">
        <div class="container-site grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
            <div class="lg:col-span-5">
                <InfoHeading
                    eyebrow="Mục tiêu khóa học"
                    title="Con sẽ học được gì?"
                    lead="Từ người dùng máy tính, con trở thành người tạo ra sản phẩm: hiểu Web & Game vận hành thế nào rồi tự tay làm ra chúng với HTML, CSS & JavaScript."
                />
                <ul class="grid grid-cols-3 gap-3 -mt-2">
                    {
                        techs.map((t) => (
                            <li class={`rounded-2xl border p-3 md:p-4 ${t.tone}`}>
                                <span class="block font-extrabold text-sm md:text-base">{t.name}</span>
                                <span class="block text-[11px] md:text-xs mt-1 opacity-80 leading-snug">{t.role}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <ul class="lg:col-span-7 grid sm:grid-cols-2 gap-4 md:gap-5">
                {
                    goals.map((g, i) => (
                        <li class="card p-5 md:p-6 flex gap-4 items-start h-full">
                            <span
                                class={`w-12 h-12 rounded-xl ring-4 flex items-center justify-center shrink-0 ${g.tone}`}
                            >
                                <InfoIcon name={g.icon} class="w-6 h-6" />
                            </span>
                            <span>
                                <span class="block text-xs font-bold text-slate-500 mb-1">Mục tiêu {i + 1}</span>
                                <span class="block text-base md:text-lg font-bold text-slate-800 leading-snug">
                                    {g.text}
                                </span>
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    {/* ── LỘ TRÌNH ────────────────────────────────────────────────── */}
    <section id="lo-trinh" class="bg-slate-50 py-16 md:py-24">
        <div class="container-site">
            <InfoHeading
                eyebrow="Lộ trình học"
                title="Lộ trình 3 giai đoạn"
                lead="Đi từng bước vững chắc: từ nền tảng web đến game tương tác và dự án của riêng con."
                align="center"
            />

            <div class="relative max-w-6xl mx-auto">
                <div
                    class="md:hidden absolute left-7 top-6 bottom-6 w-0.5 -translate-x-1/2 bg-gradient-to-b from-blue-200 via-blue-300 to-sun-300"
                    aria-hidden="true"
                >
                </div>
                <div
                    class="hidden md:block absolute top-7 left-[16.6%] right-[16.6%] h-0.5 bg-gradient-to-r from-blue-200 via-blue-300 to-sun-300"
                    aria-hidden="true"
                >
                </div>
                <ol class="relative grid md:grid-cols-3 gap-6 md:gap-8">
                    {
                        roadmap.map((s, i) => (
                            <li class="relative flex md:flex-col md:items-center gap-4 md:gap-6">
                                <span
                                    class:list={[
                                        'relative z-10 w-14 h-14 rounded-2xl text-lg font-extrabold flex items-center justify-center shrink-0 shadow-lg ring-8 ring-slate-50',
                                        i === 2
                                            ? 'bg-sun-400 text-navy-950 shadow-sun-500/30'
                                            : 'bg-gradient-to-br from-blue-600 to-navy-800 text-white shadow-blue-600/30',
                                    ]}
                                >
                                    {s.no}
                                </span>
                                <div class="card p-5 md:p-6 flex-1 w-full md:text-center">
                                    <span class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 uppercase tracking-wider">
                                        <InfoIcon name={s.icon} class="w-4 h-4" strokeWidth={2} />
                                        Giai đoạn {i + 1}
                                    </span>
                                    <h3 class="mt-2 text-lg md:text-xl font-extrabold text-slate-900">{s.title}</h3>
                                    <p class="mt-2 text-sm md:text-base text-slate-500 leading-relaxed">{s.desc}</p>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </div>
        </div>
    </section>

    {/* ── HÌNH THỨC HỌC ───────────────────────────────────────────── */}
    <section id="hinh-thuc" class="bg-white py-16 md:py-24">
        <div class="container-site">
            <InfoHeading
                eyebrow="Hình thức học"
                title="Chọn cách học phù hợp với con"
                lead="Học trực tiếp tại lớp cùng các bạn hoặc học Online 1 kèm 1 ngay tại nhà."
                align="center"
            />

            <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
                {/* Offline */}
                <article class="card overflow-hidden flex flex-col">
                    <div class="h-1.5 bg-gradient-to-r from-blue-500 to-blue-700"></div>
                    <div class="p-6 md:p-8 flex flex-col flex-1">
                        <div class="flex items-center justify-between gap-3">
                            <span
                                class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center"
                            >
                                <InfoIcon name="users" class="w-6 h-6" />
                            </span>
                            <span class="chip bg-blue-50 text-blue-700 border-blue-200">Tại lớp · Q.12</span>
                        </div>
                        <h3 class="mt-5 text-sm font-extrabold uppercase tracking-wider text-blue-600">Offline</h3>
                        <p class="mt-1 text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
                            3 - 5 học sinh / lớp
                        </p>
                        <p class="mt-1 text-slate-500 font-semibold">(kèm sát)</p>
                        <ul class="mt-6 space-y-3 text-sm md:text-base text-slate-600 flex-1">
                            <li class="flex gap-3">
                                <InfoIcon name="check" class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
                                <span>Lớp nhỏ, giáo viên theo sát từng bạn</span>
                            </li>
                            <li class="flex gap-3">
                                <InfoIcon name="check" class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
                                <span>Học trực tiếp tại {ADDRESS}</span>
                            </li>
                            <li class="flex gap-3">
                                <InfoIcon name="check" class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
                                <span>Học sinh có máy tính riêng để thực hành</span>
                            </li>
                        </ul>
                        <a href={ZALO_URL} target="_blank" rel="noopener" class="btn btn-primary mt-8 w-full">
                            Hỏi lịch lớp Offline
                        </a>
                    </div>
                </article>

                {/* Online */}
                <article class="card overflow-hidden flex flex-col">
                    <div class="h-1.5 bg-gradient-to-r from-sun-400 to-amber-500"></div>
                    <div class="p-6 md:p-8 flex flex-col flex-1">
                        <div class="flex items-center justify-between gap-3">
                            <span
                                class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center"
                            >
                                <InfoIcon name="desktop" class="w-6 h-6" />
                            </span>
                            <span class="chip bg-amber-50 text-amber-800 border-amber-200">Học tại nhà</span>
                        </div>
                        <h3 class="mt-5 text-sm font-extrabold uppercase tracking-wider text-amber-700">Online</h3>
                        <p class="mt-1 text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
                            1 kèm 1 trực tiếp
                        </p>
                        <p class="mt-1 text-slate-500 font-semibold">(tương tác cao)</p>
                        <ul class="mt-6 space-y-3 text-sm md:text-base text-slate-600 flex-1">
                            <li class="flex gap-3">
                                <InfoIcon name="check" class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" />
                                <span>Giáo viên hướng dẫn riêng, trao đổi trực tiếp</span>
                            </li>
                            <li class="flex gap-3">
                                <InfoIcon name="check" class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" />
                                <span>Không cần di chuyển, phù hợp khi ở xa</span>
                            </li>
                            <li class="flex gap-3">
                                <InfoIcon name="check" class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" />
                                <span>Học sinh có máy tính riêng để thực hành</span>
                            </li>
                        </ul>
                        <a href={ZALO_URL} target="_blank" rel="noopener" class="btn btn-outline mt-8 w-full">
                            Hỏi lịch học Online
                        </a>
                    </div>
                </article>
            </div>
        </div>
    </section>

    {/* ── LỊCH HỌC & ĐỊA ĐIỂM ─────────────────────────────────────── */}
    <section id="lich-hoc" class="bg-slate-50 py-16 md:py-24">
        <div class="container-site">
            <InfoHeading
