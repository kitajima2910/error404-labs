---
import type { GetStaticPaths } from 'astro'
import { TC_TITLE } from '../../common/TextConst'
import MainLayout from '../../layouts/MainLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { formatBlogPost } from '../../js/utils'
import Pagination from '../../components/Pagination.astro'
import CategoryCloud from '../../components/CategoryCloud.astro'

export const getStaticPaths = (({ paginate }) => {
    const allPosts = Object.values(
        import.meta.glob<any>('./*.md', { eager: true }),
    )

    const formattedPosts: any[] = formatBlogPost(allPosts, {
        limit: allPosts.length,
        filterOutDrafts: true,
        sortByDate: true,
    })

    return paginate(formattedPosts, {
        pageSize: 3,
    })
}) satisfies GetStaticPaths

const { page } = Astro.props

const length = page.data.length

// console.log('page: ', page)
---

<MainLayout title=`Bài Viết | ${TC_TITLE}`>
    <section class="my-5 mb-15 w-10/12 mx-auto" aria-label="Bài Viết Mới">
        <h1 class="text-5xl font-semibold mb-10 mt-10">Bài Viết Mới</h1>
        <div
            class="custom-grid mb-10"
            style={`max-width: ${length > 1 ? '100%' : '400px'}`}
        >
            {
                page.data.map((post) => (
                    <PostCard
                        frontmatter={post.frontmatter}
                        url={post.url}
                        tagType="h2"
                    />
                ))
            }
        </div>
        <div class="flex justify-center">
            <Pagination prevURL={page.url.prev} nextURL={page.url.next} />
        </div>
        <aside aria-label="Danh Mục Bài Viết" class="flex justify-center">
            <CategoryCloud showCount={true} />
        </aside>
    </section>
</MainLayout>

<style>
    .custom-grid {
        display: grid;
        gap: 40px;
        justify-content: center;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
        width: 100%;
    }
</style>
