const promptFiles = import.meta.glob('/src/data/game-roadmap/*.txt', { as: 'raw', eager: true }) as Record<
    string,
    string
>
const promptContentByGame = Object.fromEntries(
    Object.entries(promptFiles).map(
        ([
            path,
            content,
        ]) => {
            const fileName = path.split('/').pop() ?? ''
            const gameName = fileName.replace(/\.txt$/, '')
            return [
                gameName,
                content,
            ]
        },
    ),
)

const gameToGenre: Record<string, string> = {}
roadmapRows.forEach((weeks) => {
    weeks.forEach((week) => {
        week.games.forEach((game) => {
            gameToGenre[game] = week.genre
        })
    })
})

gameToGenre['Cyber Orbit Dodge'] = 'Action'
gameToGenre['AI Bomb Reflex'] = 'Arcade'
gameToGenre['Web3 Laser Escape'] = 'Action'
