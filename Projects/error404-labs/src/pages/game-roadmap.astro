---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'

const methods = [
    { icon: '🎮', title: 'Học qua dự án', text: 'Thực hành là chính' },
    { icon: '🧠', title: 'Tư duy logic', text: 'Giải quyết vấn đề' },
    { icon: '💡', title: 'Sáng tạo', text: 'Tự do ý tưởng' },
    { icon: '🤖', title: 'Không cần code', text: 'Dùng AI như công cụ' },
    { icon: '🏆', title: 'Sản phẩm cá nhân', text: 'Mỗi bé 1 game riêng' },
]

const months = [
    { no: 1, title: 'Khởi động', sub: 'Làm quen', icon: '🌱', color: 'green' },
    { no: 2, title: 'Né & phản xạ', sub: 'Phản xạ nhanh', icon: '⚡', color: 'orange' },
    { no: 3, title: 'Bắn súng', sub: 'Shooter cơ bản', icon: '🎯', color: 'purple' },
    { no: 4, title: 'Giải đố', sub: 'Logic cơ bản', icon: '🧊', color: 'blue' },
    { no: 5, title: 'Chiến đấu', sub: 'Combat cơ bản', icon: '⚔️', color: 'red' },
    { no: 6, title: 'Nhịp điệu', sub: 'Rhythm', icon: '🎵', color: 'cyan' },
    { no: 7, title: 'Thu thập', sub: 'Collect', icon: '🪙', color: 'green' },
    { no: 8, title: 'Hiệu ứng', sub: 'Effect & Skill', icon: '✨', color: 'orange' },
    { no: 9, title: 'Nâng cấp', sub: 'Progression', icon: '⬆️', color: 'purple' },
    { no: 10, title: 'Kẻ địch AI', sub: 'AI Enemy', icon: '🤖', color: 'blue' },
    { no: 11, title: 'Game riêng', sub: 'Tự do sáng tạo', icon: '⭐', color: 'red' },
    { no: 12, title: 'Hoàn thiện', sub: 'Polish & Showcase', icon: '👑', color: 'green' },
]

const weeks = [
    {
        title: 'Tuần 1 - Thể loại A',
        rows: [
            { genre: 'Runner', games: ['Chạy & nhảy', 'Chạy nhặt coin', 'Chạy qua platform'] },
            { genre: 'Runner', games: ['Né chướng ngại', 'Leo tường', 'Trượt xuống dốc'] },
            { genre: 'Shooter', games: ['Bắn quái đơn', 'Bắn theo sóng', 'Bảo vệ căn cứ'] },
            { genre: 'Puzzle', games: ['Ghép hình', 'Mê cung', 'Nút & cửa'] },
            { genre: 'Action', games: ['Đánh thường', 'Combo cơ bản', 'Né & đánh'] },
            { genre: 'Rhythm', games: ['Gõ nhịp', 'Nhảy theo nhạc', 'Dập beat'] },
            { genre: 'Collect', games: ['Nhặt coin', 'Nhặt kim cương', 'Nhặt sao'] },
            { genre: 'Effect', games: ['Hiệu ứng nổ', 'Trail bóng', 'Hiệu ứng băng'] },
            { genre: 'Upgrade', games: ['Nâng cấp HP', 'Nâng cấp sát thương', 'Mở khóa skill'] },
            { genre: 'AI Enemy', games: ['Enemy tuần tra', 'Enemy đuổi', 'Enemy bắn'] },
            { genre: 'Free Build', games: ['Game platform', 'Game puzzle', 'Game bắn súng'] },
            { genre: 'UI & Menu', games: ['Menu Start', 'Select Level', 'Cửa hàng UI'] },
        ],
    },
    {
        title: 'Tuần 2 - Thể loại B',
        rows: [
            { genre: 'Puzzle', games: ['Kéo thả khối', 'Đẩy hộp', 'Mở khóa cửa'] },
            { genre: 'Action', games: ['Né dao xoay', 'Nhảy tường', 'Nổ laser'] },
            { genre: 'Arcade', games: ['Bắn bong bóng', 'Bắn vịt', 'Bắn UFO'] },
            { genre: 'Logic', games: ['Sắp xếp', 'Cân bằng', 'Bật công tắc'] },
            { genre: 'Boss Fight', games: ['Boss Slime', 'Boss Robot', 'Boss Rồng'] },
            { genre: 'Music', games: ['Piano Tiles', 'Bắt nốt nhạc', 'Nhạc cụ mini'] },
            { genre: 'Adventure', games: ['Khám phá hang', 'Tìm chìa khóa', 'Đi tìm báu vật'] },
            { genre: 'Skill', games: ['Skill lửa', 'Skill băng', 'Skill sét'] },
            { genre: 'Shop', games: ['Shop vũ khí', 'Shop trang bị', 'Shop pet'] },
            { genre: 'AI Pattern', games: ['Pattern đơn', 'Pattern xoay', 'Pattern phức tạp'] },
            { genre: 'Theme Pack', games: ['Chủ đề rừng', 'Chủ đề biển', 'Chủ đề không gian'] },
            { genre: 'Polish', games: ['Âm thanh', 'Hiệu ứng', 'Hoàn thiện'] },
        ],
    },
    {
        title: 'Tuần 3 - Thể loại A',
        rows: [
            { genre: 'Arcade', games: ['Trượt để né', 'Nhảy tránh gai', 'Bay qua ống'] },
            { genre: 'Arcade', games: ['Tránh vật rơi', 'Xé xe', 'Tránh bom'] },
            { genre: 'Shooter', games: ['Nâng cấp súng', 'Bắn boss nhỏ', 'Hỗ trợ đồng đội'] },
            { genre: 'Puzzle', games: ['Sokoban mini', 'Kéo chốt', 'Thắp sáng'] },
            { genre: 'Action', games: ['Nhảy tấn công', 'Dash attack', 'Chém xoay'] },
            { genre: 'Rhythm', games: ['Tránh vật theo nhạc', 'Nhấn đúng lúc', 'Chuỗi combo'] },
            { genre: 'Collect', games: ['Thu thập trái cây', 'Thu thập vật phẩm', 'Giao hàng'] },
            { genre: 'Effect', games: ['Chữa lành', 'Hiệu ứng combo', 'Hiệu ứng đặc biệt'] },
            { genre: 'Progression', games: ['Level & EXP', 'Cây kỹ năng', 'Thăng cấp'] },
            { genre: 'Boss AI', games: ['Boss di chuyển', 'Boss pattern', 'Boss nhiều pha'] },
            { genre: 'Game Idea', games: ['Ý tưởng riêng 1', 'Ý tưởng riêng 2', 'Ý tưởng riêng 3'] },
            { genre: 'Test & Fix', games: ['Test gameplay', 'Cân bằng game', 'Sửa lỗi'] },
        ],
    },
    {
        title: 'Tuần 4 - Thể loại B',
        rows: [
            { genre: 'Simulation', games: ['Trồng cây', 'Nuôi pet', 'Cửa hàng mini'] },
            { genre: 'Puzzle', games: ['Đi đúng đường', 'Xoay đường', 'Nối đường'] },
            { genre: 'Action', games: ['Chém quái', 'Phi tiêu', 'Đấm bốc'] },
            { genre: 'Arcade', games: ['Đưa bóng vào rổ', 'Ném bóng', 'Pinball mini'] },
            { genre: 'Arcade', games: ['Sinh tồn', 'Đấu trường', 'Vượt ải'] },
            { genre: 'Arcade', games: ['Khiêu vũ', 'Disco Ball', 'Nhạc bay'] },
            { genre: 'Simulation', games: ['Nông thú', 'Câu cá', 'Nấu ăn'] },
            { genre: 'Action', games: ['Skill dash', 'Skill nhảy', 'Skill AoE'] },
            { genre: 'Adventure', games: ['Nhiệm vụ chính', 'Nhiệm vụ phụ', 'Nhiệm vụ hằng ngày'] },
            { genre: 'Simulation', games: ['NPC thông minh', 'Kẻ địch phối hợp', 'Thế giới động'] },
            { genre: 'Mechanic Mix', games: ['Kết hợp 2 cơ chế', 'Kết hợp 3 cơ chế', 'Kết hợp 4 cơ chế'] },
            { genre: 'Showcase', games: ['Trailer game', 'Poster game', 'Trình diễn'] },
        ],
    },
]

const genres = [
    ['🎮', 'Runner', 'Vượt chướng ngại'],
    ['🧩', 'Puzzle', 'Giải đố, logic'],
    ['🎯', 'Shooter', 'Bắn súng'],
    ['⚔️', 'Action', 'Đối kháng, chém'],
    ['🕹️', 'Arcade', 'Phản xạ, kỹ năng'],
    ['🌿', 'Simulation', 'Mô phỏng, nuôi dưỡng'],
]

const tools = [
    ['✦', 'Gemini', 'Tư duy, viết prompt, tạo ý tưởng'],
    ['◎', 'ChatGPT', 'Viết prompt, giải thích logic'],
    ['☂', 'Astrocode', 'Tạo game 2D nhanh, không cần code'],
    ['✦', 'AI Studio', 'Thử nghiệm nhanh'],
    ['⬡', 'OpenCode', 'Hỗ trợ code, logic game'],
]

const benefits = [
    'Phát triển tư duy logic & sáng tạo',
    'Rèn kỹ năng giải quyết vấn đề',
    'Tự tin tạo sản phẩm cá nhân',
    'Không cần biết code vẫn làm game được',
    'Chuẩn bị nền tảng cho tương lai',
]
---

<MainLayout title={`Lộ trình 12 tháng học làm game với AI | ${TC_TITLE}`} description="Lộ trình 12 tháng học làm game với AI, mỗi tháng 4 tuần, mỗi tuần 2 thể loại và nhiều lựa chọn game thực hành." searchable={false}>
    <section class="roadmap-page">
        <div class="roadmap-shell">
            <header class="hero">
                <div class="pixel-kid" aria-hidden="true">
                    <div class="kid-head">🙂</div>
                    <div class="laptop">⌨</div>
                    <div class="grass"></div>
                </div>
                <div class="hero-main">
                    <h1>Lộ trình <span>12 tháng</span> - 4 game / tháng</h1>
                    <p>Mỗi tuần 2 thể loại - mỗi buổi chọn 1 trong 3 game</p>
                    <div class="method-grid">
                        {methods.map((item) => (
                            <div class="method-card">
                                <strong>{item.icon} {item.title}</strong>
                                <small>{item.text}</small>
                            </div>
                        ))}
                    </div>
                </div>
            </header>

            <div class="content-grid">
                <main class="table-wrap" aria-label="Bảng lộ trình 12 tháng học làm game với AI">
                    <div class="roadmap-table">
                        <div class="table-head month-head">Tháng</div>
                        {weeks.map((week) => <div class="table-head">{week.title} (3 lựa chọn)</div>)}

                        {months.map((month, monthIndex) => (
                            <>
                                <div class={`month-cell ${month.color}`}>
                                    <span class="month-no">{month.no}</span>
                                    <div>
                                        <strong>{month.title}</strong>
                                        <small>({month.sub})</small>
                                    </div>
                                    <span class="month-icon">{month.icon}</span>
                                </div>
                                {weeks.map((week) => {
                                    const row = week.rows[monthIndex]
                                    return (
                                        <article class="week-cell">
                                            <h3>{row.genre}</h3>
                                            <div class="game-grid">
                                                {row.games.map((game, gameIndex) => (
                                                    <div class="game-card">
                                                        <div class="game-scene" aria-hidden="true">
                                                            <span class="sky-dot"></span>
                                                            <span class="player">{gameIndex === 1 ? '🤖' : gameIndex === 2 ? '🧑' : '🏃'}</span>
                                                            <span class="item">{month.icon}</span>
                                                        </div>
                                                        <p>{gameIndex + 1}. {game}</p>
                                                    </div>
                                                ))}
                                            </div>
                                        </article>
                                    )
                                })}
                            </>
                        ))}
                    </div>
                </main>

                <aside class="sidebars">
                    <section class="panel">
                        <h2>Thể loại game</h2>
                        <ul class="genre-list">
                            {genres.map(([icon, name, text]) => (
                                <li><span>{icon}</span><strong>{name}</strong> - {text}</li>
                            ))}
                        </ul>
                    </section>

                    <section class="panel green-panel">
                        <h2>Cách hoạt động mỗi buổi</h2>
                        <ol class="step-list">
                            <li>Chọn 1 trong 3 game gợi ý</li>
                            <li>Đọc prompt mẫu</li>
                            <li>Tạo game với AI tool</li>
                            <li>Chơi thử - chỉnh sửa</li>
                            <li>Thêm ý tưởng cá nhân</li>
                            <li>Hoàn thành & chia sẻ</li>
                        </ol>
                    </section>

                    <section class="panel">
                        <h2>Tool sử dụng <span>(100% free)</span></h2>
                        <ul class="tool-list">
                            {tools.map(([icon, name, text]) => (
                                <li><span>{icon}</span><div><strong>{name}</strong><small>{text}</small></div></li>
                            ))}
                        </ul>
                    </section>

                    <section class="panel prompt-panel">
                        <h2>Cấu trúc prompt mẫu</h2>
                        <pre>{`Tạo game [THỂ LOẠI] 2D
Tên game: [TÊN GAME]
Mục tiêu: [MỤC TIÊU]
Nhân vật: [MÔ TẢ NHÂN VẬT]
Cơ chế chính: [CƠ CHẾ]
Độ khó: [DỄ / TRUNG BÌNH / KHÓ]
Màn chơi: [SỐ MÀN]
Yêu cầu đặc biệt: [ĐIỀU KIỆN]
Xuất bản: playable trên web`}</pre>
                    </section>

                    <section class="panel benefit-panel">
                        <h2>Lợi ích khóa học</h2>
                        <ul>
                            {benefits.map((benefit) => <li>✓ {benefit}</li>)}
                        </ul>
                        <div class="brand-pixel" aria-hidden="true">🏆 🧡 🙂</div>
                    </section>
                </aside>
            </div>

            <footer class="roadmap-footer">
                <strong>⭐ Học - Chơi - Sáng tạo - Làm game dễ dàng với AI</strong>
                <strong>❤️ Mỗi ý tưởng - Một trò chơi - Một thành công</strong>
                <strong>🎮 Error404 Labs - Let's code, let's game!</strong>
            </footer>
        </div>
    </section>
</MainLayout>

<style>
    .roadmap-page {
        background:
            linear-gradient(90deg, rgba(7, 50, 112, 0.05) 1px, transparent 1px),
            linear-gradient(rgba(7, 50, 112, 0.05) 1px, transparent 1px),
            #f6fbff;
        background-size: 18px 18px;
        color: #08285a;
        padding: 12px;
    }

    .roadmap-shell {
        width: min(1880px, 100%);
        margin: 0 auto;
        border: 3px solid #0b3b82;
        box-shadow: 0 12px 0 #06275a, 0 18px 35px rgba(4, 29, 66, 0.18);
        background: #ffffff;
        overflow: hidden;
    }

    .hero {
        display: grid;
        grid-template-columns: 250px 1fr;
        gap: 18px;
        align-items: center;
        padding: 14px 18px 10px;
        background: linear-gradient(180deg, #ffffff, #eef7ff);
        border-bottom: 3px solid #0b3b82;
    }

    .pixel-kid {
        position: relative;
        min-height: 150px;
        display: grid;
        place-items: center;
    }

    .kid-head {
        position: absolute;
        top: 4px;
        left: 32px;
        font-size: 76px;
        filter: drop-shadow(4px 4px 0 #1f4c86);
    }

    .laptop {
        position: absolute;
        right: 18px;
        top: 48px;
        width: 96px;
        height: 70px;
        display: grid;
        place-items: center;
        color: #9eff64;
        font-size: 42px;
        background: #11243f;
        border: 6px solid #071a31;
        box-shadow: inset 0 0 0 4px #35658f, 6px 6px 0 #9cb8c8;
    }

    .grass {
        position: absolute;
        bottom: 0;
        left: 16px;
        width: 180px;
        height: 46px;
        background: linear-gradient(#35b956 0 42%, #80522c 43%);
        border: 5px solid #123b25;
        box-shadow: 10px 10px 0 #d5eef7;
    }

    .hero-main h1 {
        margin: 0;
        text-align: center;
        text-transform: uppercase;
        font-size: clamp(34px, 4vw, 68px);
        line-height: 1;
        font-weight: 1000;
        color: #092963;
        text-shadow: 3px 3px 0 #d9e8ff;
    }

    .hero-main h1 span {
        color: #ff672f;
    }

    .hero-main p {
        width: fit-content;
        margin: 10px auto 12px;
        padding: 7px 24px;
        border-radius: 8px;
        background: #0d3475;
        color: #fff;
        font-size: clamp(18px, 2vw, 30px);
        font-weight: 900;
        text-transform: uppercase;
        box-shadow: 0 5px 0 #041f50;
    }

    .method-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(120px, 1fr));
        gap: 10px;
    }

    .method-card,
    .panel,
    .game-card {
        border: 2px solid #c7dcf5;
        background: #fff;
        box-shadow: 4px 4px 0 #d7e8fb;
    }

    .method-card {
        min-height: 64px;
        padding: 10px;
        border-radius: 8px;
    }

    .method-card strong {
        display: block;
        font-size: 15px;
        font-weight: 900;
    }

    .method-card small {
        display: block;
        margin-top: 3px;
        color: #18376c;
        font-weight: 700;
    }

    .content-grid {
        display: grid;
        grid-template-columns: minmax(960px, 1fr) 300px;
        gap: 12px;
        padding: 12px;
    }

    .table-wrap {
        overflow-x: auto;
        border: 2px solid #b7d3ef;
        background: #eaf5ff;
    }

    .roadmap-table {
        min-width: 1180px;
        display: grid;
        grid-template-columns: 160px repeat(4, minmax(245px, 1fr));
        gap: 2px;
        background: #b8d1ed;
    }

    .table-head {
        padding: 10px 8px;
        text-align: center;
        color: #fff;
        background: linear-gradient(180deg, #1265d8, #073682);
        font-weight: 1000;
        text-transform: uppercase;
        font-size: 16px;
    }

    .month-head {
        background: linear-gradient(180deg, #0d3475, #061f56);
    }

    .month-cell {
        display: grid;
        grid-template-columns: 42px 1fr 34px;
        align-items: center;
        gap: 8px;
        min-height: 112px;
        padding: 10px;
        background: #f4fbff;
        border-left: 8px solid var(--month-color);
    }

    .month-cell.green { --month-color: #22a855; }
    .month-cell.orange { --month-color: #ff7b24; }
    .month-cell.purple { --month-color: #684be4; }
    .month-cell.blue { --month-color: #1d85e8; }
    .month-cell.red { --month-color: #ef4b65; }
    .month-cell.cyan { --month-color: #13abc3; }

    .month-no {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        color: #fff;
        background: var(--month-color);
        font-size: 20px;
        font-weight: 1000;
    }

    .month-cell strong {
        display: block;
        color: var(--month-color);
        font-size: 15px;
        font-weight: 1000;
        text-transform: uppercase;
    }

    .month-cell small {
        color: #001f4d;
        font-size: 12px;
        font-weight: 800;
    }

    .month-icon {
        font-size: 26px;
        filter: drop-shadow(2px 2px 0 #bdd9f5);
    }

    .week-cell {
        min-height: 112px;
        padding: 6px 8px 8px;
        background: #fff;
    }

    .week-cell h3 {
        margin: 0 0 5px;
        color: #0b51bf;
        text-align: center;
        text-transform: uppercase;
        font-size: 13px;
        font-weight: 1000;
    }

    .game-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
    }

    .game-card {
        min-width: 0;
        border-radius: 4px;
        overflow: hidden;
    }

    .game-scene {
        position: relative;
        height: 44px;
        background:
            linear-gradient(#8dccff 0 62%, #58bf58 63% 78%, #7d4b2a 79%);
        border-bottom: 2px solid #296ba3;
        image-rendering: pixelated;
    }

    .game-scene::before,
    .game-scene::after {
        content: '';
        position: absolute;
        bottom: 11px;
        width: 18px;
        height: 10px;
        background: #ffffffcc;
        box-shadow: 10px 0 0 #ffffff99;
    }

    .game-scene::before { left: 8px; }
    .game-scene::after { right: 10px; }

    .player,
    .item,
    .sky-dot {
        position: absolute;
        z-index: 1;
    }

    .player {
        left: 12px;
        bottom: 10px;
        font-size: 20px;
    }

    .item {
        right: 12px;
        top: 9px;
        font-size: 18px;
    }

    .sky-dot {
        top: 8px;
        left: 50%;
        width: 9px;
        height: 9px;
        background: #ffd24f;
        box-shadow: 2px 2px 0 #c48900;
    }

    .game-card p {
        margin: 0;
        padding: 4px 3px 5px;
        color: #092963;
        font-size: 10px;
        font-weight: 900;
        line-height: 1.15;
        text-align: center;
    }

    .sidebars {
        display: grid;
        gap: 12px;
        align-content: start;
    }

    .panel {
        border-radius: 8px;
        overflow: hidden;
    }

    .panel h2 {
        margin: 0;
        padding: 10px 12px;
        background: #072d6f;
        color: #fff;
        font-size: 16px;
        font-weight: 1000;
        text-align: center;
        text-transform: uppercase;
    }

    .panel h2 span {
        color: #44f17a;
        font-size: 12px;
    }

    .green-panel h2 {
        background: #e8fff0;
        color: #05713f;
    }

    .genre-list,
    .tool-list,
    .benefit-panel ul {
        margin: 0;
        padding: 12px;
        list-style: none;
    }

    .genre-list li {
        margin-bottom: 8px;
        color: #0a2e65;
        font-size: 12px;
        font-weight: 800;
    }

    .genre-list span {
        display: inline-block;
        width: 24px;
        font-size: 18px;
    }

    .genre-list strong {
        text-transform: uppercase;
    }

    .step-list {
        margin: 0;
        padding: 12px 14px 12px 42px;
        color: #08285a;
        font-size: 13px;
