---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'
import GameCell from '../components/roadmap/GameCell.astro'
import PromptModal from '../components/roadmap/PromptModal.astro'

const methods = [
    { icon: '◆', title: 'Project-first', text: 'Mỗi tuần hoàn thiện một game nhỏ', tone: 'bg-emerald-400 text-slate-950' },
    { icon: '▣', title: 'Logic rõ ràng', text: 'Tách luật chơi, mục tiêu và trạng thái', tone: 'bg-indigo-400 text-white' },
    { icon: '✦', title: 'AI prompt', text: 'Bắt đầu nhanh bằng câu lệnh mẫu', tone: 'bg-amber-300 text-slate-950' },
    { icon: '●', title: 'Portfolio', text: 'Cuối khóa có bộ game cá nhân', tone: 'bg-rose-400 text-white' },
]

const months = [
    { no: 1, title: 'Khởi động', sub: 'Làm quen', accent: 'border-emerald-500 text-emerald-600' },
    { no: 2, title: 'Phản xạ', sub: 'Né tránh', accent: 'border-indigo-500 text-indigo-600' },
    { no: 3, title: 'Shooter', sub: 'Bắn súng', accent: 'border-slate-500 text-slate-700' },
    { no: 4, title: 'Puzzle', sub: 'Logic', accent: 'border-emerald-500 text-emerald-600' },
    { no: 5, title: 'Combat', sub: 'Chiến đấu', accent: 'border-indigo-500 text-indigo-600' },
    { no: 6, title: 'Rhythm', sub: 'Nhịp điệu', accent: 'border-slate-500 text-slate-700' },
    { no: 7, title: 'Collect', sub: 'Thu thập', accent: 'border-emerald-500 text-emerald-600' },
    { no: 8, title: 'Effect', sub: 'Kỹ năng', accent: 'border-indigo-500 text-indigo-600' },
    { no: 9, title: 'Progress', sub: 'Nâng cấp', accent: 'border-slate-500 text-slate-700' },
    { no: 10, title: 'AI Enemy', sub: 'Kẻ địch', accent: 'border-emerald-500 text-emerald-600' },
    { no: 11, title: 'Game riêng', sub: 'Sáng tạo', accent: 'border-indigo-500 text-indigo-600' },
    { no: 12, title: 'Polish', sub: 'Showcase', accent: 'border-slate-500 text-slate-700' },
]

const weekLabels = ['Tuần 1', 'Tuần 2', 'Tuần 3', 'Tuần 4']

const genreStyles: Record<string, string> = {
    Runner: 'border-emerald-200 bg-emerald-50/80 text-emerald-700',
    Puzzle: 'border-amber-200 bg-amber-50/80 text-amber-700',
    Logic: 'border-yellow-200 bg-yellow-50/80 text-yellow-700',
    Shooter: 'border-rose-200 bg-rose-50/80 text-rose-700',
    Action: 'border-red-200 bg-red-50/80 text-red-700',
    'Boss Fight': 'border-red-200 bg-red-50/80 text-red-700',
    Rhythm: 'border-fuchsia-200 bg-fuchsia-50/80 text-fuchsia-700',
    Music: 'border-fuchsia-200 bg-fuchsia-50/80 text-fuchsia-700',
    Arcade: 'border-sky-200 bg-sky-50/80 text-sky-700',
    Simulation: 'border-teal-200 bg-teal-50/80 text-teal-700',
    Collect: 'border-lime-200 bg-lime-50/80 text-lime-700',
    Adventure: 'border-cyan-200 bg-cyan-50/80 text-cyan-700',
    Effect: 'border-violet-200 bg-violet-50/80 text-violet-700',
    Skill: 'border-violet-200 bg-violet-50/80 text-violet-700',
    Upgrade: 'border-indigo-200 bg-indigo-50/80 text-indigo-700',
    Shop: 'border-indigo-200 bg-indigo-50/80 text-indigo-700',
    Progression: 'border-indigo-200 bg-indigo-50/80 text-indigo-700',
    'AI Enemy': 'border-slate-300 bg-slate-100 text-slate-800',
    'AI Pattern': 'border-slate-300 bg-slate-100 text-slate-800',
    'Boss AI': 'border-slate-300 bg-slate-100 text-slate-800',
    'Free Build': 'border-orange-200 bg-orange-50/80 text-orange-700',
    'Theme Pack': 'border-orange-200 bg-orange-50/80 text-orange-700',
    'Game Idea': 'border-orange-200 bg-orange-50/80 text-orange-700',
    'Mechanic Mix': 'border-orange-200 bg-orange-50/80 text-orange-700',
    'UI & Menu': 'border-blue-200 bg-blue-50/80 text-blue-700',
    Polish: 'border-blue-200 bg-blue-50/80 text-blue-700',
    'Test & Fix': 'border-blue-200 bg-blue-50/80 text-blue-700',
    Showcase: 'border-blue-200 bg-blue-50/80 text-blue-700',
}

const promptOf = (game: string, genre: string, month: number, week: number) => `Tạo game ${genre} 2D playable trên web.
Tên game: ${game}
Tháng: ${month}
Tuần: ${week}
Mục tiêu: Người chơi hiểu cơ chế chính trong 3 phút đầu.
Nhân vật: Một nhân vật đơn giản, dễ điều khiển bằng bàn phím hoặc chạm.
Cơ chế chính: Thiết kế gameplay đúng thể loại ${genre}, có điểm số, điều kiện thắng và thua rõ ràng.
Độ khó: Dễ ở màn đầu, tăng dần qua từng màn.
Màn chơi: 3 màn ngắn.
Yêu cầu đặc biệt: Có hướng dẫn trong game, âm thanh phản hồi, hiệu ứng khi thắng/thua.
Xuất bản: Chạy trực tiếp trên trình duyệt, ưu tiên HTML/CSS/JavaScript gọn nhẹ.`

const roadmapRows = [
    [
        { genre: 'Runner', games: ['Chạy & nhảy', 'Chạy nhặt coin', 'Chạy qua platform'] },
        { genre: 'Puzzle', games: ['Kéo thả khối', 'Đẩy hộp', 'Mở khóa cửa'] },
        { genre: 'Arcade', games: ['Trượt để né', 'Nhảy tránh gai', 'Bay qua ống'] },
        { genre: 'Simulation', games: ['Trồng cây', 'Nuôi pet', 'Cửa hàng mini'] },
    ],
    [
        { genre: 'Runner', games: ['Né chướng ngại', 'Leo tường', 'Trượt xuống dốc'] },
        { genre: 'Action', games: ['Né dao xoay', 'Nhảy tường', 'Nổ laser'] },
        { genre: 'Arcade', games: ['Tránh vật rơi', 'Xé xe', 'Tránh bom'] },
        { genre: 'Puzzle', games: ['Đi đúng đường', 'Xoay đường', 'Nối đường'] },
    ],
    [
        { genre: 'Shooter', games: ['Bắn quái đơn', 'Bắn theo sóng', 'Bảo vệ căn cứ'] },
        { genre: 'Arcade', games: ['Bắn bong bóng', 'Bắn vịt', 'Bắn UFO'] },
        { genre: 'Shooter', games: ['Nâng cấp súng', 'Bắn boss nhỏ', 'Hỗ trợ đồng đội'] },
        { genre: 'Action', games: ['Chém quái', 'Phi tiêu', 'Đấm bốc'] },
    ],
    [
        { genre: 'Puzzle', games: ['Ghép hình', 'Mê cung', 'Nút & cửa'] },
        { genre: 'Logic', games: ['Sắp xếp', 'Cân bằng', 'Bật công tắc'] },
        { genre: 'Puzzle', games: ['Sokoban mini', 'Kéo chốt', 'Thắp sáng'] },
        { genre: 'Arcade', games: ['Đưa bóng vào rổ', 'Ném bóng', 'Pinball mini'] },
    ],
    [
        { genre: 'Action', games: ['Đánh thường', 'Combo cơ bản', 'Né & đánh'] },
        { genre: 'Boss Fight', games: ['Boss Slime', 'Boss Robot', 'Boss Rồng'] },
        { genre: 'Action', games: ['Nhảy tấn công', 'Dash attack', 'Chém xoay'] },
        { genre: 'Arcade', games: ['Sinh tồn', 'Đấu trường', 'Vượt ải'] },
    ],
    [
        { genre: 'Rhythm', games: ['Gõ nhịp', 'Nhảy theo nhạc', 'Dập beat'] },
        { genre: 'Music', games: ['Piano Tiles', 'Bắt nốt nhạc', 'Nhạc cụ mini'] },
        { genre: 'Rhythm', games: ['Tránh vật theo nhạc', 'Nhấn đúng lúc', 'Chuỗi combo'] },
        { genre: 'Arcade', games: ['Khiêu vũ', 'Disco Ball', 'Nhạc bay'] },
    ],
    [
        { genre: 'Collect', games: ['Nhặt coin', 'Nhặt kim cương', 'Nhặt sao'] },
        { genre: 'Adventure', games: ['Khám phá hang', 'Tìm chìa khóa', 'Đi tìm báu vật'] },
        { genre: 'Collect', games: ['Thu thập trái cây', 'Thu thập vật phẩm', 'Giao hàng'] },
        { genre: 'Simulation', games: ['Nông thú', 'Câu cá', 'Nấu ăn'] },
    ],
    [
        { genre: 'Effect', games: ['Hiệu ứng nổ', 'Trail bóng', 'Hiệu ứng băng'] },
        { genre: 'Skill', games: ['Skill lửa', 'Skill băng', 'Skill sét'] },
        { genre: 'Effect', games: ['Chữa lành', 'Hiệu ứng combo', 'Hiệu ứng đặc biệt'] },
        { genre: 'Action', games: ['Skill dash', 'Skill nhảy', 'Skill AoE'] },
    ],
    [
        { genre: 'Upgrade', games: ['Nâng cấp HP', 'Nâng cấp sát thương', 'Mở khóa skill'] },
        { genre: 'Shop', games: ['Shop vũ khí', 'Shop trang bị', 'Shop pet'] },
        { genre: 'Progression', games: ['Level & EXP', 'Cây kỹ năng', 'Thăng cấp'] },
        { genre: 'Adventure', games: ['Nhiệm vụ chính', 'Nhiệm vụ phụ', 'Nhiệm vụ hằng ngày'] },
    ],
    [
        { genre: 'AI Enemy', games: ['Enemy tuần tra', 'Enemy đuổi', 'Enemy bắn'] },
        { genre: 'AI Pattern', games: ['Pattern đơn', 'Pattern xoay', 'Pattern phức tạp'] },
        { genre: 'Boss AI', games: ['Boss di chuyển', 'Boss pattern', 'Boss nhiều pha'] },
        { genre: 'Simulation', games: ['NPC thông minh', 'Kẻ địch phối hợp', 'Thế giới động'] },
    ],
    [
        { genre: 'Free Build', games: ['Game platform', 'Game puzzle', 'Game bắn súng'] },
        { genre: 'Theme Pack', games: ['Chủ đề rừng', 'Chủ đề biển', 'Chủ đề không gian'] },
        { genre: 'Game Idea', games: ['Ý tưởng riêng 1', 'Ý tưởng riêng 2', 'Ý tưởng riêng 3'] },
        { genre: 'Mechanic Mix', games: ['Kết hợp 2 cơ chế', 'Kết hợp 3 cơ chế', 'Kết hợp 4 cơ chế'] },
    ],
    [
        { genre: 'UI & Menu', games: ['Menu Start', 'Select Level', 'Cửa hàng UI'] },
        { genre: 'Polish', games: ['Âm thanh', 'Hiệu ứng', 'Hoàn thiện'] },
        { genre: 'Test & Fix', games: ['Test gameplay', 'Cân bằng game', 'Sửa lỗi'] },
        { genre: 'Showcase', games: ['Trailer game', 'Poster game', 'Trình diễn'] },
    ],
]

const roadmap = months.map((month, monthIndex) => ({
    ...month,
    weeks: roadmapRows[monthIndex].map((week, weekIndex) => ({
        ...week,
        games: week.games.map((game) => ({
            name: game,
            prompt: promptOf(game, week.genre, month.no, weekIndex + 1),
        })),
    })),
}))
---

<MainLayout
    title={`Lộ trình 12 tháng học làm game với AI | ${TC_TITLE}`}
    description="Lộ trình 12 tháng học làm game với AI, mỗi tháng 4 tuần, mỗi tuần có prompt mẫu để thực hành."
    searchable={false}
>
    <section class="roadmap-page bg-slate-100 text-slate-900">
        <div class="mx-auto max-w-[1720px] px-4 py-8 sm:px-6 lg:px-8">
            <header class="roadmap-hero relative overflow-hidden rounded-xl border border-indigo-300 bg-slate-950 shadow-2xl shadow-indigo-950/20">
                <div class="relative z-10 grid gap-8 px-6 py-10 sm:px-8 lg:grid-cols-[1fr_460px] lg:items-end lg:px-10 lg:py-12">
                    <div>
                        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-300/40 bg-emerald-300/10 px-4 py-2 text-xs font-black uppercase tracking-[0.2em] text-emerald-200">
                            <span class="h-2 w-2 rounded-sm bg-emerald-300 shadow-[0_0_18px_rgba(110,231,183,0.9)]"></span>
                            Error404-Labs Game Roadmap
                        </div>
                        <h1 class="mt-5 max-w-5xl text-4xl font-black leading-tight text-white sm:text-6xl lg:text-7xl">
                            Lộ trình 12 tháng học làm game
                        </h1>
                        <p class="mt-5 max-w-3xl text-base font-semibold leading-8 text-slate-200 sm:text-lg">
                            Bảng học game theo tháng, tuần và prompt mẫu. Chọn một game, mở prompt, sao chép và bắt đầu build ngay với AI.
                        </p>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2">
                        {methods.map((item) => (
                            <div class="rounded-lg border border-white/15 bg-white/10 p-4 shadow-lg shadow-slate-950/20 backdrop-blur">
                                <span class={`mb-3 grid h-9 w-9 place-items-center rounded-md text-sm font-black shadow-md ${item.tone}`}>
                                    {item.icon}
                                </span>
                                <strong class="block text-sm font-black text-white">{item.title}</strong>
                                <span class="mt-1 block text-xs font-semibold leading-5 text-slate-300">{item.text}</span>
                            </div>
                        ))}
                    </div>
                </div>
            </header>

            <div class="roadmap-scroll mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-white/95 shadow-2xl shadow-slate-300/50">
                <div class="grid min-w-[1320px] grid-cols-[190px_repeat(4,minmax(280px,1fr))]">
                    <div class="sticky left-0 z-20 border-b border-r border-slate-700 bg-slate-950 px-5 py-4 text-sm font-black uppercase tracking-[0.16em] text-white">
                        Tháng
                    </div>
                    {weekLabels.map((label) => (
                        <div class="border-b border-r border-indigo-400/40 bg-gradient-to-br from-indigo-600 to-slate-900 px-5 py-4 text-center text-sm font-black uppercase tracking-[0.16em] text-white last:border-r-0">
                            {label}
                        </div>
                    ))}

                    {roadmap.map((month) => (
                        <>
                            <div class={`sticky left-0 z-10 min-h-[190px] border-b border-r border-slate-200 bg-white p-4 shadow-[8px_0_24px_rgba(15,23,42,0.08)] ${month.accent}`}>
                                <span class="grid h-12 w-12 place-items-center rounded-lg bg-slate-950 text-lg font-black text-white shadow-lg shadow-slate-300">
                                    {month.no}
                                </span>
                                <strong class="mt-4 block text-lg font-black uppercase leading-tight">{month.title}</strong>
                                <span class="mt-2 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-black uppercase text-slate-500">{month.sub}</span>
                            </div>
                            {month.weeks.map((week, weekIndex) => (
                                <article class={`min-h-[190px] border-b border-r p-3 last:border-r-0 ${genreStyles[week.genre] || 'border-slate-200 bg-slate-50 text-slate-700'}`}>
                                    <h2 class="mb-3 rounded-md bg-white/80 px-3 py-2 text-center text-xs font-black uppercase tracking-[0.14em] shadow-sm">
                                        {week.genre}
                                    </h2>
                                    <div class="grid gap-2">
                                        {week.games.map((game, gameIndex) => (
                                            <GameCell
                                                game={game.name}
                                                genre={week.genre}
                                                month={month.no}
                                                week={weekIndex + 1}
                                                index={gameIndex + 1}
                                                prompt={game.prompt}
                                            />
                                        ))}
                                    </div>
                                </article>
                            ))}
                        </>
                    ))}
                </div>
            </div>

            <div class="mt-8 grid gap-4 lg:grid-cols-3">
                <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/70">
                    <h2 class="text-base font-black uppercase text-indigo-700">Cách học mỗi tuần</h2>
                    <ol class="mt-4 space-y-2 text-sm font-semibold text-slate-600">
                        <li>1. Chọn một game phù hợp trong ô tuần.</li>
                        <li>2. Mở prompt mẫu và sao chép câu lệnh.</li>
                        <li>3. Tạo bản playable, test nhanh, rồi chỉnh theo ý tưởng riêng.</li>
                    </ol>
                </section>
                <section class="rounded-xl border border-emerald-200 bg-emerald-50 p-6 shadow-lg shadow-emerald-100/70">
                    <h2 class="text-base font-black uppercase text-emerald-700">Mục tiêu</h2>
                    <p class="mt-4 text-sm font-semibold leading-6 text-slate-700">
                        Giữ tiến độ nhỏ, đều và có sản phẩm thật sau từng tuần, phù hợp cách học bằng AI của Error404-Labs.
                    </p>
                </section>
                <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/70">
                    <h2 class="text-base font-black uppercase text-slate-800">Palette</h2>
                    <div class="mt-4 flex gap-2">
                        <span class="h-8 flex-1 rounded bg-indigo-600"></span>
                        <span class="h-8 flex-1 rounded bg-slate-800"></span>
                        <span class="h-8 flex-1 rounded bg-emerald-500"></span>
                    </div>
                </section>
            </div>
        </div>
    </section>

    <PromptModal />
</MainLayout>

<style>
    .roadmap-hero {
        background:
            linear-gradient(135deg, rgba(79, 70, 229, 0.92), rgba(15, 23, 42, 0.98) 54%, rgba(16, 185, 129, 0.84)),
            linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
            linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
        background-size: auto, 18px 18px, 18px 18px;
    }

    .roadmap-hero::after {
        content: '';
        position: absolute;
        inset: auto 5% -46px auto;
        width: 220px;
        height: 220px;
        background: rgba(16, 185, 129, 0.32);
        box-shadow:
            -180px -50px 0 rgba(79, 70, 229, 0.26),
            -70px -120px 0 rgba(245, 158, 11, 0.2);
        filter: blur(18px);
    }

    .roadmap-scroll {
        scrollbar-color: #4f46e5 #e2e8f0;
        scrollbar-width: thin;
    }

    .roadmap-scroll::-webkit-scrollbar {
        height: 12px;
    }

    .roadmap-scroll::-webkit-scrollbar-track {
        background: #e2e8f0;
        border-radius: 999px;
    }

    .roadmap-scroll::-webkit-scrollbar-thumb {
        background: linear-gradient(90deg, #4f46e5, #10b981);
        border: 3px solid #e2e8f0;
        border-radius: 999px;
    }
</style>
