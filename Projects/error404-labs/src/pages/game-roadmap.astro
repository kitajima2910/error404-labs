---

<MainLayout
    title={`Tư duy sáng tạo học làm game với AI | ${TC_TITLE}`}
    description="Tư duy sáng tạo học làm game với AI, mỗi tháng 4 tuần, mỗi tuần có prompt mẫu để thực hành."
    searchable={false}
>
    <link rel="stylesheet" href="/font-awesome/css/font-awesome.min.css" />
    <script define:vars={{ roadmap }}>
        async function checkAccess() {
            const token = localStorage.getItem('auth_token');
            if (!token) {
                window.location.href = '/?auth=required';
                return;
            }

            try {
                const response = await fetch('/api/verify', {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    }
                });
                const data = await response.json();

                if (!data.authenticated || !data.user) {
                    window.location.href = '/?auth=required';
                    return;
                }

                const user = data.user;
                window.user = user; // Lưu user để GameCell check

                const lockRoadmapCells = () => {
                    document.querySelectorAll('.roadmap-game-cell').forEach((cell) => {
                        const permission = cell.getAttribute('data-permission');
                        if (!permission) return;

                        const hasAccess = user.roles === 'admin' || user.roles === 'member' || user.prompt_access?.includes(permission);

                        if (!hasAccess) {
                            cell.classList.add('is-locked');
                            cell.setAttribute('aria-disabled', 'true');
                            cell.setAttribute('title', 'Bài học này chưa được mở khóa. Vui lòng liên hệ Admin.');
                        } else {
                            cell.classList.remove('is-locked');
                            cell.removeAttribute('aria-disabled');
                            cell.removeAttribute('title');
                        }
                    });
                }

                lockRoadmapCells();


                if (user.roles !== 'admin' && user.roles !== 'member' && !user.prompt_access?.includes('game_roadmap')) {
                    // Ẩn hoặc làm mờ phần prompt
                    const promptCard = document.querySelector('.prompt-card');
                    if (promptCard) {
                        promptCard.style.opacity = '0';
                        promptCard.style.pointerEvents = 'none';
                        // Thêm thông báo
                        const notice = document.createElement('div');
                        notice.className = 'absolute inset-0 flex items-center justify-center bg-black/50 rounded-[24px] text-white font-bold text-center p-4';
                        notice.innerHTML = 'Bạn cần được Admin cấp quyền để xem nội dung này.';
                        promptCard.style.position = 'relative';
                        promptCard.appendChild(notice);
                    }
                } else {
                    // Hiển thị prompt nếu có quyền
                    const promptCard = document.querySelector('.prompt-card');
                    if (promptCard) {
                        promptCard.style.opacity = '1';
                        promptCard.style.pointerEvents = 'auto';
                    }
                }
            } catch (error) {
                console.error('Access check failed:', error);
                window.location.href = '/?auth=required';
            }
        }

        checkAccess();

        window.roadmapData = roadmap;
        let currentMonth = 0, currentWeek = 0;

        const gameImages = [
            'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&q=80&w=400',
            'https://images.unsplash.com/photo-1622737133809-d95047b9e673?auto=format&fit=crop&q=80&w=400',
            'https://images.unsplash.com/photo-1549490349-8643362247b5?auto=format&fit=crop&q=80&w=400',
            'https://images.unsplash.com/photo-1612287230202-1ff1d85d1b9b?auto=format&fit=crop&q=80&w=400',
            'https://images.unsplash.com/photo-1534423861386-85a16f5d13fd?auto=format&fit=crop&q=80&w=400',
            'https://images.unsplash.com/photo-1552820728-8b83bb6b6414?auto=format&fit=crop&q=80&w=400',
        ];

        function getGenreClass(genre) {
            const map = {
                'Runner': 'border-emerald-200 bg-emerald-50/80 text-emerald-700',
                'Puzzle': 'border-amber-200 bg-amber-50/80 text-amber-700',
            };
            const fallback = 'border-indigo-200 bg-indigo-50/80 text-indigo-700';
            return map[genre] || fallback;
        }

        function renderGameGrid(monthIdx, weekIdx) {
            const grid = document.getElementById('game-grid');
            if (!grid) return;
            const week = window.roadmapData[monthIdx].weeks[weekIdx];
            if (!week) return;

            grid.innerHTML = week.games.map((game, gi) => {
                const genre = week.genre;
                const genreClass = getGenreClass(genre);
                const img = gameImages[gi % gameImages.length];
                return '<div data-game="' + game.name + '" data-genre="' + genre + '" data-month="' + (monthIdx + 1) + '" data-week="' + (weekIdx + 1) + '" data-month-idx="' + monthIdx + '" data-week-idx="' + weekIdx + '" data-game-idx="' + gi + '" class="game-card-button bg-white rounded-3xl border-[2px] border-gray-100 shadow-sm hover:shadow-md hover:border-gray-200 overflow-hidden transition-all flex flex-col">' +
                    '<div class="h-44 w-full bg-cover bg-center relative p-3.5 flex flex-col justify-between" style="background-image: url(\'' + img + '\')">' +
                        '<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>' +
                        '<div class="flex gap-2 relative z-10">' +
                            '<span class="bg-red-500 text-white text-[11px] font-bold px-2 py-1 rounded-md flex items-center gap-1 shadow-sm"><i class="fa fa-fire" aria-hidden="true"></i> Trending</span>' +
                        '</div>' +
                    '</div>' +
                    '<div class="p-5 flex flex-col flex-1 relative z-20 -mt-3 bg-white rounded-t-2xl">' +
                        '<h3 class="font-extrabold text-slate-900 mb-2 text-xl truncate">' + game.name + '</h3>' +
                        '<div class="flex gap-1.5 mb-2.5">' +
                            '<span class="' + genreClass + ' text-xs font-bold px-2.5 py-0.5 rounded-md">' + genre + '</span>' +
                        '</div>' +
                        '<p class="text-slate-600 text-[13px] mb-4 font-semibold leading-relaxed line-clamp-2">A fun ' + genre.toLowerCase() + ' game for quick play sessions.</p>' +
                        '<div class="flex flex-wrap gap-1.5 mb-5 mt-auto">' +
                            '<span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-green-100 text-green-700">Easy</span>' +
                            '<span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-pink-100 text-pink-700">Kids Favorite</span>' +
                        '</div>' +
                        '<div class="flex gap-2 mt-auto">' +
                            '<button class="flex-1 bg-white border-2 border-gray-100 rounded-xl py-2 flex items-center justify-center hover:bg-gray-50 hover:border-gray-200 text-slate-500 transition-colors tooltip tooltip-top" title="Copy Prompts"><i class="fa fa-copy" aria-hidden="true"></i></button>' +
                            '<button class="flex-1 bg-white border-2 border-gray-100 rounded-xl py-2 flex items-center justify-center hover:bg-gray-50 hover:border-gray-200 text-slate-500 transition-colors tooltip tooltip-top" title="Assets"><i class="fa fa-image" aria-hidden="true"></i></button>' +
                            '<button class="flex-1 bg-white border-2 border-gray-100 rounded-xl py-2 flex items-center justify-center hover:bg-gray-50 hover:border-gray-200 text-slate-500 transition-colors tooltip tooltip-top" title="Template"><i class="fa fa-code" aria-hidden="true"></i></button>' +
                            '<button class="w-14 bg-[#8b5cf6] hover:bg-purple-600 text-white rounded-xl flex items-center justify-center shadow-lg shadow-purple-500/30 transition-transform active:scale-95"><i class="fa fa-play" aria-hidden="true"></i></button>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            }).join('');

            const month = window.roadmapData[monthIdx];
            document.getElementById('grid-header-title').textContent = 'Month ' + month.no + ' – Week ' + (weekIdx + 1);
            document.getElementById('grid-header-count').textContent = week.games.length + ' Games';

            currentMonth = monthIdx;
            currentWeek = weekIdx;
        }

        function updateGameDetail(monthIdx, weekIdx, gameIdx) {
            const game = window.roadmapData[monthIdx].weeks[weekIdx].games[gameIdx];
            const genre = window.roadmapData[monthIdx].weeks[weekIdx].genre;
            if (!game) return;

            document.getElementById('selectedGameTitle').textContent = game.name;
            document.getElementById('selectedGameGenre').textContent = genre;
            document.getElementById('selectedGameTrending').innerHTML = '<i class="fa fa-bolt" aria-hidden="true"></i> Trending';
            document.getElementById('selectedGameDesc').textContent = 'A fun ' + genre.toLowerCase() + ' game built for quick play sessions.';
            const img = gameImages[(monthIdx * 4 + weekIdx + gameIdx) % gameImages.length];
            document.getElementById('selectedGameImage').style.backgroundImage = "url('" + img + "')";
        }

        function highlightWeek(monthIdx, weekIdx) {
            const container = document.querySelector(`[data-weeks-for="${monthIdx}"]`);
            if (!container) return;
            const weekNum = weekIdx + 1;

            container.querySelectorAll('.roadmap-week-row').forEach(row => {
                const isTarget = parseInt(row.getAttribute('data-week')) === weekNum;

                row.classList.toggle('font-bold', isTarget);
                row.classList.toggle('text-pink-600', isTarget);
                row.classList.toggle('font-medium', !isTarget);
                row.classList.toggle('text-slate-500', !isTarget);
                row.classList.toggle('hover:text-slate-800', !isTarget);
                row.classList.toggle('transition-colors', !isTarget);
                row.classList.toggle('group', !isTarget);

                const dot = row.querySelector('.absolute');
                if (dot) {
                    dot.classList.toggle('border-2', isTarget);
                    dot.classList.toggle('border-pink-500', isTarget);
                    dot.classList.toggle('border-[1.5px]', !isTarget);
                    dot.classList.toggle('border-gray-200', !isTarget);
                    dot.classList.toggle('group-hover:border-slate-400', !isTarget);
                    dot.classList.toggle('transition-colors', !isTarget);
                }

                const count = row.querySelector('span');
                if (count) {
                    count.classList.toggle('text-xs', isTarget);
                    count.classList.toggle('text-pink-400', isTarget);
                    count.classList.toggle('font-medium', isTarget);
                    count.classList.toggle('text-[10px]', !isTarget);
                    count.classList.toggle('font-bold', !isTarget);
                    count.classList.toggle('text-gray-400', !isTarget);
                }
            });
        }

        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.roadmap-month-btn');
            if (!btn) return;

            const parent = btn.closest('.flex.flex-col');
            const weeks = parent.querySelector('[data-weeks-for]');
            const isActive = btn.classList.contains('is-active');

            document.querySelectorAll('.roadmap-month-btn.is-active').forEach(active => {
                if (active !== btn) {
                    active.classList.remove('is-active', 'bg-pink-50', 'border-pink-100', 'ring-1', 'ring-pink-500/20');
                    active.classList.add('border-transparent', 'hover:bg-gray-50');
                    const activeParent = active.closest('.flex.flex-col');
                    const activeWeeks = activeParent.querySelector('[data-weeks-for]');
                    if (activeWeeks) activeWeeks.classList.add('hidden');
                    const activeIcon = active.querySelector('.roadmap-month-icon');
                    if (activeIcon) { activeIcon.classList.remove('bg-pink-100', 'text-pink-500'); activeIcon.classList.add('bg-indigo-50', 'text-indigo-600'); }
                    const activeTitle = active.querySelector('.roadmap-month-title');
                    if (activeTitle) activeTitle.classList.remove('text-pink-600');
                    const activeChevron = active.querySelector('.roadmap-month-chevron');
                    if (activeChevron) { activeChevron.classList.remove('fa-chevron-down', 'text-pink-500'); activeChevron.classList.add('fa-chevron-right', 'text-gray-400'); }
                }
            });

            if (isActive) {
                btn.classList.remove('is-active', 'bg-pink-50', 'border-pink-100', 'ring-1', 'ring-pink-500/20');
                btn.classList.add('border-transparent', 'hover:bg-gray-50');
                if (weeks) weeks.classList.add('hidden');
                const icon = btn.querySelector('.roadmap-month-icon');
                if (icon) { icon.classList.remove('bg-pink-100', 'text-pink-500'); icon.classList.add('bg-indigo-50', 'text-indigo-600'); }
                const title = btn.querySelector('.roadmap-month-title');
                if (title) title.classList.remove('text-pink-600');
                const chevron = btn.querySelector('.roadmap-month-chevron');
                if (chevron) { chevron.classList.remove('fa-chevron-down', 'text-pink-500'); chevron.classList.add('fa-chevron-right', 'text-gray-400'); }
            } else {
                btn.classList.remove('border-transparent', 'hover:bg-gray-50');
                btn.classList.add('is-active', 'bg-pink-50', 'border-pink-100', 'ring-1', 'ring-pink-500/20');
                if (weeks) weeks.classList.remove('hidden');
                const icon = btn.querySelector('.roadmap-month-icon');
                if (icon) { icon.classList.remove('bg-indigo-50', 'text-indigo-600'); icon.classList.add('bg-pink-100', 'text-pink-500'); }
                const title = btn.querySelector('.roadmap-month-title');
                if (title) title.classList.add('text-pink-600');
                const chevron = btn.querySelector('.roadmap-month-chevron');
                if (chevron) { chevron.classList.remove('fa-chevron-right', 'text-gray-400'); chevron.classList.add('fa-chevron-down', 'text-pink-500'); }
                const monthIdx = parseInt(btn.getAttribute('data-month')) - 1;
                renderGameGrid(monthIdx, 0);
                updateGameDetail(monthIdx, 0, 0);
                highlightWeek(monthIdx, 0);
            }
        });

        document.addEventListener('click', function(e) {
            const weekRow = e.target.closest('.roadmap-week-row');
            if (weekRow) {
                const month = parseInt(weekRow.getAttribute('data-month'));
                const week = parseInt(weekRow.getAttribute('data-week'));
                const monthIdx = month - 1;
                const weekIdx = week - 1;
                renderGameGrid(monthIdx, weekIdx);
                updateGameDetail(monthIdx, weekIdx, 0);
                highlightWeek(monthIdx, weekIdx);
            }
        });

        document.addEventListener('click', function(e) {
            const card = e.target.closest('.game-card-button');
            if (card) {
                const monthIdx = parseInt(card.getAttribute('data-month-idx'));
                const weekIdx = parseInt(card.getAttribute('data-week-idx'));
                const gameIdx = parseInt(card.getAttribute('data-game-idx'));
                updateGameDetail(monthIdx, weekIdx, gameIdx);
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            renderGameGrid(0, 0);
            highlightWeek(0, 0);
        });
