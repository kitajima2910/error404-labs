---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'
import GameCell from '../components/roadmap/GameCell.astro'
import PromptModal from '../components/roadmap/PromptModal.astro'

const methods = [
    { icon: '◆', title: 'Project-first', text: 'Mỗi tuần hoàn thiện một game nhỏ', tone: 'bg-emerald-400 text-slate-950' },
    { icon: '▣', title: 'Logic rõ ràng', text: 'Tách luật chơi, mục tiêu và trạng thái', tone: 'bg-indigo-400 text-white' },
    { icon: '✦', title: 'AI prompt', text: 'Bắt đầu nhanh bằng câu lệnh mẫu', tone: 'bg-amber-300 text-slate-950' },
    { icon: '●', title: 'Portfolio', text: 'Cuối khóa có bộ game cá nhân', tone: 'bg-rose-400 text-white' },
]

const months = [
    { no: 1, title: 'Khởi động', sub: 'Làm quen', accent: 'border-emerald-500 text-emerald-600' },
    { no: 2, title: 'Phản xạ', sub: 'Né tránh', accent: 'border-indigo-500 text-indigo-600' },
    { no: 3, title: 'Shooter', sub: 'Bắn súng', accent: 'border-slate-500 text-slate-700' },
    { no: 4, title: 'Puzzle', sub: 'Logic', accent: 'border-emerald-500 text-emerald-600' },
    { no: 5, title: 'Combat', sub: 'Chiến đấu', accent: 'border-indigo-500 text-indigo-600' },
    { no: 6, title: 'Rhythm', sub: 'Nhịp điệu', accent: 'border-slate-500 text-slate-700' },
    { no: 7, title: 'Collect', sub: 'Thu thập', accent: 'border-emerald-500 text-emerald-600' },
    { no: 8, title: 'Effect', sub: 'Kỹ năng', accent: 'border-indigo-500 text-indigo-600' },
    { no: 9, title: 'Progress', sub: 'Nâng cấp', accent: 'border-slate-500 text-slate-700' },
    { no: 10, title: 'AI Enemy', sub: 'Kẻ địch', accent: 'border-emerald-500 text-emerald-600' },
    { no: 11, title: 'Game riêng', sub: 'Sáng tạo', accent: 'border-indigo-500 text-indigo-600' },
    { no: 12, title: 'Polish', sub: 'Showcase', accent: 'border-slate-500 text-slate-700' },
]

const weekLabels = ['Tuần 1', 'Tuần 2', 'Tuần 3', 'Tuần 4']

const genreStyles: Record<string, string> = {
    Runner: 'border-emerald-200 bg-emerald-50/80 text-emerald-700',
    Puzzle: 'border-amber-200 bg-amber-50/80 text-amber-700',
    Logic: 'border-yellow-200 bg-yellow-50/80 text-yellow-700',
    Shooter: 'border-rose-200 bg-rose-50/80 text-rose-700',
    Action: 'border-red-200 bg-red-50/80 text-red-700',
    'Boss Fight': 'border-red-200 bg-red-50/80 text-red-700',
    Rhythm: 'border-fuchsia-200 bg-fuchsia-50/80 text-fuchsia-700',
    Music: 'border-fuchsia-200 bg-fuchsia-50/80 text-fuchsia-700',
    Arcade: 'border-sky-200 bg-sky-50/80 text-sky-700',
    Simulation: 'border-teal-200 bg-teal-50/80 text-teal-700',
    Collect: 'border-lime-200 bg-lime-50/80 text-lime-700',
    Adventure: 'border-cyan-200 bg-cyan-50/80 text-cyan-700',
    Effect: 'border-violet-200 bg-violet-50/80 text-violet-700',
    Skill: 'border-violet-200 bg-violet-50/80 text-violet-700',
    Upgrade: 'border-indigo-200 bg-indigo-50/80 text-indigo-700',
    Shop: 'border-indigo-200 bg-indigo-50/80 text-indigo-700',
    Progression: 'border-indigo-200 bg-indigo-50/80 text-indigo-700',
    'AI Enemy': 'border-slate-300 bg-slate-100 text-slate-800',
    'AI Pattern': 'border-slate-300 bg-slate-100 text-slate-800',
    'Boss AI': 'border-slate-300 bg-slate-100 text-slate-800',
    'Free Build': 'border-orange-200 bg-orange-50/80 text-orange-700',
    'Theme Pack': 'border-orange-200 bg-orange-50/80 text-orange-700',
    'Game Idea': 'border-orange-200 bg-orange-50/80 text-orange-700',
    'Mechanic Mix': 'border-orange-200 bg-orange-50/80 text-orange-700',
    'UI & Menu': 'border-blue-200 bg-blue-50/80 text-blue-700',
    Polish: 'border-blue-200 bg-blue-50/80 text-blue-700',
    'Test & Fix': 'border-blue-200 bg-blue-50/80 text-blue-700',
    Showcase: 'border-blue-200 bg-blue-50/80 text-blue-700',
}

const promptOf = (game: string, genre: string, month: number, week: number) => `Tạo game ${genre} 2D playable trên web.
Tên game: ${game}
Tháng: ${month}
Tuần: ${week}
Mục tiêu: Người chơi hiểu cơ chế chính trong 3 phút đầu.
Nhân vật: Một nhân vật đơn giản, dễ điều khiển bằng bàn phím hoặc chạm.
Cơ chế chính: Thiết kế gameplay đúng thể loại ${genre}, có điểm số, điều kiện thắng và thua rõ ràng.
Độ khó: Dễ ở màn đầu, tăng dần qua từng màn.
Màn chơi: 3 màn ngắn.
Yêu cầu đặc biệt: Có hướng dẫn trong game, âm thanh phản hồi, hiệu ứng khi thắng/thua.
Xuất bản: Chạy trực tiếp trên trình duyệt, ưu tiên HTML/CSS/JavaScript gọn nhẹ.`

const roadmapRows = [
    [
        { genre: 'Runner', games: ['Chạy & nhảy', 'Chạy nhặt coin', 'Chạy qua platform'] },
        { genre: 'Puzzle', games: ['Kéo thả khối', 'Đẩy hộp', 'Mở khóa cửa'] },
        { genre: 'Arcade', games: ['Trượt để né', 'Nhảy tránh gai', 'Bay qua ống'] },
        { genre: 'Simulation', games: ['Trồng cây', 'Nuôi pet', 'Cửa hàng mini'] },
    ],
    [
        { genre: 'Runner', games: ['Né chướng ngại', 'Leo tường', 'Trượt xuống dốc'] },
        { genre: 'Action', games: ['Né dao xoay', 'Nhảy tường', 'Nổ laser'] },
        { genre: 'Arcade', games: ['Tránh vật rơi', 'Xé xe', 'Tránh bom'] },
        { genre: 'Puzzle', games: ['Đi đúng đường', 'Xoay đường', 'Nối đường'] },
    ],
    [
        { genre: 'Shooter', games: ['Bắn quái đơn', 'Bắn theo sóng', 'Bảo vệ căn cứ'] },
        { genre: 'Arcade', games: ['Bắn bong bóng', 'Bắn vịt', 'Bắn UFO'] },
        { genre: 'Shooter', games: ['Nâng cấp súng', 'Bắn boss nhỏ', 'Hỗ trợ đồng đội'] },
        { genre: 'Action', games: ['Chém quái', 'Phi tiêu', 'Đấm bốc'] },
    ],
    [
        { genre: 'Puzzle', games: ['Ghép hình', 'Mê cung', 'Nút & cửa'] },
        { genre: 'Logic', games: ['Sắp xếp', 'Cân bằng', 'Bật công tắc'] },
        { genre: 'Puzzle', games: ['Sokoban mini', 'Kéo chốt', 'Thắp sáng'] },
        { genre: 'Arcade', games: ['Đưa bóng vào rổ', 'Ném bóng', 'Pinball mini'] },
    ],
    [
        { genre: 'Action', games: ['Đánh thường', 'Combo cơ bản', 'Né & đánh'] },
        { genre: 'Boss Fight', games: ['Boss Slime', 'Boss Robot', 'Boss Rồng'] },
        { genre: 'Action', games: ['Nhảy tấn công', 'Dash attack', 'Chém xoay'] },
        { genre: 'Arcade', games: ['Sinh tồn', 'Đấu trường', 'Vượt ải'] },
    ],
    [
        { genre: 'Rhythm', games: ['Gõ nhịp', 'Nhảy theo nhạc', 'Dập beat'] },
        { genre: 'Music', games: ['Piano Tiles', 'Bắt nốt nhạc', 'Nhạc cụ mini'] },
        { genre: 'Rhythm', games: ['Tránh vật theo nhạc', 'Nhấn đúng lúc', 'Chuỗi combo'] },
        { genre: 'Arcade', games: ['Khiêu vũ', 'Disco Ball', 'Nhạc bay'] },
    ],
    [
        { genre: 'Collect', games: ['Nhặt coin', 'Nhặt kim cương', 'Nhặt sao'] },
        { genre: 'Adventure', games: ['Khám phá hang', 'Tìm chìa khóa', 'Đi tìm báu vật'] },
        { genre: 'Collect', games: ['Thu thập trái cây', 'Thu thập vật phẩm', 'Giao hàng'] },
        { genre: 'Simulation', games: ['Nông thú', 'Câu cá', 'Nấu ăn'] },
    ],
    [
        { genre: 'Effect', games: ['Hiệu ứng nổ', 'Trail bóng', 'Hiệu ứng băng'] },
        { genre: 'Skill', games: ['Skill lửa', 'Skill băng', 'Skill sét'] },
        { genre: 'Effect', games: ['Chữa lành', 'Hiệu ứng combo', 'Hiệu ứng đặc biệt'] },
        { genre: 'Action', games: ['Skill dash', 'Skill nhảy', 'Skill AoE'] },
    ],
    [
        { genre: 'Upgrade', games: ['Nâng cấp HP', 'Nâng cấp sát thương', 'Mở khóa skill'] },
        { genre: 'Shop', games: ['Shop vũ khí', 'Shop trang bị', 'Shop pet'] },
        { genre: 'Progression', games: ['Level & EXP', 'Cây kỹ năng', 'Thăng cấp'] },
        { genre: 'Adventure', games: ['Nhiệm vụ chính', 'Nhiệm vụ phụ', 'Nhiệm vụ hằng ngày'] },
    ],
    [
        { genre: 'AI Enemy', games: ['Enemy tuần tra', 'Enemy đuổi', 'Enemy bắn'] },
        { genre: 'AI Pattern', games: ['Pattern đơn', 'Pattern xoay', 'Pattern phức tạp'] },
        { genre: 'Boss AI', games: ['Boss di chuyển', 'Boss pattern', 'Boss nhiều pha'] },
        { genre: 'Simulation', games: ['NPC thông minh', 'Kẻ địch phối hợp', 'Thế giới động'] },
    ],
    [
        { genre: 'Free Build', games: ['Game platform', 'Game puzzle', 'Game bắn súng'] },
        { genre: 'Theme Pack', games: ['Chủ đề rừng', 'Chủ đề biển', 'Chủ đề không gian'] },
        { genre: 'Game Idea', games: ['Ý tưởng riêng 1', 'Ý tưởng riêng 2', 'Ý tưởng riêng 3'] },
        { genre: 'Mechanic Mix', games: ['Kết hợp 2 cơ chế', 'Kết hợp 3 cơ chế', 'Kết hợp 4 cơ chế'] },
    ],
    [
        { genre: 'UI & Menu', games: ['Menu Start', 'Select Level', 'Cửa hàng UI'] },
        { genre: 'Polish', games: ['Âm thanh', 'Hiệu ứng', 'Hoàn thiện'] },
        { genre: 'Test & Fix', games: ['Test gameplay', 'Cân bằng game', 'Sửa lỗi'] },
        { genre: 'Showcase', games: ['Trailer game', 'Poster game', 'Trình diễn'] },
    ],
]

const roadmap = months.map((month, monthIndex) => ({
    ...month,
    weeks: roadmapRows[monthIndex].map((week, weekIndex) => ({
        ...week,
        games: week.games.map((game) => ({
            name: game,
            prompt: promptOf(game, week.genre, month.no, weekIndex + 1),
        })),
    })),
}))
---

<MainLayout
    title={`Lộ trình 12 tháng học làm game với AI | ${TC_TITLE}`}
    description="Lộ trình 12 tháng học làm game với AI, mỗi tháng 4 tuần, mỗi tuần có prompt mẫu để thực hành."
    searchable={false}
>
    <section class="roadmap-page min-h-screen bg-[#f5f8ff] text-slate-900">
        <div class="mx-auto max-w-[1840px] px-4 py-6 sm:px-6 lg:px-8">
            <header class="roadmap-hero compact-hero relative overflow-hidden rounded-xl border border-white bg-white shadow-xl shadow-blue-200/40">
                <div class="relative z-10 grid gap-5 px-5 py-5 lg:grid-cols-[minmax(360px,0.95fr)_minmax(620px,1.55fr)] lg:items-center">
                    <div>
                        <p class="text-xs font-black uppercase tracking-[0.22em] text-blue-700">Error404-Labs Game Roadmap</p>
                        <h1 class="mt-2 text-3xl font-black leading-tight text-slate-950 sm:text-4xl xl:text-5xl">
                            Lộ trình <span class="text-orange-500">12 tháng</span> - 4 game / tháng
                        </h1>
                        <p class="mt-2 max-w-3xl text-sm font-bold leading-6 text-slate-600">
                            Mỗi tuần 2 thể loại, mỗi buổi chọn 1 trong 3 game, mở prompt mẫu và build bản playable ngay với AI.
                        </p>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                        {
                            methods.map((item, methodIndex) => (
                                <div class="method-card rounded-lg border border-slate-200 bg-white/90 p-3 shadow-lg shadow-blue-100/60 backdrop-blur">
                                    <span
                                        class={`method-icon mb-2 grid h-10 w-10 place-items-center rounded-lg text-sm font-black shadow-md ${item.tone}`}
                                        data-method={methodIndex + 1}
                                    >
                                        {item.icon}
                                    </span>
                                    <strong class="block text-sm font-black text-slate-950">{item.title}</strong>
                                    <span class="mt-1 block text-xs font-bold leading-5 text-slate-500">{item.text}</span>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </header>

            <div class="mt-5 grid gap-5 xl:grid-cols-[minmax(0,4fr)_minmax(300px,1fr)]">
                <main
                    class="roadmap-scroll overflow-x-auto rounded-xl border border-blue-100 bg-white shadow-2xl shadow-blue-200/50"
                    aria-label="Lộ trình game 12 tháng"
                >
                    <div class="roadmap-grid grid min-w-[1380px] grid-cols-[178px_repeat(4,minmax(290px,1fr))]">
                        <div
                            class="roadmap-corner sticky left-0 top-0 z-30 border-b border-r border-blue-900/30 bg-blue-950 px-5 py-4 text-sm font-black uppercase tracking-[0.16em] text-white"
                        >
                            Tháng
                        </div>
                        {
                            weekLabels.map((label, weekLabelIndex) => (
                                <div
                                    class="roadmap-week-header sticky top-0 z-20 border-b border-r border-white/30 px-5 py-4 text-center text-sm font-black uppercase tracking-[0.16em] text-white last:border-r-0"
                                    data-week={weekLabelIndex + 1}
                                >
                                    {label} - 3 lựa chọn
                                </div>
                            ))
                        }

                        {
                            roadmap.map((month) => (
                                <>
                                    <div
                                        class={`roadmap-month sticky left-0 z-10 min-h-[188px] border-b border-r border-blue-100 bg-white p-4 shadow-[12px_0_26px_rgba(37,99,235,0.12)] ${month.accent}`}
                                    >
                                        <span class="month-badge grid h-12 w-12 place-items-center rounded-lg text-lg font-black text-white shadow-lg">
                                            {month.no}
                                        </span>
                                        <strong class="mt-4 block text-base font-black uppercase leading-tight">{month.title}</strong>
                                        <span class="mt-2 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-black uppercase text-slate-500">
                                            {month.sub}
                                        </span>
                                    </div>
                                    {month.weeks.map((week, weekIndex) => (
                                        <article
                                            class={`roadmap-week min-h-[188px] border-b border-r p-3 last:border-r-0 ${genreStyles[week.genre] || 'border-slate-200 bg-slate-50 text-slate-700'}`}
                                        >
                                            <h2 class="genre-pill mb-3 rounded-lg bg-white/85 px-3 py-2 text-center text-xs font-black uppercase tracking-[0.14em] shadow-sm">
                                                {week.genre}
                                            </h2>
                                            <div class="grid gap-2">
                                                {week.games.map((game, gameIndex) => (
                                                    <GameCell
                                                        game={game.name}
                                                        genre={week.genre}
                                                        month={month.no}
                                                        week={weekIndex + 1}
                                                        index={gameIndex + 1}
                                                        prompt={game.prompt}
                                                    />
                                                ))}
                                            </div>
                                        </article>
                                    ))}
                                </>
                            ))
                        }
                    </div>
                </main>

                <aside class="roadmap-sidebar grid content-start gap-4 xl:sticky xl:top-5">
                    <section class="sidebar-card rounded-xl border border-emerald-100 bg-white p-5 shadow-xl shadow-emerald-100/60">
                        <h2 class="flex items-center gap-3 text-sm font-black uppercase tracking-[0.12em] text-emerald-700">
                            <span class="sidebar-icon bg-emerald-500 text-white">01</span>
                            Cách hoạt động
                        </h2>
                        <ol class="mt-4 space-y-3 text-sm font-bold leading-6 text-slate-600">
                            <li>Chọn 1 trong 3 game gợi ý.</li>
                            <li>Đọc prompt mẫu và tạo game với AI tool.</li>
                            <li>Chơi thử, chỉnh sửa, thêm ý tưởng cá nhân.</li>
                            <li>Hoàn thành và chia sẻ sản phẩm.</li>
                        </ol>
                    </section>

                    <section class="sidebar-card rounded-xl border border-blue-100 bg-white p-5 shadow-xl shadow-blue-100/70">
                        <h2 class="flex items-center gap-3 text-sm font-black uppercase tracking-[0.12em] text-blue-700">
                            <span class="sidebar-icon bg-blue-600 text-white">AI</span>
                            Tool sử dụng
                        </h2>
                        <div class="mt-4 grid gap-3">
                            <p class="tool-row"><strong>Gemini</strong><span>Tư duy, viết prompt, tạo ý tưởng</span></p>
                            <p class="tool-row"><strong>ChatGPT</strong><span>Viết prompt, giải thích logic</span></p>
                            <p class="tool-row"><strong>Astrocode</strong><span>Tạo game 2D nhanh, không cần code</span></p>
                            <p class="tool-row"><strong>AI Studio</strong><span>Thử nghiệm nhanh</span></p>
                        </div>
                    </section>

                    <section class="sidebar-card prompt-card rounded-xl border border-amber-100 bg-white p-5 shadow-xl shadow-amber-100/70">
                        <h2 class="flex items-center gap-3 text-sm font-black uppercase tracking-[0.12em] text-amber-700">
                            <span class="sidebar-icon bg-amber-400 text-slate-950">P</span>
                            Cấu trúc Prompt mẫu
                        </h2>
                        <div class="mt-4 rounded-lg border border-amber-100 bg-amber-50/70 p-4 text-sm font-bold leading-7 text-slate-700">
                            <p>Tạo game [THỂ LOẠI] 2D</p>
                            <p>Tên game: [TÊN GAME]</p>
                            <p>Mục tiêu: [MỤC TIÊU]</p>
                            <p>Nhân vật: [MÔ TẢ NHÂN VẬT]</p>
                            <p>Cơ chế chính: [CƠ CHẾ]</p>
                            <p>Xuất bản: playable trên web</p>
                        </div>
                    </section>

                    <section class="sidebar-card rounded-xl border border-rose-100 bg-white p-5 shadow-xl shadow-rose-100/70">
                        <h2 class="flex items-center gap-3 text-sm font-black uppercase tracking-[0.12em] text-rose-700">
                            <span class="sidebar-icon bg-rose-500 text-white">+</span>
                            Lợi ích khóa học
                        </h2>
                        <ul class="mt-4 space-y-3 text-sm font-bold leading-6 text-slate-600">
                            <li>Phát triển tư duy logic và sáng tạo.</li>
                            <li>Rèn kỹ năng giải quyết vấn đề.</li>
                            <li>Tự tin tạo sản phẩm cá nhân.</li>
                            <li>Chuẩn bị nền tảng cho tương lai AI.</li>
                        </ul>
                    </section>
                </aside>
            </div>
        </div>
    </section>
    <PromptModal />
</MainLayout>

<style>
    .roadmap-page {
        background:
            radial-gradient(circle at 8% 0%, rgba(59, 130, 246, 0.18), transparent 34%),
            radial-gradient(circle at 92% 10%, rgba(249, 115, 22, 0.16), transparent 30%),
            linear-gradient(180deg, #f8fbff 0%, #eef5ff 48%, #f8fbff 100%);
    }

    .roadmap-hero {
        background:
            linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(239, 246, 255, 0.94) 52%, rgba(255, 247, 237, 0.92)),
            linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
            linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
        background-size:
            auto,
            22px 22px,
            22px 22px;
    }

    .roadmap-hero::after {
        content: '';
        position: absolute;
        inset: auto 8% -58px auto;
        width: 260px;
        height: 160px;
        background: rgba(59, 130, 246, 0.18);
        box-shadow:
            -210px -34px 0 rgba(249, 115, 22, 0.14),
            -88px -98px 0 rgba(16, 185, 129, 0.12);
        filter: blur(22px);
    }

    .method-card {
        transition:
            transform 180ms ease,
            box-shadow 180ms ease,
            border-color 180ms ease;
    }

    .method-card:hover {
        border-color: rgba(37, 99, 235, 0.32);
        box-shadow: 0 18px 36px rgba(37, 99, 235, 0.16);
        transform: translateY(-2px);
    }

    .method-icon {
        box-shadow:
            0 10px 18px rgba(15, 23, 42, 0.14),
            inset 0 1px 0 rgba(255, 255, 255, 0.32);
    }

    .roadmap-grid {
        background:
            linear-gradient(#dbeafe 1px, transparent 1px),
            linear-gradient(90deg, #dbeafe 1px, transparent 1px);
        background-size: 100% 188px, calc((100% - 178px) / 4) 100%;
    }

    .roadmap-corner,
    .roadmap-week-header {
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.2);
    }

    .roadmap-week-header {
        background: linear-gradient(135deg, #1d4ed8 0%, #4338ca 48%, #0f766e 100%);
    }

    .roadmap-week-header[data-week='2'] {
        background: linear-gradient(135deg, #2563eb 0%, #7c3aed 55%, #db2777 100%);
    }

    .roadmap-week-header[data-week='3'] {
        background: linear-gradient(135deg, #0891b2 0%, #2563eb 50%, #f97316 100%);
    }

    .roadmap-week-header[data-week='4'] {
        background: linear-gradient(135deg, #16a34a 0%, #0ea5e9 48%, #4f46e5 100%);
    }

    .month-badge {
        background: linear-gradient(135deg, #0f172a, #2563eb);
    }

