    '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><defs><linearGradient id="m4" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#34d399"/><stop offset="100%" stop-color="#059669"/></linearGradient></defs><rect x="5" y="5" width="6" height="6" rx="1" fill="#ecfdf5" stroke="url(#m4)" stroke-width="1.5"/><rect x="13" y="5" width="6" height="6" rx="1" fill="#ecfdf5" stroke="url(#m4)" stroke-width="1.5"/><rect x="5" y="13" width="6" height="6" rx="1" fill="#ecfdf5" stroke="url(#m4)" stroke-width="1.5"/><rect x="13" y="13" width="6" height="6" rx="1" fill="#ecfdf5" stroke="url(#m4)" stroke-width="1.5"/><circle cx="8" cy="8" r="1" fill="url(#m4)"/><circle cx="16" cy="8" r="1" fill="url(#m4)"/><circle cx="8" cy="16" r="1" fill="url(#m4)"/><circle cx="16" cy="16" r="1" fill="url(#m4)"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><defs><linearGradient id="m5" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#818cf8"/><stop offset="100%" stop-color="#4f46e5"/></linearGradient></defs><path d="M6 6l4 4-4 4M18 6l-4 4 4 4" stroke="url(#m5)" stroke-width="1.8" stroke-linecap="round"/><path d="M5 19h14" stroke="url(#m5)" stroke-width="1.5" stroke-linecap="round"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><defs><linearGradient id="m6" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#e879f9"/><stop offset="100%" stop-color="#c026d3"/></linearGradient></defs><path d="M9 18V5l8-1v11" stroke="url(#m6)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><ellipse cx="7.5" cy="18" rx="2.5" ry="2" fill="#fae8ff" stroke="url(#m6)" stroke-width="1.2"/><ellipse cx="17.5" cy="16" rx="2.5" ry="2" fill="#fae8ff" stroke="url(#m6)" stroke-width="1.2"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><defs><linearGradient id="m7" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#65a30d"/><stop offset="100%" stop-color="#4d7c0f"/></linearGradient></defs><path d="M12 4l4 5 5 1-3 4 1 5-5-2-5 2 1-5-3-4 5-1z" fill="#f7fee7" stroke="url(#m7)" stroke-width="1.5" stroke-linejoin="round"/><circle cx="12" cy="11" r="1.5" fill="url(#m7)"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><defs><linearGradient id="m8" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#a78bfa"/><stop offset="100%" stop-color="#7c3aed"/></linearGradient></defs><path d="M12 3l1 3 3 1-3 1-1 3-1-3-3-1 3-1z" fill="#f5f3ff" stroke="url(#m8)" stroke-width="1.2" stroke-linejoin="round"/><circle cx="17" cy="17" r="3" fill="#f5f3ff" stroke="url(#m8)" stroke-width="1.2"/><circle cx="7" cy="16" r="2" fill="none" stroke="url(#m8)" stroke-width="1.2"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><defs><linearGradient id="m9" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#94a3b8"/><stop offset="100%" stop-color="#64748b"/></linearGradient></defs><rect x="5" y="15" width="3" height="5" rx=".8" fill="#f8fafc" stroke="url(#m9)" stroke-width="1.2"/><rect x="10.5" y="10" width="3" height="10" rx=".8" fill="#f8fafc" stroke="url(#m9)" stroke-width="1.2"/><rect x="16" y="5" width="3" height="15" rx=".8" fill="#f8fafc" stroke="url(#m9)" stroke-width="1.2"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><defs><linearGradient id="m10" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#34d399"/><stop offset="100%" stop-color="#059669"/></linearGradient></defs><rect x="6" y="8" width="12" height="10" rx="3" fill="#ecfdf5" stroke="url(#m10)" stroke-width="1.5"/><circle cx="10" cy="13" r="1" fill="url(#m10)"/><circle cx="14" cy="13" r="1" fill="url(#m10)"/><path d="M10 16a2 2 0 0 1 4 0" stroke="url(#m10)" stroke-width="1.2" fill="none"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><defs><linearGradient id="m11" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#818cf8"/><stop offset="100%" stop-color="#4f46e5"/></linearGradient></defs><path d="M12 2l1.5 5.5 5.5.5-4 3.5 1.5 5.5-5-3.5-5 3.5 1.5-5.5-4-3.5 5.5-.5z" fill="#eef2ff" stroke="url(#m11)" stroke-width="1.5" stroke-linejoin="round"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><defs><linearGradient id="m12" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#94a3b8"/><stop offset="100%" stop-color="#64748b"/></linearGradient></defs><path d="M6 9l-2 5h3.5L6 21l6-5.5L18 21l-1.5-7H20l-2-5H6z" fill="#f8fafc" stroke="url(#m12)" stroke-width="1.5" stroke-linejoin="round"/></svg>',
]
---

<MainLayout
    title={`Tư duy sáng tạo học làm game với AI | ${TC_TITLE}`}
    description="Tư duy sáng tạo học làm game với AI, mỗi cấp độ 4 tuần, mỗi tuần có prompt mẫu để thực hành."
    searchable={false}
>
    <link rel="stylesheet" href="/font-awesome/css/font-awesome.min.css" />
    <script define:vars={{ roadmap, genreIcons, monthSvgs, attrSvgs, allGamesData }}>
        async function checkAccess() {
            const token = localStorage.getItem('auth_token')
            if (!token) {
                window.location.href = '/?auth=required'
                return
            }

            try {
                const response = await fetch('/api/verify', {
                    headers: {
                        Authorization: `Bearer ${token}`,
                        'Content-Type': 'application/json',
                    },
                })
                const data = await response.json()

                if (!data.authenticated || !data.user) {
                    window.location.href = '/?auth=required'
                    return
                }

                const user = data.user
                window.user = user // Lưu user để GameCell check

                const lockRoadmapCells = () => {
                    document.querySelectorAll('.roadmap-game-cell').forEach((cell) => {
                        const permission = cell.getAttribute('data-permission')
                        if (!permission) return

                        const hasAccess =
                            user.roles === 'admin' ||
                            user.roles === 'member' ||
                            user.prompt_access?.includes(permission)

                        if (!hasAccess) {
                            cell.classList.add('is-locked')
                            cell.setAttribute('aria-disabled', 'true')
                            cell.setAttribute('title', 'Bài học này chưa được mở khóa. Vui lòng liên hệ Admin.')
                        } else {
                            cell.classList.remove('is-locked')
                            cell.removeAttribute('aria-disabled')
                            cell.removeAttribute('title')
                        }
                    })
                }

                lockRoadmapCells()

                if (
                    user.roles !== 'admin' &&
                    user.roles !== 'member' &&
                    !user.prompt_access?.includes('game_roadmap')
                ) {
                    // Ẩn hoặc làm mờ phần prompt
                    const promptCard = document.querySelector('.prompt-card')
                    if (promptCard) {
                        promptCard.style.opacity = '0'
                        promptCard.style.pointerEvents = 'none'
                        // Thêm thông báo
                        const notice = document.createElement('div')
                        notice.className =
                            'absolute inset-0 flex items-center justify-center bg-black/50 rounded-[24px] text-white font-bold text-center p-4'
                        notice.innerHTML = 'Bạn cần được Admin cấp quyền để xem nội dung này.'
                        promptCard.style.position = 'relative'
                        promptCard.appendChild(notice)
                    }
                } else {
                    // Hiển thị prompt nếu có quyền
                    const promptCard = document.querySelector('.prompt-card')
                    if (promptCard) {
                        promptCard.style.opacity = '1'
                        promptCard.style.pointerEvents = 'auto'
                    }
                }
            } catch (error) {
                console.error('Access check failed:', error)
                window.location.href = '/?auth=required'
            }
        }

        checkAccess()

        window.roadmapData = roadmap
        let currentMonth = 0,
            currentWeek = 0

        const genreGradBg = {
            Runner: 'from-emerald-500 to-emerald-700',
            Puzzle: 'from-amber-500 to-amber-700',
            Logic: 'from-yellow-500 to-yellow-700',
            Shooter: 'from-rose-500 to-rose-700',
            Action: 'from-red-500 to-red-700',
            'Boss Fight': 'from-red-500 to-red-700',
            Rhythm: 'from-fuchsia-500 to-fuchsia-700',
            Music: 'from-fuchsia-500 to-fuchsia-700',
            Arcade: 'from-sky-500 to-sky-700',
            Simulation: 'from-teal-500 to-teal-700',
            Collect: 'from-lime-500 to-lime-700',
            Adventure: 'from-cyan-500 to-cyan-700',
            Effect: 'from-violet-500 to-violet-700',
            Skill: 'from-violet-500 to-violet-700',
            Upgrade: 'from-indigo-500 to-indigo-700',
            Shop: 'from-indigo-500 to-indigo-700',
            Progression: 'from-indigo-500 to-indigo-700',
            'AI Enemy': 'from-slate-400 to-slate-600',
            'AI Pattern': 'from-slate-400 to-slate-600',
            'Boss AI': 'from-slate-400 to-slate-600',
            'Free Build': 'from-orange-500 to-orange-700',
            'Theme Pack': 'from-orange-500 to-orange-700',
            'Game Idea': 'from-orange-500 to-orange-700',
            'Mechanic Mix': 'from-orange-500 to-orange-700',
            'UI & Menu': 'from-blue-500 to-blue-700',
            Polish: 'from-blue-500 to-blue-700',
            'Test & Fix': 'from-blue-500 to-blue-700',
            Showcase: 'from-blue-500 to-blue-700',
        }

        function getGenreClass(genre) {
            const map = {
                Runner: 'border-emerald-200 bg-emerald-50/80 text-emerald-700',
                Puzzle: 'border-amber-200 bg-amber-50/80 text-amber-700',
            }
            const fallback = 'border-indigo-200 bg-indigo-50/80 text-indigo-700'
            return map[genre] || fallback
        }

        function renderGameGrid(monthIdx, weekIdx) {
            const grid = document.getElementById('game-grid')
            if (!grid) return
            const week = window.roadmapData[monthIdx].weeks[weekIdx]
            if (!week) return

            grid.innerHTML = week.games
                .map((game, gi) => {
                    const genre = week.genre
                    const genreClass = getGenreClass(genre)
                    const svg = genreIcons[genre] || genreIcons['Arcade']
                    const gradBg = genreGradBg[genre] || 'from-indigo-500 to-indigo-700'
                    const imageSrc = '/images-game-roadmap/' + encodeURIComponent(game.name) + '.webp'
                    const promptBadge = hasPrompt(game)
                        ? '<span class="bg-emerald-500 text-white text-[11px] font-bold px-2 py-1 rounded-md flex items-center gap-1 shadow-sm"><i class="fa fa-check-circle"></i> Verified</span>'
                        : ''
                    return (
                        '<div data-game="' +
                        game.name +
                        '" data-genre="' +
                        genre +
                        '" data-month="' +
                        (monthIdx + 1) +
                        '" data-week="' +
                        (weekIdx + 1) +
                        '" data-month-idx="' +
                        monthIdx +
                        '" data-week-idx="' +
                        weekIdx +
                        '" data-game-idx="' +
                        gi +
                        '" data-prompt-content="' +
                        encodeURIComponent(game.promptContent || '') +
                        '" class="game-card-button game-card-clickable cursor-pointer bg-white rounded-3xl border-[2px] border-gray-100 shadow-sm hover:shadow-md hover:border-gray-200 overflow-hidden transition-all flex flex-col">' +
                        '<div class="h-44 w-full relative p-3.5 flex flex-col justify-between bg-gradient-to-br ' +
                        gradBg +
                        '">' +
                        '<img src="' +
                        imageSrc +
                        '" alt="' +
                        game.name +
                        '" class="absolute inset-0 h-full w-full object-cover" onload="this.parentElement.querySelector(\'.game-card-svg-fallback\')?.remove()" onerror="this.remove()">' +
                        '<div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>' +
                        '<div class="game-card-svg-fallback absolute inset-0 flex items-center justify-center opacity-20 p-8">' +
                        svg +
                        '</div>' +
                        '<div class="flex gap-2 relative z-10">' +
                        promptBadge +
                        '<span class="hidden bg-red-500 text-white text-[11px] font-bold px-2 py-1 rounded-md flex items-center gap-1 shadow-sm">' +
                        attrSvgs.fire +
                        ' Trending</span>' +
                        '</div>' +
                        '</div>' +
                        '<div class="p-5 flex flex-col flex-1 relative z-20 -mt-3 bg-white rounded-t-2xl">' +
                        '<h3 class="font-extrabold text-slate-900 mb-2 text-xl truncate">' +
                        game.name +
                        '</h3>' +
                        '<div class="flex gap-1.5 mb-2.5">' +
                        '<span class="' +
                        genreClass +
                        ' text-xs font-bold px-2.5 py-0.5 rounded-md">' +
                        genre +
                        '</span>' +
                        '</div>' +
                        '</div>' +
                        '</div>' +
                        '</div>'
                    )
                })
                .join('')

            const month = window.roadmapData[monthIdx]
            document.getElementById('grid-header-title').textContent = 'Level ' + month.no + ' – Week ' + (weekIdx + 1)
            document.getElementById('grid-header-count').textContent = week.games.length + ' Games'

            currentMonth = monthIdx
            currentWeek = weekIdx
        }

        let shuffledGames = []
        let displayCount = 9

        function hasPrompt(game) {
            return game.promptContent && game.promptContent.trim() !== '' && game.promptContent.trim() !== 'Đang tải...'
        }

        function shuffleArray(arr) {
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1))
                ;[
                    arr[i],
                    arr[j],
                ] = [
                    arr[j],
                    arr[i],
                ]
            }
            return arr
        }

        function renderAllGamesRandom(gamesData) {
            const grid = document.getElementById('game-grid')
            if (!grid) return

            if (shuffledGames.length === 0) {
                const withPrompt = shuffleArray(gamesData.filter(hasPrompt))
                const withoutPrompt = shuffleArray(gamesData.filter((g) => !hasPrompt(g)))
                shuffledGames = [
                    ...withPrompt,
                    ...withoutPrompt,
                ]
            }

            const visible = shuffledGames.slice(0, displayCount)

            grid.innerHTML = visible
                .map((game) => {
                    const genre = game.genre
                    const genreClass = getGenreClass(genre)
                    const svg = genreIcons[genre] || genreIcons['Arcade']
                    const gradBg = genreGradBg[genre] || 'from-indigo-500 to-indigo-700'
                    const imageSrc = '/images-game-roadmap/' + encodeURIComponent(game.name) + '.webp'
                    const promptBadge = hasPrompt(game)
                        ? '<span class="bg-emerald-500 text-white text-[11px] font-bold px-2 py-1 rounded-md flex items-center gap-1 shadow-sm"><i class="fa fa-check-circle"></i> Verified</span>'
                        : ''
                    return (
                        '<div data-game="' +
                        game.name +
                        '" data-genre="' +
                        genre +
                        '" data-month="0" data-week="0" data-month-idx="0" data-week-idx="0" data-game-idx="0" data-prompt-content="' +
                        encodeURIComponent(game.promptContent || '') +
                        '" class="game-card-button game-card-clickable cursor-pointer bg-white rounded-3xl border-[2px] border-gray-100 shadow-sm hover:shadow-md hover:border-gray-200 overflow-hidden transition-all flex flex-col">' +
                        '<div class="h-44 w-full relative p-3.5 flex flex-col justify-between bg-gradient-to-br ' +
                        gradBg +
                        '">' +
                        '<img src="' +
                        imageSrc +
                        '" alt="' +
                        game.name +
                        '" class="absolute inset-0 h-full w-full object-cover" onload="this.parentElement.querySelector(\'.game-card-svg-fallback\')?.remove()" onerror="this.remove()">' +
                        '<div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>' +
                        '<div class="game-card-svg-fallback absolute inset-0 flex items-center justify-center opacity-20 p-8">' +
                        svg +
                        '</div>' +
                        '<div class="flex gap-2 relative z-10">' +
                        promptBadge +
                        '<span class="hidden bg-red-500 text-white text-[11px] font-bold px-2 py-1 rounded-md flex items-center gap-1 shadow-sm">' +
                        attrSvgs.fire +
                        ' Trending</span>' +
                        '</div>' +
                        '</div>' +
                        '<div class="p-5 flex flex-col flex-1 relative z-20 -mt-3 bg-white rounded-t-2xl">' +
                        '<h3 class="font-extrabold text-slate-900 mb-2 text-xl truncate">' +
                        game.name +
                        '</h3>' +
                        '<div class="flex gap-1.5 mb-2.5">' +
                        '<span class="' +
                        genreClass +
                        ' text-xs font-bold px-2.5 py-0.5 rounded-md">' +
                        genre +
                        '</span>' +
                        '</div>' +
                        '</div>' +
                        '</div>' +
                        '</div>'
                    )
                })
                .join('')

            document.getElementById('grid-header-title').textContent = 'Tất cả Game Prompt'
            document.getElementById('grid-header-count').textContent =
                visible.length + ' / ' + shuffledGames.length + ' Games'

            const loadMoreBtn = document.getElementById('load-more-games-btn')
            if (loadMoreBtn) {
                if (displayCount >= shuffledGames.length) {
                    loadMoreBtn.classList.add('hidden')
                } else {
                    loadMoreBtn.classList.remove('hidden')
                }
            }
        }

        function loadMoreGames() {
            displayCount += 6
            renderAllGamesRandom()
        }

        function highlightWeek(monthIdx, weekIdx) {
            const container = document.querySelector(`[data-weeks-for="${monthIdx}"]`)
            if (!container) return
            const weekNum = weekIdx + 1

            container.querySelectorAll('.roadmap-week-row').forEach((row) => {
                const isTarget = parseInt(row.getAttribute('data-week')) === weekNum

                row.classList.toggle('font-bold', isTarget)
                row.classList.toggle('text-pink-600', isTarget)
                row.classList.toggle('font-medium', !isTarget)
                row.classList.toggle('text-slate-500', !isTarget)
                row.classList.toggle('hover:text-slate-800', !isTarget)
                row.classList.toggle('transition-colors', !isTarget)
                row.classList.toggle('group', !isTarget)

                const dot = row.querySelector('.absolute')
                if (dot) {
                    dot.classList.toggle('border-2', isTarget)
                    dot.classList.toggle('border-pink-500', isTarget)
                    dot.classList.toggle('border-[1.5px]', !isTarget)
                    dot.classList.toggle('border-gray-200', !isTarget)
                    dot.classList.toggle('group-hover:border-slate-400', !isTarget)
                    dot.classList.toggle('transition-colors', !isTarget)
                }
            })
        }

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.roadmap-month-btn')
            if (!btn) return

            const parent = btn.closest('.flex.flex-col')
            const weeks = parent.querySelector('[data-weeks-for]')
            const isActive = btn.classList.contains('is-active')

            document.querySelectorAll('.roadmap-month-btn.is-active').forEach((active) => {
                if (active !== btn) {
                    active.classList.remove('is-active', 'bg-pink-50', 'border-pink-100', 'ring-1', 'ring-pink-500/20')
                    active.classList.add('border-transparent', 'hover:bg-gray-50')
                    const activeParent = active.closest('.flex.flex-col')
                    const activeWeeks = activeParent.querySelector('[data-weeks-for]')
                    if (activeWeeks) activeWeeks.classList.add('hidden')
                    const activeIcon = active.querySelector('.roadmap-month-icon')
                    if (activeIcon) {
                        activeIcon.classList.remove('bg-pink-100', 'text-pink-500')
                        activeIcon.classList.add('bg-indigo-50', 'text-indigo-600')
                    }
                    const activeTitle = active.querySelector('.roadmap-month-title')
                    if (activeTitle) activeTitle.classList.remove('text-pink-600')
                    const activeChevron = active.querySelector('.roadmap-month-chevron')
                    if (activeChevron) {
                        activeChevron.classList.remove('fa-chevron-down', 'text-pink-500')
                        activeChevron.classList.add('fa-chevron-right', 'text-gray-400')
                    }
                }
            })

            if (isActive) {
                btn.classList.remove('is-active', 'bg-pink-50', 'border-pink-100', 'ring-1', 'ring-pink-500/20')
                btn.classList.add('border-transparent', 'hover:bg-gray-50')
                if (weeks) weeks.classList.add('hidden')
                const icon = btn.querySelector('.roadmap-month-icon')
                if (icon) {
                    icon.classList.remove('bg-pink-100', 'text-pink-500')
                    icon.classList.add('bg-indigo-50', 'text-indigo-600')
                }
                const title = btn.querySelector('.roadmap-month-title')
                if (title) title.classList.remove('text-pink-600')
                const chevron = btn.querySelector('.roadmap-month-chevron')
                if (chevron) {
                    chevron.classList.remove('fa-chevron-down', 'text-pink-500')
                    chevron.classList.add('fa-chevron-right', 'text-gray-400')
                }
            } else {
                btn.classList.remove('border-transparent', 'hover:bg-gray-50')
                btn.classList.add('is-active', 'bg-pink-50', 'border-pink-100', 'ring-1', 'ring-pink-500/20')
                if (weeks) weeks.classList.remove('hidden')
                const icon = btn.querySelector('.roadmap-month-icon')
                if (icon) {
                    icon.classList.remove('bg-indigo-50', 'text-indigo-600')
                    icon.classList.add('bg-pink-100', 'text-pink-500')
                }
                const title = btn.querySelector('.roadmap-month-title')
                if (title) title.classList.add('text-pink-600')
                const chevron = btn.querySelector('.roadmap-month-chevron')
                if (chevron) {
                    chevron.classList.remove('fa-chevron-right', 'text-gray-400')
                    chevron.classList.add('fa-chevron-down', 'text-pink-500')
                }
                const monthIdx = parseInt(btn.getAttribute('data-month')) - 1
                renderGameGrid(monthIdx, 0)
                highlightWeek(monthIdx, 0)
            }
        })

        document.addEventListener('click', function (e) {
            const weekRow = e.target.closest('.roadmap-week-row')
            if (weekRow) {
                const month = parseInt(weekRow.getAttribute('data-month'))
                const week = parseInt(weekRow.getAttribute('data-week'))
                const monthIdx = month - 1
                const weekIdx = week - 1
                renderGameGrid(monthIdx, weekIdx)
                highlightWeek(monthIdx, weekIdx)
            }
        })

        document.addEventListener('DOMContentLoaded', () => {
            renderAllGamesRandom(allGamesData)

            const loadMoreBtn = document.getElementById('load-more-games-btn')
            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', loadMoreGames)
            }

            // Copy template button
            const copyBtn = document.getElementById('copy-template-btn')
            const useTemplateBtn = document.getElementById('btn-use-template')
            const templateModal = document.getElementById('template-modal')
            const modalTargetInput = document.getElementById('modal-target-input')
            const modalActionSelect = document.getElementById('modal-action-select')
            const modalCopyBtn = document.getElementById('btn-modal-copy')
            const modalCloseBtn = document.getElementById('btn-modal-close')
            const modalClearBtn = document.getElementById('btn-modal-clear')
            const closeTemplateModal = () => templateModal?.classList.add('hidden')

            if (copyBtn) {
                copyBtn.addEventListener('click', async () => {
                    const text = `RULE:\n- Không rewrite src\n- Không sửa logic cũ\n- Chỉ tác động trong TARGET\n\nTARGET:\n(mô tả rõ)\n\nACTION:\n(chỉ chọn 1: add / fix / update / remove)`
                    try {
                        await navigator.clipboard.writeText(text)
                        if (window.showToast) window.showToast('Đã copy Prompt Template thành công!', 'success')
                    } catch {
                        if (window.showToast) window.showToast('Copy thất bại!', 'error')
                    }
                })
            }

            if (useTemplateBtn && templateModal) {
                useTemplateBtn.addEventListener('click', () => {
                    templateModal.classList.remove('hidden')
                    modalTargetInput?.focus()
                })
            }

            if (modalCopyBtn && modalTargetInput && modalActionSelect) {
                modalCopyBtn.addEventListener('click', async () => {
                    const text = `RULE:\n- Không rewrite src\n- Không sửa logic cũ\n- Chỉ tác động trong TARGET\n\nTARGET:\n${modalTargetInput.value}\n\nACTION:\n${modalActionSelect.value}`
                    try {
                        await navigator.clipboard.writeText(text)
                        if (window.showToast) window.showToast('Đã tạo và copy prompt thành công!', 'success')
                    } catch {
                        if (window.showToast) window.showToast('Copy thất bại!', 'error')
                    }
                })
            }

            if (modalCloseBtn) {
                modalCloseBtn.addEventListener('click', closeTemplateModal)
            }

            if (modalClearBtn && modalTargetInput && modalActionSelect) {
                modalClearBtn.addEventListener('click', () => {
                    modalTargetInput.value = ''
                    modalActionSelect.value = 'add'
                })
            }

            if (templateModal) {
                templateModal.addEventListener('click', (e) => {
                    if (e.target === templateModal) closeTemplateModal()
                })
            }
        })

        // Copy prompt for game cards (event delegation)
        function promptOf(game, genre, month, week) {
            return `=== CREATE GAME ===
Tên: ${game}
Style: Game 2D ${genre} hiện đại, màu sắc rõ, dễ đọc, playable trên web.
Đối tượng: Người mới học làm game với AI, cần hiểu cơ chế chính trong 3 phút đầu.
Gameplay: Thiết kế vòng chơi ngắn theo đúng chủ đề ${genre}; điều khiển đơn giản bằng bàn phím hoặc chạm; mỗi lượt chơi kéo dài 1-3 phút.
Luật: Có mục tiêu thắng rõ ràng, điều kiện thua rõ ràng, điểm số hoặc tiến trình, độ khó tăng nhẹ theo thời gian hoặc theo màn.
Hiển thị: Hiện nhân vật/vật thể chính, mục tiêu, điểm số, trạng thái thắng/thua và hướng dẫn ngắn ngay trong game.
UI: Giao diện gọn, có màn hình bắt đầu, nút chơi lại, thông tin điều khiển và phản hồi trực quan khi người chơi tương tác.
Hiệu ứng: Thêm hiệu ứng va chạm, thu thập, thắng/thua, chuyển màn và âm thanh phản hồi nhẹ nếu có thể.
Build: Xuất bản thành một bản HTML/CSS/JavaScript chạy trực tiếp trên trình duyệt, ưu tiên code gọn, dễ sửa và không dùng asset ngoài bắt buộc.

Thông tin bài học: Cấp độ ${month}, Tuần ${week}, thể loại ${genre}.`
        }

        document.addEventListener('click', async function (e) {
            const btn = e.target.closest('.btn-copy-prompt')
            if (!btn) return
            const card = btn.closest('.game-card-button')
            if (!card) return
            const game = card.dataset.game
            const genre = card.dataset.genre
            const month = parseInt(card.dataset.month)
            const week = parseInt(card.dataset.week)
            const promptContent = decodeURIComponent(card.dataset.promptContent || '')
            if (promptContent.trim() === 'Đang tải...') {
                if (window.showToast)
                    window.showToast('Nội dung prompt đang được cập nhật, vui lòng quay lại sau!', 'warning')
                return
            }
            const promptText = promptContent.trim() ? promptContent : promptOf(game, genre, month, week)
            try {
                await navigator.clipboard.writeText(promptText)
                if (window.showToast) window.showToast('Đã copy Game Prompt thành công!', 'success')
            } catch {
                if (window.showToast) window.showToast('Copy thất bại!', 'error')
            }
        })

        function showGamePromptModal(card) {
            const game = card.dataset.game
            const genre = card.dataset.genre
            const month = parseInt(card.dataset.month)
            const week = parseInt(card.dataset.week)
            const promptContent = decodeURIComponent(card.dataset.promptContent || '')

            const modal = document.getElementById('game-prompt-modal')
            const titleEl = document.getElementById('game-prompt-modal-title')
            const subtitleEl = document.getElementById('game-prompt-modal-subtitle')
            const contentEl = document.getElementById('game-prompt-modal-content')

            if (titleEl) titleEl.textContent = game
            if (subtitleEl) subtitleEl.textContent = 'Level ' + month + ' · Tuần ' + week + ' · ' + genre

            const promptText = promptContent.trim() ? promptContent : promptOf(game, genre, month, week)

            if (contentEl) contentEl.value = promptText
            if (modal) modal.classList.remove('hidden')
        }

        function closeGamePromptModal() {
            const modal = document.getElementById('game-prompt-modal')
            if (modal) modal.classList.add('hidden')
        }

        document.addEventListener('click', function (e) {
            const anyBtn = e.target.closest('button')
            if (anyBtn) return

            const card = e.target.closest('.game-card-button')
            if (!card) return

            showGamePromptModal(card)
        })

        document.addEventListener('click', function (e) {
            const closeBtn = e.target.closest('#game-prompt-modal-close')
            if (closeBtn) {
                closeGamePromptModal()
                return
            }

            const modal = document.getElementById('game-prompt-modal')
            if (modal && e.target === modal) {
                closeGamePromptModal()
            }
        })

        document.addEventListener('click', async function (e) {
            const copyBtn = e.target.closest('#game-prompt-modal-copy')
            if (!copyBtn) return

            const contentEl = document.getElementById('game-prompt-modal-content')
            if (!contentEl || !contentEl.value) {
                if (window.showToast) window.showToast('Chưa có prompt để copy!', 'warning')
                return
            }

            try {
                await navigator.clipboard.writeText(contentEl.value)
                if (window.showToast) window.showToast('Đã copy Game Prompt thành công!', 'success')
            } catch {
                if (window.showToast) window.showToast('Copy thất bại!', 'error')
            }
        })
    </script>
