        { genre: 'AI Pattern', games: ['Spiral Pattern Duel', 'Rotating Pattern Core', 'Complex Pattern Arena'] },
        { genre: 'Boss AI', games: ['Moving Boss Protocol', 'Phase Pattern Titan', 'Multi Phase Overlord'] },
        { genre: 'Simulation', games: ['Smart NPC Village', 'Enemy Squad Tactics', 'Dynamic World Engine'] },
