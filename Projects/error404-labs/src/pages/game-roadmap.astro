gameToGenre['Web3 Route Lab'] = 'Puzzle'
gameToGenre['AI Traffic Split'] = 'Arcade'
gameToGenre['Cyber Wall Ninja'] = 'Action'

const allGamesNames = Object.keys(promptContentByGame)
const allGamesData = allGamesNames.map((name) => ({
    name,
    genre: gameToGenre[name] || 'Arcade',
    promptContent: promptContentByGame[name] ?? '',
}))

const roadmap = months.map((month, monthIndex) => ({
    ...month,
    weeks: roadmapRows[monthIndex].map((week, weekIndex) => ({
        ...week,
        games: week.games.map((game) => ({
            name: game,
            promptContent: promptContentByGame[game] ?? '',
        })),
    })),
}))

