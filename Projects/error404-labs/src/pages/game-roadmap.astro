    ],
    [
        { genre: 'Runner', games: ['Hazard Dash Reactor', 'Wall Climb Rush', 'Downhill Drift Runner'] },
        { genre: 'Action', games: ['Blade Orbit Dodge', 'Wall Kick Ninja', 'Laser Burst Escape'] },
        { genre: 'Arcade', games: ['Meteor Drop Panic', 'Turbo Traffic Split', 'Bomb Rain Reflex'] },
        { genre: 'Puzzle', games: ['Path Finder Grid', 'Route Rotate Lab', 'Link Line Circuit'] },
    ],
    [
        { genre: 'Shooter', games: ['Slime Blaster Zero', 'Wave Defense Outpost', 'Base Guard Blitz'] },
        { genre: 'Arcade', games: ['Bubble Pop Cannon', 'Duck Shot Carnival', 'UFO Zap Patrol'] },
        { genre: 'Shooter', games: ['Arsenal Upgrade Run', 'Mini Boss Barrage', 'Squad Assist Strike'] },
        { genre: 'Action', games: ['Monster Slash Dash', 'Shuriken Storm', 'Boxing Beatdown'] },
    ],
    [
        { genre: 'Puzzle', games: ['Mosaic Mind Quest', 'Maze Core Escape', 'Switch Door Lab'] },
        { genre: 'Logic', games: ['Sort Stack Factory', 'Balance Beam Logic', 'Power Switch Grid'] },
        { genre: 'Puzzle', games: ['Sokoban Space Crates', 'Pin Pull Dungeon', 'Light Tower Circuit'] },
        { genre: 'Arcade', games: ['Hoop Shot Puzzle', 'Trick Toss Arena', 'Neon Pinball Mini'] },
    ],
    [
        { genre: 'Action', games: ['Street Combo Rookie', 'Combo Forge Arena', 'Dodge Counter Strike'] },
        { genre: 'Boss Fight', games: ['Slime King Duel', 'Robot Core Raid', 'Dragon Flame Trial'] },
        { genre: 'Action', games: ['Jump Strike Hero', 'Dash Blade Assault', 'Cyclone Slash'] },
        { genre: 'Arcade', games: ['Survival Ring', 'Battle Dome Rush', 'Trial Gate Runner'] },
    ],
    [
        { genre: 'Rhythm', games: ['Beat Tap Reactor', 'Dance Sync Hero', 'Bass Drop Strike'] },
        { genre: 'Music', games: ['Piano Rush Tiles', 'Note Catcher Pop', 'Mini Synth Jam'] },
        { genre: 'Rhythm', games: ['Beat Dodge Highway', 'Perfect Timing Dash', 'Combo Chain Groove'] },
        { genre: 'Arcade', games: ['Neon Dance Floor', 'Disco Orb Chase', 'Melody Sky Ride'] },
    ],
