const roadmap = months.map((month, monthIndex) => ({
    ...month,
    weeks: roadmapRows[monthIndex].map((week, weekIndex) => ({
        ...week,
        games: week.games.map((game) => ({
            name: game,
            prompt: promptOf(game, week.genre, month.no, weekIndex + 1),
        })),
    })),
}))
---

<MainLayout
    title={`Lộ trình 12 tháng học làm game với AI | ${TC_TITLE}`}
    description="Lộ trình 12 tháng học làm game với AI, mỗi tháng 4 tuần, mỗi tuần có prompt mẫu để thực hành."
    searchable={false}
>
    <section class="roadmap-page min-h-screen overflow-hidden text-white">
        <div class="mx-auto max-w-[1840px] px-4 py-6 sm:px-6 lg:px-8">
            <header class="roadmap-hero compact-hero relative overflow-hidden rounded-[28px] border border-white/15 shadow-2xl shadow-indigo-950/40">
                <div class="relative z-10 grid gap-6 px-5 py-7 sm:px-7 lg:grid-cols-[minmax(360px,0.9fr)_minmax(620px,1.35fr)] lg:items-center xl:px-9 xl:py-9">
                    <div>
                        <p class="text-xs font-black uppercase tracking-[0.32em] text-orange-200">Error404-Labs Game Roadmap</p>
                        <h1 class="hero-title mt-3 text-4xl font-black leading-[0.95] text-white sm:text-6xl xl:text-7xl">
                            Tư Duy <span>Sáng Tạo</span> Game
                        </h1>
                        <p class="mt-5 max-w-3xl text-base font-bold leading-7 text-slate-200">
                            Làm chủ quy trình thiết kế và tư duy sản phẩm, biến mọi ý tưởng thành bản game hoàn chỉnh thông qua sức mạnh của AI.
                        </p>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                        {
                            methods.map((item, methodIndex) => (
                                <div class="method-card rounded-2xl border border-white/15 bg-white/10 p-4 shadow-xl shadow-indigo-950/20 backdrop-blur-xl">
                                    <span
                                        class={`method-icon mb-3 grid h-11 w-11 place-items-center rounded-2xl text-sm font-black shadow-md ${item.tone}`}
                                        data-method={methodIndex + 1}
                                    >
                                        {item.icon}
                                    </span>
                                    <strong class="block text-sm font-black text-white">{item.title}</strong>
                                    <span class="mt-1 block text-xs font-bold leading-5 text-slate-300">{item.text}</span>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </header>

            <div class="mt-6 grid gap-5 xl:grid-cols-[minmax(0,4fr)_minmax(300px,1fr)]">
                <main
                    class="roadmap-scroll overflow-x-auto rounded-[28px] border border-white/10 bg-slate-950/45 p-3 shadow-2xl shadow-indigo-950/35 backdrop-blur-xl"
                    aria-label="Lộ trình game 12 tháng"
                >
                    <div class="roadmap-grid grid min-w-[1380px] grid-cols-[178px_repeat(4,minmax(290px,1fr))] gap-3">
                        <div
                            class="roadmap-corner sticky left-0 top-0 z-30 rounded-2xl border border-white/10 px-5 py-4 text-sm font-black uppercase tracking-[0.16em] text-white backdrop-blur-xl"
                        >
                            Tháng
                        </div>
                        {
                            weekLabels.map((label, weekLabelIndex) => (
                                <div
                                    class="roadmap-week-header sticky top-0 z-20 rounded-2xl border border-white/10 px-5 py-4 text-center text-sm font-black uppercase tracking-[0.16em] text-white backdrop-blur-xl"
                                    data-week={weekLabelIndex + 1}
                                >
                                    {label} - 3 lựa chọn
                                </div>
                            ))
                        }

                        {
                            roadmap.map((month) => (
                                <>
                                    <div
                                        class={`roadmap-month sticky left-0 z-10 min-h-[208px] rounded-2xl border border-white/10 p-4 shadow-[16px_0_30px_rgba(15,23,42,0.35)] backdrop-blur-xl ${month.accent}`}
                                    >
                                        <span class="month-badge grid h-14 w-14 place-items-center rounded-2xl text-xl font-black text-white shadow-lg">
                                            {month.no}
                                        </span>
                                        <strong class="mt-4 block text-base font-black uppercase leading-tight text-white">{month.title}</strong>
                                        <span class="mt-2 inline-flex rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-black uppercase text-slate-300">
                                            {month.sub}
                                        </span>
                                    </div>
                                    {month.weeks.map((week, weekIndex) => (
                                        <article
                                            class={`roadmap-week min-h-[208px] rounded-2xl border p-3 ${genreStyles[week.genre] || 'border-slate-200 bg-slate-50 text-slate-700'}`}
                                        >
                                            <h2 class="genre-pill mb-3 rounded-xl bg-white/10 px-3 py-2 text-center text-xs font-black uppercase tracking-[0.14em] shadow-sm backdrop-blur">
                                                {week.genre}
                                            </h2>
                                            <div class="grid gap-2">
                                                {week.games.map((game, gameIndex) => (
                                                    <GameCell
                                                        game={game.name}
                                                        genre={week.genre}
                                                        month={month.no}
                                                        week={weekIndex + 1}
                                                        index={gameIndex + 1}
                                                        prompt={game.prompt}
                                                    />
                                                ))}
                                            </div>
                                        </article>
                                    ))}
                                </>
                            ))
                        }
                    </div>
                </main>

                <aside class="roadmap-sidebar grid content-start gap-4 xl:sticky xl:top-5">
                    <section class="sidebar-card rounded-[24px] border border-white/15 bg-white/10 p-5 shadow-xl shadow-indigo-950/20 backdrop-blur-xl">
                        <h2 class="flex items-center gap-3 text-sm font-black uppercase tracking-[0.12em] text-emerald-200">
                            <span class="sidebar-icon bg-emerald-400 text-slate-950">C</span>
                            Cách hoạt động
                        </h2>
                        <ol class="mt-4 space-y-3 text-sm font-bold leading-6 text-slate-300">
                            <li>Chọn 1 trong 3 game gợi ý.</li>
                            <li>Đọc prompt mẫu và tạo game với AI tool.</li>
                            <li>Chơi thử, chỉnh sửa, thêm ý tưởng cá nhân.</li>
                            <li>Hoàn thành và chia sẻ sản phẩm.</li>
                        </ol>
                    </section>

                    <section class="sidebar-card rounded-[24px] border border-white/15 bg-white/10 p-5 shadow-xl shadow-indigo-950/20 backdrop-blur-xl">
                        <h2 class="flex items-center gap-3 text-sm font-black uppercase tracking-[0.12em] text-indigo-200">
                            <span class="sidebar-icon bg-indigo-400 text-white">AI</span>
                            Tool sử dụng
                        </h2>
                        <div class="mt-4 grid gap-3">
                            <p class="tool-row"><strong>Gemini</strong><span>Phác thảo kiến trúc ý tưởng đột phá</span></p>
                            <p class="tool-row"><strong>ChatGPT</strong><span>Giải mã thuật toán, tối ưu quy trình</span></p>
                            <p class="tool-row"><strong>Astrocade</strong><span>Dựng prototype 2D thần tốc, không cần code</span></p>
                            <p class="tool-row"><strong>AI Studio</strong><span>Thử nghiệm prompt và mô hình chuyên sâu</span></p>
                            <p class="tool-row"><strong>Deepseek</strong><span>Tối ưu hiệu năng và logic phức tạp</span></p>
                            <p class="tool-row"><strong>Qwen</strong><span>Hiểu ngữ cảnh, sáng tạo nội dung đa ngôn ngữ</span></p>
                        </div>
                    </section>

                    <section class="sidebar-card prompt-card rounded-[24px] border border-white/15 bg-white/10 p-5 shadow-xl shadow-indigo-950/20 backdrop-blur-xl">
                        <div class="prompt-protocol-head flex items-start justify-between gap-3">
                            <div>
                                <h2 class="flex items-center gap-3 text-sm font-black uppercase tracking-[0.12em] text-orange-200">
                                    <span class="sidebar-icon bg-orange-400 text-slate-950">M</span>
                                    Mẹo Prompt cho Game
                                </h2>
                                <span class="protocol-code mt-2 inline-flex">PROTOCOL / AI-GAME-03</span>
                            </div>
                            <button class="prompt-copy-all-btn" type="button" aria-label="Copy prompt template">Copy All</button>
                        </div>
                        <p class="mt-2 text-xs font-bold uppercase tracking-[0.12em] text-orange-100/80">
                            Giữ game ổn định – không bị hỏng logic
                        </p>
                        <div class="prompt-protocol-flow mt-4 grid gap-3 text-sm font-bold leading-6 text-slate-200">
                            <div class="prompt-tip prompt-tip-rule">
                                <span class="prompt-tip-node">01</span>
                                <span class="prompt-tip-badge">RULE</span>
                                <p>- Không rewrite game</p>
                                <p>- Không sửa logic cũ</p>
                                <p>- Chỉ tác động trong TARGET.</p>
                            </div>
                            <div class="prompt-tip prompt-tip-target">
                                <span class="prompt-tip-node">02</span>
                                <span class="prompt-tip-badge">TARGET</span>
                                <p>(mô tả rõ chỗ cần sửa)</p>
                            </div>
                            <div class="prompt-tip prompt-tip-action">
                                <span class="prompt-tip-node">03</span>
                                <span class="prompt-tip-badge">ACTION</span>
                                <p>(chỉ chọn 1: add / fix / update / remove)</p>
                            </div>
                        </div>
                    </section>

                    <section class="sidebar-card rounded-[24px] border border-white/15 bg-white/10 p-5 shadow-xl shadow-indigo-950/20 backdrop-blur-xl">
                        <h2 class="flex items-center gap-3 text-sm font-black uppercase tracking-[0.12em] text-rose-200">
                            <span class="sidebar-icon bg-rose-400 text-white">L</span>
                            Lợi ích khóa học
                        </h2>
                        <ul class="mt-4 space-y-3 text-sm font-bold leading-6 text-slate-300">
                            <li>Phát triển tư duy logic và sáng tạo.</li>
                            <li>Rèn kỹ năng giải quyết vấn đề.</li>
                            <li>Tự tin tạo sản phẩm cá nhân.</li>
                            <li>Chuẩn bị nền tảng cho tương lai AI.</li>
                        </ul>
                    </section>
                </aside>
            </div>
        </div>
    </section>
    <PromptModal />
    <script>
        const initPromptTipCopy = () => {
            const promptTemplate = `RULE:
- Không rewrite game
- Không sửa logic cũ
- Chỉ tác động trong TARGET

TARGET:
(mô tả rõ chỗ cần sửa)

ACTION:
(chỉ chọn 1: add / fix / update / remove)`

            document.querySelectorAll<HTMLButtonElement>('.prompt-copy-all-btn').forEach((button) => {
                if (button.dataset.copyReady === 'true') return

                button.dataset.copyReady = 'true'
                button.addEventListener('click', async () => {
                    try {
                        await navigator.clipboard.writeText(promptTemplate)
                    } catch {
                        const textarea = document.createElement('textarea')
                        textarea.value = promptTemplate
                        textarea.setAttribute('readonly', '')
                        textarea.style.position = 'fixed'
                        textarea.style.opacity = '0'
                        document.body.appendChild(textarea)
                        textarea.select()
                        document.execCommand('copy')
                        textarea.remove()
                    }

                    button.textContent = 'Copied!'
                    button.classList.add('is-copied')
                    window.setTimeout(() => {
                        button.textContent = 'Copy'
                        button.classList.remove('is-copied')
                    }, 1200)
                })
            })
        }

        initPromptTipCopy()
        document.addEventListener('astro:page-load', initPromptTipCopy)
    </script>
</MainLayout>

<style>
    .roadmap-page {
        background:
            radial-gradient(circle at 12% 5%, rgba(249, 115, 22, 0.38), transparent 28%),
            radial-gradient(circle at 88% 4%, rgba(99, 102, 241, 0.44), transparent 30%),
            radial-gradient(circle at 50% 52%, rgba(14, 165, 233, 0.2), transparent 34%),
            linear-gradient(135deg, #020617 0%, #111827 44%, #312e81 100%);
        position: relative;
    }

    .roadmap-page::before {
