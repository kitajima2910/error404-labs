---
import { TC_TITLE } from '../common/TextConst'
import Link from '../components/Link.astro'
import IconHome from '../icons/IconHome.astro'
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout title=`404 | ${TC_TITLE}`>
    <section class="grid place-items-center text-center gap-3">
        <h1 class="text-3xl">🐣 Oops~ Trang này đang đi lạc mất rồi!</h1>
        <p>Đừng lo, mình cùng quay về trang chủ nha 💛</p>
        <Link
            href="/"
            text="Trang chủ"
            style="primary"
            isFilled={!true}
            borderVisible
            icon={{
                component: IconHome,
                side: 'left',
            }}
        />
    </section>
</MainLayout>
