---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'
---

<MainLayout title={`Ủng hộ | ${TC_TITLE}`}>
    <section class="h-[calc(100vh-168px)] flex flex-col justify-center items-center px-2 pt-0">
        <iframe
            src="/thu-nghiem/web/Donate/index.html"
            frameborder="0"
            width="100%"
            height="100%"
            allow="payment"
            allowfullscreen
            title="donate"></iframe>
    </section>
</MainLayout>
