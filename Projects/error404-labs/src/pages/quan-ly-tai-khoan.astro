---
import '../styles/global.css'
import '@fontsource/montserrat'

export const prerender = false
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý tài khoản | Error404-Labs</title>
    <meta name="description" content="Trang quản trị tài khoản dành cho Admin">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <style>
        .view-section { transition: all 0.3s ease; }
        .nav-item.active { background-color: #f0f4ff; color: #4338ca; font-weight: 600; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans" style="font-family: 'Montserrat', sans-serif;">
    <!-- Page Skeleton -->
    <div id="page-skeleton" class="flex animate-pulse">
        <!-- Sidebar Skeleton -->
        <div class="w-80 bg-white border-r border-slate-200 p-6 space-y-6">
            <div class="h-8 w-40 bg-slate-200 rounded"></div>
            <div class="space-y-3">
                {[1,2,3,4,5,6].map(() => <div class="h-10 bg-slate-200 rounded-xl"></div>)}
            </div>
            <div class="mt-auto space-y-3">
                <div class="h-12 bg-slate-200 rounded-xl"></div>
                <div class="h-10 bg-slate-200 rounded-xl"></div>
            </div>
        </div>
        <!-- Main Skeleton -->
        <div class="flex-1">
            <div class="bg-white border-b border-slate-200 p-6">
                <div class="flex justify-between items-center">
                    <div class="h-6 w-64 bg-slate-200 rounded"></div>
                    <div class="h-8 w-8 bg-slate-200 rounded-full"></div>
                </div>
            </div>
            <div class="p-6 space-y-6">
                <div class="flex justify-between items-center">
                    <div class="h-8 w-64 bg-slate-200 rounded"></div>
                    <div class="h-10 w-32 bg-slate-200 rounded-xl"></div>
                </div>
                <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
                    <div class="h-16 bg-slate-50 border-b border-slate-100"></div>
                    <div class="p-6 space-y-4">
                        {[1, 2, 3, 4, 5].map(() => (
                            <div class="flex gap-4">
                                <div class="h-12 flex-1 bg-slate-50 rounded-xl"></div>
                                <div class="h-12 flex-[2] bg-slate-50 rounded-xl"></div>
                                <div class="h-12 flex-1 bg-slate-50 rounded-xl"></div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Auth Guard -->
    <div id="auth-guard" class="hidden flex min-h-screen">
        <!-- Sidebar -->
        <aside class="w-80 bg-white border-r border-slate-200 p-6 flex flex-col min-h-screen fixed">
            <div class="flex items-center gap-3 mb-8">
                <img src="/avatar_v2.avif" alt="Logo" class="w-10 h-10 rounded-full" />
                <span class="font-bold text-slate-800 text-lg">Error404-Labs</span>
            </div>
            <nav class="space-y-2 flex-1">
                <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                    Trang chủ
                </a>
                <a href="#" id="navAccounts" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl bg-indigo-50 text-indigo-700 font-medium transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                    </svg>
                    Quản lý tài khoản
                </a>
                <a href="#" id="navLessons" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    Quản lý bài học
                </a>
            </nav>

            <!-- User Card -->
            <div class="mt-auto pt-6 border-t border-slate-200 space-y-3">
                <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50">
                    <div class="w-10 h-10 bg-indigo-600 rounded-full flex items-center justify-center">
                        <span class="text-white font-bold text-sm" id="sidebarUserAvatar">A</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="font-medium text-slate-900 truncate" id="sidebarUserName">Admin</p>
                        <p class="text-sm text-slate-500" id="sidebarUserRole">Admin</p>
                    </div>
                </div>
                <button id="logoutBtn" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-red-600 hover:bg-red-50 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span class="text-sm font-bold">Đăng xuất</span>
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 ml-80">
            <!-- Header -->
            <header class="bg-white border-b border-slate-200 px-6 py-4">
                <div class="flex items-center">
                    <div>
                        <h1 class="text-xl font-bold text-slate-900">
                            Xin chào, <span id="adminGreetingName" class="text-indigo-600">Admin</span>! 👋
                        </h1>
                        <p class="text-sm text-slate-500 mt-1">Chúc bạn một ngày làm việc hiệu quả</p>
                    </div>
                </div>
            </header>

            <!-- Content -->
            <div class="p-6">
                <div class="max-w-7xl mx-auto">
                    <!-- Accounts View -->
                    <div id="accountsView" class="view-section">
                        <!-- Section Header -->
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h2 class="text-2xl font-bold text-slate-900">Danh sách tài khoản</h2>
                                <p class="text-slate-500 mt-1">Quản lý tất cả tài khoản thành viên trong hệ thống</p>
                            </div>
                            <button
                                id="addMemberBtn"
                                class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl font-semibold transition-all shadow-lg shadow-indigo-200 flex items-center gap-2 cursor-pointer"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
                                </svg>
                                Thêm tài khoản
                            </button>
                        </div>

                        <!-- Filters & Search -->
                        <div class="flex flex-wrap gap-4 mb-6">
                            <div class="relative flex-1 min-w-64">
                                <input
                                    type="text"
                                    id="memberSearch"
                                    placeholder="Tìm kiếm tài khoản..."
                                    class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm bg-white"
                                />
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </div>
                            <select id="roleFilter" class="px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm bg-white min-w-40">
                                <option value="">Tất cả vai trò</option>
                                <option value="admin">Admin</option>
                                <option value="member">Member</option>
                            </select>
                            <select id="statusFilter" class="px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm bg-white min-w-40">
                                <option value="">Tất cả trạng thái</option>
                                <option value="active">Đang hoạt động</option>
                                <option value="inactive">Không hoạt động</option>
                            </select>
                        </div>

                        <!-- Table -->
                        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-slate-50 border-b border-slate-200">
                                            <th class="sortable px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider cursor-pointer hover:bg-slate-100 transition-colors group" data-sort="id">
                                                STT <span class="sort-icon ml-1 opacity-20 group-hover:opacity-100">⇅</span>
                                            </th>
                                            <th class="sortable px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider cursor-pointer hover:bg-slate-100 transition-colors group" data-sort="member">
                                                Tài khoản <span class="sort-icon ml-1 opacity-20 group-hover:opacity-100">⇅</span>
                                            </th>
                                            <th class="sortable px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider cursor-pointer hover:bg-slate-100 transition-colors group" data-sort="display_name">
                                                Tên hiển thị <span class="sort-icon ml-1 opacity-20 group-hover:opacity-100">⇅</span>
                                            </th>
                                            <th class="sortable px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider cursor-pointer hover:bg-slate-100 transition-colors group text-center" data-sort="roles">
                                                Vai trò <span class="sort-icon ml-1 opacity-20 group-hover:opacity-100">⇅</span>
                                            </th>
                                            <th class="sortable px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider cursor-pointer hover:bg-slate-100 transition-colors group text-center" data-sort="created_at">
                                                Ngày tham gia <span class="sort-icon ml-1 opacity-20 group-hover:opacity-100">⇅</span>
                                            </th>
                                            <th class="px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider text-center">Trạng thái</th>
                                            <th class="px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider text-center">Quyền truy cập</th>
                                            <th class="px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider text-right">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody id="memberTableBody" class="divide-y divide-slate-100">
                                        <tr>
                                            <td colspan="8" class="px-6 py-12 text-center text-slate-400">Đang tải dữ liệu...</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Phân trang -->
                            <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-200 flex items-center justify-between flex-wrap gap-4">
                                <p class="text-sm text-slate-600">
                                    Hiển thị <span id="showingStart" class="font-semibold text-slate-900">0</span> - <span id="showingEnd" class="font-semibold text-slate-900">0</span> trong <span id="totalMembers" class="font-semibold text-slate-900">0</span> tài khoản
                                </p>
                                <div class="flex items-center gap-2">
                                    <button id="prevPage" class="p-2 rounded-xl border border-slate-200 text-slate-600 hover:bg-white hover:shadow-sm transition-all disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                                    </button>
                                    <div id="pageNumbers" class="flex items-center gap-1"></div>
                                    <button id="nextPage" class="p-2 rounded-xl border border-slate-200 text-slate-600 hover:bg-white hover:shadow-sm transition-all disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Lessons View -->
                    <div id="lessonsView" class="view-section hidden">
                        <!-- Section Header -->
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h2 class="text-2xl font-bold text-slate-900">Danh sách bài học</h2>
                                <p class="text-slate-500 mt-1">Quản lý các bài học và tài liệu hỗ trợ học viên</p>
                            </div>
                            <button
                                id="addLessonBtn"
                                class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl font-semibold transition-all shadow-lg shadow-indigo-200 flex items-center gap-2 cursor-pointer"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
                                </svg>
                                Thêm bài học
                            </button>
                        </div>

                        <!-- Search -->
                        <div class="flex flex-wrap gap-4 mb-6">
                            <div class="relative flex-1 min-w-64">
                                <input
                                    type="text"
                                    id="lessonSearch"
                                    placeholder="Tìm kiếm bài học..."
                                    class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm bg-white"
                                />
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </div>
                        </div>

                        <!-- Table -->
                        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-slate-50 border-b border-slate-200">
                                            <th class="px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider">Tiêu đề bài học</th>
                                            <th class="px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider">Mô tả ngắn</th>
                                            <th class="px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider text-center">Liên kết</th>
                                            <th class="px-6 py-4 text-xs font-bold text-slate-600 uppercase tracking-wider text-right">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody id="lessonTableBody" class="divide-y divide-slate-100">
                                        <tr>
                                            <td colspan="4" class="px-6 py-12 text-center text-slate-400">Đang tải dữ liệu bài học...</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Form -->
    <div
        id="memberModal"
        class="fixed inset-0 z-[150] hidden items-center justify-center bg-black/50 p-4 transition-opacity"
    >
        <div
            class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all scale-95 opacity-0"
            id="memberModalContent"
        >
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <h3 id="modalTitle" class="text-xl font-bold text-slate-800">Thêm tài khoản mới</h3>
                <button
                    type="button"
                    class="closeModalBtn text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
                        ></path>
                    </svg>
                </button>
            </div>
            <form id="memberForm" class="p-6 space-y-4">
                <input type="hidden" id="memberId" name="id" />
                <div id="usernameWrapper">
                    <label for="mUsername" class="block text-sm font-bold text-slate-700 mb-1.5">Tên tài khoản</label>
                    <input
                        type="text"
                        id="mUsername"
                        name="username"
                        required
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300"
                        placeholder="Nhập tên đăng nhập"
                    />
                </div>
                <div>
                    <label for="mDisplayName" class="block text-sm font-bold text-slate-700 mb-1.5">Tên hiển thị</label>
                    <input
                        type="text"
                        id="mDisplayName"
                        name="display_name"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300"
                        placeholder="Tên thường gọi"
                    />
                </div>
                <div id="passwordWrapper">
                    <label for="mPassword" class="block text-sm font-bold text-slate-700 mb-1.5"
                        >Mật khẩu (Mã truy cập)</label
                    >
                    <input
                        type="password"
                        id="mPassword"
                        name="password"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300"
                        placeholder="Để trống nếu không đổi"
                    />
                    <p id="passwordHint" class="text-[10px] text-slate-400 mt-1 italic hidden">
                        * Bắt buộc cho tài khoản mới
                    </p>
                </div>
                <div id="roleWrapper">
                    <label for="mRole" class="block text-sm font-bold text-slate-700 mb-1.5">Vai trò</label>
                    <select
                        id="mRole"
                        name="roles"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all appearance-none bg-no-repeat bg-[right_1rem_center] cursor-pointer"
                        style="background-image: url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 fill=%27none%27 viewBox=%270 0 20 20%27%3E%3Cpath stroke=%27%236B7280%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%271.5%27 d=%27M6 8l4 4 4-4%27/%3E%3C/svg%3E');"
                    >
                        <option value="member">Thành viên (Member)</option>
                        <option value="admin">Quản trị viên (Admin)</option>
                    </select>
                </div>
                <div class="flex gap-3 mt-8">
                    <button
                        type="button"
                        class="closeModalBtn flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 transition-all cursor-pointer"
                        >Hủy</button
                    >
                    <button
                        type="submit"
                        id="submitBtn"
                        class="flex-[2] px-4 py-2.5 rounded-xl bg-indigo-600 text-white font-bold hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100 cursor-pointer"
                        >Lưu thông tin</button
                    >
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Quản lý Prompt Access -->
    <div id="promptAccessModal" class="fixed inset-0 z-[160] hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 transition-all duration-300">
        <div id="promptAccessModalContent" class="bg-white rounded-3xl shadow-2xl w-full max-w-4xl max-h-[85vh] overflow-hidden transform scale-95 opacity-0 transition-all duration-300 border border-slate-100 flex flex-col">
            <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-emerald-50 to-white shrink-0">
                <div>
                    <h3 class="text-xl font-black text-slate-800 uppercase tracking-tight flex items-center gap-2">
                        <span class="text-emerald-600">🔗</span> Quản lý Prompt Access
                    </h3>
                    <p class="text-sm text-slate-500 mt-1">
                        Member: <span id="promptAccessMemberName" class="font-bold text-emerald-600"></span>
                    </p>
                </div>
                <button type="button" id="closePromptAccessModal" class="text-slate-400 hover:text-slate-600 p-2 rounded-xl hover:bg-slate-100 transition-colors cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="flex-1 overflow-hidden flex flex-col">
                <div class="px-6 py-4 bg-slate-50/50 border-b border-slate-100 flex items-center justify-between gap-4 shrink-0">
                    <div class="flex items-center gap-3">
                        <button id="selectAllPrompts" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-blue-50 text-blue-600 border border-blue-100 hover:bg-blue-100 transition-all cursor-pointer">
                            Chọn tất cả
                        </button>
                        <button id="deselectAllPrompts" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition-all cursor-pointer">
                            Bỏ chọn tất cả
                        </button>
                    </div>
                    <div class="flex items-center gap-3">
                        <input type="text" id="promptAccessSearch" placeholder="Tìm kiếm prompt..." class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" />
                        <button id="savePromptAccess" class="text-xs font-bold px-4 py-1.5 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition-all shadow-lg shadow-emerald-100 cursor-pointer flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Lưu thay đổi
                        </button>
                    </div>
                </div>
                <div class="px-6 py-2 bg-slate-50/50 border-b border-slate-100 flex gap-2 shrink-0">
                    <button id="tabTools" class="tab-button active px-4 py-2 rounded-lg text-sm font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all">Trình tạo Game</button>
                    <button id="tabRoadmap" class="tab-button px-4 py-2 rounded-lg text-sm font-bold bg-slate-100 border border-slate-200 text-slate-500 hover:bg-slate-50 transition-all">Lộ trình 12 Tháng</button>
                </div>
                <div id="promptAccessList" class="flex-1 overflow-y-auto p-4 space-y-2 custom-scrollbar">
                    <!-- Prompt list will be rendered here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Xác nhận thay đổi trạng thái -->
    <div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm transition-all duration-300">
        <div id="deleteModalContent" class="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden transform scale-95 opacity-0 transition-all duration-300 border border-blue-50">
            <div class="bg-blue-50 p-6 flex flex-col items-center">
                <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <h3 class="text-xl font-black text-blue-600 uppercase tracking-tight">Thay đổi trạng thái tài khoản?</h3>
                <p class="text-slate-500 mt-2 text-center text-sm leading-relaxed">
                    Hành động này sẽ <span class="font-bold text-blue-600 italic">khóa/mở khóa</span> tài khoản. Người dùng có thể đăng nhập lại nếu được mở khóa.
                </p>
            </div>
            <div class="p-6 flex flex-col gap-3">
                <button id="confirmDeleteBtn" class="w-full py-3.5 bg-blue-600 text-white font-black rounded-2xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-200 active:scale-95 cursor-pointer">
                    Xác nhận thay đổi
                </button>
                <button id="cancelDeleteBtn" class="w-full py-3.5 bg-slate-100 text-slate-600 font-bold rounded-2xl hover:bg-slate-200 transition-all cursor-pointer">
                    Hủy bỏ
                </button>
            </div>
        </div>
    </div>

    <!-- Modal Quản lý Bài học -->
    <div id="lessonModal" class="fixed inset-0 z-[150] hidden items-center justify-center bg-black/50 p-4 transition-opacity">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden transform transition-all scale-95 opacity-0" id="lessonModalContent">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <h3 id="lessonModalTitle" class="text-xl font-bold text-slate-800">Thêm bài học mới</h3>
                <button type="button" class="closeLessonModalBtn text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <form id="lessonForm" class="p-6 space-y-4">
                <input type="hidden" id="lessonId" name="id" />
                <div>
                    <label for="lTitle" class="block text-sm font-bold text-slate-700 mb-1.5">Tiêu đề bài học</label>
                    <input type="text" id="lTitle" name="title" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" placeholder="VD: Bài 1: Làm quen với AI" />
                </div>
                <div>
                    <label for="lUrl" class="block text-sm font-bold text-slate-700 mb-1.5">Liên kết (URL)</label>
                    <input type="url" id="lUrl" name="url" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" placeholder="https://..." />
                </div>
                <div>
                    <label for="lDescription" class="block text-sm font-bold text-slate-700 mb-1.5">Mô tả ngắn</label>
                    <textarea id="lDescription" name="description" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" placeholder="Mô tả nội dung bài học..."></textarea>
                </div>
                <div class="flex gap-3 mt-8">
                    <button type="button" class="closeLessonModalBtn flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 transition-all cursor-pointer">Hủy</button>
                    <button type="submit" id="lessonSubmitBtn" class="flex-[2] px-4 py-2.5 rounded-xl bg-indigo-600 text-white font-bold hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100 cursor-pointer">Lưu bài học</button>
                </div>
            </form>
        </div>
    </div>

    <script is:inline>
        // Proactive Client-side Guard
        (async function() {
            const token = localStorage.getItem('auth_token');
            const guard = document.getElementById('auth-guard');
            
            if (!token) {
                window.location.href = '/?auth=required';
                return;
            }

            try {
                const res = await fetch('/api/verify', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();

                if (!res.ok || !data.authenticated || data.user?.roles !== 'admin') {
                    if (data.error === 'Session invalid or expired') {
                        localStorage.removeItem('auth_token');
                        localStorage.removeItem('user_session');
                        localStorage.removeItem('user_roles');
                    }
                    window.location.href = '/?auth=required';
                    return;
                }

                // Show content if verified
                guard.classList.remove('hidden');
                document.getElementById('page-skeleton')?.classList.add('hidden');

                // Initialize User Info
                const adminGreetingName = document.getElementById('adminGreetingName');
                const sidebarUserName = document.getElementById('sidebarUserName');
                const sidebarUserRole = document.getElementById('sidebarUserRole');
                const sidebarUserAvatar = document.getElementById('sidebarUserAvatar');

                const displayName = data.user?.display_name || data.user?.member || 'Admin';
                const role = data.user?.roles === 'admin' ? 'Admin' : 'Member';
                const avatar = displayName.charAt(0).toUpperCase();

                if (adminGreetingName) adminGreetingName.textContent = displayName;
                if (sidebarUserName) sidebarUserName.textContent = displayName;
                if (sidebarUserRole) sidebarUserRole.textContent = role;
                if (sidebarUserAvatar) sidebarUserAvatar.textContent = avatar;
                
                // Initial load
                fetchMembers();
            } catch (err) {
                console.error('Guard Error:', err);
                window.location.href = '/?error=connection';
            }
        })();

        // Elements & State
        const tableBody = document.getElementById('memberTableBody')
        const modal = document.getElementById('memberModal')
        const modalContent = document.getElementById('memberModalContent')
        const memberForm = document.getElementById('memberForm')
        const modalTitle = document.getElementById('modalTitle')
        const passwordHint = document.getElementById('passwordHint')
        const addMemberBtn = document.getElementById('addMemberBtn')
        const closeModalBtns = document.querySelectorAll('.closeModalBtn')

        const deleteModal = document.getElementById('deleteModal')
        const deleteModalContent = document.getElementById('deleteModalContent')
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn')
        const cancelDeleteBtn = document.getElementById('cancelDeleteBtn')
        let memberToToggle = null

        const memberSearch = document.getElementById('memberSearch')
        const roleFilterSelect = document.getElementById('roleFilter')
        const statusFilterSelect = document.getElementById('statusFilter')
        const showingStart = document.getElementById('showingStart')
        const showingEnd = document.getElementById('showingEnd')
        const totalMembers = document.getElementById('totalMembers')
        const prevPageBtn = document.getElementById('prevPage')
        const nextPageBtn = document.getElementById('nextPage')
        const pageNumbers = document.getElementById('pageNumbers')
        const sortHeaders = document.querySelectorAll('.sortable')

        // State variables
        let members = []
        let currentUser = localStorage.getItem('user_session') || ''
        let total = 0
        let currentPage = 1
        const limit = 5
        let search = ''
        let roleFilter = ''
        let statusFilter = ''
        let sortBy = 'id'
        let sortOrder = 'ASC'

        // View Switching
        const navAccounts = document.getElementById('navAccounts');
        const navLessons = document.getElementById('navLessons');
        const accountsView = document.getElementById('accountsView');
        const lessonsView = document.getElementById('lessonsView');

        // Lesson Management Elements
        const lessonTableBody = document.getElementById('lessonTableBody');
        const lessonModal = document.getElementById('lessonModal');
        const lessonModalContent = document.getElementById('lessonModalContent');
        const lessonForm = document.getElementById('lessonForm');
        const lessonModalTitle = document.getElementById('lessonModalTitle');
        const addLessonBtn = document.getElementById('addLessonBtn');
        const closeLessonModalBtns = document.querySelectorAll('.closeLessonModalBtn');
        const lessonSearchInput = document.getElementById('lessonSearch');

        let lessons = [];
        let lessonSearchQuery = '';

        function switchView(viewName) {
            if (viewName === 'accounts') {
                accountsView.classList.remove('hidden');
                lessonsView.classList.add('hidden');
                navAccounts.classList.add('bg-indigo-50', 'text-indigo-700', 'font-medium');
                navAccounts.classList.remove('text-slate-600');
                navLessons.classList.remove('bg-indigo-50', 'text-indigo-700', 'font-medium');
                navLessons.classList.add('text-slate-600');
                fetchMembers();
            } else {
                accountsView.classList.add('hidden');
                lessonsView.classList.remove('hidden');
                navLessons.classList.add('bg-indigo-50', 'text-indigo-700', 'font-medium');
                navLessons.classList.remove('text-slate-600');
                navAccounts.classList.remove('bg-indigo-50', 'text-indigo-700', 'font-medium');
                navAccounts.classList.add('text-slate-600');
                fetchLessons();
            }
        }

        navAccounts.addEventListener('click', (e) => {
            e.preventDefault();
            switchView('accounts');
        });

        navLessons.addEventListener('click', (e) => {
            e.preventDefault();
            switchView('lessons');
        });

        async function fetchMembers() {
            const offset = (currentPage - 1) * limit
            try {
                const url = `/api/admin/members?search=${encodeURIComponent(search)}&role=${roleFilter}&status=${statusFilter}&sortBy=${sortBy}&sortOrder=${sortOrder}&limit=${limit}&offset=${offset}`
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` }
                })
                if (!res.ok) throw new Error('Không có quyền hoặc lỗi DB')
                const data = await res.json()
                members = data.members
                total = data.total
                renderMembers()
                renderPagination()
            } catch (err) {
                tableBody.innerHTML = `<tr><td colspan="8" class="px-6 py-12 text-center text-red-500">${err.message}</td></tr>`
            }
        }

        function renderMembers() {
            tableBody.innerHTML = ''
            if (members.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="8" class="px-6 py-12 text-center text-slate-400 italic">Không tìm thấy tài khoản nào phù hợp yêu cầu.</td></tr>'
                return
            }

            members.forEach((m) => {
                const tr = document.createElement('tr')
                tr.className = "hover:bg-slate-50 transition-colors"
                
                const isSuper = currentUser === 'pxh2910'
                const isSelf = m.member === currentUser
                const targetIsAdmin = m.roles === 'admin'
                const targetIsSuper = m.member === 'pxh2910'

                const canEdit = isSuper || !targetIsAdmin || isSelf
                const canDelete = !isSelf && !targetIsSuper && (isSuper || !targetIsAdmin)

                tr.innerHTML = `
                    <td class="px-6 py-5 text-sm font-medium text-slate-600">#${m.id}</td>
                    <td class="px-6 py-5 text-sm font-semibold text-slate-900">${m.member}</td>
                    <td class="px-6 py-5 text-sm text-slate-700">${m.display_name || '-'}</td>
                    <td class="px-6 py-5 text-center">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${targetIsAdmin ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-blue-50 text-blue-700 border border-blue-200'}">
                            ${targetIsAdmin ? (targetIsSuper ? 'Super Admin' : 'Admin') : 'Member'}
                        </span>
                    </td>
                    <td class="px-6 py-5 text-sm text-slate-600 text-center">
                        ${m.created_at ? `<div class="flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg><span>${new Date(m.created_at).toLocaleDateString('vi-VN')}</span></div>` : '-'}
                    </td>
                    <td class="px-6 py-5 text-center">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${m.status !== 'inactive' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-red-50 text-red-700 border border-red-200'}">
                            ${m.status !== 'inactive' ? 'Đang hoạt động' : 'Không hoạt động'}
                        </span>
                    </td>
                    <td class="px-6 py-5 text-center">
                        <button onclick="window.openPromptAccessModal(${m.id}, '${m.member}', '${m.display_name || m.member}', ${JSON.stringify(m.prompt_access || [])})" class="text-xs font-semibold px-3 py-1.5 rounded-xl border transition-all cursor-pointer ${targetIsAdmin ? 'bg-amber-50 text-amber-700 border-amber-200 cursor-not-allowed' : 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100'}" ${targetIsAdmin ? 'disabled' : ''}>
                            ${targetIsAdmin ? 'Full Quyền' : (m.prompt_access?.length > 0 ? `${m.prompt_access.length} prompts` : '0 prompts')}
                        </button>
                    </td>
                    <td class="px-6 py-5 text-right">
                        <div class="flex items-center justify-end gap-2">
                            ${canEdit ? `<button onclick="window.editMember(${m.id})" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-xl transition-all cursor-pointer" title="Chỉnh sửa"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" /></svg></button>` : ''}
                            ${canDelete ? `<button onclick="window.toggleMemberStatus(${m.id})" class="p-2 rounded-xl transition-all cursor-pointer ${m.status === 'active' ? 'text-red-600 hover:bg-red-50' : 'text-green-600 hover:bg-green-50'}" title="${m.status === 'active' ? 'Khóa tài khoản' : 'Mở khóa tài khoản'}">${m.status === 'active' ? '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>' : '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" /></svg>'}</button>` : ''}
                        </div>
                    </td>
                `
                tableBody.appendChild(tr)
            })
        }

        function renderPagination() {
            const totalPages = Math.ceil(total / limit)
            showingStart.textContent = total === 0 ? 0 : (currentPage - 1) * limit + 1
            showingEnd.textContent = Math.min(currentPage * limit, total)
            totalMembers.textContent = total

            prevPageBtn.disabled = currentPage === 1
            nextPageBtn.disabled = currentPage === totalPages || totalPages === 0

            pageNumbers.innerHTML = ''
            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button')
                btn.textContent = i
                btn.className = `w-8 h-8 rounded-lg text-sm font-bold transition-all cursor-pointer ${currentPage === i ? 'bg-indigo-600 text-white shadow-md shadow-indigo-100' : 'text-slate-500 hover:bg-white hover:shadow-sm'}`
                btn.onclick = () => { currentPage = i; fetchMembers(); }
                pageNumbers.appendChild(btn)
            }
        }

        // Lesson CRUD Logic
        async function fetchLessons() {
            try {
                const res = await fetch(`/api/admin/lessons?search=${encodeURIComponent(lessonSearchQuery)}`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` }
                });
                if (!res.ok) throw new Error('Lỗi khi tải danh sách bài học');
                const data = await res.json();
                lessons = data.lessons;
                renderLessons();
            } catch (err) {
                lessonTableBody.innerHTML = `<tr><td colspan="4" class="px-6 py-12 text-center text-red-500">${err.message}</td></tr>`;
            }
        }

        function renderLessons() {
            lessonTableBody.innerHTML = '';
            if (lessons.length === 0) {
                lessonTableBody.innerHTML = '<tr><td colspan="4" class="px-6 py-12 text-center text-slate-400 italic">Không tìm thấy bài học nào.</td></tr>';
                return;
            }

            lessons.forEach(lesson => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition-colors";
                tr.innerHTML = `
                    <td class="px-6 py-4 text-sm font-semibold text-slate-900">${lesson.title}</td>
                    <td class="px-6 py-4 text-sm text-slate-600 max-w-xs truncate">${lesson.description || '-'}</td>
                    <td class="px-6 py-4 text-center">
                        <a href="${lesson.url}" target="_blank" class="text-indigo-600 hover:text-indigo-800 font-medium flex items-center justify-center gap-1">
                            Xem bài học
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                        </a>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                            <button onclick="window.editLesson(${lesson.id})" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-xl transition-all cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                </svg>
                            </button>
                            <button onclick="window.deleteLesson(${lesson.id})" class="p-2 text-red-600 hover:bg-red-50 rounded-xl transition-all cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </td>
                `;
                lessonTableBody.appendChild(tr);
            });
        }

        // Search & Filters Listeners
        let searchTimeout;
        memberSearch.oninput = (e) => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => { search = e.target.value; currentPage = 1; fetchMembers(); }, 300);
        };
        roleFilterSelect.onchange = (e) => { roleFilter = e.target.value; currentPage = 1; fetchMembers(); };
        statusFilterSelect.onchange = (e) => { statusFilter = e.target.value; currentPage = 1; fetchMembers(); };

        sortHeaders.forEach(header => {
            header.onclick = () => {
                const newSortBy = header.dataset.sort;
                if (sortBy === newSortBy) sortOrder = sortOrder === 'ASC' ? 'DESC' : 'ASC';
                else { sortBy = newSortBy; sortOrder = 'ASC'; }
                sortHeaders.forEach(h => {
                    const icon = h.querySelector('.sort-icon');
                    if (h === header) { icon.textContent = sortOrder === 'ASC' ? '↑' : '↓'; icon.classList.remove('opacity-20'); }
                    else { icon.textContent = '⇅'; icon.classList.add('opacity-20'); }
                });
                fetchMembers();
            };
        });

        prevPageBtn.onclick = () => { if (currentPage > 1) { currentPage--; fetchMembers(); } };
        nextPageBtn.onclick = () => { if (currentPage < Math.ceil(total / limit)) { currentPage++; fetchMembers(); } };

        // Member Modal Logic
        function openModal(isEdit = false, data = null) {
            modalTitle.textContent = isEdit ? 'Chỉnh sửa tài khoản' : 'Thêm tài khoản mới';
            passwordHint.classList.toggle('hidden', isEdit);
            document.getElementById('mPassword').required = !isEdit;
            if (isEdit && data) {
                document.getElementById('memberId').value = data.id;
                document.getElementById('mUsername').value = data.member;
                document.getElementById('mDisplayName').value = data.display_name || '';
                document.getElementById('mRole').value = data.roles;
                document.getElementById('mPassword').value = '';
            } else {
                memberForm.reset();
                document.getElementById('memberId').value = '';
                document.getElementById('mRole').value = 'member';
            }
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => { modalContent.classList.remove('scale-95', 'opacity-0'); modalContent.classList.add('scale-100', 'opacity-100'); }, 10);
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modalContent.classList.add('scale-95', 'opacity-0');
            modalContent.classList.remove('scale-100', 'opacity-100');
            setTimeout(() => { modal.classList.add('hidden'); modal.classList.remove('flex'); document.body.style.overflow = ''; }, 200);
        }

        addMemberBtn.onclick = () => openModal(false);
        closeModalBtns.forEach(btn => btn.onclick = closeModal);
        modal.onclick = (e) => { if (e.target === modal) closeModal(); };

        memberForm.onsubmit = async (e) => {
            e.preventDefault();
            const formData = new FormData(memberForm);
            const data = Object.fromEntries(formData.entries());
            const isEdit = !!data.id;
            try {
                const res = await fetch('/api/admin/members', {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` },
                    body: JSON.stringify(data),
                });
                if (res.ok) {
                    showToast(isEdit ? 'Cập nhật thành công' : 'Thêm mới thành công', 'success');
                    closeModal();
                    fetchMembers();
                } else {
                    const err = await res.json();
                    showToast(err.error || 'Lỗi thao tác', 'error');
                }
            } catch { showToast('Lỗi kết nối', 'error'); }
        };

        // Lesson Modal Logic
        function openLessonModal(isEdit = false, data = null) {
            lessonModalTitle.textContent = isEdit ? 'Chỉnh sửa bài học' : 'Thêm bài học mới';
            if (isEdit && data) {
                document.getElementById('lessonId').value = data.id;
                document.getElementById('lTitle').value = data.title;
                document.getElementById('lUrl').value = data.url;
                document.getElementById('lDescription').value = data.description || '';
            } else {
                lessonForm.reset();
                document.getElementById('lessonId').value = '';
            }
            lessonModal.classList.remove('hidden');
            lessonModal.classList.add('flex');
            setTimeout(() => { lessonModalContent.classList.remove('scale-95', 'opacity-0'); lessonModalContent.classList.add('scale-100', 'opacity-100'); }, 10);
            document.body.style.overflow = 'hidden';
        }

        function closeLessonModal() {
            lessonModalContent.classList.add('scale-95', 'opacity-0');
            lessonModalContent.classList.remove('scale-100', 'opacity-100');
            setTimeout(() => { lessonModal.classList.add('hidden'); lessonModal.classList.remove('flex'); document.body.style.overflow = ''; }, 200);
        }

        window.editMember = (id) => { const member = members.find(m => m.id === id); if (member) openModal(true, member); };
        window.toggleMemberStatus = (id) => openDeleteModal(id);
        window.editLesson = (id) => { const lesson = lessons.find(l => l.id === id); if (lesson) openLessonModal(true, lesson); };

        window.deleteLesson = async (id) => {
            if (!confirm('Bạn có chắc chắn muốn xóa bài học này?')) return;
            try {
                const res = await fetch('/api/admin/lessons', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` },
                    body: JSON.stringify({ id })
                });
                if (res.ok) { showToast('Đã xóa bài học thành công', 'success'); fetchLessons(); }
                else { const data = await res.json(); showToast(data.error || 'Lỗi khi xóa bài học', 'error'); }
            } catch { showToast('Lỗi kết nối', 'error'); }
        };

        addLessonBtn.onclick = () => openLessonModal(false);
        closeLessonModalBtns.forEach(btn => btn.onclick = closeLessonModal);
        lessonModal.onclick = (e) => { if (e.target === lessonModal) closeLessonModal(); };

        lessonSearchInput.oninput = (e) => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => { lessonSearchQuery = e.target.value; fetchLessons(); }, 300);
        };

        lessonForm.onsubmit = async (e) => {
            e.preventDefault();
            const formData = new FormData(lessonForm);
            const data = Object.fromEntries(formData.entries());
            const isEdit = !!data.id;
            try {
                const res = await fetch('/api/admin/lessons', {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` },
                    body: JSON.stringify(data)
                });
                if (res.ok) {
                    showToast(isEdit ? 'Cập nhật bài học thành công' : 'Thêm bài học thành công', 'success');
                    closeLessonModal();
                    fetchLessons();
                } else {
                    const err = await res.json();
                    showToast(err.error || 'Lỗi thao tác', 'error');
                }
            } catch { showToast('Lỗi kết nối', 'error'); }
        };

        // Delete Modal Logic (Toggle Status)
        function openDeleteModal(id) {
            memberToToggle = id;
            deleteModal.classList.remove('hidden');
            deleteModal.classList.add('flex');
            setTimeout(() => { deleteModalContent.classList.remove('scale-95', 'opacity-0'); deleteModalContent.classList.add('scale-100', 'opacity-100'); }, 10);
            document.body.style.overflow = 'hidden';
        }

        function closeDeleteModal() {
            deleteModalContent.classList.add('scale-95', 'opacity-0');
            deleteModalContent.classList.remove('scale-100', 'opacity-100');
            setTimeout(() => { deleteModal.classList.add('hidden'); deleteModal.classList.remove('flex'); document.body.style.overflow = ''; memberToToggle = null; }, 200);
        }

        confirmDeleteBtn.onclick = async () => {
            if (!memberToToggle) return;
            try {
                const res = await fetch('/api/admin/members', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` },
                    body: JSON.stringify({ id: memberToToggle }),
                });
                if (res.ok) {
                    const data = await res.json();
                    showToast(`Đã ${data.newStatus === 'active' ? 'mở khóa' : 'khóa'} tài khoản thành công`, 'success');
                    closeDeleteModal();
                    fetchMembers();
                } else {
                    const data = await res.json();
                    showToast(data.error || 'Lỗi khi thay đổi trạng thái', 'error');
                }
            } catch { showToast('Lỗi kết nối', 'error'); }
        };

        cancelDeleteBtn.onclick = closeDeleteModal;
        deleteModal.onclick = (e) => { if (e.target === deleteModal) closeDeleteModal(); };

        // Logout
        const logoutBtn = document.getElementById('logoutBtn');
        if (logoutBtn) {
            logoutBtn.onclick = () => {
                localStorage.removeItem('auth_token');
                localStorage.removeItem('user_session');
                localStorage.removeItem('user_roles');
                localStorage.removeItem('user_displayName');
                window.location.href = '/';
            };
        }

        // Prompt Access Logic
        const promptAccessModal = document.getElementById('promptAccessModal')
        const promptAccessModalContent = document.getElementById('promptAccessModalContent')
        const promptAccessMemberName = document.getElementById('promptAccessMemberName')
        const promptAccessList = document.getElementById('promptAccessList')
        const promptAccessSearch = document.getElementById('promptAccessSearch')
        const selectAllPrompts = document.getElementById('selectAllPrompts')
        const deselectAllPrompts = document.getElementById('deselectAllPrompts')
        const savePromptAccess = document.getElementById('savePromptAccess')
        const tabTools = document.getElementById('tabTools')
        const tabRoadmap = document.getElementById('tabRoadmap')
        const closePromptAccessModal = document.getElementById('closePromptAccessModal')

        let currentPromptAccessMemberId = null
        let currentPromptAccessList = []
        let allPromptsData = []
        let currentTab = 'tools'

        async function loadPromptsData() {
            try {
                const res = await fetch('/api/get-prompt?type=list', { headers: { 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` } });
                if (res.ok) { const data = await res.json(); allPromptsData = data.prompts || []; }
            } catch {}
        }

        window.openPromptAccessModal = function(memberId, member, displayName, accessList) {
            currentPromptAccessMemberId = memberId;
            currentPromptAccessList = [...accessList];
            promptAccessMemberName.textContent = displayName || member;
            promptAccessModal.classList.remove('hidden');
            promptAccessModal.classList.add('flex');
            setTimeout(() => { promptAccessModalContent.classList.remove('scale-95', 'opacity-0'); promptAccessModalContent.classList.add('scale-100', 'opacity-100'); }, 10);
            renderPromptAccessList();
        }

        function renderPromptAccessList(filterText = '', tab = currentTab) {
            promptAccessList.innerHTML = '';
            const filter = filterText.toLowerCase();
            let filteredByTab = allPromptsData;
            if (tab === 'tools') filteredByTab = allPromptsData.filter(p => typeof p.id === 'number' || !String(p.id).startsWith('roadmap_'));
            else if (tab === 'roadmap') filteredByTab = allPromptsData.filter(p => String(p.id).startsWith('roadmap_'));
            
            const filteredPrompts = filteredByTab.filter(p => p.text.toLowerCase().includes(filter) || String(p.id).includes(filter));
            if (filteredPrompts.length === 0) { promptAccessList.innerHTML = '<div class="text-center text-slate-400 py-8">Không tìm thấy prompt nào</div>'; return; }

            filteredPrompts.forEach(p => {
                const isChecked = currentPromptAccessList.includes(String(p.id));
                const label = document.createElement('label');
                label.className = `flex items-center gap-3 p-3 rounded-xl border transition-all cursor-pointer ${isChecked ? 'bg-emerald-50 border-emerald-200' : 'bg-white border-slate-100 hover:border-slate-300'}`;
                label.innerHTML = `<input type="checkbox" class="w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500 cursor-pointer" ${isChecked ? 'checked' : ''}><span class="flex-1 text-sm font-medium text-slate-700">${p.id}. ${p.text}</span><span class="text-xs font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-500">#${p.id}</span>`;
                label.querySelector('input').onchange = (e) => {
                    if (e.target.checked) { if (!currentPromptAccessList.includes(String(p.id))) currentPromptAccessList.push(String(p.id)); }
                    else currentPromptAccessList = currentPromptAccessList.filter(id => id !== String(p.id));
                    label.className = `flex items-center gap-3 p-3 rounded-xl border transition-all cursor-pointer ${e.target.checked ? 'bg-emerald-50 border-emerald-200' : 'bg-white border-slate-100 hover:border-slate-300'}`;
                };
                promptAccessList.appendChild(label);
            });
        }

        promptAccessSearch.oninput = (e) => renderPromptAccessList(e.target.value);
        selectAllPrompts.onclick = () => {
            const filter = promptAccessSearch.value.toLowerCase();
            let filteredByTab = allPromptsData;
            if (currentTab === 'tools') filteredByTab = allPromptsData.filter(p => typeof p.id === 'number' || !String(p.id).startsWith('roadmap_'));
            else if (currentTab === 'roadmap') filteredByTab = allPromptsData.filter(p => String(p.id).startsWith('roadmap_'));
            filteredByTab.filter(p => p.text.toLowerCase().includes(filter) || String(p.id).includes(filter)).forEach(p => { if (!currentPromptAccessList.includes(String(p.id))) currentPromptAccessList.push(String(p.id)); });
            renderPromptAccessList(filter);
        };
        deselectAllPrompts.onclick = () => { currentPromptAccessList = []; renderPromptAccessList(promptAccessSearch.value); };
        tabTools.onclick = () => { currentTab = 'tools'; tabTools.classList.add('active', 'bg-white', 'text-slate-700'); tabTools.classList.remove('bg-slate-100', 'text-slate-500'); tabRoadmap.classList.remove('active', 'bg-white', 'text-slate-700'); tabRoadmap.classList.add('bg-slate-100', 'text-slate-500'); renderPromptAccessList(promptAccessSearch.value); };
        tabRoadmap.onclick = () => { currentTab = 'roadmap'; tabRoadmap.classList.add('active', 'bg-white', 'text-slate-700'); tabRoadmap.classList.remove('bg-slate-100', 'text-slate-500'); tabTools.classList.remove('active', 'bg-white', 'text-slate-700'); tabTools.classList.add('bg-slate-100', 'text-slate-500'); renderPromptAccessList(promptAccessSearch.value); };

        savePromptAccess.onclick = async () => {
            try {
                const res = await fetch('/api/admin/prompt-access', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` },
                    body: JSON.stringify({ memberId: currentPromptAccessMemberId, promptIds: currentPromptAccessList, action: 'update' })
                });
                if (res.ok) { showToast('Cập nhật quyền truy cập thành công!', 'success'); closePromptAccessModalFunc(); fetchMembers(); }
                else { const err = await res.json(); showToast(err.error || 'Lỗi thao tác', 'error'); }
            } catch { showToast('Lỗi kết nối', 'error'); }
        };

        function closePromptAccessModalFunc() {
            promptAccessModalContent.classList.add('scale-95', 'opacity-0');
            promptAccessModalContent.classList.remove('scale-100', 'opacity-100');
            setTimeout(() => { promptAccessModal.classList.add('hidden'); promptAccessModal.classList.remove('flex'); }, 200);
        }

        closePromptAccessModal.onclick = closePromptAccessModalFunc;
        promptAccessModal.onclick = (e) => { if (e.target === promptAccessModal) closePromptAccessModalFunc(); };

        // Toast Notification Logic
        const toast = document.getElementById('toastNotification')
        const toastMessage = document.getElementById('toastMessage')
        const toastTitle = document.getElementById('toastTitle')
        const toastIcon = document.getElementById('toastIcon')
        const toastClose = document.getElementById('toastClose')
        let toastTimeout

        window.showToast = function(msg, type = 'success') {
            if (toast) {
                toastMessage.innerHTML = msg.replace(/\n/g, '<br>')
                if (type === 'success') { toast.className = toast.className.replace(/border-[\w-]+/, 'border-emerald-500'); toastIcon.className = 'text-emerald-500'; toastTitle.textContent = 'Thành công!'; }
                else if (type === 'error') { toast.className = toast.className.replace(/border-[\w-]+/, 'border-red-500'); toastIcon.className = 'text-red-500'; toastTitle.textContent = 'Lỗi!'; }
                else if (type === 'info') { toast.className = toast.className.replace(/border-[\w-]+/, 'border-blue-500'); toastIcon.className = 'text-blue-500'; toastTitle.textContent = 'Thông báo'; }
                else if (type === 'warning') { toast.className = toast.className.replace(/border-[\w-]+/, 'border-amber-500'); toastIcon.className = 'text-amber-500'; toastTitle.textContent = 'Chú ý!'; }

                toast.classList.remove('translate-x-full', 'opacity-0')
                if (toastTimeout) clearTimeout(toastTimeout)
                toastTimeout = setTimeout(() => { toast.classList.add('translate-x-full', 'opacity-0') }, 3000)
            }
        }
        if (toastClose) toastClose.onclick = () => toast.classList.add('translate-x-full', 'opacity-0')

        loadPromptsData();
    </script>

    <!-- Toast Notification -->
    <div id="toastNotification" class="fixed top-24 right-5 z-[120] transform transition-all duration-300 translate-x-full opacity-0 flex items-center gap-3 bg-white px-4 py-3 rounded-xl shadow-2xl border-l-[6px] border-emerald-500">
        <div id="toastIcon" class="text-emerald-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <div class="flex flex-col">
            <span id="toastTitle" class="font-bold text-gray-800 text-sm">Thành công!</span>
            <span id="toastMessage" class="text-xs text-gray-500 font-medium">Thao tác thành công.</span>
        </div>
        <button id="toastClose" class="ml-4 text-gray-400 hover:text-gray-600 outline-none pxhCursorPointer"> ✕ </button>
    </div>
</body>
</html>
