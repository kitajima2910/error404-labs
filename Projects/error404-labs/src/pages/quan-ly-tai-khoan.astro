---
import MainLayout from '../layouts/MainLayout.astro'
import jwt from 'jsonwebtoken'

export const prerender = false

const token = Astro.cookies.get('auth_token')?.value
let user = null

try {
    if (token) {
        user = jwt.verify(token, import.meta.env.JWT_SECRET) as any
    }
} catch (e) {}

if (!user || user.roles !== 'admin') {
    return Astro.redirect('/')
}
---

<MainLayout title="Quản lý tài khoản | Error404-Labs" description="Trang quản trị tài khoản dành cho Admin">
    <section class="h-[calc(100vh-168px)] max-w-6xl mx-auto px-4 py-12">
        <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-bold text-slate-800">Quản Lý Tài Khoản</h1>
                <p class="text-slate-500 mt-1">Danh sách thành viên trong hệ thống Error404-Labs</p>
            </div>
            <button
                id="addMemberBtn"
                class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-indigo-200 flex items-center gap-2 w-fit"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path
                        fill-rule="evenodd"
                        d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
                        clip-rule="evenodd"></path>
                </svg>
                Thêm tài khoản
            </button>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-100">
                            <th class="px-6 py-4 text-sm font-bold text-slate-600 uppercase tracking-wider">ID</th>
                            <th class="px-6 py-4 text-sm font-bold text-slate-600 uppercase tracking-wider"
                                >Tài khoản</th
                            >
                            <th class="px-6 py-4 text-sm font-bold text-slate-600 uppercase tracking-wider">Vai trò</th>
                            <th class="px-6 py-4 text-sm font-bold text-slate-600 uppercase tracking-wider text-right"
                                >Thao tác</th
                            >
                        </tr>
                    </thead>
                    <tbody id="memberTableBody" class="divide-y divide-slate-100">
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-slate-400">Đang tải dữ liệu...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Modal Form -->
    <div
        id="memberModal"
        class="fixed inset-0 z-[150] hidden items-center justify-center bg-black/50 p-4 transition-opacity"
    >
        <div
            class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all scale-95 opacity-0"
            id="memberModalContent"
        >
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <h3 id="modalTitle" class="text-xl font-bold text-slate-800">Thêm tài khoản mới</h3>
                <button
                    type="button"
                    class="closeModalBtn text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
                        ></path>
                    </svg>
                </button>
            </div>
            <form id="memberForm" class="p-6 space-y-4">
                <input type="hidden" id="memberId" name="id" />
                <div>
                    <label for="mUsername" class="block text-sm font-bold text-slate-700 mb-1.5">Tên tài khoản</label>
                    <input
                        type="text"
                        id="mUsername"
                        name="username"
                        required
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300"
                        placeholder="Nhập tên đăng nhập"
                    />
                </div>
                <div>
                    <label for="mPassword" class="block text-sm font-bold text-slate-700 mb-1.5"
                        >Mật khẩu (Mã truy cập)</label
                    >
                    <input
                        type="password"
                        id="mPassword"
                        name="password"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300"
                        placeholder="Để trống nếu không đổi"
                    />
                    <p id="passwordHint" class="text-[10px] text-slate-400 mt-1 italic hidden">
                        * Bắt buộc cho tài khoản mới
                    </p>
                </div>
                <div>
                    <label for="mRole" class="block text-sm font-bold text-slate-700 mb-1.5">Vai trò</label>
                    <select
                        id="mRole"
                        name="roles"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all appearance-none bg-no-repeat bg-[right_1rem_center]"
                        style="background-image: url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 fill=%27none%27 viewBox=%270 0 20 20%27%3E%3Cpath stroke=%27%236B7280%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%271.5%27 d=%27M6 8l4 4 4-4%27/%3E%3C/svg%3E');"
                    >
                        <option value="member">Thành viên (Member)</option>
                        <option value="admin">Quản trị viên (Admin)</option>
                    </select>
                </div>
                <div class="flex gap-3 mt-8">
                    <button
                        type="button"
                        class="closeModalBtn flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 transition-all"
                        >Hủy</button
                    >
                    <button
                        type="submit"
                        id="submitBtn"
                        class="flex-[2] px-4 py-2.5 rounded-xl bg-indigo-600 text-white font-bold hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100"
                        >Lưu thông tin</button
                    >
                </div>
            </form>
        </div>
    </div>

    <script is:inline>
        const tableBody = document.getElementById('memberTableBody')
        const modal = document.getElementById('memberModal')
        const modalContent = document.getElementById('memberModalContent')
        const memberForm = document.getElementById('memberForm')
        const modalTitle = document.getElementById('modalTitle')
        const passwordHint = document.getElementById('passwordHint')
        const addMemberBtn = document.getElementById('addMemberBtn')
        const closeModalBtns = document.querySelectorAll('.closeModalBtn')

        let members = []

        async function fetchMembers() {
            try {
                const res = await fetch('/api/admin/members')
                if (!res.ok) throw new Error('Không có quyền hoặc lỗi DB')
                members = await res.json()
                renderMembers()
            } catch (err) {
                tableBody.innerHTML = `<tr><td colspan="4" class="px-6 py-12 text-center text-red-500">${err.message}</td></tr>`
            }
        }

        function renderMembers() {
            if (members.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="4" class="px-6 py-12 text-center text-slate-400">Chưa có tài khoản nào.</td></tr>`
                return
            }

            tableBody.innerHTML = members
                .map(
                    (m) => `
                <tr class="hover:bg-slate-50/50 transition-colors">
                    <td class="px-6 py-4 text-sm font-medium text-slate-500">#${m.id}</td>
                    <td class="px-6 py-4 text-sm font-bold text-slate-700">${m.member}</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold ${m.roles === 'admin' ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700'}">
                            ${m.roles === 'admin' ? 'Admin' : 'Member'}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                        <button onclick="editMember(${m.id})" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="Chỉnh sửa">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                            </svg>
                        </button>
                        <button onclick="deleteMember(${m.id})" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Xóa">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                        </button>
                    </td>
                </tr>
            `,
                )
                .join('')
        }

        function openModal(isEdit = false, data = null) {
            modalTitle.textContent = isEdit ? 'Chỉnh sửa tài khoản' : 'Thêm tài khoản mới'
            passwordHint.classList.toggle('hidden', isEdit)
            document.getElementById('mPassword').required = !isEdit

            if (isEdit && data) {
                document.getElementById('memberId').value = data.id
                document.getElementById('mUsername').value = data.member
                document.getElementById('mRole').value = data.roles
                document.getElementById('mPassword').value = ''
            } else {
                memberForm.reset()
                document.getElementById('memberId').value = ''
            }

            modal.classList.remove('hidden')
            modal.classList.add('flex')
            setTimeout(() => {
                modalContent.classList.remove('scale-95', 'opacity-0')
                modalContent.classList.add('scale-100', 'opacity-100')
            }, 10)
            document.body.style.overflow = 'hidden'
        }

        function closeModal() {
            modalContent.classList.add('scale-95', 'opacity-0')
            modalContent.classList.remove('scale-100', 'opacity-100')
            setTimeout(() => {
                modal.classList.add('hidden')
                modal.classList.remove('flex')
                document.body.style.overflow = ''
            }, 200)
        }

        window.editMember = (id) => {
            const member = members.find((m) => m.id === id)
            if (member) openModal(true, member)
        }

        window.deleteMember = async (id) => {
            if (!confirm('Bạn có chắc chắn muốn xóa tài khoản này?')) return

            try {
                const res = await fetch('/api/admin/members', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id }),
                })
                if (res.ok) {
                    showToast('Xóa tài khoản thành công', 'success')
                    fetchMembers()
                } else {
                    const data = await res.json()
                    showToast(data.error || 'Lỗi khi xóa', 'error')
                }
            } catch {
                showToast('Lỗi kết nối', 'error')
            }
        }

        addMemberBtn.onclick = () => openModal(false)
        closeModalBtns.forEach((btn) => (btn.onclick = closeModal))
        modal.onclick = (e) => {
            if (e.target === modal) closeModal()
        }

        memberForm.onsubmit = async (e) => {
            e.preventDefault()
            const formData = new FormData(memberForm)
            const data = Object.fromEntries(formData.entries())
            const isEdit = !!data.id

            try {
                const res = await fetch('/api/admin/members', {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                })

                if (res.ok) {
                    showToast(isEdit ? 'Cập nhật thành công' : 'Thêm mới thành công', 'success')
                    closeModal()
                    fetchMembers()
                } else {
                    const err = await res.json()
                    showToast(err.error || 'Lỗi thao tác', 'error')
                }
            } catch {
                showToast('Lỗi kết nối', 'error')
            }
        }

        fetchMembers()
    </script>
</MainLayout>
