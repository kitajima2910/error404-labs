---
import MainLayout from '../layouts/MainLayout.astro'

export const prerender = false
---

<MainLayout 
    title="Quản lý tài khoản | Error404-Labs" 
    description="Trang quản trị tài khoản dành cho Admin"
    searchable={false}
>
    <!-- Page Skeleton -->
    <div id="page-skeleton" class="max-w-6xl mx-auto px-4 py-12 animate-pulse">
        <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
            <div class="space-y-3">
                <div class="h-10 w-64 bg-slate-200 rounded-xl"></div>
                <div class="h-4 w-96 bg-slate-100 rounded-lg"></div>
            </div>
            <div class="h-12 w-40 bg-slate-200 rounded-xl"></div>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="h-16 bg-slate-50 border-b border-slate-100"></div>
            <div class="p-6 space-y-4">
                {[1, 2, 3, 4, 5].map(() => (
                    <div class="flex gap-4">
                        <div class="h-12 flex-1 bg-slate-50 rounded-xl"></div>
                        <div class="h-12 flex-[2] bg-slate-50 rounded-xl"></div>
                        <div class="h-12 flex-1 bg-slate-50 rounded-xl"></div>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <!-- Auth Guard -->
    <div id="auth-guard" class="hidden pb-24 md:pb-12">
        <section class="max-w-6xl mx-auto px-4 py-12">
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-slate-800 tracking-tight">QUẢN LÝ TÀI KHOẢN</h1>
                    <p class="text-slate-500 mt-1">
                        Chào, <span id="adminGreetingName" class="font-bold text-indigo-600 underline decoration-indigo-200 underline-offset-4">Admin</span>!
                        Bạn đang quản lý các thành viên Error404-Labs.
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row items-center gap-3">
                <div class="relative w-full sm:w-64">
                    <input 
                        type="text" 
                        id="memberSearch" 
                        placeholder="Tìm kiếm..." 
                        class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all text-sm"
                    />
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <button
                    id="addMemberBtn"
                    class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-indigo-200 flex items-center gap-2 w-full sm:w-auto cursor-pointer"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
                    </svg>
                    Thêm tài khoản
                </button>
            </div>

        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-100">
                            <th class="sortable px-6 py-4 text-xs font-black text-slate-600 uppercase tracking-widest cursor-pointer hover:bg-slate-100 transition-colors group" data-sort="id">
                                ID <span class="sort-icon ml-1 opacity-20 group-hover:opacity-100">⇅</span>
                            </th>
                            <th class="sortable px-6 py-4 text-xs font-black text-slate-600 uppercase tracking-widest cursor-pointer hover:bg-slate-100 transition-colors group" data-sort="member">
                                Tài khoản <span class="sort-icon ml-1 opacity-20 group-hover:opacity-100">⇅</span>
                            </th>
                            <th class="sortable px-6 py-4 text-xs font-black text-slate-600 uppercase tracking-widest cursor-pointer hover:bg-slate-100 transition-colors group" data-sort="display_name">
                                Tên hiển thị <span class="sort-icon ml-1 opacity-20 group-hover:opacity-100">⇅</span>
                            </th>
                            <th class="sortable px-6 py-4 text-xs font-black text-slate-600 uppercase tracking-widest cursor-pointer hover:bg-slate-100 transition-colors group text-center" data-sort="roles">
                                Vai trò <span class="sort-icon ml-1 opacity-20 group-hover:opacity-100">⇅</span>
                            </th>
                            <th class="sortable px-6 py-4 text-xs font-black text-slate-600 uppercase tracking-widest cursor-pointer hover:bg-slate-100 transition-colors group text-center" data-sort="created_at">
                                Ngày tham gia <span class="sort-icon ml-1 opacity-20 group-hover:opacity-100">⇅</span>
                            </th>
                            <th class="px-6 py-4 text-xs font-black text-slate-600 uppercase tracking-widest text-center">Truy cập</th>
                            <th class="px-6 py-4 text-xs font-black text-slate-600 uppercase tracking-widest text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="memberTableBody" class="divide-y divide-slate-100">
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-slate-400">Đang tải dữ liệu...</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Phân trang -->
            <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between flex-wrap gap-4">
                <p class="text-sm text-slate-500">
                    Hiển thị <span id="showingStart" class="font-bold text-slate-700">0</span> - <span id="showingEnd" class="font-bold text-slate-700">0</span> trong <span id="totalMembers" class="font-bold text-slate-700">0</span> tài khoản
                </p>
                <div class="flex items-center gap-2">
                    <button id="prevPage" class="p-2 rounded-xl border border-slate-200 text-slate-600 hover:bg-white hover:shadow-sm transition-all disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                    </button>
                    <div id="pageNumbers" class="flex items-center gap-1"></div>
                    <button id="nextPage" class="p-2 rounded-xl border border-slate-200 text-slate-600 hover:bg-white hover:shadow-sm transition-all disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Modal Form -->
    <div
        id="memberModal"
        class="fixed inset-0 z-[150] hidden items-center justify-center bg-black/50 p-4 transition-opacity"
    >
        <div
            class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all scale-95 opacity-0"
            id="memberModalContent"
        >
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <h3 id="modalTitle" class="text-xl font-bold text-slate-800">Thêm tài khoản mới</h3>
                <button
                    type="button"
                    class="closeModalBtn text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
                        ></path>
                    </svg>
                </button>
            </div>
            <form id="memberForm" class="p-6 space-y-4">
                <input type="hidden" id="memberId" name="id" />
                <div id="usernameWrapper">
                    <label for="mUsername" class="block text-sm font-bold text-slate-700 mb-1.5">Tên tài khoản</label>
                    <input
                        type="text"
                        id="mUsername"
                        name="username"
                        required
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300"
                        placeholder="Nhập tên đăng nhập"
                    />
                </div>
                <div>
                    <label for="mDisplayName" class="block text-sm font-bold text-slate-700 mb-1.5">Tên hiển thị</label>
                    <input
                        type="text"
                        id="mDisplayName"
                        name="display_name"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300"
                        placeholder="Tên thường gọi"
                    />
                </div>
                <div id="passwordWrapper">
                    <label for="mPassword" class="block text-sm font-bold text-slate-700 mb-1.5"
                        >Mật khẩu (Mã truy cập)</label
                    >
                    <input
                        type="password"
                        id="mPassword"
                        name="password"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300"
                        placeholder="Để trống nếu không đổi"
                    />
                    <p id="passwordHint" class="text-[10px] text-slate-400 mt-1 italic hidden">
                        * Bắt buộc cho tài khoản mới
                    </p>
                </div>
                <div id="roleWrapper">
                    <label for="mRole" class="block text-sm font-bold text-slate-700 mb-1.5">Vai trò</label>
                    <select
                        id="mRole"
                        name="roles"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all appearance-none bg-no-repeat bg-[right_1rem_center] cursor-pointer"
                        style="background-image: url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 fill=%27none%27 viewBox=%270 0 20 20%27%3E%3Cpath stroke=%27%236B7280%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%271.5%27 d=%27M6 8l4 4 4-4%27/%3E%3C/svg%3E');"
                    >
                        <option value="member">Thành viên (Member)</option>
                        <option value="admin">Quản trị viên (Admin)</option>
                    </select>
                </div>
                <div class="flex gap-3 mt-8">
                    <button
                        type="button"
                        class="closeModalBtn flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 transition-all cursor-pointer"
                        >Hủy</button
                    >
                    <button
                        type="submit"
                        id="submitBtn"
                        class="flex-[2] px-4 py-2.5 rounded-xl bg-indigo-600 text-white font-bold hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100 cursor-pointer"
                        >Lưu thông tin</button
                    >
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Quản lý Prompt Access -->
    <div id="promptAccessModal" class="fixed inset-0 z-[160] hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 transition-all duration-300">
        <div id="promptAccessModalContent" class="bg-white rounded-3xl shadow-2xl w-full max-w-4xl max-h-[85vh] overflow-hidden transform scale-95 opacity-0 transition-all duration-300 border border-slate-100 flex flex-col">
            <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-emerald-50 to-white shrink-0">
                <div>
                    <h3 class="text-xl font-black text-slate-800 uppercase tracking-tight flex items-center gap-2">
                        <span class="text-emerald-600">🔗</span> Quản lý Prompt Access
                    </h3>
                    <p class="text-sm text-slate-500 mt-1">
                        Member: <span id="promptAccessMemberName" class="font-bold text-emerald-600"></span>
                    </p>
                </div>
                <button type="button" id="closePromptAccessModal" class="text-slate-400 hover:text-slate-600 p-2 rounded-xl hover:bg-slate-100 transition-colors cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="flex-1 overflow-hidden flex flex-col">
                <div class="px-6 py-4 bg-slate-50/50 border-b border-slate-100 flex items-center justify-between gap-4 shrink-0">
                    <div class="flex items-center gap-3">
                        <button id="selectAllPrompts" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-blue-50 text-blue-600 border border-blue-100 hover:bg-blue-100 transition-all cursor-pointer">
                            Chọn tất cả
                        </button>
                        <button id="deselectAllPrompts" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition-all cursor-pointer">
                            Bỏ chọn tất cả
                        </button>
                    </div>
                    <div class="flex items-center gap-3">
                        <input type="text" id="promptAccessSearch" placeholder="Tìm kiếm prompt..." class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" />
                        <button id="savePromptAccess" class="text-xs font-bold px-4 py-1.5 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition-all shadow-lg shadow-emerald-100 cursor-pointer flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Lưu thay đổi
                        </button>
                    </div>
                </div>
                <div id="promptAccessList" class="flex-1 overflow-y-auto p-4 space-y-2 custom-scrollbar">
                    <!-- Prompt list will be rendered here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Xác nhận xóa (Premium) -->
    <div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm transition-all duration-300">
        <div id="deleteModalContent" class="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden transform scale-95 opacity-0 transition-all duration-300 border border-red-50">
            <div class="bg-red-50 p-6 flex flex-col items-center">
                <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </div>
                <h3 class="text-xl font-black text-red-600 uppercase tracking-tight">Xóa tài khoản?</h3>
                <p class="text-slate-500 mt-2 text-center text-sm leading-relaxed">
                    Hành động này <span class="font-bold text-red-600 italic">không thể hoàn tác</span>. Tài khoản này sẽ bị xóa vĩnh viễn khỏi hệ thống Error404-Labs.
                </p>
            </div>
            <div class="p-6 flex flex-col gap-3">
                <button id="confirmDeleteBtn" class="w-full py-3.5 bg-red-600 text-white font-black rounded-2xl hover:bg-red-700 transition-all shadow-lg shadow-red-200 active:scale-95 cursor-pointer">
                    Xác nhận xóa ngay
                </button>
                <button id="cancelDeleteBtn" class="w-full py-3.5 bg-slate-100 text-slate-600 font-bold rounded-2xl hover:bg-slate-200 transition-all cursor-pointer">
                    Hủy bỏ
                </button>
            </div>
        </div>
    </div>
</div> <!-- Close auth-guard -->

    <script is:inline>
        // Proactive Client-side Guard
        (async function() {
            const token = localStorage.getItem('auth_token');
            const guard = document.getElementById('auth-guard');
            
            if (!token) {
                window.location.href = '/?auth=required';
                return;
            }

            try {
                const res = await fetch('/api/verify', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();

                if (!res.ok || !data.authenticated || data.user?.roles !== 'admin') {
                    // Nếu là token cũ hoặc không hợp lệ, xóa sạch để yêu cầu login lại
                    if (data.error === 'Session invalid or expired') {
                        localStorage.removeItem('auth_token');
                        localStorage.removeItem('user_session');
                        localStorage.removeItem('user_roles');
                    }
                    window.location.href = '/?auth=required';
                    return;
                }

                // Show content if verified
                guard.classList.remove('hidden');
                document.getElementById('page-skeleton')?.classList.add('hidden');
                
                // Initialize Admin Name
                const adminGreetingName = document.getElementById('adminGreetingName');
                if (adminGreetingName) {
                    adminGreetingName.textContent = data.user?.display_name || data.user?.member || 'Admin';
                }
            } catch (err) {
                console.error('Guard Error:', err);
                window.location.href = '/?error=connection';
            }
        })();

        const tableBody = document.getElementById('memberTableBody')
        const modal = document.getElementById('memberModal')
        const modalContent = document.getElementById('memberModalContent')
        const memberForm = document.getElementById('memberForm')
        const modalTitle = document.getElementById('modalTitle')
        const passwordHint = document.getElementById('passwordHint')
        const addMemberBtn = document.getElementById('addMemberBtn')
        const closeModalBtns = document.querySelectorAll('.closeModalBtn')

        const deleteModal = document.getElementById('deleteModal')
        const deleteModalContent = document.getElementById('deleteModalContent')
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn')
        const cancelDeleteBtn = document.getElementById('cancelDeleteBtn')
        let memberToDelete = null

        const memberSearch = document.getElementById('memberSearch')
        const showingStart = document.getElementById('showingStart')
        const showingEnd = document.getElementById('showingEnd')
        const totalMembers = document.getElementById('totalMembers')
        const prevPageBtn = document.getElementById('prevPage')
        const nextPageBtn = document.getElementById('nextPage')
        const pageNumbers = document.getElementById('pageNumbers')
        const sortHeaders = document.querySelectorAll('.sortable')

        let members = []
        let currentUser = ''
        let total = 0
        let currentPage = 1
        const limit = 5
        let search = ''
        let sortBy = 'id'
        let sortOrder = 'ASC'

        async function fetchMembers() {
            const offset = (currentPage - 1) * limit
            try {
                const url = `/api/admin/members?search=${encodeURIComponent(search)}&sortBy=${sortBy}&sortOrder=${sortOrder}&limit=${limit}&offset=${offset}`
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` }
                })
                if (!res.ok) throw new Error('Không có quyền hoặc lỗi DB')
                const data = await res.json()
                members = data.members
                total = data.total
                currentUser = data.currentUser
                
                renderMembers()
                renderPagination()
            } catch (err) {
                tableBody.innerHTML = `<tr><td colspan="7" class="px-6 py-12 text-center text-red-500">${err.message}</td></tr>`
            }
        }

        function renderMembers() {
            tableBody.innerHTML = '' // Clear existing

            if (members.length === 0) {
                const tr = document.createElement('tr')
                tr.innerHTML = '<td colspan="7" class="px-6 py-12 text-center text-slate-400 italic">Không tìm thấy tài khoản nào phù hợp yêu cầu.</td>'
                tableBody.appendChild(tr)
                return
            }

            members.forEach((m) => {
                const tr = document.createElement('tr')
                tr.className = "hover:bg-slate-50/50 transition-colors"

                // ID cell
                const tdId = document.createElement('td')
                tdId.className = "px-6 py-4 text-sm font-medium text-slate-500"
                tdId.textContent = `#${m.id}`
                tr.appendChild(tdId)

                // Member cell
                const tdMember = document.createElement('td')
                tdMember.className = "px-6 py-4 text-sm font-bold text-slate-700"
                tdMember.textContent = m.member
                tr.appendChild(tdMember)

                // Display Name cell
                const tdDisplayName = document.createElement('td')
                tdDisplayName.className = "px-6 py-4 text-sm text-slate-600"
                tdDisplayName.textContent = m.display_name || '-'
                tr.appendChild(tdDisplayName)

                // Roles cell
                const tdRoles = document.createElement('td')
                tdRoles.className = "px-6 py-4 text-center"
                const roleSpan = document.createElement('span')
                const targetIsSuper = m.member === 'pxh2910'
                roleSpan.className = `inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-tighter ${m.roles === 'admin' ? 'bg-amber-100 text-amber-700 border border-amber-200' : 'bg-blue-100 text-blue-700 border border-blue-200'}`
                roleSpan.textContent = m.roles === 'admin' ? (targetIsSuper ? 'Super Admin' : 'Admin') : 'Member'
                tdRoles.appendChild(roleSpan)
                tr.appendChild(tdRoles)

                // Join Date cell
                const tdDate = document.createElement('td')
                tdDate.className = "px-6 py-4 text-sm text-slate-500"
                tdDate.textContent = m.created_at ? new Date(m.created_at).toLocaleDateString('vi-VN') : '-'
                tr.appendChild(tdDate)

                const isSuper = currentUser === 'pxh2910'
                const isSelf = m.member === currentUser
                const targetIsAdmin = m.roles === 'admin'

                const canEdit = isSuper || !targetIsAdmin || isSelf
                const canDelete = !isSelf && !targetIsSuper && (isSuper || !targetIsAdmin)
                const canEditAccess = isSuper || !targetIsAdmin || isSelf

                // Prompt Access cell
                const tdAccess = document.createElement('td')
                tdAccess.className = "px-6 py-4 text-center"
                const accessBtn = document.createElement('button')
                const accessCount = m.prompt_access ? m.prompt_access.length : 0
                accessBtn.className = `text-xs font-bold px-3 py-1.5 rounded-lg border transition-all cursor-pointer ${targetIsAdmin ? 'bg-amber-50 text-amber-600 border-amber-100 cursor-not-allowed' : 'bg-emerald-50 text-emerald-600 border-emerald-100 hover:bg-emerald-100'}`
                accessBtn.textContent = targetIsAdmin ? 'Full Quyền' : (accessCount > 0 ? `${accessCount} prompts` : '0 prompts')
                accessBtn.title = targetIsAdmin ? "Admin có full quyền truy cập mọi prompt" : "Quản lý quyền truy cập Prompt"
                if (!targetIsAdmin) {
                    accessBtn.onclick = () => window.openPromptAccessModal(m.id, m.member, m.display_name, m.prompt_access || [])
                }
                tdAccess.appendChild(accessBtn)
                tr.appendChild(tdAccess)

                // Actions cell
                const tdActions = document.createElement('td')
                tdActions.className = "px-6 py-4 text-right"
                const actionsContainer = document.createElement('div')
                actionsContainer.className = "flex items-center justify-end gap-1"
                
                if (canEdit) {
                    const editBtn = document.createElement('button')
                    editBtn.className = "p-2 text-indigo-600 hover:bg-indigo-50 rounded-xl transition-all cursor-pointer"
                    editBtn.title = "Chỉnh sửa"
                    editBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                    </svg>`
                    editBtn.onclick = () => window.editMember(m.id)
                    actionsContainer.appendChild(editBtn)
                }

                if (canDelete) {
                    const delBtn = document.createElement('button')
                    delBtn.className = "p-2 text-red-600 hover:bg-red-50 rounded-xl transition-all cursor-pointer"
                    delBtn.title = "Xóa"
                    delBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>`
                    delBtn.onclick = () => window.deleteMember(m.id)
                    actionsContainer.appendChild(delBtn)
                }

                tdActions.appendChild(actionsContainer)
                tr.appendChild(tdActions)
                tableBody.appendChild(tr)
            })
        }

        function renderPagination() {
            const totalPages = Math.ceil(total / limit)
            showingStart.textContent = total === 0 ? 0 : (currentPage - 1) * limit + 1
            showingEnd.textContent = Math.min(currentPage * limit, total)
            totalMembers.textContent = total

            prevPageBtn.disabled = currentPage === 1
            nextPageBtn.disabled = currentPage === totalPages || totalPages === 0

            pageNumbers.innerHTML = ''
            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button')
                btn.textContent = i
                btn.className = `w-8 h-8 rounded-lg text-sm font-bold transition-all cursor-pointer ${
                    currentPage === i 
                        ? 'bg-indigo-600 text-white shadow-md shadow-indigo-100' 
                        : 'text-slate-500 hover:bg-white hover:shadow-sm'
                }`
                btn.onclick = () => {
                    currentPage = i
                    fetchMembers()
                }
                pageNumbers.appendChild(btn)
            }
        }

        // --- NHÀ MÁY XỬ LÝ SỰ KIỆN ---
        let searchTimeout
        memberSearch.oninput = (e) => {
            clearTimeout(searchTimeout)
            searchTimeout = setTimeout(() => {
                search = e.target.value
                currentPage = 1
                fetchMembers()
            }, 300)
        }

        sortHeaders.forEach(header => {
            header.onclick = () => {
                const newSortBy = header.dataset.sort
                if (sortBy === newSortBy) {
                    sortOrder = sortOrder === 'ASC' ? 'DESC' : 'ASC'
                } else {
                    sortBy = newSortBy
                    sortOrder = 'ASC'
                }
                
                sortHeaders.forEach(h => {
                    const icon = h.querySelector('.sort-icon')
                    if (h === header) {
                        icon.textContent = sortOrder === 'ASC' ? '↑' : '↓'
                        icon.classList.remove('opacity-20')
                    } else {
                        icon.textContent = '⇅'
                        icon.classList.add('opacity-20')
                    }
                })
                
                fetchMembers()
            }
        })

        prevPageBtn.onclick = () => {
            if (currentPage > 1) {
                currentPage--
                fetchMembers()
            }
        }

        nextPageBtn.onclick = () => {
            if (currentPage < Math.ceil(total / limit)) {
                currentPage++
                fetchMembers()
            }
        }

        function openModal(isEdit = false, data = null) {
            modalTitle.textContent = isEdit ? 'Chỉnh sửa tài khoản' : 'Thêm tài khoản mới'
            passwordHint.classList.toggle('hidden', isEdit)
            document.getElementById('mPassword').required = !isEdit

            const isTargetAdmin = data && data.roles === 'admin'
            const isTargetSuper = data && data.member === 'pxh2910'
            const isSuperAdmin = currentUser === 'pxh2910'
            const isRegularAdmin = !isSuperAdmin
            
            const usernameWrapper = document.getElementById('usernameWrapper')
            const passwordWrapper = document.getElementById('passwordWrapper')
            const roleWrapper = document.getElementById('roleWrapper')

            let shouldHideAll = false;
            if (isEdit) {
                if (isTargetSuper) shouldHideAll = true;
                else if (isTargetAdmin && isRegularAdmin) shouldHideAll = true;
            }

            if (shouldHideAll) {
                usernameWrapper.classList.add('hidden')
                passwordWrapper.classList.add('hidden')
                roleWrapper.classList.add('hidden')
                modalTitle.textContent = isTargetSuper ? 'Cập nhật thông tin cá nhân (Super Admin)' : 'Cập nhật Tên hiển thị'
            } else {
                usernameWrapper.classList.remove('hidden')
                passwordWrapper.classList.remove('hidden')
                roleWrapper.classList.remove('hidden')
            }

            if (isEdit && data) {
                document.getElementById('memberId').value = data.id
                document.getElementById('mUsername').value = data.member
                document.getElementById('mDisplayName').value = data.display_name || ''
                document.getElementById('mRole').value = data.roles
                document.getElementById('mPassword').value = ''
            } else {
                memberForm.reset()
                document.getElementById('memberId').value = ''
                document.getElementById('mRole').value = 'member'
            }

            modal.classList.remove('hidden')
            modal.classList.add('flex')
            setTimeout(() => {
                modalContent.classList.remove('scale-95', 'opacity-0')
                modalContent.classList.add('scale-100', 'opacity-100')
            }, 10)
            document.body.style.overflow = 'hidden'
        }

        function closeModal() {
            modalContent.classList.add('scale-95', 'opacity-0')
            modalContent.classList.remove('scale-100', 'opacity-100')
            setTimeout(() => {
                modal.classList.add('hidden')
                modal.classList.remove('flex')
                document.body.style.overflow = ''
            }, 200)
        }

        // --- NHÀ MÁY XỬ LÝ XÓA ---
        function openDeleteModal(id) {
            memberToDelete = id
            deleteModal.classList.remove('hidden')
            deleteModal.classList.add('flex')
            setTimeout(() => {
                deleteModalContent.classList.remove('scale-95', 'opacity-0')
                deleteModalContent.classList.add('scale-100', 'opacity-100')
            }, 10)
            document.body.style.overflow = 'hidden'
        }

        function closeDeleteModal() {
            deleteModalContent.classList.add('scale-95', 'opacity-0')
            deleteModalContent.classList.remove('scale-100', 'opacity-100')
            setTimeout(() => {
                deleteModal.classList.add('hidden')
                deleteModal.classList.remove('flex')
                document.body.style.overflow = ''
                memberToDelete = null
            }, 200)
        }

        window.editMember = (id) => {
            const member = members.find((m) => m.id === id)
            if (member) openModal(true, member)
        }

        window.deleteMember = (id) => openDeleteModal(id)

        confirmDeleteBtn.onclick = async () => {
            if (!memberToDelete) return
            confirmDeleteBtn.disabled = true
            confirmDeleteBtn.textContent = 'Đang xóa...'
            confirmDeleteBtn.classList.add('opacity-50')

            try {
                const res = await fetch('/api/admin/members', {
                    method: 'DELETE',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('auth_token')}`
                    },
                    body: JSON.stringify({ id: memberToDelete }),
                })
                if (res.ok) {
                    showToast('Xóa thành công', 'success')
                    closeDeleteModal()
                    fetchMembers()
                } else {
                    const data = await res.json()
                    showToast(data.error || 'Lỗi khi xóa', 'error')
                }
            } catch {
                showToast('Lỗi kết nối', 'error')
            } finally {
                confirmDeleteBtn.disabled = false
                confirmDeleteBtn.textContent = 'Xác nhận xóa ngay'
                confirmDeleteBtn.classList.remove('opacity-50')
            }
        }

        cancelDeleteBtn.onclick = closeDeleteModal
        deleteModal.onclick = (e) => { if (e.target === deleteModal) closeDeleteModal() }
        // -------------------------

        addMemberBtn.onclick = () => openModal(false)
        closeModalBtns.forEach((btn) => (btn.onclick = closeModal))
        modal.onclick = (e) => { if (e.target === modal) closeModal() }

        memberForm.onsubmit = async (e) => {
            e.preventDefault()
            const formData = new FormData(memberForm)
            const data = Object.fromEntries(formData.entries())
            const isEdit = !!data.id

            try {
                const res = await fetch('/api/admin/members', {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('auth_token')}`
                    },
                    body: JSON.stringify(data),
                })

                if (res.ok) {
                    showToast(isEdit ? 'Cập nhật thành công' : 'Thêm mới thành công', 'success')
                    
                    // Kiểm tra xem có đang tự cập nhật bản thân không?
                    const originalMember = members.find(m => m.id == data.id);
                    const isSelf = originalMember && originalMember.member === currentUser;

                    if (isEdit && isSelf) {
                        const newDisplayName = data.display_name || data.username;
                        
                        // Cập nhật Local Storage & Session State
                        localStorage.setItem('user_session', data.username); // Update if username changed
                        localStorage.setItem('user_displayName', newDisplayName);
                        currentUser = data.username; // Cập nhật biến để các lần edit sau vẫn đúng check
                        
                        // Cập nhật UI Greeting ngay tại trang này
                        const adminGreetingName = document.getElementById('adminGreetingName');
                        if (adminGreetingName) adminGreetingName.textContent = newDisplayName;
                        
                        // Phát sự kiện để Nav.astro nhận biết và cập nhật
                        window.dispatchEvent(new Event('user-config-update'));
                    }

                    closeModal()
                    fetchMembers()
                } else {
                    const err = await res.json()
                    showToast(err.error || 'Lỗi thao tác', 'error')
                }
            } catch {
                showToast('Lỗi kết nối', 'error')
            }
        }

        // Redirect về trang chủ nếu logout
        window.addEventListener('user-logout', () => {
            window.location.href = '/'
        })

        // === Prompt Access Modal ===
        const promptAccessModal = document.getElementById('promptAccessModal')
        const promptAccessModalContent = document.getElementById('promptAccessModalContent')
        const promptAccessMemberName = document.getElementById('promptAccessMemberName')
        const promptAccessList = document.getElementById('promptAccessList')
        const promptAccessSearch = document.getElementById('promptAccessSearch')
        const selectAllPrompts = document.getElementById('selectAllPrompts')
        const deselectAllPrompts = document.getElementById('deselectAllPrompts')
        const savePromptAccess = document.getElementById('savePromptAccess')
        const closePromptAccessModal = document.getElementById('closePromptAccessModal')

        let currentPromptAccessMemberId = null
        let currentPromptAccessList = []
        let allPromptsData = []

        // Lấy dữ liệu prompts từ data
        async function loadPromptsData() {
            try {
                const res = await fetch('/api/get-prompt?type=list', {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` }
                })
                if (res.ok) {
                    const data = await res.json()
                    allPromptsData = data.prompts || []
                }
            } catch {}
        }

        window.openPromptAccessModal = async function(memberId, member, displayName, accessList) {
            currentPromptAccessMemberId = memberId
            currentPromptAccessList = [...accessList]
            
            promptAccessMemberName.textContent = displayName || member
            
            promptAccessModal.classList.remove('hidden')
            promptAccessModal.classList.add('flex')
            setTimeout(() => {
                promptAccessModalContent.classList.remove('scale-95', 'opacity-0')
                promptAccessModalContent.classList.add('scale-100', 'opacity-100')
            }, 10)

            renderPromptAccessList()
        }

        function renderPromptAccessList(filterText = '') {
            promptAccessList.innerHTML = ''
            
            const filter = filterText.toLowerCase()
            const filteredPrompts = allPromptsData.filter(p => 
                p.text.toLowerCase().includes(filter) || 
                String(p.id).includes(filter)
            )

            if (filteredPrompts.length === 0) {
                promptAccessList.innerHTML = '<div class="text-center text-slate-400 py-8">Không tìm thấy prompt nào</div>'
                return
            }

            filteredPrompts.forEach(p => {
                const isChecked = currentPromptAccessList.includes(String(p.id))
                const label = document.createElement('label')
                label.className = `flex items-center gap-3 p-3 rounded-xl border transition-all cursor-pointer ${isChecked ? 'bg-emerald-50 border-emerald-200' : 'bg-white border-slate-100 hover:border-slate-300'}`
                
                const checkbox = document.createElement('input')
                checkbox.type = 'checkbox'
                checkbox.className = 'w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500 cursor-pointer'
                checkbox.checked = isChecked
                checkbox.onchange = () => {
                    if (checkbox.checked) {
                        if (!currentPromptAccessList.includes(String(p.id))) {
                            currentPromptAccessList.push(String(p.id))
                        }
                    } else {
                        currentPromptAccessList = currentPromptAccessList.filter(id => id !== String(p.id))
                    }
                }

                const text = document.createElement('span')
                text.className = 'flex-1 text-sm font-medium text-slate-700'
                text.textContent = `${p.id}. ${p.text}`

                const idBadge = document.createElement('span')
                idBadge.className = 'text-xs font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-500'
                idBadge.textContent = `#${p.id}`

                label.appendChild(checkbox)
                label.appendChild(text)
                label.appendChild(idBadge)
                promptAccessList.appendChild(label)
            })
        }

        promptAccessSearch.oninput = (e) => {
            renderPromptAccessList(e.target.value)
        }

        selectAllPrompts.onclick = () => {
            const filter = promptAccessSearch.value.toLowerCase()
            const filteredPrompts = allPromptsData.filter(p => 
                p.text.toLowerCase().includes(filter) || 
                String(p.id).includes(filter)
            )
            filteredPrompts.forEach(p => {
                if (!currentPromptAccessList.includes(String(p.id))) {
                    currentPromptAccessList.push(String(p.id))
                }
            })
            renderPromptAccessList(filter)
        }

        deselectAllPrompts.onclick = () => {
            currentPromptAccessList = []
            renderPromptAccessList(promptAccessSearch.value)
        }

        savePromptAccess.onclick = async () => {
            try {
                const res = await fetch('/api/admin/prompt-access', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('auth_token')}`
                    },
                    body: JSON.stringify({
                        memberId: currentPromptAccessMemberId,
                        promptIds: currentPromptAccessList,
                        action: 'update'
                    })
                })

                if (res.ok) {
                    showToast('Cập nhật quyền truy cập thành công!', 'success')
                    closePromptAccessModalFunc()
                    fetchMembers()
                } else {
                    const err = await res.json()
                    showToast(err.error || 'Lỗi thao tác', 'error')
                }
            } catch {
                showToast('Lỗi kết nối', 'error')
            }
        }

        function closePromptAccessModalFunc() {
            promptAccessModalContent.classList.add('scale-95', 'opacity-0')
            promptAccessModalContent.classList.remove('scale-100', 'opacity-100')
            setTimeout(() => {
                promptAccessModal.classList.add('hidden')
                promptAccessModal.classList.remove('flex')
            }, 200)
        }

        closePromptAccessModal.onclick = closePromptAccessModalFunc
        promptAccessModal.onclick = (e) => {
            if (e.target === promptAccessModal) closePromptAccessModalFunc()
        }

        // Expose function globally
        window.openPromptAccessModal = openPromptAccessModal

        loadPromptsData()
        fetchMembers()
    </script>
</MainLayout>
