---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'
import { categories } from '../data/dataPromptsGame.js'
import { DATA_DEMO } from '../data/dataTestDemo.js'

// Tự động load tất cả các file .txt trong thư mục prompts
const promptFiles = import.meta.glob('../data/prompts/*.txt', {
    query: '?raw',
    import: 'default',
    eager: true,
})

const titleTranslate: Record<string, string> = {
    '1. BASIC GAMES (EASIEST → ADD HOOK)': 'TRÒ CHƠI CƠ BẢN',
    '2. REFLEX GAMES (FAST + SKILL)': 'TRÒ CHƠI PHẢN XẠ',
    '3. OBSTACLE (ENDLESS + CHAOS)': 'VƯỢT CHƯỚNG NGẠI VẬT',
    '4. COLLECT (PROGRESSION LOOP)': 'TRÒ CHƠI THU THẬP',
    '5. 2D SHOOTING (ACTION CORE)': 'TRÒ CHƠI BẮN SÚNG 2D',
    '6. PLATFORM (SKILL EXPRESSION)': 'PHIÊU LƯU NỀN TẢNG',
    '7. PUZZLE (BRAIN HOOK)': 'TRÒ CHƠI GIẢI ĐỐ',
    '8. SIMPLE AI (SMART FEEL)': 'TRÒ CHƠI AI ĐƠN GIẢN',
    '9. ADVANCED (SYSTEM DESIGN)': 'HỆ THỐNG NÂNG CAO',
    '10. PRO LEVEL (GẦN GAME THẬT)': 'CẤP ĐỘ CHUYÊN NGHIỆP',
}
---

<MainLayout title={`Câu lệnh prompts Game HTML5 | ${TC_TITLE}`}>
    <section aria-label="Giới thiệu" class="min-h-screen py-10 px-4 bg-[#F0F9FF]">
        <div class="max-w-6xl mx-auto text-center mb-10">
            <h1 class="text-4xl md:text-5xl font-black text-slate-800 mb-2">100 Ý TƯỞNG</h1>
            <h2 class="text-5xl md:text-6xl font-black text-[#FF5722] mb-1 drop-shadow-sm">TRÒ CHƠI 2D HTML5</h2>
            <p class="text-2xl font-bold text-slate-600">(TỪ DỄ ĐẾN KHÓ)</p>
        </div>

        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6 pb-20">
            {
                categories.map((cat) => (
                    <div class="bg-white rounded-2xl overflow-hidden shadow-lg border border-slate-200">
                        <div class={`${cat.color} py-4 px-6 text-white text-center`}>
                            <h3 class="text-xl font-black uppercase tracking-tight flex items-center justify-center gap-2">
                                <span class="text-2xl">{cat.icon}</span>
                                {cat.title}
                            </h3>
                            <p class="text-[10px] md:text-xs font-bold opacity-90 uppercase tracking-[0.2em] mt-1">
                                ({titleTranslate[cat.title] || 'Nâng cao'})
                            </p>
                        </div>
                        <div class="p-4 grid grid-cols-2 gap-x-4 gap-y-2">
                            {cat.items.map((item) => {
                                // Tìm file prompt tương ứng với ID (ví dụ: "2-Bat-Qua.txt")
                                const fileKey = Object.keys(promptFiles).find((key) =>
                                    key.split('/').pop()?.startsWith(`${item.id}-`),
                                )
                                const fileContent = fileKey ? promptFiles[fileKey] : null

                                // Nếu có file thì ghép với prompt_extends, nếu không thì dùng prompt_extends
                                const fullPrompt = fileContent
                                    ? `${item.prompt_extends}\n\n${fileContent}`
                                    : item.prompt_extends

                                // Tìm link demo từ DATA_DEMO
                                const demoItem = DATA_DEMO.find((d) => d.name.startsWith(`${item.id}.`))
                                const demoLink = demoItem ? demoItem.link : null

                                return (
                                    <a
                                        href="#"
                                        class={`flex items-center gap-2 font-bold transition-all duration-200 group ${fullPrompt ? 'text-slate-700 hover:text-blue-600 cursor-pointer' : 'text-slate-400 cursor-default'}`}
                                        data-title={item.text.split(':')[0].replace('+', '')}
                                        data-prompt={fullPrompt}
                                        data-tooltip={item.prompt_extends}
                                        data-demo-link={demoLink}
                                    >
                                        <span class="text-slate-400 group-hover:text-blue-400 transition-colors">
                                            {item.id}.
                                        </span>
                                        <span class="text-sm md:text-base leading-tight hover:underline underline-offset-4 flex-1">
                                            {item.text}
                                        </span>
                                        {fileContent && (
                                            <span class="text-emerald-500 text-xs bg-emerald-50 px-1.5 py-0.5 rounded-md border border-emerald-100 shadow-sm animate-pulse">
                                                ✔
                                            </span>
                                        )}
                                    </a>
                                )
                            })}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Tooltip -->
    <div
        id="tooltip-game"
        class="fixed z-[120] pointer-events-none opacity-0 translate-y-2 transition-all duration-300 max-w-[280px] md:max-w-sm"
    >
        <div
            class="relative bg-slate-900/95 backdrop-blur-md text-white p-4 rounded-2xl shadow-2xl border border-white/10 text-xs md:text-sm leading-relaxed overflow-hidden group"
        >
            <div class="absolute top-0 left-0 w-1 h-full bg-blue-500"></div>
            <div id="tooltip-text" class="relative z-10 font-medium italic text-slate-200"></div>
            <!-- Glow effect -->
            <div class="absolute -right-4 -bottom-4 w-16 h-16 bg-blue-500/20 blur-2xl rounded-full"></div>
        </div>
        <!-- Arrow -->
        <div class="absolute -bottom-1.5 left-8 w-3 h-3 bg-slate-900 rotate-45 border-r border-b border-white/10"></div>
    </div>

    <!-- Modal Prompt (Thay thế Toast) -->
    <div
        id="modal-prompt"
        class="fixed inset-0 z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 px-4"
    >
        <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-md"></div>
        <div
            class="relative bg-white w-full max-w-2xl max-h-[85vh] rounded-[2rem] shadow-2xl overflow-hidden flex flex-col scale-90 transition-all duration-300 border border-white/20"
            id="modal-content"
        >
            <div
                class="px-6 py-5 bg-gradient-to-r from-slate-50 to-white border-b border-gray-100 flex items-center justify-between shrink-0"
            >
                <div class="flex items-center gap-3">
                    <div class="bg-blue-600 p-2 rounded-xl shadow-lg shadow-blue-200">
                        <span class="text-white text-xl">📋</span>
                    </div>
                    <div>
                        <h3
                            class="font-black text-slate-800 text-base md:text-lg uppercase tracking-tight"
                            id="modal-title"
                        >
                            Prompt Trò Chơi
                        </h3>
                        <p class="text-[10px] text-blue-600 font-bold uppercase tracking-wider">
                            Đã sao chép vào bộ nhớ tạm!
                        </p>
                    </div>
                </div>
                <button
                    id="close-modal"
                    class="cursor-pointer w-10 h-10 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-800 transition-all"
                >
                    <span class="text-2xl font-light">&times;</span>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto p-4 md:p-6 bg-slate-50/30 custom-scrollbar">
                <pre
                    id="modal-text"
                    class="bg-white border border-slate-200 rounded-2xl p-5 text-xs md:text-sm text-slate-600 font-mono leading-relaxed whitespace-pre-wrap shadow-inner break-words">
                </pre>
            </div>
            <div class="p-4 bg-white border-t border-gray-100 flex items-center justify-center gap-3 shrink-0">
                <a
                    id="modal-demo-btn"
                    href="#"
                    target="_blank"
                    class="hidden bg-blue-600 text-white font-black text-xs py-2.5 px-8 rounded-full hover:bg-blue-500 transition-all shadow-lg hover:shadow-blue-200 uppercase tracking-widest flex items-center gap-2"
                >
                    <span>🎮</span> XEM DEMO
                </a>
                <button
                    id="close-modal-btn"
                    class="cursor-pointer bg-slate-800 text-white font-bold text-xs py-2.5 px-10 rounded-full hover:bg-slate-700 transition-colors shadow-lg uppercase tracking-widest"
                >
                    ĐÓNG
                </button>
            </div>
        </div>
    </div>
</MainLayout>

<script is:inline>
    // Xử lý sự kiện click để copy và hiện modal
    const copyLinks = document.querySelectorAll('a[data-title]')

    // Tooltip elements
    const tooltip = document.getElementById('tooltip-game')
    const tooltipText = document.getElementById('tooltip-text')

    // Modal elements
    const modal = document.getElementById('modal-prompt')
    const modalContent = document.getElementById('modal-content')
    const modalText = document.getElementById('modal-text')
    const modalTitle = document.getElementById('modal-title')
    const modalDemoBtn = document.getElementById('modal-demo-btn')
    const closeBtns = [
        document.getElementById('close-modal'),
        document.getElementById('close-modal-btn'),
    ]

    const copyToClipboard = (text) => {
        if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(text)
        } else {
            const textArea = document.createElement('textarea')
            textArea.value = text
            document.body.appendChild(textArea)
            textArea.select()
            try {
                document.execCommand('copy')
            } catch (err) {
                console.error('Không thể copy', err)
            }
            document.body.removeChild(textArea)
            return Promise.resolve()
        }
    }

    const openModal = (text, title, demoLink) => {
        modalText.textContent = text
        modalTitle.textContent = `Prompt: ${title}`

        if (demoLink && demoLink !== 'null') {
            modalDemoBtn.href = demoLink
            modalDemoBtn.classList.remove('hidden')
        } else {
            modalDemoBtn.classList.add('hidden')
        }

        modal.classList.remove('opacity-0', 'pointer-events-none')
        modalContent.classList.remove('scale-90')
        modalContent.classList.add('scale-100')
        document.body.style.overflow = 'hidden'
    }

    const closeModal = () => {
        modal.classList.add('opacity-0', 'pointer-events-none')
        modalContent.classList.remove('scale-100')
        modalContent.classList.add('scale-90')
        document.body.style.overflow = ''
    }

    closeBtns.forEach((btn) => {
        btn?.addEventListener('click', closeModal)
    })

    modal?.addEventListener('click', (e) => {
        if (!modalContent.contains(e.target)) closeModal()
    })

    copyLinks.forEach((link) => {
        // Hover for tooltip
        link.addEventListener('mouseenter', (e) => {
            const tooltipContent = link.getAttribute('data-tooltip')
            if (tooltipContent) {
                tooltipText.textContent = tooltipContent
                tooltip.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none')
                tooltip.classList.add('opacity-100', 'translate-y-0')
            }
        })

        link.addEventListener('mousemove', (e) => {
            const x = e.clientX
            const y = e.clientY
            const tooltipHeight = tooltip.offsetHeight
            const tooltipWidth = tooltip.offsetWidth

            // Tối ưu vị trí: hiển thị bên trên cursor, nếu sát mép trên thì hiện bên dưới
            let top = y - tooltipHeight - 20
            if (top < 10) top = y + 20

            // Không để tràn sang phải
            let left = x - 32
            if (left + tooltipWidth > window.innerWidth - 20) {
                left = window.innerWidth - tooltipWidth - 20
            }
            if (left < 10) left = 10

            tooltip.style.left = `${left}px`
            tooltip.style.top = `${top}px`
        })

        link.addEventListener('mouseleave', () => {
            tooltip.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none')
            tooltip.classList.remove('opacity-100', 'translate-y-0')
        })

        // Click for modal
        link.addEventListener('click', (e) => {
            e.preventDefault()
            const prompt = link.getAttribute('data-prompt')
            const title = link.getAttribute('data-title')
            const demoLink = link.getAttribute('data-demo-link')

            if (prompt) {
                copyToClipboard(prompt).then(() => {
                    openModal(prompt, title, demoLink)
                })
            }
        })
    })
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
</style>
