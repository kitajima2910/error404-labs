---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'
import { categories } from '../data/dataPromptsGame.js'
---

<MainLayout title={`Câu lệnh prompts Game HTML5 | ${TC_TITLE}`}>
    <section aria-label="Giới thiệu" class="min-h-screen py-10 px-4 bg-[#F0F9FF]">
        <div class="max-w-6xl mx-auto text-center mb-10">
            <h1 class="text-4xl md:text-5xl font-black text-slate-800 mb-2">100 Ý TƯỞNG</h1>
            <h2 class="text-5xl md:text-6xl font-black text-[#FF5722] mb-1 drop-shadow-sm">TRÒ CHƠI HTML5</h2>
            <p class="text-2xl font-bold text-slate-600">(TỪ DỄ ĐẾN KHÓ)</p>
        </div>

        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6 pb-20">
            {
                categories.map((cat) => (
                    <div class="bg-white rounded-2xl overflow-hidden shadow-lg border border-slate-200">
                        <div class={`${cat.color} py-3 px-6 text-white text-center`}>
                            <h3 class="text-xl font-extrabold uppercase tracking-wide flex items-center justify-center gap-2">
                                <span class="text-2xl">{cat.icon}</span>
                                {cat.title}
                            </h3>
                        </div>
                        <div class="p-4 grid grid-cols-2 gap-x-4 gap-y-2">
                            {cat.items.map((item) => (
                                <a
                                    href="#"
                                    class="flex items-center gap-2 text-slate-700 hover:text-blue-600 font-bold transition-all duration-200 group"
                                    data-prompt={item.prompt}
                                >
                                    <span class="text-slate-400 group-hover:text-blue-400 transition-colors">
                                        {item.id}.
                                    </span>
                                    <span class="text-sm md:text-base leading-tight hover:underline underline-offset-4">
                                        {item.text}
                                    </span>
                                </a>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Thông báo Copy -->
    <div
        id="toast-copy"
        class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-slate-900/90 backdrop-blur-md text-white px-8 py-3 rounded-2xl shadow-2xl border border-white/10 transition-all duration-500 translate-y-32 opacity-0 z-[100] pointer-events-none flex items-center gap-3"
    >
        <span class="text-xl">🚀</span>
        <span class="font-bold tracking-wide">Đã copy câu lệnh prompt!</span>
    </div>
</MainLayout>

<script is:inline>
    // Xử lý sự kiện click để copy prompt
    const copyLinks = document.querySelectorAll('a[data-prompt]')
    const toast = document.getElementById('toast-copy')
    let toastTimeout

    copyLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
            e.preventDefault()
            const prompt = link.getAttribute('data-prompt')

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(prompt).then(showToast)
            } else {
                // Fallback cho môi trường không hỗ trợ clipboard API trực tiếp
                const textArea = document.createElement('textarea')
                textArea.value = prompt
                document.body.appendChild(textArea)
                textArea.select()
                try {
                    document.execCommand('copy')
                    showToast()
                } catch (err) {
                    console.error('Không thể copy prompt', err)
                }
                document.body.removeChild(textArea)
            }
        })
    })

    function showToast() {
        // Clear timeout cũ nếu đang hiện
        if (toastTimeout) clearTimeout(toastTimeout)

        // Hiện toast
        toast.classList.remove('translate-y-32', 'opacity-0')
        toast.classList.add('translate-y-0', 'opacity-100')

        // Ẩn toast sau 2 giây
        toastTimeout = setTimeout(() => {
            toast.classList.add('translate-y-32', 'opacity-0')
            toast.classList.remove('translate-y-0', 'opacity-100')
        }, 2500)
    }
</script>
