<script is:inline>
    // ── Auth Guard + Permission Init ──────────────────────────────────────────
    ;(async () => {
        const token = localStorage.getItem('auth_token')
        if (!token) {
            window.location.href = '/?auth=required'
            return
        }
        try {
            const res = await fetch('/api/verify', {
                headers: { Authorization: 'Bearer ' + token },
            })
            const data = await res.json()
            if (data.authenticated) {
                // Lưu thông tin user vào global để các script khác dùng
                window.currentUser = data.user

                document.getElementById('auth-guard').classList.remove('hidden')
                document.getElementById('page-skeleton').classList.add('hidden')

                // Áp dụng phân quyền sau khi DOM hiển thị
                if (typeof window.initPermissions === 'function') {
                    window.initPermissions()
                }
            } else {
                localStorage.removeItem('auth_token')
                window.location.href = '/?auth=required'
            }
        } catch {
            window.location.href = '/?auth=required'
        }
    })()
</script>

<script define:vars={{ promptsJson }}>
    // ── Data ──────────────────────────────────────────────────────────────────
    const PROMPTS = JSON.parse(promptsJson)

    // ── Kiểm tra quyền xem prompt ─────────────────────────────────────────────
    // Trả về true nếu user có quyền xem game với id cho trước
    function hasAccess(id) {
        const user = window.currentUser
        if (!user) return false
        const access = Array.isArray(user.prompt_access) ? user.prompt_access : []
        return access.map(Number).includes(Number(id))
    }

    // ── Áp dụng trạng thái khóa/mở lên tất cả game card ─────────────────────
    window.initPermissions = function () {
        const cards = document.querySelectorAll('.game-card')
        cards.forEach((card) => {
            const id = parseInt(card.dataset.id || '0', 10)
            if (!id) return
            if (hasAccess(id)) {
                // Đã có quyền — xóa trạng thái khóa nếu có
                card.style.opacity = ''
                card.style.cursor = ''
                const lockBadge = card.querySelector('.lock-badge')
                if (lockBadge) lockBadge.remove()
            } else {
                // Không có quyền — làm mờ và thêm icon khóa
                card.style.opacity = '0.5'
                card.style.cursor = 'not-allowed'
                if (!card.querySelector('.lock-badge')) {
                    const badge = document.createElement('span')
                    badge.className = 'lock-badge'
                    badge.textContent = '🔒'
                    badge.style.cssText =
                        'position:absolute;top:8px;right:8px;font-size:14px;line-height:1;pointer-events:none;'
                    // Đảm bảo card có position relative để badge định vị đúng
                    card.style.position = 'relative'
                    card.appendChild(badge)
                }
            }
        })

        // ── Bổ sung (không đổi hành vi cũ): gắn class trạng thái để hiển thị nhãn
        // "Chưa mở khóa" / "Đã mở" rõ ràng và cập nhật bộ đếm mở khóa
        let unlocked = 0
        cards.forEach((card) => {
            const id = parseInt(card.dataset.id || '0', 10)
            if (!id) return
            const ok = hasAccess(id)
            card.classList.toggle('is-locked', !ok)
            card.classList.toggle('is-unlocked', ok)
            if (ok) unlocked++
        })
        document.querySelectorAll('.category-block').forEach((block) => {
            const progress = block.querySelector('.cat-progress')
            if (!progress) return
            const total = block.querySelectorAll('.game-card').length
            const open = block.querySelectorAll('.game-card.is-unlocked').length
            progress.textContent = `Đã mở ${open}/${total}`
        })
        const total = cards.length
        const countEl = document.getElementById('unlockCount')
        const barEl = document.getElementById('unlockBar')
        if (countEl) countEl.textContent = `${unlocked}/${total}`
        if (barEl) barEl.style.width = total ? `${Math.round((unlocked / total) * 100)}%` : '0%'
        if (total && unlocked >= total) {
            const titleEl = document.getElementById('unlockTitle')
            if (titleEl) titleEl.textContent = 'Bạn đã mở khóa toàn bộ prompt 🎉'
            document.getElementById('unlockAction')?.classList.add('hidden')
            // Đã mở hết → thay lời nhắc liên hệ Zalo bằng lời chúc, ẩn nút mở khóa ở hero
            const descEl = document.getElementById('unlockDesc')
            if (descEl)
                descEl.textContent = `Bạn đã có quyền xem cả ${total} prompt. Chọn một ý tưởng và bắt đầu làm game nhé!`
            const heroCta = document.getElementById('heroUnlockCta')
            if (heroCta) heroCta.style.display = 'none'
        }
    }

    // ── Search ────────────────────────────────────────────────────────────────
    const searchInput = document.getElementById('gameSearch')
    const noResults = document.getElementById('noResults')
    const categoryBlocks = document.querySelectorAll('.category-block')
    const gameCards = document.querySelectorAll('.game-card')

    // Bỏ dấu tiếng Việt để tìm "ban" vẫn ra "bắn"
    const normalizeText = (s) =>
        (s || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/đ/g, 'd')

    if (searchInput) {
        searchInput.addEventListener('input', () => {
            const q = normalizeText(searchInput.value.trim())
            let totalVisible = 0

            categoryBlocks.forEach((block) => {
                const cards = block.querySelectorAll('.game-card')
                let blockVisible = 0
                cards.forEach((card) => {
                    const match = !q || normalizeText(card.dataset.name).includes(q)
                    card.style.display = match ? '' : 'none'
                    if (match) blockVisible++
                })
                block.style.display = blockVisible > 0 ? '' : 'none'
                totalVisible += blockVisible
            })

            if (noResults) noResults.classList.toggle('hidden', totalVisible > 0)
        })
    }

    // ── Thanh chọn chủ đề: ẩn chủ đề không có kết quả + đánh dấu chủ đề đang xem
    const jumpLinks = Array.from(document.querySelectorAll('.cat-jump'))
    const jumpList = document.getElementById('catJumpList')

    if (searchInput) {
        searchInput.addEventListener('input', () => {
            jumpLinks.forEach((link) => {
                const block = document.getElementById(link.dataset.target || '')
                const item = link.parentElement
                if (block && item) item.style.display = block.style.display === 'none' ? 'none' : ''
            })
            // Nếu đang cuộn sâu, đưa danh sách về đầu để thấy ngay kết quả tìm kiếm
            const bar = document.getElementById('kho-prompt')
            const hero = bar && bar.previousElementSibling
            if (bar && hero) {
                const navH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-h'), 10) || 0
                const listTop = hero.getBoundingClientRect().bottom + window.scrollY - navH
                if (window.scrollY > listTop) window.scrollTo({ top: listTop })
            }
            updateActiveJump()
        })
    }

    let activeTarget = ''
    function updateActiveJump() {
        const bar = document.getElementById('kho-prompt')
        const offset = (bar ? bar.getBoundingClientRect().bottom : 0) + 48
        let current = ''
        categoryBlocks.forEach((block) => {
            if (block.style.display === 'none') return
            if (block.getBoundingClientRect().top <= offset) current = block.id
        })
        if (current === activeTarget) return
        activeTarget = current
        // Trở về phía trên chủ đề đầu tiên → cuộn thanh chip về đầu để thấy "Cơ bản"
        if (current === '' && jumpList) jumpList.scrollTo({ left: 0, behavior: 'smooth' })
        jumpLinks.forEach((link) => {
            const active = link.dataset.target === current
            link.classList.toggle('is-active', active)
            if (active) link.setAttribute('aria-current', 'true')
            else link.removeAttribute('aria-current')
            // Cuộn ngang để chip đang chọn luôn nhìn thấy (không cuộn trang)
            if (active && jumpList && jumpList.scrollWidth > jumpList.clientWidth) {
                const left = link.offsetLeft - (jumpList.clientWidth - link.offsetWidth) / 2
                jumpList.scrollTo({ left: Math.max(0, left), behavior: 'smooth' })
            }
        })
    }

    let jumpTicking = false
    window.addEventListener(
        'scroll',
        () => {
            if (jumpTicking) return
            jumpTicking = true
            requestAnimationFrame(() => {
                jumpTicking = false
                updateActiveJump()
            })
        },
        { passive: true },
    )

    // ── Modal ─────────────────────────────────────────────────────────────────
    const modal = document.getElementById('promptModal')
    const modalTitle = document.getElementById('promptModalTitle')
    const promptContent = document.getElementById('promptContent')
    const modalClose = document.getElementById('promptModalClose')
    const modalBackdrop = document.getElementById('promptModalBackdrop')
    const copyBtn = document.getElementById('promptCopyBtn')
    const copyIcon = document.getElementById('copyIcon')
    const checkIcon = document.getElementById('checkIcon')
    const copyBtnText = document.getElementById('copyBtnText')

    let lastFocused = null
    function openModal(id) {
        // Kiểm tra quyền trước khi mở modal
        if (!hasAccess(id)) {
            const msg = 'Prompt này chưa được mở khóa. Liên hệ Zalo 0373.306.966 để được mở khóa nhé!'
            if (window.showToast) {
                window.showToast(msg, 'warning')
            } else {
                alert(msg)
            }
            return
        }

        const prompt = PROMPTS.find((p) => p.id === id)
        if (!prompt) return
        if (modalTitle) modalTitle.textContent = prompt.name
        if (promptContent) promptContent.textContent = prompt.content
        resetCopy()
        if (modal) {
            lastFocused = document.activeElement
            modal.style.setProperty('display', 'flex', 'important')
            document.body.style.overflow = 'hidden'
            setTimeout(() => {
                if (modalClose) modalClose.focus()
            }, 50)
        }
    }

    function closeModal() {
        if (modal) {
            const wasOpen = modal.style.display !== 'none'
            modal.style.setProperty('display', 'none', 'important')
            document.body.style.overflow = ''
            // Trả focus về thẻ game đã mở modal
            if (wasOpen && lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus()
            lastFocused = null
        }
    }

    function resetCopy() {
        if (copyIcon) copyIcon.classList.remove('hidden')
        if (checkIcon) checkIcon.classList.add('hidden')
        if (copyBtnText) copyBtnText.textContent = 'Sao chép prompt'
        if (copyBtn) copyBtn.style.background = 'linear-gradient(135deg, #2563eb, #1d4ed8)'
    }

    if (modalClose) modalClose.addEventListener('click', closeModal)
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal)
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal()
        // Giữ focus bên trong modal khi bấm Tab
        if (e.key === 'Tab' && modal && modal.style.display !== 'none') {
            const focusables = Array.from(modal.querySelectorAll('button, a[href], [tabindex]:not([tabindex="-1"])'))
            if (!focusables.length) return
            const first = focusables[0]
            const last = focusables[focusables.length - 1]
            if (!modal.contains(document.activeElement)) {
                e.preventDefault()
                first.focus()
            } else if (e.shiftKey && document.activeElement === first) {
                e.preventDefault()
                last.focus()
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault()
                first.focus()
            }
        }
    })

    if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
            const text = (promptContent && promptContent.textContent) || ''
            try {
                await navigator.clipboard.writeText(text)
                if (copyIcon) copyIcon.classList.add('hidden')
                if (checkIcon) checkIcon.classList.remove('hidden')
                if (copyBtnText) copyBtnText.textContent = 'Đã sao chép!'
                if (copyBtn) copyBtn.style.background = 'linear-gradient(135deg, #059669, #10b981)'
                setTimeout(resetCopy, 2500)
            } catch {
                if (window.showToast) window.showToast('Không thể sao chép. Hãy chọn và copy thủ công!', 'warning')
            }
        })
    }

    // ── Card click → open modal ───────────────────────────────────────────────
    gameCards.forEach((card) => {
        card.addEventListener('click', () => {
            const id = parseInt(card.dataset.id || '0', 10)
            if (id) openModal(id)
        })
    })
</script>

<style>
    /* Modal entrance animation */
    #promptModalPanel {
        animation: modalPop 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @keyframes modalPop {
        from {
            opacity: 0;
            transform: scale(0.9) translateY(20px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    /* Ô tìm kiếm */
    #gameSearch:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18);
    }

    /* Thanh chip chủ đề: cuộn ngang, ẩn thanh cuộn */
    .cat-jump-list {
        scrollbar-width: none;
    }
    .cat-jump-list::-webkit-scrollbar {
        display: none;
    }
    .cat-jump.is-active {
        background: #2563eb;
        border-color: #2563eb;
        color: #fff;
    }

    /* Thẻ game */
    .game-card {
        display: flex;
        flex-direction: column;
        position: relative;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            border-color 0.25s ease;
    }
    .game-card:hover {
        transform: translateY(-3px);
        border-color: rgba(37, 99, 235, 0.35);
        box-shadow: 0 16px 32px -16px rgba(15, 23, 42, 0.22);
    }
    .game-card:active {
        transform: translateY(0) scale(0.99);
    }
    .game-card .state-cta-open {
        margin-top: auto;
        padding-top: 0.75rem;
    }

    /* Nhãn trạng thái: chỉ hiện sau khi initPermissions gắn class */
    .state-badge {
        display: none;
    }
    .game-card.is-unlocked .state-unlocked,
    .game-card.is-locked .state-locked {
        display: inline-flex;
    }
    .game-card.is-locked .state-cta-open {
        display: none;
    }

    /* Thẻ bị khóa: trông "có chủ đích" thay vì mờ như lỗi.
       initPermissions vẫn đặt opacity/cursor inline — ghi đè phần hiển thị ở đây. */
    .game-card.is-locked {
        opacity: 1 !important;
        background: #f8fafc;
    }
    .game-card.is-locked .game-card-name {
        color: #334155;
    }
    .game-card.is-locked .game-card-desc {
        color: #64748b;
    }
    .game-card.is-locked:hover {
        transform: none;
        border-color: #fcd34d;
        box-shadow: none;
    }
    .game-card.is-unlocked {
        border-color: #a7f3d0;
    }
    /* Biểu tượng khóa cũ do initPermissions chèn — đã thay bằng nhãn "Chưa mở khóa" */
    :global(.game-card .lock-badge) {
        display: none !important;
    }

    /* Prompt scrollbar */
    .prompt-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .prompt-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .prompt-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 99px;
    }
    .prompt-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    /* Line clamp */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
