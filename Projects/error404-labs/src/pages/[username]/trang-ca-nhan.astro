---
import MainLayout from '../../layouts/MainLayout.astro'
import { neon } from '@neondatabase/serverless'

export const prerender = false

const { username } = Astro.params

if (!username) {
    return Astro.redirect('/404')
}

const dbUrl = import.meta.env.DATABASE_URL

let member: { id: number; member: string; display_name: string; avatar_url: string | null } | null = null
let error = ''

try {
    if (dbUrl) {
        const sql = neon(dbUrl)
        const members = await sql`
            SELECT id, member, display_name, avatar_url
            FROM error404labs.members
            WHERE member = ${username}
        `
        if (members.length > 0) {
            member = members[0]
        } else {
            error = 'Thành viên không tồn tại'
        }
    } else {
        error = 'Database not configured'
    }
} catch (e: any) {
    console.error('Member fetch error:', e)
    error = 'Failed to load data'
}

const displayName = member?.display_name || member?.member || username

// Lấy danh sách bài học từ Admin (lessons có author = username)
let lessons: { id: number; title: string; url: string; description: string; created_at: string; thumbnail_url: string | null }[] = []
if (dbUrl && member) {
    try {
        const sql = neon(dbUrl)
        const rows = await sql`
            SELECT id, title, url, description, created_at, thumbnail_url
            FROM error404labs.lessons
            WHERE author = ${username}
            ORDER BY created_at DESC
        `
        lessons = rows as typeof lessons
    } catch (e) {
        console.error('Lessons fetch error:', e)
    }
}
---

<MainLayout title={`Trang Cá Nhân - ${displayName} | Error404-Labs`} description={`Trang cá nhân của ${displayName} trên Error404-Labs`}>
    <div class="max-w-6xl mx-auto px-4 py-8">
        {error ? (
            <div class="text-center py-20">
                <h1 class="text-2xl font-bold text-red-600">{error}</h1>
                <a href="/" class="inline-block mt-4 text-blue-600 hover:underline">← Về trang chủ</a>
            </div>
        ) : (
            <>
                <!-- Header -->
                <div class="mb-10 text-center">
                    <div class="inline-flex items-center gap-3 mb-3">
                        <div class="w-16 h-16 rounded-full overflow-hidden ring-4 ring-indigo-500/30 shadow-lg">
                            <img src={member?.avatar_url || '/avatar_v2.avif'} alt={displayName} class="w-full h-full object-cover" />
                        </div>
                    </div>
                    <h1 class="text-4xl font-bold text-slate-800">Trang Cá Nhân</h1>
                    <p class="text-slate-600 mt-2 text-lg">
                        Lộ trình bài học của <span class="font-semibold text-indigo-600">{displayName}</span>
                    </p>
                </div>

                <!-- Lộ trình bài học từ Admin -->
                {lessons.length > 0 ? (
                    <div>
                        <div class="flex items-center gap-3 mb-5">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-xl font-bold text-slate-800">Lộ trình bài học</h2>
                                <p class="text-sm text-slate-500">{lessons.length} bài học được Admin chỉ định</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            {lessons.map((lesson) => (
                                <div class="group relative bg-white/70 backdrop-blur-sm rounded-2xl border border-emerald-100 shadow-sm hover:shadow-xl hover:shadow-emerald-500/15 transition-all duration-300 hover:-translate-y-1 overflow-hidden">
                                    <!-- Thumbnail -->
                                    {lesson.thumbnail_url ? (
                                        <div class="aspect-[16/9] overflow-hidden bg-slate-100">
                                            <img
                                                src={lesson.thumbnail_url}
                                                alt={lesson.title}
                                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                                loading="lazy"
                                            />
                                        </div>
                                    ) : (
                                        <div class="h-1 w-full bg-gradient-to-r from-emerald-400 to-teal-500"></div>
                                    )}
                                    <div class="p-5">
                                        <div class="flex items-start gap-3 mb-3">
                                            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-100 to-teal-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                                </svg>
                                            </div>
                                            <h3 class="font-bold text-slate-800 text-sm leading-snug group-hover:text-emerald-700 transition-colors line-clamp-2">
                                                {lesson.title}
                                            </h3>
                                        </div>

                                        {lesson.description && (
                                            <p class="text-xs text-slate-500 line-clamp-2 mb-4 leading-relaxed pl-11">
                                                {lesson.description}
                                            </p>
                                        )}

                                        <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                                            <span class="text-xs text-slate-400">
                                                {new Date(lesson.created_at).toLocaleDateString('vi-VN')}
                                            </span>
                                            {lesson.url && (
                                                <a
                                                    href={lesson.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gradient-to-r from-emerald-500 to-teal-600 text-white text-xs font-semibold rounded-lg hover:from-emerald-600 hover:to-teal-700 transition-all shadow-sm hover:shadow-md"
                                                >
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                                    </svg>
                                                    Xem bài học
                                                </a>
                                            )}
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                ) : (
                    <div class="text-center py-20 bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl border border-slate-200">
                        <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-slate-200 flex items-center justify-center">
                            <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                            </svg>
                        </div>
                        <p class="text-slate-500 text-lg font-medium">Chưa có bài học nào</p>
                        <p class="text-sm text-slate-400 mt-1">Admin chưa chỉ định bài học cho tài khoản này.</p>
                    </div>
                )}
            </>
        )}
    </div>
</MainLayout>
