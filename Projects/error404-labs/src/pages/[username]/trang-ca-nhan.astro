---
import MainLayout from '../../layouts/MainLayout.astro'
import { neon } from '@neondatabase/serverless'
import jwt from 'jsonwebtoken'

export const prerender = false

const { username } = Astro.params

if (!username) {
    return Astro.redirect('/404')
}

const dbUrl = import.meta.env.DATABASE_URL

let member: { id: number; member: string; display_name: string } | null = null
let error = ''

try {
    if (dbUrl) {
        const sql = neon(dbUrl)
        const members = await sql`
            SELECT id, member, display_name
            FROM error404labs.members
            WHERE member = ${username}
        `
        if (members.length > 0) {
            member = members[0]
        } else {
            error = 'Thành viên không tồn tại'
        }
    } else {
        error = 'Database not configured'
    }
} catch (e: any) {
    console.error('Page store error:', e)
    error = 'Failed to load data'
}

const displayName = member?.display_name || member?.member || username
---

<MainLayout title={`Trang Cá Nhân - ${displayName} | Error404-Labs`} description={`Trang cá nhân lưu trữ bài học tập và sản phẩm của ${displayName}`}>
    <!-- Player Modal -->
    <div id="playerModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm">
        <div class="w-full max-w-4xl m-4 rounded-2xl bg-slate-900 shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between p-4 border-b border-slate-700">
                <h3 id="playerTitle" class="text-white font-semibold truncate"></h3>
                <button id="closePlayer" class="text-slate-400 hover:text-white transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="aspect-[16/9] bg-black">
                <iframe id="playerIframe" class="w-full h-full border-0" allowfullscreen></iframe>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div id="editModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm">
        <div class="w-full max-w-lg m-4 rounded-2xl bg-white shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between p-4 border-b border-slate-200">
                <h3 class="text-lg font-bold text-slate-800">Sửa bài tập</h3>
                <button id="closeEditModal" class="text-slate-400 hover:text-slate-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <form id="editPageForm" class="p-4 space-y-4">
                <input type="hidden" id="editPageId" />
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Tiêu đề</label>
                    <input type="text" id="editPageTitle" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Liên kết (URL)</label>
                    <input type="url" id="editPageUrl" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Ảnh thumbnail</label>
                    <input type="url" id="editPageThumbnail" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="https://.../image.jpg" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Chế độ hiển thị</label>
                    <div class="flex gap-3 mt-2">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="editDisplayMode" value="direct" class="w-4 h-4 text-indigo-600" />
                            <span class="text-sm text-slate-600">Chơi trực tiếp</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="editDisplayMode" value="newtab" class="w-4 h-4 text-indigo-600" />
                            <span class="text-sm text-slate-600">Mở tab mới</span>
                        </label>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Quyền riêng tư</label>
                    <div class="flex gap-3 mt-2">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="editIsPublic" value="true" class="w-4 h-4 text-indigo-600" />
                            <span class="text-sm text-slate-600">Công khai</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="editIsPublic" value="false" class="w-4 h-4 text-indigo-600" />
                            <span class="text-sm text-slate-600">Riêng tư</span>
                        </label>
                    </div>
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="submit" class="flex-1 px-4 py-3 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 font-medium">Lưu thay đổi</button>
                    <button type="button" id="cancelEditBtn" class="px-4 py-3 border border-slate-200 text-slate-600 rounded-xl hover:bg-slate-50">Hủy</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm">
        <div class="w-full max-w-md m-4 rounded-2xl bg-white shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="p-6 text-center">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-red-100 flex items-center justify-center">
                    <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-2">Xóa bài tập?</h3>
                <p class="text-slate-600 mb-6">Hành động này không thể hoàn tác. Bạn có chắc muốn xóa bài tập này?</p>
                <div class="flex gap-3">
                    <button id="cancelDeleteBtn" class="flex-1 px-4 py-3 border border-slate-200 text-slate-600 rounded-xl hover:bg-slate-50 font-medium">Hủy</button>
                    <button id="confirmDeleteBtn" class="flex-1 px-4 py-3 bg-red-600 text-white rounded-xl hover:bg-red-700 font-medium">Xóa</button>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 py-8">
        {error ? (
            <div class="text-center py-20">
                <h1 class="text-2xl font-bold text-red-600">{error}</h1>
                <a href="/" class="inline-block mt-4 text-blue-600 hover:underline">← Về trang chủ</a>
            </div>
        ) : (
            <>
                <!-- Header -->
                <div class="mb-10 text-center">
                    <div class="inline-flex items-center gap-3 mb-3">
                        <div class="w-16 h-16 rounded-full overflow-hidden ring-4 ring-indigo-500/30 shadow-lg">
                            <img src="/avatar_v2.avif" alt={displayName} class="w-full h-full object-cover" />
                        </div>
                    </div>
                    <h1 class="text-4xl font-bold text-slate-800">Trang Cá Nhân</h1>
                    <p class="text-slate-600 mt-2 text-lg">Kho bài học tập & sản phẩm của <span class="font-semibold text-indigo-600">{displayName}</span></p>
                    <p id="pageCount" class="text-sm text-slate-400 mt-1"></p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                    <!-- Admin Panel -->
                    <div id="adminPanel" class="hidden lg:col-span-1">
                        <div class="sticky top-24 p-5 bg-gradient-to-br from-indigo-500/10 to-purple-500/10 rounded-2xl border border-indigo-500/20 backdrop-blur-sm">
                            <h3 class="font-bold text-lg text-slate-800 mb-4 flex items-center gap-2">
                                <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                </svg>
                                Thêm bài mới
                            </h3>
                            <form id="addPageForm" class="space-y-3">
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Tiêu đề</label>
                                    <input type="text" id="pageTitle" required class="w-full px-3 py-2 bg-white/80 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 backdrop-blur-sm text-sm" placeholder="Tên bài học tập" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Liên kết</label>
                                    <input type="url" id="pageUrl" required class="w-full px-3 py-2 bg-white/80 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 backdrop-blur-sm text-sm" placeholder="https://..." />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Thumbnail</label>
                                    <input type="url" id="pageThumbnail" class="w-full px-3 py-2 bg-white/80 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 backdrop-blur-sm text-sm" placeholder="https://.../image.jpg" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Chế độ hiển thị</label>
                                    <div class="flex gap-2 mt-1">
                                        <label class="flex items-center gap-1 cursor-pointer">
                                            <input type="radio" name="displayMode" value="direct" checked class="w-3 h-3 text-indigo-600" />
                                            <span class="text-xs text-slate-600">Trực tiếp</span>
                                        </label>
                                        <label class="flex items-center gap-1 cursor-pointer">
                                            <input type="radio" name="displayMode" value="newtab" class="w-3 h-3 text-indigo-600" />
                                            <span class="text-xs text-slate-600">Tab mới</span>
                                        </label>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Quyền riêng tư</label>
                                    <div class="flex gap-2 mt-1">
                                        <label class="flex items-center gap-1 cursor-pointer">
                                            <input type="radio" name="isPublic" value="true" class="w-3 h-3 text-indigo-600" />
                                            <span class="text-xs text-slate-600">Công khai</span>
                                        </label>
                                        <label class="flex items-center gap-1 cursor-pointer">
                                            <input type="radio" name="isPublic" value="false" checked class="w-3 h-3 text-indigo-600" />
                                            <span class="text-xs text-slate-600">Riêng tư</span>
                                        </label>
                                    </div>
                                </div>
                                <button type="submit" class="w-full px-4 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-xl hover:from-indigo-700 hover:to-purple-700 transition-all font-medium text-sm shadow-md">
                                    Thêm bài
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Posts Grid -->
                    <div id="postsGrid" class="lg:col-span-3">
                        <div class="flex items-center justify-center py-20">
                            <div class="animate-pulse text-slate-400">Đang tải...</div>
                        </div>
                    </div>
                </div>
            </>
        )}
    </div>
</MainLayout>

<script>
    const currentUser = localStorage.getItem('user_session')
    const currentUsername = window.location.pathname.split('/')[1]
    const isPageOwner = currentUser === currentUsername
    const token = localStorage.getItem('auth_token')

    // Chặn truy cập nếu chưa đăng nhập
    if (!token) {
        window.location.href = '/?auth=required'
    }

    if (isPageOwner) {
        const adminPanel = document.getElementById('adminPanel')
        if (adminPanel) adminPanel.classList.remove('hidden')
    }

    const renderPages = (pages: any[], isOwner: boolean) => {
        const grid = document.getElementById('postsGrid')
        const pageCount = document.getElementById('pageCount')
        if (!grid) return

        if (pages.length === 0) {
            grid.innerHTML = `
                <div class="text-center py-16 bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl border border-slate-200">
                    <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-slate-200 flex items-center justify-center">
                        <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                        </svg>
                    </div>
                    <p class="text-slate-500 text-lg">${isOwner ? 'Chưa có bài nào' : 'Không có bài công khai'}</p>
                    ${isOwner ? '<p class="text-sm text-slate-400 mt-1">Hãy thêm bài học tập của bạn!</p>' : ''}
                </div>
            `
            if (pageCount) pageCount.textContent = ''
            return
        }

        if (pageCount) {
            pageCount.textContent = isOwner ? `Hiển thị ${pages.length} bài` : `Hiển thị ${pages.length} bài công khai`
        }

        grid.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                ${pages.map((page: any) => `
                    <div class="pageCard group relative bg-white rounded-2xl shadow-md border border-slate-100 overflow-hidden hover:shadow-2xl hover:shadow-indigo-500/20 transition-all duration-300 hover:-translate-y-1" data-url="${page.url}" data-mode="${page.displayMode}" data-title="${page.title}">
                        <div class="aspect-[16/10] bg-gradient-to-br from-slate-100 to-slate-200 overflow-hidden relative">
                            ${page.thumbnailUrl ? `
                                <img src="${page.thumbnailUrl}" alt="${page.title}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                            ` : `
                                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-indigo-100 to-purple-100">
                                    <img src="/og-image.avif" alt="${page.title}" class="w-16 h-16 rounded-full shadow-lg" />
                                </div>
                            `}
                            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-3">
                                <button class="playBtn px-3 py-1.5 bg-white/90 backdrop-blur-sm rounded-full text-xs font-medium text-slate-800 hover:bg-white">
                                    ${page.displayMode === 'direct' ? '🎮 Chơi' : '🔗 Mở'}
                                </button>
                            </div>
                            ${!isOwner && `
                                <div class="absolute top-2 right-2">
                                    <span class="px-2 py-0.5 bg-green-500 text-white text-xs rounded-full font-medium">
                                        Công khai
                                    </span>
                                </div>
                            `}
                        </div>
                        <div class="p-3">
                            <h4 class="font-bold text-slate-800 line-clamp-2 group-hover:text-indigo-600 transition-colors text-sm">${page.title}</h4>
                            <div class="flex items-center justify-between mt-2">
                                <span class="text-xs text-slate-400">${new Date(page.createdAt).toLocaleDateString('vi-VN')}</span>
                                ${isOwner ? `
                                    <div class="ownerActions flex items-center gap-2">
                                        <span class="text-xs px-1.5 py-0.5 rounded-full ${page.isPublic ? 'bg-green-100 text-green-600' : 'bg-slate-100 text-slate-500'}">
                                            ${page.isPublic ? 'Public' : 'Private'}
                                        </span>
                                        <button class="editPageBtn text-blue-500 hover:text-blue-700 text-xs font-medium" data-id="${page.id}" data-title="${page.title}" data-url="${page.url}" data-thumbnail="${page.thumbnailUrl || ''}" data-mode="${page.displayMode}" data-public="${page.isPublic}">
                                            Sửa
                                        </button>
                                        <button class="deletePageBtn text-red-500 hover:text-red-700 text-xs" data-page-id="${page.id}">
                                            Xóa
                                        </button>
                                    </div>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `).join('')}
            </div>
        `
    }

    const fetchPages = async () => {
        try {
            const headers: Record<string, string> = { 'Content-Type': 'application/json' }
            if (token) {
                headers['Authorization'] = `Bearer ${token}`
            }

            const res = await fetch(`/api/user/page-store/${currentUsername}`, { headers })
            const data = await res.json()

            if (data.error) {
                const grid = document.getElementById('postsGrid')
                if (grid) {
                    grid.innerHTML = `
                        <div class="text-center py-16 bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl border border-slate-200">
                            <p class="text-red-500">${data.error}</p>
                        </div>
                    `
                }
                return
            }

            renderPages(data.pages || [], data.isOwner || false)
        } catch (err) {
            console.error('Fetch error:', err)
            const grid = document.getElementById('postsGrid')
            if (grid) {
                grid.innerHTML = `
                    <div class="text-center py-16 bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl border border-slate-200">
                        <p class="text-red-500">Lỗi tải dữ liệu</p>
                    </div>
                `
            }
        }
    }

    fetchPages()

    const playerModal = document.getElementById('playerModal')
    const playerIframe = document.getElementById('playerIframe') as HTMLIFrameElement
    const playerTitle = document.getElementById('playerTitle')
    const closePlayer = document.getElementById('closePlayer')

    const openPlayer = (url: string, title: string) => {
        if (playerModal && playerIframe && playerTitle) {
            playerTitle.textContent = title
            playerIframe.src = url
            playerModal.classList.remove('hidden')
            playerModal.classList.add('flex')
            document.body.classList.add('overflow-hidden')
        }
    }

    const closePlayerFn = () => {
        if (playerModal) {
            playerModal.classList.add('hidden')
            playerModal.classList.remove('flex')
            document.body.classList.remove('overflow-hidden')
        }
        if (playerIframe) playerIframe.src = ''
    }

    if (closePlayer) closePlayer.onclick = closePlayerFn
    if (playerModal) {
        playerModal.onclick = (e) => {
            if (e.target === playerModal) closePlayerFn()
        }
    }

    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement
        const card = target.closest('.pageCard')
        if (!card) return

        const url = (card as HTMLElement).dataset.url
        const mode = (card as HTMLElement).dataset.mode
        const title = (card as HTMLElement).dataset.title || ''

        if (target.closest('.playBtn') || target.closest('.pageCard')) {
            if (target.closest('.editPageBtn') || target.closest('.deletePageBtn') || target.closest('.playBtn')) {
                return
            }
            if (mode === 'direct' && url) {
                openPlayer(url, title)
            } else if (url) {
                window.open(url, '_blank')
            }
        }
    })

    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement
        const playBtn = target.closest('.playBtn')
        if (playBtn) {
            e.preventDefault()
            e.stopPropagation()
            const card = playBtn.closest('.pageCard') as HTMLElement
            if (card) {
                const url = card.dataset.url
                const mode = card.dataset.mode
                const title = card.dataset.title || ''
                if (mode === 'direct' && url) {
                    openPlayer(url, title)
                } else if (url) {
                    window.open(url, '_blank')
                }
            }
        }
    })

    const editModal = document.getElementById('editModal')
    const editPageForm = document.getElementById('editPageForm') as HTMLFormElement
    const closeEditModal = document.getElementById('closeEditModal')
    const cancelEditBtn = document.getElementById('cancelEditBtn')

    const openEditModal = (page: { id: string; title: string; url: string; thumbnail: string | null; mode: string; isPublic: boolean }) => {
        if (editModal) {
            ;(document.getElementById('editPageId') as HTMLInputElement).value = page.id
            ;(document.getElementById('editPageTitle') as HTMLInputElement).value = page.title
            ;(document.getElementById('editPageUrl') as HTMLInputElement).value = page.url
            ;(document.getElementById('editPageThumbnail') as HTMLInputElement).value = page.thumbnail || ''

            const modeRadios = document.getElementsByName('editDisplayMode') as RadioNodeList
            for (const radio of modeRadios) {
                radio instanceof HTMLInputElement && (radio.checked = radio.value === page.mode)
            }

            const publicRadios = document.getElementsByName('editIsPublic') as RadioNodeList
            for (const radio of publicRadios) {
                radio instanceof HTMLInputElement && (radio.checked = radio.value === (page.isPublic ? 'true' : 'false'))
            }

            editModal.classList.remove('hidden')
            editModal.classList.add('flex')
            document.body.classList.add('overflow-hidden')
        }
    }

    const closeEditModalFn = () => {
        if (editModal) {
            editModal.classList.add('hidden')
            editModal.classList.remove('flex')
            document.body.classList.remove('overflow-hidden')
        }
    }

    if (closeEditModal) closeEditModal.onclick = closeEditModalFn
    if (cancelEditBtn) cancelEditBtn.onclick = closeEditModalFn
    if (editModal) {
        editModal.onclick = (e) => {
            if (e.target === editModal) closeEditModalFn()
        }
    }

    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement
        const editBtn = target.closest('.editPageBtn')
        if (editBtn) {
            e.preventDefault()
            const page = {
                id: (editBtn as HTMLElement).dataset.id || '',
                title: (editBtn as HTMLElement).dataset.title || '',
                url: (editBtn as HTMLElement).dataset.url || '',
                thumbnail: (editBtn as HTMLElement).dataset.thumbnail || null,
                mode: (editBtn as HTMLElement).dataset.mode || 'direct',
                isPublic: (editBtn as HTMLElement).dataset.public === 'true',
            }
            openEditModal(page)
        }
    })

    if (editPageForm && isPageOwner) {
        editPageForm.addEventListener('submit', async (e) => {
            e.preventDefault()
            const pageId = (document.getElementById('editPageId') as HTMLInputElement).value
            const url = (document.getElementById('editPageUrl') as HTMLInputElement).value
            const title = (document.getElementById('editPageTitle') as HTMLInputElement).value
            const thumbnailUrl = (document.getElementById('editPageThumbnail') as HTMLInputElement).value
            const displayMode = (document.querySelector('input[name="editDisplayMode"]:checked') as HTMLInputElement)?.value || 'direct'
            const isPublic = (document.querySelector('input[name="editIsPublic"]:checked') as HTMLInputElement)?.value === 'true'

            try {
                const res = await fetch(`/api/user/page-store/${currentUsername}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        Authorization: `Bearer ${token}`,
                    },
                    body: JSON.stringify({ pageId, url, title, thumbnailUrl, displayMode, isPublic }),
                })
                const data = await res.json()
                if (data.success) {
                    closeEditModalFn()
                    // @ts-ignore
                    window.showToast('Cập nhật thành công!', 'success')
                    fetchPages()
                } else {
                    // @ts-ignore
                    window.showToast(data.error || 'Lỗi cập nhật', 'error')
                }
            } catch {
                // @ts-ignore
                window.showToast('Lỗi kết nối', 'error')
            }
        })
    }

    const addPageForm = document.getElementById('addPageForm') as HTMLFormElement
    if (addPageForm && isPageOwner) {
        addPageForm.addEventListener('submit', async (e) => {
            e.preventDefault()
            const title = (document.getElementById('pageTitle') as HTMLInputElement).value
            const url = (document.getElementById('pageUrl') as HTMLInputElement).value
            const thumbnailUrl = (document.getElementById('pageThumbnail') as HTMLInputElement).value
            const displayMode = (document.querySelector('input[name="displayMode"]:checked') as HTMLInputElement)?.value || 'direct'
            const isPublic = (document.querySelector('input[name="isPublic"]:checked') as HTMLInputElement)?.value === 'true'

            try {
                const res = await fetch(`/api/user/page-store/${currentUsername}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        Authorization: `Bearer ${token}`,
                    },
                    body: JSON.stringify({ url, title, thumbnailUrl, displayMode, isPublic }),
                })
                const data = await res.json()
                if (data.success) {
                    addPageForm.reset()
                    // @ts-ignore
                    window.showToast('Thêm bài thành công!', 'success')
                    fetchPages()
                } else {
                    // @ts-ignore
                    window.showToast(data.error || 'Lỗi thêm bài', 'error')
                }
            } catch {
                // @ts-ignore
                window.showToast('Lỗi kết nối', 'error')
            }
        })
    }

    const deleteModal = document.getElementById('deleteModal')
    const cancelDeleteBtn = document.getElementById('cancelDeleteBtn')
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn')
    let pendingDeleteId: string | null = null

    const openDeleteModal = (pageId: string) => {
        pendingDeleteId = pageId
        if (deleteModal) {
            deleteModal.classList.remove('hidden')
            deleteModal.classList.add('flex')
            document.body.classList.add('overflow-hidden')
        }
    }

    const closeDeleteModal = () => {
        pendingDeleteId = null
        if (deleteModal) {
            deleteModal.classList.add('hidden')
            deleteModal.classList.remove('flex')
            document.body.classList.remove('overflow-hidden')
        }
    }

    if (cancelDeleteBtn) cancelDeleteBtn.onclick = closeDeleteModal
    if (deleteModal) {
        deleteModal.onclick = (e) => {
            if (e.target === deleteModal) closeDeleteModal()
        }
    }

    if (confirmDeleteBtn) {
        confirmDeleteBtn.onclick = () => {
            if (!pendingDeleteId) return

            fetch(`/api/user/page-store/${currentUsername}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({ pageId: pendingDeleteId }),
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        closeDeleteModal()
                        // @ts-ignore
                        window.showToast('Xóa thành công!', 'success')
                        fetchPages()
                    } else {
                        // @ts-ignore
                        window.showToast(data.error || 'Lỗi xóa', 'error')
                    }
                })
                .catch(() => {
                    closeDeleteModal()
                    // @ts-ignore
                    window.showToast('Lỗi kết nối', 'error')
                })
        }
    }

    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement
        const deleteBtn = target.closest('.deletePageBtn')
        if (deleteBtn && isPageOwner) {
            e.preventDefault()
            e.stopPropagation()
            const pageId = (deleteBtn as HTMLElement).dataset.pageId
            if (pageId) openDeleteModal(pageId)
        }
    })
</script>