<script define:vars={{ promptsJson }}>
    // ── Data ──────────────────────────────────────────────────────────────────
    /** @type {Array<{id: number, toolName: string, content: string}>} */
    const PROMPTS = JSON.parse(promptsJson)

    // ── Helpers ───────────────────────────────────────────────────────────────
    const isLoggedIn = () => !!localStorage.getItem('auth_token')

    /** Fetch the member's prompt_access list from the API (cached per session) */
    let _accessCache = null
    let _isAdmin = false
    async function getMyAccess() {
        if (_accessCache !== null) return _accessCache
        try {
            const token = localStorage.getItem('auth_token')
            if (!token) {
                _accessCache = []
                return _accessCache
            }
            const res = await fetch('/api/admin/prompt-access?action=my-access', {
                headers: { Authorization: `Bearer ${token}` },
            })
            if (res.ok) {
                const data = await res.json()
                _accessCache = data.access || []
                _isAdmin = data.isAdmin === true
            } else {
                _accessCache = []
            }
        } catch {
            _accessCache = []
        }
        return _accessCache
    }

    /** Check if the member has access to a specific vibe prompt */
    async function hasVibeAccess(id) {
        await getMyAccess()
        if (_isAdmin) return true
        return _accessCache.includes(`vibe_${id}`)
    }

    // ── Search ────────────────────────────────────────────────────────────────
    const searchInput = /** @type {HTMLInputElement} */ (document.getElementById('toolSearch'))
    const noResults = document.getElementById('noResults')
    const cards = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('.tool-card'))
    const toolCount = document.getElementById('toolCount')
    const viewAllWrap = document.getElementById('viewAllWrap')

    /** Cập nhật dòng "Đang hiển thị x/y công cụ" theo số thẻ thực sự đang hiện */
    const updateToolCount = (query = '') => {
        const shown = Array.from(cards).filter(
            (card) => card.style.display !== 'none' && !card.classList.contains('hidden'),
        ).length
        if (toolCount) {
            toolCount.innerHTML = query
                ? `Tìm thấy <strong class="text-slate-900">${shown}</strong> công cụ`
                : `Đang hiển thị <strong class="text-slate-900">${shown}/${cards.length}</strong> công cụ`
        }
        return shown
    }

    // Bỏ dấu tiếng Việt để tìm "dem tu" vẫn ra "đếm từ"
    const normalizeText = (s) =>
        (s || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/đ/g, 'd')

    searchInput?.addEventListener('input', () => {
        const query = normalizeText(searchInput.value.trim())
        cards.forEach((card) => {
            const match =
                !query ||
                normalizeText(card.dataset.name).includes(query) ||
                normalizeText(card.dataset.desc).includes(query)
            card.style.display = match ? '' : 'none'
            // Thẻ 26–50 (.extra-tool) bị ẩn bằng class 'hidden' khi danh sách thu gọn:
            // đang tìm kiếm → bỏ 'hidden' để thẻ khớp hiện ra; xóa từ khóa → trả lại trạng thái thu gọn
            if (card.classList.contains('extra-tool')) {
                card.classList.toggle('hidden', query ? false : !allVisible)
            }
        })
        // Đếm theo trạng thái hiển thị thật (không chỉ theo kết quả khớp)
        const visible = updateToolCount(query)
        noResults?.classList.toggle('hidden', visible > 0)
        // Ẩn nút "Xem tất cả" khi đang tìm kiếm để tránh xung đột trạng thái thu gọn
        if (viewAllWrap) viewAllWrap.style.display = query ? 'none' : ''
        // Nếu đang cuộn sâu, đưa danh sách về đầu để thấy ngay kết quả
        const bar = document.getElementById('danh-sach')
        const hero = bar && bar.previousElementSibling
        if (bar && hero) {
            const navH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-h'), 10) || 0
            const listTop = hero.getBoundingClientRect().bottom + window.scrollY - navH
            if (window.scrollY > listTop) window.scrollTo({ top: listTop })
        }
    })

    // ── Trạng thái mở khóa từng thẻ (chạy sau khi xác thực thành công) ────────
    async function markAccess() {
        await getMyAccess()
        let unlocked = 0
        cards.forEach((card) => {
            const id = Number(card.dataset.id || 0)
            if (!id) return
            const ok = _isAdmin || (_accessCache || []).includes(`vibe_${id}`)
            card.classList.toggle('is-locked', !ok)
            card.classList.toggle('is-unlocked', ok)
            if (ok) unlocked++
        })
        const total = cards.length
        const countEl = document.getElementById('unlockCount')
        const barEl = document.getElementById('unlockBar')
        if (countEl) countEl.textContent = `${unlocked}/${total}`
        if (barEl) barEl.style.width = total ? `${Math.round((unlocked / total) * 100)}%` : '0%'
        if (total && unlocked >= total) {
            const titleEl = document.getElementById('unlockTitle')
            if (titleEl) titleEl.textContent = 'Bạn đã mở khóa toàn bộ prompt 🎉'
            document.getElementById('unlockAction')?.classList.add('hidden')
            // Đã mở hết → thay lời nhắc liên hệ Zalo bằng lời chúc, ẩn nút mở khóa ở hero
            const descEl = document.getElementById('unlockDesc')
            if (descEl) descEl.textContent = `Bạn đã có quyền xem cả ${total} prompt. Chọn một công cụ và bắt đầu thôi!`
            const heroCta = document.getElementById('heroUnlockCta')
            if (heroCta) heroCta.style.display = 'none'
        }
    }
    window.addEventListener('vibe:auth-ok', () => {
        markAccess()
    })

    // ── Use Tool ──────────────────────────────────────────────────────────────
    window.vibeUseTool = (id) => {
        if (window.showToast) {
            window.showToast(`Tool #${String(id).padStart(2, '0')} đang được phát triển! 🚀`, 'info')
        } else {
            alert(`Tool #${String(id).padStart(2, '0')} đang được phát triển! 🚀`)
        }
    }

    // ── Prompt Modal ──────────────────────────────────────────────────────────
    const promptModal = document.getElementById('promptModal')
    const promptModalTitle = document.getElementById('promptModalTitle')
    const promptContent = document.getElementById('promptContent')
    const promptModalClose = document.getElementById('promptModalClose')
    const promptModalBackdrop = document.getElementById('promptModalBackdrop')
    const promptCopyBtn = document.getElementById('promptCopyBtn')
    const copyIcon = document.getElementById('copyIcon')
    const checkIcon = document.getElementById('checkIcon')
    const copyBtnText = document.getElementById('copyBtnText')

    // Phần tử đã mở modal → trả focus lại khi đóng
    let lastFocused = null
    const restoreFocus = () => {
        if (lastFocused && typeof lastFocused.focus === 'function' && document.contains(lastFocused)) {
            lastFocused.focus()
        }
        lastFocused = null
    }

    const openPromptModal = (id) => {
        const prompt = PROMPTS.find((p) => p.id === id)
        if (!prompt) return
        const card = document.querySelector(`.tool-card[data-id="${id}"]`)
        if (promptModalTitle) promptModalTitle.textContent = card?.dataset.label || prompt.toolName
        if (promptContent) promptContent.textContent = prompt.content
        if (promptModal) {
            lastFocused = document.activeElement
            promptModal.style.removeProperty('display')
            promptModal.style.display = 'flex'
            // Reset copy button state
            resetCopyBtn()
            // Prevent body scroll
            document.body.style.overflow = 'hidden'
            // Focus close button for accessibility
            setTimeout(() => promptModalClose?.focus(), 50)
        }
    }

    const closePromptModal = () => {
        if (promptModal) {
            const wasOpen = promptModal.style.display !== 'none'
            promptModal.style.display = 'none'
            document.body.style.overflow = ''
            if (wasOpen) restoreFocus()
        }
    }

    const resetCopyBtn = () => {
        if (copyIcon) copyIcon.classList.remove('hidden')
        if (checkIcon) checkIcon.classList.add('hidden')
        if (copyBtnText) copyBtnText.textContent = 'Sao chép prompt'
        if (promptCopyBtn) promptCopyBtn.style.background = 'linear-gradient(135deg, #2563eb, #1d4ed8)'
    }

    promptModalClose?.addEventListener('click', closePromptModal)
    promptModalBackdrop?.addEventListener('click', closePromptModal)

    promptCopyBtn?.addEventListener('click', async () => {
        const text = promptContent?.textContent || ''
        try {
            await navigator.clipboard.writeText(text)
            // Success state
            if (copyIcon) copyIcon.classList.add('hidden')
            if (checkIcon) checkIcon.classList.remove('hidden')
            if (copyBtnText) copyBtnText.textContent = 'Đã sao chép!'
            if (promptCopyBtn) promptCopyBtn.style.background = 'linear-gradient(135deg, #059669, #10b981)'
            setTimeout(resetCopyBtn, 2500)
        } catch {
            if (window.showToast) {
                window.showToast('Không thể sao chép. Hãy chọn và copy thủ công!', 'warning')
            }
        }
    })

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closePromptModal()
            closeAuthGateModal()
        }
        // Giữ focus bên trong modal đang mở khi bấm Tab
        if (e.key === 'Tab') {
            const openDialog = [
                promptModal,
                authGateModal,
            ].find((m) => m && m.style.display !== 'none')
            if (!openDialog) return
            const focusables = Array.from(
                openDialog.querySelectorAll('button, a[href], [tabindex]:not([tabindex="-1"])'),
            ).filter((el) => el.offsetParent !== null)
            if (!focusables.length) return
            const first = focusables[0]
            const last = focusables[focusables.length - 1]
            if (!openDialog.contains(document.activeElement)) {
                e.preventDefault()
                first.focus()
            } else if (e.shiftKey && document.activeElement === first) {
                e.preventDefault()
                last.focus()
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault()
                first.focus()
            }
        }
    })

    // ── Auth Gate Modal ───────────────────────────────────────────────────────
    const authGateModal = document.getElementById('authGateModal')
    const authGateBackdrop = document.getElementById('authGateBackdrop')
    const authGateLoginBtn = document.getElementById('authGateLoginBtn')
    const authGateCloseBtn = document.getElementById('authGateCloseBtn')
    const authGateZaloBtn = document.getElementById('authGateZaloBtn')

    const openAuthGateModal = (mode = 'login') => {
        // Update text based on mode
        const title = document.getElementById('authGateTitle')
        const desc = document.getElementById('authGateDesc')
        const loginBtn = document.getElementById('authGateLoginBtn')
        if (mode === 'no-access') {
            if (title) title.textContent = 'Chưa có quyền truy cập'
            if (desc)
                desc.innerHTML =
                    'Prompt này dành riêng cho thành viên được <strong class="text-blue-700">Admin cấp quyền</strong>. Liên hệ Zalo <strong class="text-slate-900 whitespace-nowrap">0373.306.966</strong> để được mở khóa nhé!'
            if (loginBtn) loginBtn.style.display = 'none'
            if (authGateZaloBtn) authGateZaloBtn.style.display = ''
        } else {
            if (title) title.textContent = 'Nội dung dành riêng'
            if (desc)
                desc.innerHTML =
                    'Vui lòng <strong class="text-blue-700">đăng nhập</strong> để xem prompt AI dành cho thành viên Vibe.'
            if (loginBtn) loginBtn.style.display = ''
            if (authGateZaloBtn) authGateZaloBtn.style.display = 'none'
        }
        if (authGateModal) {
            lastFocused = document.activeElement
            authGateModal.style.removeProperty('display')
            authGateModal.style.display = 'flex'
            document.body.style.overflow = 'hidden'
            setTimeout(() => (mode === 'no-access' ? authGateCloseBtn?.focus() : authGateLoginBtn?.focus()), 50)
        }
    }

    const closeAuthGateModal = () => {
        if (authGateModal) {
            const wasOpen = authGateModal.style.display !== 'none'
            authGateModal.style.display = 'none'
            document.body.style.overflow = ''
            if (wasOpen) restoreFocus()
        }
    }

    authGateBackdrop?.addEventListener('click', closeAuthGateModal)
    authGateCloseBtn?.addEventListener('click', closeAuthGateModal)

    authGateLoginBtn?.addEventListener('click', () => {
        closeAuthGateModal()
        // Trigger the existing login modal in Nav
        const openLoginBtn = document.getElementById('openLoginModal')
        if (openLoginBtn) {
            openLoginBtn.click()
        } else {
            window.location.href = '/dang-nhap'
        }
    })

    // ── View Prompt (auth-gated entry point) ──────────────────────────────────
    window.vibeViewPrompt = async (id) => {
        if (!isLoggedIn()) {
            openAuthGateModal()
            return
        }
        const allowed = await hasVibeAccess(id)
        if (allowed) {
            openPromptModal(id)
        } else {
            // Logged in but no access to this specific prompt
            openAuthGateModal('no-access')
        }
    }

    // ── View All Button ───────────────────────────────────────────────────────
    const viewAllBtn = document.getElementById('viewAllBtn')
    let allVisible = false

    viewAllBtn?.addEventListener('click', () => {
        allVisible = !allVisible
        const extraCards = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('.extra-tool'))
        const btnLabel = viewAllBtn.querySelector('span:last-child')

        if (allVisible) {
            extraCards.forEach((card) => card.classList.remove('hidden'))
            if (btnLabel) btnLabel.textContent = 'Thu gọn danh sách'
        } else {
            extraCards.forEach((card) => card.classList.add('hidden'))
            if (btnLabel) btnLabel.textContent = `Xem tất cả ${cards.length} công cụ`
        }
        updateToolCount()
    })
</script>

<style>
    /* Thẻ công cụ */
    .tool-card-inner {
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            border-color 0.25s ease;
    }
    .tool-card:hover .tool-card-inner {
        transform: translateY(-3px);
        border-color: rgba(37, 99, 235, 0.35);
        box-shadow: 0 16px 32px -16px rgba(15, 23, 42, 0.22);
    }

    /* Nút xem prompt: mặc định (chưa biết quyền) → xanh nhạt */
    .tool-card-btn {
        background: #eff6ff;
        border-color: #dbeafe;
        color: #1d4ed8;
    }
    .tool-card-btn:hover {
        background: #2563eb;
        border-color: #2563eb;
        color: #fff;
    }
    .tool-card-btn .label-locked {
        display: none;
    }
    /* Đã mở khóa → nút xanh đậm */
    .tool-card.is-unlocked .tool-card-btn {
        background: #2563eb;
        border-color: #2563eb;
        color: #fff;
    }
    .tool-card.is-unlocked .tool-card-btn:hover {
        background: #1d4ed8;
    }
    .tool-card.is-unlocked .tool-card-inner {
        border-color: #a7f3d0;
    }
    /* Chưa mở khóa → nhãn vàng, rõ ràng là "khóa có chủ đích" */
    .tool-card.is-locked .tool-card-btn {
        background: #fffbeb;
        border-color: #fde68a;
        color: #92400e;
    }
    .tool-card.is-locked .tool-card-btn:hover {
        background: #fef3c7;
        border-color: #fcd34d;
        color: #78350f;
    }
    .tool-card.is-locked .label-open {
        display: none;
    }
    .tool-card.is-locked .label-locked {
        display: inline;
    }

    /* Search input focus ring */
    #toolSearch:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18);
    }

    /* Modal entrance animation */
    #promptModal > div:last-child,
    #authGateModal > div:last-child {
        animation: modalPop 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @keyframes modalPop {
        from {
            opacity: 0;
            transform: scale(0.92) translateY(12px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    /* Prompt content scrollbar */
    #promptContent::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    #promptContent::-webkit-scrollbar-track {
        background: transparent;
    }
    #promptContent::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 99px;
    }
</style>
