                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="flex-1 overflow-y-auto px-6 py-5">
                <!-- Tip banner -->
                <div class="flex items-start gap-3 rounded-2xl p-4 mb-5" style="background: #fdf4ff; border: 1.5px solid #e9d5ff;">
