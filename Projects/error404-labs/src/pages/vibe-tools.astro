<MainLayout
    title="50 công cụ mini Vibe | Error404-Labs"
    description="50 công cụ mini vibe giúp bạn học tập, làm việc và sáng tạo mỗi ngày!"
    searchable={false}
>
    <script>
        async function checkAccess() {
            const token = localStorage.getItem('auth_token')
            if (!token) {
                window.location.href = '/?auth=required'
                return
            }
            try {
                const response = await fetch('/api/verify', {
                    headers: {
                        Authorization: `Bearer ${token}`,
                        'Content-Type': 'application/json',
                    },
                })
                const data = await response.json()
                if (!data.authenticated || !data.user) {
                    window.location.href = '/?auth=required'
                    return
                }
                // Xác thực xong — hiện nội dung, ẩn khung chờ
                document.getElementById('vibe-guard')?.classList.remove('hidden')
                document.getElementById('vibe-skeleton')?.classList.add('hidden')
                window.dispatchEvent(new CustomEvent('vibe:auth-ok'))
            } catch (error) {
                console.error('Access check failed:', error)
                window.location.href = '/?auth=required'
            }
        }
        checkAccess()
    </script>

    {/* Khung chờ trong lúc kiểm tra đăng nhập (tránh lộ nội dung trước khi chuyển hướng) */}
    <div id="vibe-skeleton" aria-busy="true" aria-label="Đang tải thư viện prompt">
