---

<MainLayout title="50 Mini Tools Vibe | Error404-Labs" description="50 công cụ mini vibe giúp bạn học tập, làm việc và sáng tạo mỗi ngày!" searchable={false}>
    <div class="min-h-screen" style="background: linear-gradient(135deg, #f0f4ff 0%, #fdf0ff 50%, #fff0f8 100%);">

        <!-- Header -->
        <div class="max-w-6xl mx-auto px-4 pt-8 pb-4">

            <!-- Main Title -->
            <div class="text-center mb-6">
                <h1 class="text-4xl md:text-5xl font-extrabold mb-3 leading-tight">
                    <span class="text-yellow-400">✦</span>
                    <span class="text-gray-800"> 50 Mini Tools </span>
                    <span style="background: linear-gradient(135deg, #7c3aed, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Vibe</span>
                    <span class="text-yellow-400"> ✦</span>
                </h1>
                <p class="text-gray-500 text-base md:text-lg">Những công cụ nhỏ xinh giúp bạn học tập, làm việc và sáng tạo mỗi ngày!</p>
            </div>

            <!-- Search Bar -->
            <div class="max-w-md mx-auto mb-8">
                <div class="relative">
                    <input
                        type="text"
                        id="toolSearch"
                        placeholder="Tìm kiếm tool bạn cần..."
                        class="w-full px-5 py-3 rounded-full border-2 border-purple-100 bg-white shadow-sm text-gray-700 placeholder-gray-400 outline-none focus:border-purple-300 transition-all text-sm"
                    />
                    <button class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-purple-500 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Tools Grid -->
        <div class="max-w-6xl mx-auto px-4 pb-12">
            <div id="toolsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5">
                {tools.map((tool) => (
                    <div
                        class="tool-card bg-white rounded-3xl p-5 shadow-sm border border-gray-100 flex flex-col items-center text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg cursor-pointer"
                        data-name={tool.name.toLowerCase()}
                        data-desc={tool.desc.toLowerCase()}
                    >
                        <!-- Number badge -->
                        <div class="self-start mb-3">
                            <span class="text-xs font-bold text-gray-400 bg-gray-50 px-2 py-0.5 rounded-full">
                                {String(tool.id).padStart(2, '0')}
                            </span>
                        </div>

                        <!-- Icon -->
                        <div class={`w-16 h-16 rounded-2xl bg-gradient-to-br ${tool.bg} flex items-center justify-center mb-3 shadow-md`}>
                            {tool.isText ? (
                                <span class="text-white font-extrabold text-xl">{tool.icon}</span>
                            ) : (
                                <span class="text-3xl">{tool.icon}</span>
                            )}
                        </div>

                        <!-- Name & Desc -->
                        <h3 class="font-bold text-gray-800 text-sm mb-1 leading-tight">{tool.name}</h3>
                        <p class="text-gray-400 text-xs mb-4 leading-relaxed flex-1">{tool.desc}</p>

                        <!-- Buttons -->
                        <div class="w-full flex flex-col gap-2">
                            <button
                                class="w-full py-2 rounded-xl text-white text-xs font-semibold transition-all duration-200 hover:opacity-90 hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-1.5"
                                style="background: linear-gradient(135deg, #7c3aed, #6d28d9);"
                                onclick={`window.vibeUseTool(${tool.id})`}
                            >
                                <span>▶</span>
                                <span>Dùng tool</span>
                            </button>
                            <button
                                class="w-full py-2 rounded-xl text-xs font-semibold transition-all duration-200 hover:opacity-90 hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-1.5"
                                style="background: #fff0f8; color: #ec4899; border: 1.5px solid #fce7f3;"
                                onclick={`window.vibeViewPrompt(${tool.id})`}
                            >
                                <span>⊙</span>
                                <span>Xem prompt</span>
                            </button>
                        </div>
                    </div>
                ))}
            </div>

            <!-- No results message -->
            <div id="noResults" class="hidden text-center py-16">
                <div class="text-5xl mb-4">🔍</div>
                <p class="text-gray-500 text-lg font-medium">Không tìm thấy tool nào</p>
                <p class="text-gray-400 text-sm mt-1">Thử tìm kiếm với từ khóa khác nhé!</p>
            </div>

            <!-- View All Button -->
            <div class="flex justify-center mt-10">
                <button
                    class="px-8 py-3.5 rounded-full text-white font-bold text-sm shadow-lg transition-all duration-300 hover:shadow-xl hover:scale-105 active:scale-95 flex items-center gap-2"
                    style="background: linear-gradient(135deg, #7c3aed, #ec4899);"
                    id="viewAllBtn"
                >
                    <span>✦</span>
                    <span>Xem tất cả 50 tools</span>
                </button>
            </div>
        </div>
    </div>
</MainLayout>

<script>
    // Search functionality
    const searchInput = document.getElementById('toolSearch') as HTMLInputElement
    const toolsGrid = document.getElementById('toolsGrid')
    const noResults = document.getElementById('noResults')
    const cards = document.querySelectorAll<HTMLElement>('.tool-card')

    searchInput?.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim()
        let visibleCount = 0

        cards.forEach((card) => {
            const name = card.dataset.name || ''
            const desc = card.dataset.desc || ''
            const matches = name.includes(query) || desc.includes(query)
            card.style.display = matches ? '' : 'none'
            if (matches) visibleCount++
        })

        if (noResults) {
            noResults.classList.toggle('hidden', visibleCount > 0)
        }
    })

    // Tool action handlers
    window.vibeUseTool = (id: number) => {
        // @ts-ignore
        if (window.showToast) {
            // @ts-ignore
            window.showToast(`Tool #${String(id).padStart(2, '0')} đang được phát triển! 🚀`, 'info')
        } else {
            alert(`Tool #${String(id).padStart(2, '0')} đang được phát triển! 🚀`)
        }
    }

    window.vibeViewPrompt = (id: number) => {
        // @ts-ignore
        if (window.showToast) {
            // @ts-ignore
            window.showToast(`Prompt cho tool #${String(id).padStart(2, '0')} sắp ra mắt! 💜`, 'info')
        } else {
            alert(`Prompt cho tool #${String(id).padStart(2, '0')} sắp ra mắt! 💜`)
        }
    }

    // View all button
    document.getElementById('viewAllBtn')?.addEventListener('click', () => {
        // @ts-ignore
        if (window.showToast) {
            // @ts-ignore
            window.showToast('25 tools tiếp theo đang được phát triển! Hãy chờ đón nhé 🍄', 'info')
        } else {
            alert('25 tools tiếp theo đang được phát triển! Hãy chờ đón nhé 🍄')
        }
    })
</script>

<style>
    /* Smooth card hover */
    .tool-card {
        will-change: transform;
    }

    /* Search input focus ring */
    #toolSearch:focus {
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
    }
</style>
