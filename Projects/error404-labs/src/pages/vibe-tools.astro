                        style="background: #f8f7ff; border: 1.5px solid #ede9fe; color: #3b0764; min-height: 120px;"
                    ></pre>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-between gap-3 px-6 py-4 flex-shrink-0" style="border-top: 1.5px solid #f3f4f6;">
                <p class="text-gray-400 text-xs">Dành riêng cho thành viên Vibe 💜</p>
