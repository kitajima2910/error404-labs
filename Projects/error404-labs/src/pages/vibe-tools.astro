                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center text-lg">⊙</div>
                    <div>
                        <p class="text-white/70 text-xs font-medium uppercase tracking-wider">Prompt AI</p>
