---
import MainLayout from '../../../../layouts/MainLayout.astro'
import PyIcon from '../../../../components/python/PyIcon.astro'
import IconPython from '../../../../icons/IconPython.astro'
import { TC_TITLE } from '../../../../common/TextConst'
import { Marked, type Tokens } from 'marked'
import { highlightPython, escapeHtml } from '../../../../utils/python-highlight'
import '@fontsource/montserrat/500.css'
import '@fontsource/montserrat/600.css'
import '@fontsource/montserrat/700.css'
import '@fontsource/montserrat/800.css'

// ── Neon DB ───────────────────────────────────────────────────────────
const { neon } = await import('@neondatabase/serverless')
const sql = neon(import.meta.env.DATABASE_URL)

const { courseSlug, lessonSlug } = Astro.params

interface Lesson {
    id: string
    title: string
    slug: string
    description: string
    lesson_type: 'theory' | 'practice' | 'quiz' | 'project'
    content_markdown: string
    starter_code: string
    difficulty: 'easy' | 'medium' | 'hard'
    xp_reward: number
    estimated_minutes: number
    comparison_mode: 'exact' | 'float' | 'custom'
    float_epsilon: number
    time_limit_ms: number
    course_title: string
    course_slug: string
}

interface TestCase {
    id: string
    stdin: string
    expected_output: string
    is_hidden: boolean
    order_index: number
}

interface QuizQuestion {
    id: string
    question_text: string
    options: string[]
    correct_index: number
    explanation: string
    order_index: number
}

interface CourseLesson {
    id: string
    slug: string
    title: string
    lesson_type: string
    order_index: number
    chapter_order: number
    chapter_title: string
}

// Fetch lesson
const [lesson]: (Lesson | undefined)[] = await sql`
    SELECT
        l.id, l.title, l.slug, l.description, l.lesson_type,
        l.content_markdown, l.starter_code, l.difficulty,
        l.xp_reward, l.estimated_minutes, l.comparison_mode,
        l.float_epsilon, l.time_limit_ms,
        c.title AS course_title, c.slug AS course_slug
    FROM error404labs.py_lessons l
    JOIN error404labs.py_chapters ch ON ch.id = l.chapter_id
    JOIN error404labs.py_courses c ON c.id = ch.course_id
    WHERE l.slug = ${lessonSlug} AND c.slug = ${courseSlug} AND l.published = true
    LIMIT 1
`

if (!lesson) {
    return Astro.redirect('/404', 404)
}

// Fetch test cases
const testCases: TestCase[] = await sql`
    SELECT id, stdin, expected_output, is_hidden, order_index
    FROM error404labs.py_test_cases
    WHERE lesson_id = ${lesson.id}
    ORDER BY order_index ASC
`

// Fetch quiz questions (chỉ cho theory lessons)
const quizQuestions: QuizQuestion[] =
    lesson.lesson_type === 'theory'
        ? await sql`
    SELECT id, question_text, options, correct_index, explanation, order_index
    FROM error404labs.py_quiz_questions
    WHERE lesson_id = ${lesson.id}
    ORDER BY order_index ASC
`
        : []

// Fetch tất cả lessons trong course để biết bài trước/sau + danh sách bài học
const allLessons: CourseLesson[] = await sql`
    SELECT l.id, l.slug, l.title, l.lesson_type, l.order_index,
        ch.order_index AS chapter_order, ch.title AS chapter_title
    FROM error404labs.py_lessons l
    JOIN error404labs.py_chapters ch ON ch.id = l.chapter_id
    JOIN error404labs.py_courses c ON c.id = ch.course_id
    WHERE c.slug = ${courseSlug} AND l.published = true
    ORDER BY ch.order_index ASC, l.order_index ASC
`

const currentIdx = allLessons.findIndex((l) => l.slug === lessonSlug)
const prevLesson = currentIdx > 0 ? allLessons[currentIdx - 1] : null
const nextLesson = currentIdx >= 0 && currentIdx < allLessons.length - 1 ? allLessons[currentIdx + 1] : null

// Nhóm bài học theo chương cho drawer "Danh sách bài học"
const chapterGroups: { title: string; order: number; lessons: CourseLesson[] }[] = []
for (const l of allLessons) {
    const last = chapterGroups[chapterGroups.length - 1]
    if (last && last.order === l.chapter_order) last.lessons.push(l)
    else chapterGroups.push({ title: l.chapter_title, order: l.chapter_order, lessons: [l] })
}
const currentChapterIdx = chapterGroups.findIndex((g) => g.lessons.some((l) => l.slug === lessonSlug))
const currentLessonInChapter =
    currentChapterIdx >= 0 ? chapterGroups[currentChapterIdx].lessons.findIndex((l) => l.slug === lessonSlug) : -1

// Render markdown → HTML trên server (tô màu code Python, thêm thanh công cụ cho khối code)
const markdown = new Marked({
    renderer: {
        code({ text, lang }: Tokens.Code) {
            const language = (lang || '').trim().toLowerCase()
            const isPython = language === 'python' || language === 'py' || language === 'python3'
            if (isPython) {
                return (
                    '<div class="code-block code-block--python">' +
                    '<div class="code-head"><span class="code-lang">Python</span><span class="code-actions">' +
                    '<button type="button" class="code-btn code-copy" title="Sao chép code">Sao chép</button>' +
                    '<button type="button" class="code-btn code-try" title="Đưa code này vào trình soạn thảo">▶ Thử ngay</button>' +
                    '</span></div>' +
                    '<pre><code class="language-python">' +
                    highlightPython(text) +
                    '</code></pre></div>'
                )
            }
            return (
                '<div class="code-block code-block--plain">' +
                '<button type="button" class="code-btn code-copy" title="Sao chép">Sao chép</button>' +
                '<pre><code>' +
                escapeHtml(text) +
                '</code></pre></div>'
            )
        },
    },
})

// Bỏ tiêu đề H1 đầu tiên (đã hiển thị ở phần đầu bài học)
const mdTokens = markdown.lexer(lesson.content_markdown || '')
const firstContentIdx = mdTokens.findIndex((t) => t.type !== 'space')
if (firstContentIdx >= 0) {
    const first = mdTokens[firstContentIdx]
    if (first.type === 'heading' && (first as Tokens.Heading).depth === 1) mdTokens.splice(firstContentIdx, 1)
}
const contentHtml = markdown.parser(mdTokens)

// Badge helpers
const typeLabel: Record<string, string> = {
    theory: 'Lý thuyết',
    practice: 'Thực hành',
    quiz: 'Quiz',
    project: 'Dự án',
}
const typeColor: Record<string, string> = {
    theory: 'bg-sky-50 text-sky-700 border-sky-200',
    practice: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    quiz: 'bg-violet-50 text-violet-700 border-violet-200',
    project: 'bg-orange-50 text-orange-700 border-orange-200',
}
const diffLabel: Record<string, string> = { easy: 'Dễ', medium: 'Trung bình', hard: 'Khó' }
const diffColor: Record<string, string> = {
    easy: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    medium: 'bg-amber-50 text-amber-700 border-amber-200',
    hard: 'bg-rose-50 text-rose-700 border-rose-200',
}
const lessonIconName = (type: string) =>
    (type in typeLabel ? type : 'practice') as 'theory' | 'practice' | 'quiz' | 'project'

// Serialize dữ liệu cho client (dùng JSON để giữ newline)
// Hidden test: chỉ gửi stdin để client chạy, KHÔNG gửi expected_output — tránh lộ đáp án hidden
const clientTestCases = testCases.map((tc) =>
    tc.is_hidden ? { id: tc.id, stdin: tc.stdin, is_hidden: true, order_index: tc.order_index } : tc,
)
const testCasesJson = JSON.stringify(clientTestCases)
const lessonIdJson = JSON.stringify(lesson.id)
const starterCodeJson = JSON.stringify(lesson.starter_code || '# Viết code Python của bạn ở đây\n')
const xpReward = lesson.xp_reward
const comparisonMode = lesson.comparison_mode
const floatEpsilon = lesson.float_epsilon
const isTheory = lesson.lesson_type === 'theory'
const hasTests = testCases.length > 0
const prevLessonJson = JSON.stringify(prevLesson)
const nextLessonJson = JSON.stringify(nextLesson)
const quizQuestionsJson = JSON.stringify(quizQuestions)
---

<MainLayout title={`${lesson.title} | Python | ${TC_TITLE}`}>
    <div id="py-ide" class="flex flex-col bg-slate-100">
        <!-- ── Header bài học ─────────────────────────────────────── -->
        <header class="h-14 shrink-0 bg-white border-b border-slate-200 flex items-center gap-2 sm:gap-3 px-2 sm:px-4">
            <button
                id="lessonListBtn"
                type="button"
                class="inline-flex items-center gap-2 h-9 px-2.5 rounded-lg text-slate-600 hover:text-[#3776AB] hover:bg-slate-100 font-semibold text-sm transition-colors shrink-0"
                title="Danh sách bài học"
                aria-controls="lessonDrawer"
            >
                <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path
                        fill-rule="evenodd"
                        d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 10.5a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75ZM2 10a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 10Z"
                        clip-rule="evenodd"></path>
                </svg>
                <span class="hidden lg:inline">Danh sách bài</span>
            </button>

            <span class="w-px h-6 bg-slate-200 shrink-0"></span>

            <div class="flex-1 min-w-0">
                <a
                    href={`/hoc-python/khoa-hoc/${courseSlug}`}
                    class="hidden sm:block text-[11px] font-semibold text-slate-400 hover:text-[#3776AB] truncate no-underline leading-tight"
                >
                    {lesson.course_title}
                    {currentChapterIdx >= 0 && <span> · Chương {currentChapterIdx + 1}</span>}
                </a>
                <h1 class="font-bold text-slate-800 text-sm truncate leading-tight">{lesson.title}</h1>
            </div>

            <!-- Tiến độ khóa học (JS cập nhật) -->
            <div id="headerProgress" class="hidden lg:flex items-center gap-3 shrink-0 invisible">
                <div class="w-36 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div
                        id="headerProgressBar"
                        class="h-full bg-gradient-to-r from-[#3776AB] to-emerald-500 rounded-full transition-all duration-700"
                        style="width: 0%"
                    >
                    </div>
                </div>
                <span id="headerProgressText" class="text-xs font-semibold text-slate-500 whitespace-nowrap"></span>
            </div>

            <div class="flex items-center gap-1.5 shrink-0" id="lessonNav">
                {
                    prevLesson ? (
                        <a
                            href={`/hoc-python/hoc/${courseSlug}/${prevLesson.slug}`}
                            class="inline-flex items-center justify-center h-9 w-9 md:w-auto md:px-3 gap-1.5 rounded-lg border border-slate-200 text-slate-600 hover:border-[#3776AB] hover:text-[#3776AB] text-sm font-semibold transition-colors no-underline"
                            title={`Bài trước: ${prevLesson.title}`}
                        >
                            <span aria-hidden="true">←</span>
                            <span class="hidden md:inline">Bài trước</span>
                        </a>
                    ) : (
                        <span class="inline-flex items-center justify-center h-9 w-9 md:w-auto md:px-3 gap-1.5 rounded-lg border border-slate-100 text-slate-300 text-sm font-semibold cursor-not-allowed">
                            <span aria-hidden="true">←</span>
                            <span class="hidden md:inline">Bài trước</span>
                        </span>
                    )
                }
                <button
                    id="nextLessonBtn"
                    type="button"
                    class:list={['py-next-btn', nextLesson ? 'py-next-btn--pending' : 'hidden']}
                    data-next-slug={nextLesson?.slug || ''}
                    title={nextLesson ? `Bài tiếp: ${nextLesson.title}` : ''}
                >
                    <span class="hidden md:inline">Bài tiếp</span>
                    <span aria-hidden="true">→</span>
                </button>
            </div>
        </header>

        <!-- Tabs cho mobile -->
        <div class="md:hidden shrink-0 grid grid-cols-2 bg-white border-b border-slate-200" role="tablist">
            <button type="button" data-mobile-tab="lesson" class="mobile-tab is-active">📖 Đề bài</button>
            <button type="button" data-mobile-tab="code" class="mobile-tab">⌨️ Code &amp; Kết quả</button>
        </div>

        <!-- ── Workspace ──────────────────────────────────────────── -->
        <div id="workspace" class="flex-1 min-h-0 flex">
            <!-- LEFT: Nội dung bài học -->
            <section
                id="lesson-panel"
                class="w-full md:w-[42%] md:min-w-[300px] overflow-y-auto bg-white lesson-content-panel"
            >
                <div class="max-w-3xl mx-auto px-5 md:px-8 py-6 md:py-8">
                    <!-- Lesson header -->
                    <div class="mb-6 pb-6 border-b border-slate-100">
                        <p class="text-xs font-bold text-[#3776AB] uppercase tracking-wider mb-2">
                            {
                                currentChapterIdx >= 0
                                    ? `Chương ${currentChapterIdx + 1} · Bài ${currentLessonInChapter + 1}`
                                    : 'Bài học'
                            }
                        </p>
                        <h2
                            class="text-2xl md:text-[28px] font-extrabold text-slate-900 leading-tight tracking-tight mb-3"
                        >
                            {lesson.title}
                        </h2>
                        {lesson.description && <p class="text-slate-500 leading-relaxed mb-4">{lesson.description}</p>}
                        <div class="flex flex-wrap items-center gap-2">
                            <span
                                class={`inline-flex items-center gap-1.5 text-xs font-bold px-2.5 py-1 rounded-md border ${typeColor[lesson.lesson_type] || typeColor.practice}`}
                            >
                                <PyIcon name={lessonIconName(lesson.lesson_type)} class="w-3.5 h-3.5" />
                                {typeLabel[lesson.lesson_type] || 'Thực hành'}
                            </span>
                            <span
                                class={`text-xs font-bold px-2.5 py-1 rounded-md border ${diffColor[lesson.difficulty] || diffColor.easy}`}
                            >
                                {diffLabel[lesson.difficulty] || 'Dễ'}
                            </span>
                            <span
                                class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-md border bg-amber-50 text-amber-700 border-amber-200"
                            >
                                <PyIcon name="bolt" class="w-3.5 h-3.5" /> +{lesson.xp_reward} XP
                            </span>
                            <span
                                class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-md border bg-slate-50 text-slate-600 border-slate-200"
                            >
                                <PyIcon name="clock" class="w-3.5 h-3.5" />
                                {lesson.estimated_minutes} phút
                            </span>
                            {
                                hasTests && (
                                    <span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-md border bg-slate-50 text-slate-600 border-slate-200">
                                        <PyIcon name="check" class="w-3.5 h-3.5" /> {testCases.length} test case
                                    </span>
                                )
                            }
                        </div>
                    </div>

                    <!-- Nội dung markdown -->
                    <article class="lesson-prose">
                        <div set:html={contentHtml} />
                    </article>

                    <!-- Quiz questions (chỉ cho theory) -->
                    {
                        quizQuestions.length > 0 && (
                            <div id="quiz-section" class="mt-10">
                                <div class="rounded-2xl border border-slate-200 overflow-hidden">
                                    <div class="bg-gradient-to-r from-[#3776AB] to-[#1E4D73] px-5 py-4">
                                        <h3 class="text-white font-extrabold text-base flex items-center gap-2">
                                            <PyIcon name="quiz" class="w-5 h-5 text-[#FFD43B]" /> Kiểm tra nhanh
                                        </h3>
                                        <p id="quiz-header-title" class="text-blue-100 text-xs mt-1">
                                            📝 Đây là bài tự kiểm tra — nhấn "Hoàn thành bài" để hoàn thành
                                        </p>
                                    </div>
                                    <div class="p-5 space-y-6 bg-white" id="quiz-container">
                                        {quizQuestions.map((q, qi) => (
                                            <div class="quiz-question" data-qindex={qi} data-correct={q.correct_index}>
                                                <p class="text-sm font-bold text-slate-800 mb-3 flex items-start gap-2.5">
                                                    <span class="shrink-0 w-6 h-6 rounded-full bg-[#3776AB] text-white text-xs font-bold flex items-center justify-center">
                                                        {qi + 1}
                                                    </span>
                                                    <span class="pt-0.5">{q.question_text}</span>
                                                </p>
                                                <div class="space-y-2 ml-8">
                                                    {q.options.map((opt, oi) => (
                                                        <label
                                                            class="quiz-option flex items-start gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer transition-all duration-150 hover:border-[#3776AB]/40 hover:bg-blue-50/30"
                                                            data-optindex={oi}
                                                        >
                                                            <input
                                                                type="radio"
                                                                name={`quiz-q-${qi}`}
                                                                value={oi}
                                                                class="mt-0.5 accent-[#3776AB] shrink-0"
                                                            />
                                                            <span class="text-sm text-slate-700 leading-relaxed">
                                                                {opt}
                                                            </span>
                                                        </label>
                                                    ))}
                                                </div>
                                                <div class="quiz-feedback hidden ml-8 mt-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200" />
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        )
                    }

                    <!-- Điều hướng cuối bài -->
                    <div class="mt-10 pt-6 border-t border-slate-100 grid sm:grid-cols-2 gap-3">
                        {
                            prevLesson ? (
                                <a
                                    href={`/hoc-python/hoc/${courseSlug}/${prevLesson.slug}`}
                                    class="group p-4 rounded-xl border border-slate-200 hover:border-[#3776AB] transition-colors no-underline"
                                >
                                    <p class="text-xs font-semibold text-slate-400 mb-1">← Bài trước</p>
                                    <p class="text-sm font-bold text-slate-700 group-hover:text-[#3776AB] truncate">
                                        {prevLesson.title}
                                    </p>
                                </a>
                            ) : (
                                <div class="hidden sm:block" />
                            )
                        }
                        {
                            nextLesson ? (
                                <a
                                    id="nextLessonLink"
                                    href={`/hoc-python/hoc/${courseSlug}/${nextLesson.slug}`}
                                    class="group p-4 rounded-xl border border-slate-200 hover:border-[#3776AB] transition-colors text-right no-underline"
                                >
                                    <p class="text-xs font-semibold text-slate-400 mb-1">Bài tiếp theo →</p>
                                    <p class="text-sm font-bold text-slate-700 group-hover:text-[#3776AB] truncate">
                                        {nextLesson.title}
                                    </p>
                                </a>
                            ) : (
                                <a
                                    href={`/hoc-python/khoa-hoc/${courseSlug}`}
                                    class="group p-4 rounded-xl border border-slate-200 hover:border-[#3776AB] transition-colors text-right no-underline"
                                >
                                    <p class="text-xs font-semibold text-slate-400 mb-1">Bài cuối cùng 🎓</p>
                                    <p class="text-sm font-bold text-slate-700 group-hover:text-[#3776AB] truncate">
                                        Về trang khóa học
                                    </p>
                                </a>
                            )
                        }
                    </div>
                </div>
            </section>

            <!-- Split pane resize handle -->
            <div
                id="split-handle"
                class="hidden md:flex w-1.5 bg-slate-200 hover:bg-[#3776AB] cursor-col-resize items-center justify-center group transition-colors duration-150 shrink-0 relative"
                title="Kéo để thay đổi kích thước"
            >
                <div class="w-0.5 h-8 rounded-full bg-slate-400 group-hover:bg-white transition-colors"></div>
                <div class="absolute inset-y-0 -left-1.5 -right-1.5"></div>
            </div>

            <!-- RIGHT: Editor + Console -->
            <section id="editor-panel" class="flex-1 flex flex-col bg-[#282c34] min-w-0 relative max-md:hidden">
                <!-- Toolbar -->
                <div
                    class="flex items-center justify-between gap-2 h-11 pl-0 pr-2 bg-[#21252b] border-b border-black/30 shrink-0"
                >
                    <div class="flex items-center h-full min-w-0">
                        <span
                            class="h-full inline-flex items-center gap-2 px-4 bg-[#282c34] border-t-2 border-[#FFD43B] text-[13px] text-slate-200 font-mono"
                        >
                            <IconPython class="w-4 h-4 text-[#FFD43B]" /> main.py
                        </span>
                        <span
                            id="pyodide-loading"
                            class="hidden ml-3 items-center gap-2 text-xs text-slate-400 whitespace-nowrap"
                        >
                            <span
                                class="w-3.5 h-3.5 rounded-full border-2 border-[#61afef] border-t-transparent animate-spin"
                            ></span>
                            <span class="hidden sm:inline">Đang tải Python...</span>
                        </span>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                        <button
                            id="resetBtn"
                            type="button"
                            class="ide-btn ide-btn--ghost"
                            title="Khôi phục code ban đầu"
                        >
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path
                                    fill-rule="evenodd"
                                    d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0v-2.43l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.23-3.723a.75.75 0 0 0 .219-.53V2.929a.75.75 0 0 0-1.5 0V5.36l-.31-.31A7 7 0 0 0 3.239 8.188a.75.75 0 1 0 1.448.389A5.5 5.5 0 0 1 13.89 6.11l.311.31h-2.432a.75.75 0 0 0 0 1.5h4.243a.75.75 0 0 0 .53-.219Z"
                                    clip-rule="evenodd"></path>
                            </svg>
                            <span class="hidden xl:inline">Làm lại</span>
                        </button>
                        <button id="runBtn" type="button" class="ide-btn ide-btn--run" title="Chạy thử (Ctrl + Enter)">
                            <PyIcon name="play" class="w-3.5 h-3.5" />
                            Chạy thử
                        </button>
                        <button
                            id="submitBtn"
                            type="button"
                            class="ide-btn ide-btn--submit"
                            title={hasTests ? 'Nộp bài để chấm điểm' : 'Đánh dấu hoàn thành bài học'}
                        >
                            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path
                                    d="M3.105 2.288a.75.75 0 0 0-.826.95l1.414 4.926A1.5 1.5 0 0 0 5.135 9.25h6.115a.75.75 0 0 1 0 1.5H5.135a1.5 1.5 0 0 0-1.442 1.086l-1.414 4.926a.75.75 0 0 0 .826.95 28.897 28.897 0 0 0 15.293-7.155.75.75 0 0 0 0-1.114A28.897 28.897 0 0 0 3.105 2.288Z"
                                ></path>
                            </svg>
                            {hasTests ? 'Nộp bài' : 'Hoàn thành bài'}
                        </button>
                    </div>
                </div>

                <!-- CodeMirror container -->
                <div id="cm-editor" class="flex-1 min-h-0 overflow-hidden"></div>

                <!-- Bottom: Test case + Console -->
                <div
                    id="console-panel"
                    class="shrink-0 flex flex-col border-t border-black/40 bg-[#21252b]"
