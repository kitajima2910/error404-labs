                >
                    <div
                        id="console-resize-handle"
                        class="h-1.5 bg-[#181a1f] hover:bg-[#3776AB] cursor-row-resize group transition-colors flex items-center justify-center shrink-0"
                        title="Kéo để thay đổi kích thước"
                    >
                        <div class="w-8 h-0.5 rounded-full bg-slate-600 group-hover:bg-white transition-colors"></div>
                    </div>
                    <!-- Tab bar -->
                    <div
                        id="console-tabbar"
                        class="flex items-center justify-between gap-2 px-2 border-b border-black/30 shrink-0"
                    >
                        <div class="flex items-center">
                            <button type="button" class="result-tab" data-tab="test-results">
                                <span id="test-tab-label">Test case</span>
                            </button>
                            <button type="button" class="result-tab" data-tab="console">Console</button>
                        </div>
                        <button
                            id="customInputBtn"
                            type="button"
                            class="text-[11px] font-semibold text-slate-400 hover:text-white px-2.5 py-1 rounded-md hover:bg-white/10 transition-colors"
                            title="Thử chạy với input tùy chỉnh"
                        >
                            ⌨ Input tùy chỉnh
                        </button>
                    </div>

                    <div class="flex-1 min-h-0 relative">
                        <!-- Test results -->
                        <div
                            id="tab-test-results"
                            class="result-pane absolute inset-0 p-3 overflow-y-auto text-sm leading-relaxed"
                        >
                        </div>
                        <!-- Console output -->
                        <div
                            id="tab-console"
                            class="result-pane absolute inset-0 p-3 overflow-y-auto font-mono text-[13px] leading-relaxed hidden"
                        >
                            <div class="text-slate-500 italic">Nhấn "▶ Chạy thử" để thực thi code Python...</div>
                        </div>
                    </div>
                </div>

                <!-- Status bar -->
                <div
                    class="h-6 shrink-0 flex items-center justify-between gap-3 px-3 bg-[#3776AB] text-white/90 text-[11px] font-medium"
                >
                    <span id="runtimeStatus" class="inline-flex items-center gap-1.5 whitespace-nowrap">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-300"></span> Python 3 · đang khởi tạo
                    </span>
                    <span class="flex items-center gap-4 whitespace-nowrap overflow-hidden">
                        <span id="cursorPos">Dòng 1, Cột 1</span>
                        <span class="hidden sm:inline">UTF-8</span>
                        <span class="hidden lg:inline">Ctrl + Enter: Chạy thử</span>
                    </span>
                </div>
            </section>
        </div>
    </div>

    <!-- ── Drawer: Danh sách bài học ──────────────────────────────── -->
    <div id="lessonDrawerBackdrop" class="hidden fixed inset-0 top-26 z-[55] bg-slate-900/40 backdrop-blur-[1px]"></div>
    <aside
        id="lessonDrawer"
        class="fixed top-26 bottom-0 left-0 z-[56] w-[340px] max-w-[88vw] bg-white shadow-2xl border-r border-slate-200 flex flex-col -translate-x-full transition-transform duration-300 invisible"
        aria-label="Danh sách bài học"
    >
        <div class="px-5 py-4 border-b border-slate-100 shrink-0">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <p class="text-[11px] font-bold text-[#3776AB] uppercase tracking-wider">Nội dung khóa học</p>
                    <a
                        href={`/hoc-python/khoa-hoc/${courseSlug}`}
                        class="block font-extrabold text-slate-800 truncate hover:text-[#3776AB] no-underline"
                        >{lesson.course_title}</a
                    >
                </div>
                <button
                    id="lessonDrawerClose"
                    type="button"
                    class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-500 flex items-center justify-center shrink-0"
                    title="Đóng">✕</button
                >
            </div>
            <div id="drawerProgress" class="mt-3 hidden">
                <div class="flex justify-between text-xs mb-1">
                    <span class="text-slate-500">Tiến độ</span>
                    <span id="drawerProgressText" class="font-bold text-[#3776AB]"></span>
                </div>
                <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div
                        id="drawerProgressBar"
                        class="h-full bg-gradient-to-r from-[#3776AB] to-emerald-500 rounded-full transition-all duration-700"
                        style="width: 0%"
                    >
                    </div>
                </div>
            </div>
        </div>
        <div class="flex-1 overflow-y-auto py-2 lesson-content-panel">
            {
                chapterGroups.map((group, gi) => (
                    <div class="mb-1">
                        <p class="px-5 pt-3 pb-1.5 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                            Chương {gi + 1} · {group.title}
                        </p>
                        <ul>
                            {group.lessons.map((l, li) => (
                                <li>
                                    <a
                                        href={`/hoc-python/hoc/${courseSlug}/${l.slug}`}
                                        data-drawer-slug={l.slug}
                                        class:list={[
                                            'flex items-center gap-3 px-5 py-2.5 text-sm no-underline transition-colors border-l-[3px]',
                                            l.slug === lessonSlug
                                                ? 'bg-[#3776AB]/[0.07] border-[#3776AB] text-[#3776AB] font-bold'
                                                : 'border-transparent text-slate-600 hover:bg-slate-50 hover:text-slate-900',
                                        ]}
                                        aria-current={l.slug === lessonSlug ? 'page' : undefined}
                                    >
                                        <span class="drawer-status w-6 h-6 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center shrink-0">
                                            <PyIcon name={lessonIconName(l.lesson_type)} class="w-3.5 h-3.5" />
                                        </span>
                                        <span class="flex-1 min-w-0 truncate">
                                            <span class="text-slate-400 font-medium">
                                                {gi + 1}.{li + 1}
                                            </span>{' '}
                                            {l.title}
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </aside>

    <!-- Custom input overlay (hidden by default) -->
    <div id="custom-input-overlay" class="hidden fixed inset-0 bg-slate-900/60 z-[70] items-center justify-center p-4">
        <div class="bg-white rounded-2xl p-6 max-w-md shadow-2xl w-full">
            <h3 class="text-slate-900 font-extrabold text-lg mb-1">Chạy với input tùy chỉnh</h3>
            <p class="text-sm text-slate-500 mb-4">
                Nhập dữ liệu đầu vào (stdin), mỗi giá trị <code class="text-[#3776AB] font-mono">input()</code> trên một dòng.
            </p>
            <textarea
                id="custom-input-text"
                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-slate-800 font-mono text-sm resize-none focus:outline-none focus:border-[#3776AB] focus:ring-4 focus:ring-[#3776AB]/10 transition"
                rows="5"
                placeholder="Ví dụ:
3
5"></textarea>
            <div class="flex justify-end gap-3 mt-4">
                <button
                    id="custom-input-cancel"
                    type="button"
                    class="text-sm font-semibold text-slate-600 hover:text-slate-900 px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 transition-colors"
                    >Hủy</button
                >
                <button
                    id="custom-input-run"
                    type="button"
                    class="text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-500 px-4 py-2 rounded-lg transition-colors"
                    >▶ Chạy</button
                >
            </div>
        </div>
    </div>

    <!-- Modal hoàn thành bài học -->
    <div id="successModal" class="hidden fixed inset-0 bg-slate-900/60 z-[70] items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-sm w-full shadow-2xl overflow-hidden text-center py-success-pop">
            <div class="relative bg-gradient-to-br from-emerald-500 to-teal-600 px-6 pt-8 pb-10">
                <div
                    class="w-20 h-20 mx-auto rounded-full bg-white/20 flex items-center justify-center ring-8 ring-white/10"
                >
                    <PyIcon name="check" class="w-11 h-11 text-white" />
                </div>
            </div>
            <div class="relative px-6 pb-6 -mt-5">
                <span
                    id="successXp"
                    class="inline-flex items-center gap-1.5 bg-[#FFD43B] text-[#0B1E33] font-extrabold text-sm px-4 py-1.5 rounded-full shadow-md"
                    >⚡ +0 XP</span
                >
                <h3 class="text-xl font-extrabold text-slate-900 mt-4">Chúc mừng! 🎉</h3>
                <p id="successText" class="text-sm text-slate-500 mt-1.5">Bạn đã hoàn thành bài học này.</p>
                <p
                    id="successAchievements"
                    class="hidden text-sm font-semibold text-amber-700 bg-amber-50 border border-amber-200 rounded-xl px-3 py-2 mt-3"
                >
                </p>
                <div class="flex gap-3 mt-6">
                    <button
                        id="successStay"
                        type="button"
                        class="flex-1 text-sm font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 px-4 py-3 rounded-xl transition-colors"
                        >Ở lại</button
                    >
                    <a
                        id="successNext"
                        href={nextLesson
                            ? `/hoc-python/hoc/${courseSlug}/${nextLesson.slug}`
                            : `/hoc-python/khoa-hoc/${courseSlug}`}
                        class="flex-1 text-sm font-bold text-white bg-[#3776AB] hover:bg-[#2B5E8A] px-4 py-3 rounded-xl transition-colors no-underline"
                    >
                        {nextLesson ? 'Bài tiếp theo →' : 'Về khóa học'}
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Data attributes cho JS -->
    <div
        id="lesson-data"
        data-starter-code={starterCodeJson}
        data-test-cases={testCasesJson}
        data-lesson-id={lessonIdJson}
        data-course-slug={courseSlug}
        data-comparison-mode={comparisonMode}
        data-float-epsilon={floatEpsilon}
        data-xp-reward={xpReward}
        data-is-theory={isTheory ? 'true' : 'false'}
        data-has-tests={hasTests ? 'true' : 'false'}
        data-prev-lesson={prevLessonJson}
        data-next-lesson={nextLessonJson}
        data-quiz-questions={quizQuestionsJson}
    >
    </div>
</MainLayout>

<script>
    if (!localStorage.getItem('auth_token')) {
        window.location.href = '/?login=true'
    }
</script>
<script>
    // ─────────────────────────────────────────────────────────────────────
    // Client-side logic: CodeMirror 6 + Pyodide + Run/Submit
    // ─────────────────────────────────────────────────────────────────────

    // DOM refs — dùng JSON.parse để giữ nguyên newlines
    const lessonData = document.getElementById('lesson-data')
    const starterCode = JSON.parse(lessonData?.dataset.starterCode || '"# Viết code Python của bạn ở đây\\n"')
    const testCases = JSON.parse(lessonData?.dataset.testCases || '[]')
    const publicTests = testCases.filter(function (tc) {
        return !tc.is_hidden
    })
    const hiddenTests = testCases.filter(function (tc) {
        return tc.is_hidden
    })
    const lessonId = JSON.parse(lessonData?.dataset.lessonId || '""')
    const courseSlug = lessonData?.dataset.courseSlug || ''
    const prevLesson = JSON.parse(lessonData?.dataset.prevLesson || 'null')
    const nextLesson = JSON.parse(lessonData?.dataset.nextLesson || 'null')
    const quizQuestions = JSON.parse(lessonData?.dataset.quizQuestions || '[]')
    const cmContainer = document.getElementById('cm-editor')
    const consoleEl = document.getElementById('tab-console')
    const testResultsEl = document.getElementById('tab-test-results')
    const loadingEl = document.getElementById('pyodide-loading')
    const runBtn = document.getElementById('runBtn')
    const submitBtn = document.getElementById('submitBtn')
    const resetBtn = document.getElementById('resetBtn')
    const nextLessonBtn = document.getElementById('nextLessonBtn')
    const customInputBtn = document.getElementById('customInputBtn')
    const runtimeStatusEl = document.getElementById('runtimeStatus')
    const cursorPosEl = document.getElementById('cursorPos')
    const draftKey = 'py_draft_' + lessonId

    // State
    let editorView = null
    let pyodide = null
    let lessonCompleted = false
    let isBusy = false
    let selectedTestIdx = -1
    let draftTimer = null

    // ── Helper: normalize output (match server-side) ────────────────
    function normalizeOutput(str) {
        return (str || '')
            .replace(/\r\n/g, '\n')
            .split('\n')
            .map((line) => line.replace(/\s+$/, ''))
            .join('\n')
            .trim()
            .replace(/\n{3,}/g, '\n\n')
    }

    function compareClientOutputs(actual, expected, mode, epsilon) {
        var normActual = normalizeOutput(actual)
        var normExpected = normalizeOutput(expected)
        if (mode === 'float') {
            var a = parseFloat(normActual)
            var b = parseFloat(normExpected)
            return !isNaN(a) && !isNaN(b) && Math.abs(a - b) < (epsilon || 0.001)
        }
        if (mode === 'contains') {
            return normActual.indexOf(normExpected) !== -1
        }
        return normActual === normExpected
    }

    // ── Helper: HTML-escape ──────────────────────────────────────────
    function escapeHtml(str) {
        if (typeof str !== 'string') return str
        var div = document.createElement('div')
        div.textContent = str
        return div.innerHTML
    }

    // ── Completion tracking ──────────────────────────────────────────
    function markLessonCompleted() {
        lessonCompleted = true
        try {
            var completed = JSON.parse(localStorage.getItem('py_completed') || '{}')
            completed[lessonId] = true
            localStorage.setItem('py_completed', JSON.stringify(completed))
        } catch {}
        updateNextButtonState()
    }

    function isLessonCompleted() {
        if (lessonCompleted) return true
        try {
            var completed = JSON.parse(localStorage.getItem('py_completed') || '{}')
            if (completed[lessonId]) {
                lessonCompleted = true
                return true
            }
        } catch {}
        return false
    }

    function updateNextButtonState() {
        if (!nextLessonBtn || !nextLesson) return
        nextLessonBtn.className = 'py-next-btn ' + (isLessonCompleted() ? 'py-next-btn--ready' : 'py-next-btn--pending')
    }

    // ── Skip Warning Modal ───────────────────────────────────────────
    function showSkipWarning() {
        var overlay = document.createElement('div')
        overlay.id = 'skipModal'
        overlay.className = 'fixed inset-0 bg-slate-900/60 z-[70] flex items-center justify-center p-4'
        overlay.innerHTML =
            '<div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl">' +
            '<div class="w-12 h-12 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-2xl mb-4">⚠️</div>' +
            '<h3 class="text-slate-900 font-extrabold text-lg mb-2">Chưa hoàn thành!</h3>' +
            '<p class="text-slate-500 text-sm leading-relaxed mb-6">Bạn chưa hoàn thành bài học này. ' +
            'Có thể bạn sẽ bỏ lỡ kiến thức quan trọng nếu bỏ qua. Vẫn muốn tiếp tục?</p>' +
            '<div class="flex gap-3 justify-end">' +
            '<button class="skip-cancel text-sm font-semibold text-slate-600 hover:text-slate-900 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 transition-colors">Ở lại học tiếp</button>' +
            '<button class="skip-confirm text-sm font-bold text-white bg-amber-500 hover:bg-amber-600 px-4 py-2.5 rounded-xl transition-colors">Bỏ qua</button>' +
            '</div></div>'
        document.body.appendChild(overlay)

        overlay.querySelector('.skip-cancel').addEventListener('click', function () {
            overlay.remove()
        })
        overlay.querySelector('.skip-confirm').addEventListener('click', function () {
            if (nextLesson) window.location.href = '/hoc-python/hoc/' + courseSlug + '/' + nextLesson.slug
        })
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) overlay.remove()
        })
    }

    function goToNextLesson() {
        if (!nextLesson) return
        if (isLessonCompleted()) {
            window.location.href = '/hoc-python/hoc/' + courseSlug + '/' + nextLesson.slug
        } else {
            showSkipWarning()
        }
    }

    // ── Success modal ────────────────────────────────────────────────
    function showSuccessModal(xpAwarded, achievements, detail) {
        var modal = document.getElementById('successModal')
        if (!modal) return
        var xpEl = document.getElementById('successXp')
        var textEl = document.getElementById('successText')
        var achEl = document.getElementById('successAchievements')
        if (xpEl) xpEl.textContent = xpAwarded > 0 ? '⚡ +' + xpAwarded + ' XP' : '✓ Đã hoàn thành'
        if (textEl) textEl.textContent = detail || 'Bạn đã hoàn thành bài học này.'
        if (achEl) {
            if (achievements && achievements.length > 0) {
                achEl.textContent = '🏅 Mở khoá thành tích: ' + achievements.join(', ')
                achEl.classList.remove('hidden')
            } else {
                achEl.classList.add('hidden')
            }
        }
        modal.classList.remove('hidden')
        modal.classList.add('flex')
    }

    function hideSuccessModal() {
        var modal = document.getElementById('successModal')
        if (!modal) return
        modal.classList.add('hidden')
        modal.classList.remove('flex')
    }

    // ── Runtime status (status bar) ──────────────────────────────────
    function setRuntimeStatus(state, text) {
        if (!runtimeStatusEl) return
        var color = state === 'ready' ? 'bg-emerald-300' : state === 'error' ? 'bg-rose-300' : 'bg-amber-300'
        runtimeStatusEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full ' + color + '"></span> ' + escapeHtml(text)
    }

    function setBusy(busy) {
        isBusy = busy
        ;[
            runBtn,
            submitBtn,
        ].forEach(function (btn) {
            if (!btn) return
            btn.disabled = busy
            btn.classList.toggle('opacity-60', busy)
            btn.classList.toggle('cursor-wait', busy)
        })
    }

    // ── Draft (tự lưu code vào localStorage) ─────────────────────────
    function loadDraft() {
        try {
            return localStorage.getItem(draftKey)
        } catch {
            return null
        }
    }

    function saveDraft(code) {
        try {
            if (code === starterCode) localStorage.removeItem(draftKey)
            else localStorage.setItem(draftKey, code)
        } catch {}
    }

    // ── CodeMirror 6 (singleton cache) ──────────────────────────────
    async function initEditor() {
        if (editorView) return
        if (cmContainer) cmContainer.innerHTML = ''

        var cmModules
        if (window.__cmModules) {
            cmModules = window.__cmModules
        } else {
            var [
                cm,
                state,
                lang,
                theme,
                view,
                commands,
            ] = await Promise.all([
                import('codemirror'),
                import('@codemirror/state'),
                import('@codemirror/lang-python'),
                import('@codemirror/theme-one-dark'),
                import('@codemirror/view'),
                import('@codemirror/commands'),
            ])
            cmModules = {
                EditorView: cm.EditorView,
                basicSetup: cm.basicSetup,
                EditorState: state.EditorState,
                python: lang.python,
                oneDark: theme.oneDark,
                keymap: view.keymap,
                indentWithTab: commands.indentWithTab,
            }
            window.__cmModules = cmModules
        }

        var draft = loadDraft()
        var state = cmModules.EditorState.create({
            doc: draft !== null ? draft : starterCode,
            extensions: [
                cmModules.basicSetup,
                cmModules.keymap.of([cmModules.indentWithTab]),
                cmModules.python(),
                cmModules.oneDark,
                cmModules.EditorView.theme({
                    '&': { height: '100%' },
                    '.cm-scroller': { overflow: 'auto' },
                }),
                cmModules.EditorView.lineWrapping,
                cmModules.EditorView.updateListener.of(function (update) {
                    if (update.selectionSet || update.docChanged) {
                        var pos = update.state.selection.main.head
                        var line = update.state.doc.lineAt(pos)
                        if (cursorPosEl)
                            cursorPosEl.textContent = 'Dòng ' + line.number + ', Cột ' + (pos - line.from + 1)
                    }
                    if (update.docChanged) {
                        clearTimeout(draftTimer)
                        draftTimer = setTimeout(function () {
                            saveDraft(update.state.doc.toString())
                        }, 400)
                    }
                }),
            ],
        })

        if (cmContainer) {
            editorView = new cmModules.EditorView({ state, parent: cmContainer })
        }
        if (draft !== null && draft !== starterCode) {
            appendConsole('💾 Đã khôi phục bản nháp lần trước. Nhấn "Làm lại" để về code ban đầu.')
        }
    }

    // ── Pyodide (singleton cache — avoid reload on SPA navigation) ──
    var pyodideInitPromise = null
    async function initPyodide() {
        if (pyodide) return true
        if (pyodideInitPromise) return pyodideInitPromise
        if (loadingEl) {
            loadingEl.classList.remove('hidden')
            loadingEl.classList.add('inline-flex')
        }
        setRuntimeStatus('loading', 'Python 3 · đang tải runtime...')

        pyodideInitPromise = (async function () {
            try {
                if (!window.__pyodide) {
                    const script = document.createElement('script')
                    script.src = 'https://cdn.jsdelivr.net/npm/pyodide@0.27.3/pyodide.js'
                    await new Promise(function (resolve, reject) {
                        script.onload = resolve
                        script.onerror = function () {
                            reject(new Error('Không thể tải Pyodide từ CDN'))
                        }
                        document.head.appendChild(script)
                    })
                    window.__pyodide = await globalThis.loadPyodide({
                        indexURL: 'https://cdn.jsdelivr.net/npm/pyodide@0.27.3/',
                    })
                }
                pyodide = window.__pyodide
                if (loadingEl) {
                    loadingEl.classList.add('hidden')
                    loadingEl.classList.remove('inline-flex')
                }
                setRuntimeStatus('ready', 'Python ' + pyodide.version + ' · sẵn sàng')
                appendConsole('✅ Python runtime đã sẵn sàng! (Python ' + pyodide.version + ')')
                return true
            } catch (err) {
                if (loadingEl) {
                    loadingEl.classList.add('hidden')
                    loadingEl.classList.remove('inline-flex')
                }
                setRuntimeStatus('error', 'Không tải được Python runtime')
                appendConsole('❌ Lỗi tải Pyodide: ' + err.message, 'error')
                console.error('Pyodide init error:', err)
                pyodideInitPromise = null
                return false
            }
        })()
        return pyodideInitPromise
    }

    // ── Console helpers ──────────────────────────────────────────────
    function appendConsole(text, type) {
        if (!consoleEl) return
        var line = document.createElement('div')
        line.className =
            'py-0.5 whitespace-pre-wrap break-words ' +
            (type === 'error'
                ? 'text-[#e06c75]'
                : type === 'success'
                  ? 'text-[#98c379]'
                  : type === 'output'
                    ? 'text-slate-100'
                    : 'text-slate-400')
        line.textContent = text
        consoleEl.appendChild(line)
        consoleEl.scrollTop = consoleEl.scrollHeight
    }

    function clearConsole() {
        if (consoleEl) consoleEl.innerHTML = ''
    }

    // ── Run Python helper ───────────────────────────────────────────
    async function runPythonWithStdin(code, stdin) {
        return await pyodide.runPythonAsync(
            'import sys\nfrom io import StringIO\n' +
                'sys.stdin = StringIO(' +
                JSON.stringify(stdin || '') +
                ')\n' +
                '_out = StringIO()\nsys.stdout = _out\n' +
                'try:\n    _ = 0\n' +
                code
                    .split('\n')
                    .map(function (line) {
                        return '    ' + line
                    })
                    .join('\n') +
                '\n' +
                'except Exception:\n    import traceback\n    traceback.print_exc()\n' +
                'sys.stdout = sys.__stdout__\n_out.getvalue()',
        )
    }

    async function ensureReady() {
        if (!pyodide || !editorView) {
            appendConsole('⚠️ Python runtime chưa sẵn sàng. Vui lòng đợi...', 'error')
            if (!pyodide) await initPyodide()
            if (!pyodide || !editorView) return false
        }
        return true
    }

    // ── Run code — chạy public test cases ────────────────────────────
    async function runCode() {
        if (isBusy) return
        showCodeOnMobile()
        if (!(await ensureReady())) return
        setBusy(true)
        try {
            var code = editorView.state.doc.toString()

            if (publicTests.length === 0) {
                clearConsole()
                switchTab('console')
                appendConsole('▶ Đang chạy...')
                try {
                    var result = await runPythonWithStdin(code, '')
                    var output = (result || '').trim()
                    if (output) {
                        output.split('\n').forEach(function (line) {
                            appendConsole(line, 'output')
                        })
                    } else {
                        appendConsole('✅ Code chạy thành công (không có output)', 'success')
                    }
                } catch (err) {
                    appendConsole('❌ Lỗi: ' + (err.message || String(err)), 'error')
                }
                return
            }

            clearConsole()
            appendConsole('▶ Đang chạy ' + publicTests.length + ' test case mẫu...')
            switchTab('test-results')
            selectedTestIdx = -1
            showTestResults([], 0, publicTests.length, true)

            var passed = 0
            var results = []

            for (var i = 0; i < publicTests.length; i++) {
                var tc = publicTests[i]
                var testLabel = 'Test ' + (i + 1)

                try {
                    var output = await runPythonWithStdin(code, tc.stdin)
                    var actualOutput = (output || '').trim()
                    var expected = tc.expected_output.trim()
                    var compMode = lessonData?.dataset.comparisonMode || 'exact'
                    var epsilon = parseFloat(lessonData?.dataset.floatEpsilon || '0.001')
                    var match = compareClientOutputs(actualOutput, expected, compMode, epsilon)

                    if (match) {
                        passed++
                        results.push({
                            index: i,
                            passed: true,
                            label: testLabel,
                            stdin: tc.stdin,
                            expected: expected,
                            actual: actualOutput,
                        })
                    } else {
                        results.push({
                            index: i,
                            passed: false,
                            label: testLabel,
                            stdin: tc.stdin,
                            expected: expected,
                            actual: actualOutput,
                        })
                    }
                } catch (err) {
                    results.push({
                        index: i,
                        passed: false,
                        label: testLabel,
                        stdin: tc.stdin,
                        expected: tc.expected_output,
                        error: err.message || String(err),
                    })
                }
                showTestResults(results, passed, publicTests.length)
            }

            showTestResults(results, passed, publicTests.length)

            if (passed === publicTests.length) {
                appendConsole(
                    '✅ ' +
                        passed +
                        '/' +
                        publicTests.length +
                        ' test case mẫu đúng! Hãy nhấn "Nộp bài" để chấm cả test ẩn.',
                    'success',
                )
            } else {
                appendConsole(
                    '📊 ' + passed + '/' + publicTests.length + ' test case đúng — sửa code rồi chạy lại.',
                    'info',
                )
            }
        } finally {
            setBusy(false)
        }
    }

    // ── Run with custom input ───────────────────────────────────────
    async function runWithCustomInput(stdin) {
        if (isBusy) return
        if (!(await ensureReady())) return
        setBusy(true)
        var code = editorView.state.doc.toString()
        clearConsole()
        switchTab('console')
        appendConsole('▶ Đang chạy với input tùy chỉnh...')
        try {
            var result = await runPythonWithStdin(code, stdin)
            var output = (result || '').trim()
            if (output) {
                output.split('\n').forEach(function (line) {
                    appendConsole(line, 'output')
                })
            } else {
                appendConsole('✅ Code chạy thành công (không có output)', 'success')
            }
        } catch (err) {
            appendConsole('❌ Lỗi: ' + (err.message || String(err)), 'error')
        } finally {
            setBusy(false)
        }
    }

    // ── Submit (chạy test cases) ─────────────────────────────────────
    async function submitCode() {
        if (isBusy) return
        showCodeOnMobile()
        if (!(await ensureReady())) {
            switchTab('console')
            return
        }
        setBusy(true)
        try {
            await submitCodeInner()
        } finally {
            setBusy(false)
        }
    }

    async function submitCodeInner() {
        var code = editorView.state.doc.toString()

        if (testCases.length === 0) {
            clearConsole()
            switchTab('console')
            appendConsole('📤 Đang đánh dấu bài học...')
            try {
                var token = localStorage.getItem('auth_token')
                if (!token) {
                    appendConsole('⚠️ Vui lòng đăng nhập để lưu tiến độ.', 'error')
                    return
                }
                var res = await fetch('/api/hoc-python/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
                    body: JSON.stringify({ lessonId: lessonId, sourceCode: code, outputs: [] }),
                })
                var data = await res.json()
                if (data.passed !== false) {
                    appendConsole('✅ Đã đánh dấu bài học là hoàn thành! +' + (data.xpAwarded || 0) + ' XP', 'success')
                    var quizCorrect = 0
                    var quizTotal = quizQuestions.length
                    var quizText = ''
                    if (quizTotal > 0) {
                        document.querySelectorAll('.quiz-question').forEach(function (qEl) {
                            var correctIdx = parseInt(qEl.dataset.correct || '0')
                            var correctRadio = qEl.querySelector('input[type="radio"][value="' + correctIdx + '"]')
                            if (correctRadio && correctRadio.checked) quizCorrect++
                        })
                        if (quizCorrect === quizTotal) {
                            appendConsole(
                                '🎯 Trắc nghiệm: ' + quizCorrect + '/' + quizTotal + ' — xuất sắc!',
                                'success',
                            )
                        } else {
                            appendConsole('📊 Trắc nghiệm: ' + quizCorrect + '/' + quizTotal + ' câu đúng', 'info')
                        }
                        quizText = 'Trắc nghiệm: ' + quizCorrect + '/' + quizTotal + ' câu đúng.'
                    }
                    if (data.newAchievements && data.newAchievements.length > 0) {
                        appendConsole('🏅 Mở khoá thành tích: ' + data.newAchievements.join(', '), 'success')
                    }
                    markLessonCompleted()
                    loadCourseProgress()
                    showSuccessModal(
                        data.xpAwarded || 0,
                        data.newAchievements,
                        quizText || 'Bạn đã hoàn thành bài học lý thuyết này.',
                    )
                } else {
                    appendConsole('⚠️ ' + (data.error || 'Lỗi không xác định'), 'error')
                }
            } catch (err) {
                appendConsole('❌ Lỗi kết nối: ' + err.message, 'error')
            }
            return
        }

        clearConsole()
        var totalTests = testCases.length
        var hiddenCount = hiddenTests.length
        appendConsole('📤 Đang nộp bài và chạy ' + totalTests + ' test case (trong đó ' + hiddenCount + ' ẩn)...')

        switchTab('test-results')
        selectedTestIdx = -1
        showTestResults([], 0, totalTests, true)

        var passed = 0
        var results = []
        var outputs = []

        for (var i = 0; i < testCases.length; i++) {
            var tc = testCases[i]
            var testLabel = 'Test ' + (i + 1)

            try {
                var output = await runPythonWithStdin(code, tc.stdin)
                var actualOutput = (output || '').trim()
                outputs.push(actualOutput)

                if (tc.is_hidden) {
                    // Hidden test: chỉ chạy để lấy output, KHÔNG chấm trên client (không có đáp án) — server chấm
                    results.push({ index: i, pending: true, hidden: true, label: testLabel })
                } else {
                    var expected = tc.expected_output.trim()
                    var compMode = lessonData?.dataset.comparisonMode || 'exact'
                    var epsilon = parseFloat(lessonData?.dataset.floatEpsilon || '0.001')
                    var match = compareClientOutputs(actualOutput, expected, compMode, epsilon)

                    if (match) {
                        passed++
                        results.push({
                            index: i,
                            passed: true,
                            label: testLabel,
                            stdin: tc.stdin,
                            expected: expected,
                            actual: actualOutput,
                        })
                    } else {
                        results.push({
                            index: i,
                            passed: false,
                            label: testLabel,
                            stdin: tc.stdin,
                            expected: expected,
                            actual: actualOutput,
                        })
                    }
                }
            } catch (err) {
                outputs.push('')
                results.push({
                    index: i,
                    passed: false,
                    hidden: !!tc.is_hidden,
                    label: testLabel,
                    stdin: tc.is_hidden ? undefined : tc.stdin,
                    error: err.message || String(err),
                })
            }
            showTestResults(results, passed, testCases.length)
        }

        // Gửi output lên server để chấm (kể cả hidden tests) — kết quả chính thức từ server
        var token = localStorage.getItem('auth_token')
        var data = null
        try {
            var res = await fetch('/api/hoc-python/submit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token ? { Authorization: 'Bearer ' + token } : {}),
                },
                body: JSON.stringify({ lessonId: lessonId, sourceCode: code, outputs: outputs }),
            })
            data = await res.json()

            if (res.status === 401 && data.error === 'Unauthorized') {
                localStorage.removeItem('auth_token')
                window.location.href = '/?login=true'
                return
            }
        } catch (err) {
            appendConsole('❌ Lỗi kết nối: ' + (err.message || String(err)), 'error')
        }

        if (data && Array.isArray(data.results)) {
            // Hiển thị kết quả chính thức — hidden test không lộ expected/actual
            var serverResults = data.results.map(function (r, idx) {
                var tc = testCases[idx]
                var label = 'Test ' + (idx + 1)
                var obj = { index: idx, passed: !!r.passed, label: label, hidden: !!(tc && tc.is_hidden) }
                if (r.error) obj.error = r.error
                if (!tc || !tc.is_hidden) {
                    if (tc) obj.stdin = tc.stdin
                    if (r.expected !== undefined) obj.expected = r.expected
                    if (r.actual !== undefined) obj.actual = r.actual
                }
                return obj
            })
            var serverPassed = serverResults.filter(function (r) {
                return r.passed
            }).length
            selectedTestIdx = -1
            showTestResults(serverResults, serverPassed, testCases.length)

            if (data.passed) {
                appendConsole(
                    '🎉 Hoàn thành ' +
                        serverPassed +
                        '/' +
                        testCases.length +
                        ' test case (gồm ' +
                        hiddenCount +
                        ' ẩn)!',
                    'success',
                )
                markLessonCompleted()
                loadCourseProgress()
            } else {
                appendConsole('📊 Kết quả: ' + serverPassed + '/' + testCases.length + ' test case đúng', 'info')
            }
            if (data.xpAwarded > 0) appendConsole('🏆 Đã nhận +' + data.xpAwarded + ' XP!', 'success')
            if (data.newAchievements && data.newAchievements.length > 0)
                appendConsole('🏅 Mở khoá thành tích: ' + data.newAchievements.join(', '), 'success')
            if (data.error) appendConsole('⚠️ ' + data.error, 'error')
            if (data.passed) {
                showSuccessModal(
                    data.xpAwarded || 0,
                    data.newAchievements,
                    'Bài làm đúng ' +
                        serverPassed +
                        '/' +
                        testCases.length +
                        ' test case' +
                        (hiddenCount ? ' (gồm ' + hiddenCount + ' test ẩn).' : '.'),
                )
            }
        } else if (data && data.error) {
            appendConsole('⚠️ ' + data.error, 'error')
            switchTab('console')
        }
    }

    // ── Test results UI (kiểu CodeLearn: danh sách test + chi tiết) ─
    var lastTestView = { results: [], passed: 0, total: 0 }

    function testPreviewItems() {
        // Trạng thái ban đầu: liệt kê test case, chưa chạy
        return testCases.map(function (tc, idx) {
            return tc.is_hidden
                ? { index: idx, notRun: true, hidden: true, label: 'Test ' + (idx + 1) }
                : {
                      index: idx,
                      notRun: true,
                      label: 'Test ' + (idx + 1),
                      stdin: tc.stdin,
                      expected: (tc.expected_output || '').trim(),
                  }
        })
    }

    function ioBlock(title, value, tone) {
        var empty = value === undefined || value === null || value === ''
        return (
            '<div class="min-w-0">' +
            '<p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">' +
            title +
            '</p>' +
            '<pre class="io-box io-box--' +
            (tone || 'plain') +
            '">' +
            (empty ? '<span class="text-slate-600 italic">(trống)</span>' : escapeHtml(value)) +
            '</pre></div>'
        )
    }

    function renderTestDetail(r) {
        if (!r) return ''
        if (r.hidden) {
            var status = r.notRun ? 'Chưa chạy' : r.pending ? 'Đang chờ server chấm...' : r.passed ? 'Đúng' : 'Sai'
            return (
                '<div class="flex items-start gap-3 rounded-lg bg-white/5 border border-white/10 p-3">' +
                '<span class="text-lg">🔒</span><div><p class="text-slate-200 text-sm font-semibold">Test case ẩn — ' +
                status +
                '</p>' +
                '<p class="text-slate-500 text-xs mt-0.5">Input và output của test ẩn được giấu để đảm bảo tính công bằng khi chấm bài.</p>' +
                (r.error && !r.passed
                    ? '<p class="text-[#e06c75] text-xs mt-1 font-mono">Lỗi: ' + escapeHtml(r.error) + '</p>'
                    : '') +
                '</div></div>'
            )
        }
        var html =
            '<div class="grid gap-3 ' +
            (r.notRun ? 'sm:grid-cols-2' : 'sm:grid-cols-3') +
            '">' +
            ioBlock('Input', r.stdin, 'plain') +
            ioBlock('Output mong muốn', r.expected, 'plain')
        if (!r.notRun) {
            html += ioBlock('Output của bạn', r.error ? '' : r.actual, r.passed ? 'pass' : 'fail')
        }
        html += '</div>'
        if (r.error) {
            html += '<pre class="io-box io-box--fail mt-3">Lỗi: ' + escapeHtml(r.error) + '</pre>'
        }
        if (!r.notRun && !r.passed && r.expected !== undefined && r.actual !== undefined && !r.error) {
            var linesExpected = String(r.expected).split('\n')
            var linesActual = String(r.actual).split('\n')
            var diffHtml = ''
            var maxLines = Math.max(linesExpected.length, linesActual.length)
            for (var d = 0; d < Math.min(maxLines, 8); d++) {
                var eLine = linesExpected[d] || ''
                var aLine = linesActual[d] || ''
                if (eLine !== aLine) {
                    diffHtml +=
                        '<div class="text-[#e06c75]">- ' +
                        escapeHtml(eLine || '(trống)') +
                        '</div>' +
                        '<div class="text-[#98c379]">+ ' +
                        escapeHtml(aLine || '(trống)') +
                        '</div>'
                } else {
                    diffHtml += '<div class="text-slate-500">  ' + escapeHtml(eLine) + '</div>'
                }
            }
            if (diffHtml) {
                html +=
                    '<details class="mt-3"><summary class="text-slate-400 hover:text-slate-200 cursor-pointer text-xs font-semibold">So sánh từng dòng (- mong muốn, + của bạn)</summary>' +
                    '<pre class="io-box io-box--plain mt-2">' +
                    diffHtml +
                    '</pre></details>'
            }
        }
        return html
    }

    function showTestResults(results, passed, total, loading) {
        if (!testResultsEl) return

        var label = document.getElementById('test-tab-label')

        if (loading) {
            if (label) label.innerHTML = 'Test case <span class="tab-badge">…</span>'
            testResultsEl.innerHTML =
                '<div class="flex items-center gap-3 text-slate-400 py-6 justify-center">' +
                '<span class="w-5 h-5 rounded-full border-2 border-[#61afef] border-t-transparent animate-spin"></span>' +
                'Đang chạy test case...</div>'
            return
        }

        lastTestView = { results: results, passed: passed, total: total }
        var notRun =
            results.length > 0 &&
            results.every(function (r) {
                return r.notRun
            })
        var anyPending = results.some(function (r) {
            return r.pending
        })
        var allPassed = total > 0 && passed === total && !anyPending

        if (label) {
            label.innerHTML =
                notRun || results.length === 0
                    ? 'Test case'
                    : 'Test case <span class="tab-badge ' +
                      (allPassed ? 'tab-badge--pass' : 'tab-badge--fail') +
                      '">' +
                      passed +
                      '/' +
                      total +
                      '</span>'
        }

        if (results.length === 0) {
            testResultsEl.innerHTML =
                '<div class="text-slate-500 italic py-2">Bài học này không có test case. Nhấn "▶ Chạy thử" để chạy code.</div>'
            return
        }

        // Chọn test hiển thị chi tiết: giữ lựa chọn cũ, mặc định test sai đầu tiên
        if (selectedTestIdx < 0 || selectedTestIdx >= results.length) {
            var firstFail = results.findIndex(function (r) {
                return !r.notRun && !r.pending && !r.passed
            })
            selectedTestIdx = firstFail >= 0 ? firstFail : 0
        }

        var html = ''
        if (notRun) {
            html +=
                '<div class="flex items-center gap-2 mb-3 text-sm"><span class="font-bold text-slate-200">' +
                total +
                ' test case</span>' +
                '<span class="hidden sm:inline text-slate-500">· ' +
                (publicTests.length
                    ? 'nhấn "▶ Chạy thử" để kiểm tra với test mẫu, "Nộp bài" để chấm toàn bộ'
                    : 'nhấn "Nộp bài" để chấm') +
                '</span></div>'
        } else {
            var pct = total > 0 ? Math.round((passed / total) * 100) : 0
            html +=
                '<div class="flex items-center gap-3 mb-3">' +
                '<span class="text-sm font-extrabold ' +
                (allPassed ? 'text-[#98c379]' : anyPending ? 'text-slate-300' : 'text-[#e5c07b]') +
                '">' +
                (allPassed ? '✓ Chính xác' : anyPending ? 'Đang chấm...' : '✗ Chưa đúng') +
                '</span>' +
                '<span class="text-sm text-slate-300">' +
                passed +
                '/' +
                total +
                ' test case</span>' +
                '<div class="flex-1 max-w-48 h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full rounded-full ' +
                (allPassed ? 'bg-[#98c379]' : 'bg-[#e5c07b]') +
                '" style="width:' +
                pct +
                '%"></div></div></div>'
        }

        html += '<div class="flex flex-wrap gap-1.5 mb-3">'
        results.forEach(function (r, idx) {
            var state = r.notRun ? 'idle' : r.pending ? 'pending' : r.passed ? 'pass' : 'fail'
            var icon = state === 'pass' ? '✓' : state === 'fail' ? '✗' : state === 'pending' ? '…' : '•'
            html +=
                '<button type="button" class="tc-chip tc-chip--' +
                state +
                (idx === selectedTestIdx ? ' is-selected' : '') +
                '" data-test-idx="' +
                idx +
                '">' +
                '<span>' +
                icon +
                '</span>' +
                escapeHtml(r.label) +
                (r.hidden ? ' 🔒' : '') +
                '</button>'
        })
        html += '</div>'

        html += '<div class="tc-detail">' + renderTestDetail(results[selectedTestIdx]) + '</div>'

        if (allPassed && !nextLesson) {
            html +=
                '<div class="mt-4 pt-3 border-t border-white/10">' +
                '<div class="text-sm text-[#98c379] font-semibold">🎉 Chúc mừng! Bạn đã hoàn thành khóa học!</div>' +
                '<a href="/hoc-python/khoa-hoc/' +
                courseSlug +
                '" class="mt-1 inline-flex items-center gap-2 text-sm font-medium text-slate-400 hover:text-white transition-colors">← Về trang khóa học</a></div>'
        }

        testResultsEl.innerHTML = html
    }

    // ── Tab switching ────────────────────────────────────────────────
    function switchTab(tabId) {
        document.querySelectorAll('.result-tab').forEach(function (t) {
            t.classList.toggle('active', t.dataset.tab === tabId)
        })
        document.querySelectorAll('.result-pane').forEach(function (p) {
            p.classList.add('hidden')
        })
        var pane = document.getElementById('tab-' + tabId)
        if (pane) pane.classList.remove('hidden')
    }

    // ── Reset code ────────────────────────────────────────────────────
    function resetCode() {
        if (!editorView) return
        if (
            editorView.state.doc.toString() !== starterCode &&
            !window.confirm('Khôi phục code ban đầu? Code hiện tại của bạn sẽ bị xóa.')
        )
            return
        editorView.dispatch({ changes: { from: 0, to: editorView.state.doc.length, insert: starterCode } })
        try {
            localStorage.removeItem(draftKey)
        } catch {}
        editorView.focus()
    }

    // ── Đưa code mẫu trong bài giảng vào editor ──────────────────────
    function initCodeBlocks() {
        document.querySelectorAll('.lesson-prose .code-block').forEach(function (block) {
            var pre = block.querySelector('pre')
            var copyBtn = block.querySelector('.code-copy')
            var tryBtn = block.querySelector('.code-try')
            var code = pre ? pre.textContent || '' : ''
            copyBtn?.addEventListener('click', function () {
                navigator.clipboard
                    ?.writeText(code)
                    .then(function () {
                        copyBtn.textContent = '✓ Đã chép'
                        setTimeout(function () {
                            copyBtn.textContent = 'Sao chép'
                        }, 1500)
                    })
                    .catch(function () {})
            })
            tryBtn?.addEventListener('click', function () {
                if (!editorView) return
                var current = editorView.state.doc.toString()
                if (
                    current.trim() &&
                    current !== starterCode &&
                    !window.confirm('Thay code trong trình soạn thảo bằng đoạn code mẫu này?')
                )
                    return
                editorView.dispatch({
                    changes: { from: 0, to: editorView.state.doc.length, insert: code.replace(/\n$/, '') + '\n' },
                })
                showCodeOnMobile()
                editorView.focus()
            })
        })
    }

    // ── Split Pane Resize ────────────────────────────────────────────
    function initSplitPane() {
        var handle = document.getElementById('split-handle')
        var lessonPanel = document.getElementById('lesson-panel')
        var editorPanel = document.getElementById('editor-panel')
        var workspace = document.getElementById('workspace')
        if (!handle || !lessonPanel || !editorPanel || !workspace) return

        var dragging = false
        var startX = 0
        var startWidth = 0

        function applyWidth(clientX) {
            var dx = clientX - startX
            var totalWidth = workspace.getBoundingClientRect().width
            var newWidth = Math.max(280, Math.min(totalWidth - 360, startWidth + dx))
            var pct = ((newWidth / totalWidth) * 100).toFixed(1)
            lessonPanel.style.width = pct + '%'
            lessonPanel.style.flexShrink = '0'
            editorPanel.style.flex = '1'
        }

        handle.addEventListener('mousedown', function (e) {
            e.preventDefault()
            dragging = true
            startX = e.clientX
            startWidth = lessonPanel.getBoundingClientRect().width
            document.body.style.cursor = 'col-resize'
            document.body.style.userSelect = 'none'
        })

        document.addEventListener('mousemove', function (e) {
            if (dragging) applyWidth(e.clientX)
        })

        document.addEventListener('mouseup', function () {
            if (dragging) {
                dragging = false
                document.body.style.cursor = ''
                document.body.style.userSelect = ''
            }
        })

        // Touch support
        handle.addEventListener(
            'touchstart',
            function (e) {
                dragging = true
                startX = e.touches[0].clientX
                startWidth = lessonPanel.getBoundingClientRect().width
            },
            { passive: true },
        )

        document.addEventListener(
            'touchmove',
            function (e) {
                if (dragging) applyWidth(e.touches[0].clientX)
            },
            { passive: true },
        )

        document.addEventListener('touchend', function () {
            dragging = false
        })
    }

    // ── Console Resize ──────────────────────────────────────────────
    function initConsoleResize() {
        var handle = document.getElementById('console-resize-handle')
        var consolePanel = document.getElementById('console-panel')
        var editorPanel = document.getElementById('editor-panel')
        if (!handle || !consolePanel || !editorPanel) return

        var dragging = false
        var startY = 0
        var startHeight = 0

        function applyHeight(clientY) {
            var dy = startY - clientY
            var maxHeight = Math.max(160, editorPanel.getBoundingClientRect().height - 140)
            var newHeight = Math.max(110, Math.min(maxHeight, startHeight + dy))
            consolePanel.style.height = newHeight + 'px'
        }

        handle.addEventListener('mousedown', function (e) {
            e.preventDefault()
            dragging = true
            startY = e.clientY
            startHeight = consolePanel.getBoundingClientRect().height
            document.body.style.cursor = 'row-resize'
            document.body.style.userSelect = 'none'
        })

        document.addEventListener('mousemove', function (e) {
            if (dragging) applyHeight(e.clientY)
        })

        document.addEventListener('mouseup', function () {
            if (dragging) {
                dragging = false
                document.body.style.cursor = ''
                document.body.style.userSelect = ''
            }
        })

        handle.addEventListener(
            'touchstart',
            function (e) {
                dragging = true
                startY = e.touches[0].clientY
                startHeight = consolePanel.getBoundingClientRect().height
            },
            { passive: true },
        )

        document.addEventListener(
            'touchmove',
            function (e) {
                if (dragging) applyHeight(e.touches[0].clientY)
            },
            { passive: true },
        )

        document.addEventListener('touchend', function () {
            dragging = false
        })
    }

    // ── Mobile tabs (Đề bài / Code) ─────────────────────────────────
    function setMobileTab(tab) {
        var lessonPanel = document.getElementById('lesson-panel')
        var editorPanel = document.getElementById('editor-panel')
        if (!lessonPanel || !editorPanel) return
        lessonPanel.classList.toggle('max-md:hidden', tab !== 'lesson')
        editorPanel.classList.toggle('max-md:hidden', tab !== 'code')
        document.querySelectorAll('[data-mobile-tab]').forEach(function (btn) {
            btn.classList.toggle('is-active', btn.getAttribute('data-mobile-tab') === tab)
        })
        if (tab === 'code' && editorView) editorView.requestMeasure()
    }

    function showCodeOnMobile() {
        if (window.matchMedia('(max-width: 767px)').matches) setMobileTab('code')
    }

    function initMobileTabs() {
        document.querySelectorAll('[data-mobile-tab]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                setMobileTab(btn.getAttribute('data-mobile-tab'))
            })
        })
    }

    // ── Drawer danh sách bài học ────────────────────────────────────
    function initLessonDrawer() {
        var drawer = document.getElementById('lessonDrawer')
        var backdrop = document.getElementById('lessonDrawerBackdrop')
        var openBtn = document.getElementById('lessonListBtn')
        var closeBtn = document.getElementById('lessonDrawerClose')
        if (!drawer || !backdrop) return

        function open() {
            drawer.classList.remove('invisible', '-translate-x-full')
            backdrop.classList.remove('hidden')
            var current = drawer.querySelector('[aria-current="page"]')
            if (current) current.scrollIntoView({ block: 'center' })
        }
        function close() {
            drawer.classList.add('-translate-x-full')
            backdrop.classList.add('hidden')
            setTimeout(function () {
                if (drawer.classList.contains('-translate-x-full')) drawer.classList.add('invisible')
            }, 300)
        }
        openBtn?.addEventListener('click', open)
        closeBtn?.addEventListener('click', close)
        backdrop.addEventListener('click', close)
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                close()
                hideSuccessModal()
            }
        })
    }

    // ── Tiến độ khóa học (header + drawer) ──────────────────────────
    var ICON_CHECK =
        '<svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>'
    var ICON_LOCK =
        '<svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/></svg>'

    function loadCourseProgress() {
        var token = localStorage.getItem('auth_token')
        if (!token || !courseSlug) return
        fetch('/api/hoc-python/progress?courseSlug=' + encodeURIComponent(courseSlug), {
            headers: { Authorization: 'Bearer ' + token },
        })
            .then(function (r) {
                return r.ok ? r.json() : null
            })
            .then(function (data) {
                if (!data || !data.progress) return
                var slugs = Object.keys(data.progress)
                var total = slugs.length
                var done = slugs.filter(function (s) {
                    return data.progress[s] === 'completed'
                }).length
                if (!total) return
                var pct = Math.round((done / total) * 100)
                var text = done + '/' + total + ' bài · ' + pct + '%'

                var hp = document.getElementById('headerProgress')
                var hpBar = document.getElementById('headerProgressBar')
                var hpText = document.getElementById('headerProgressText')
                if (hp) hp.classList.remove('invisible')
                if (hpBar) hpBar.style.width = pct + '%'
                if (hpText) hpText.textContent = text

                var dp = document.getElementById('drawerProgress')
                var dpBar = document.getElementById('drawerProgressBar')
                var dpText = document.getElementById('drawerProgressText')
                if (dp) dp.classList.remove('hidden')
                if (dpBar) dpBar.style.width = pct + '%'
                if (dpText) dpText.textContent = text

                document.querySelectorAll('[data-drawer-slug]').forEach(function (link) {
                    var status = data.progress[link.getAttribute('data-drawer-slug')]
                    var icon = link.querySelector('.drawer-status')
                    if (!icon) return
                    if (status === 'completed') {
                        icon.innerHTML = ICON_CHECK
                        icon.className =
                            'drawer-status w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0'
                    } else if (status === 'locked' || status === 'level_locked') {
                        icon.innerHTML = ICON_LOCK
                        icon.className =
                            'drawer-status w-6 h-6 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center shrink-0'
                    }
                })

                if (
                    data.progress[window.location.pathname.split('/').pop() || ''] === 'completed' &&
                    !isLessonCompleted()
                ) {
                    markLessonCompleted()
                }
            })
            .catch(function () {})
    }

    // ── Custom Input Modal ──────────────────────────────────────────
    function initCustomInput() {
        var overlay = document.getElementById('custom-input-overlay')
        var cancelBtn = document.getElementById('custom-input-cancel')
        var runBtnCustom = document.getElementById('custom-input-run')
        var inputField = document.getElementById('custom-input-text')

        if (!overlay || !cancelBtn || !runBtnCustom || !inputField) return

        function hide() {
            overlay.classList.add('hidden')
            overlay.classList.remove('flex')
        }

        customInputBtn?.addEventListener('click', function () {
            if (!inputField.value && publicTests.length > 0) inputField.value = publicTests[0].stdin || ''
            overlay.classList.remove('hidden')
            overlay.classList.add('flex')
            inputField.focus()
        })

        cancelBtn.addEventListener('click', hide)
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) hide()
        })
        runBtnCustom.addEventListener('click', function () {
            hide()
            runWithCustomInput(inputField.value)
        })
    }

    // ── Event Listeners ──────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', async function () {
        document.querySelectorAll('.result-tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                switchTab(tab.dataset.tab)
            })
        })

        // Tab mặc định: bài có test → "Test case", bài lý thuyết → "Console"
        if (testCases.length > 0) {
            switchTab('test-results')
            showTestResults(testPreviewItems(), 0, testCases.length)
        } else {
            switchTab('console')
            showTestResults([], 0, 0)
        }

        initMobileTabs()
        initLessonDrawer()
        initSplitPane()
        initConsoleResize()
        initCustomInput()
        loadCourseProgress()

        await initEditor()
        initPyodide()
        initCodeBlocks()

        if (lessonData?.dataset.isTheory === 'true') {
            appendConsole(
                '📖 Đây là bài học lý thuyết. Đọc nội dung bên trái và thử chạy code mẫu bằng nút "▶ Chạy thử"!',
                'info',
            )
        }

        runBtn?.addEventListener('click', runCode)
        submitBtn?.addEventListener('click', submitCode)
        resetBtn?.addEventListener('click', resetCode)
        nextLessonBtn?.addEventListener('click', goToNextLesson)
        document.getElementById('successStay')?.addEventListener('click', hideSuccessModal)
        document.getElementById('successModal')?.addEventListener('click', function (e) {
            if (e.target === e.currentTarget) hideSuccessModal()
        })

        testResultsEl?.addEventListener('click', function (e) {
            var chip = e.target.closest('[data-test-idx]')
            if (!chip) return
            selectedTestIdx = parseInt(chip.getAttribute('data-test-idx') || '0')
            showTestResults(lastTestView.results, lastTestView.passed, lastTestView.total)
        })

        var nextLink = document.getElementById('nextLessonLink')
        if (nextLink) {
            nextLink.addEventListener('click', function (e) {
                if (!isLessonCompleted()) {
                    e.preventDefault()
                    showSkipWarning()
                }
            })
        }

        updateNextButtonState()

        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault()
                runCode()
            }
        })

        // ── Quiz interaction ──────────────────────────────────────────
        if (quizQuestions.length > 0) {
            var correctCount = 0
            var totalQuestions = quizQuestions.length
            var quizContainer = document.getElementById('quiz-container')

            quizContainer?.querySelectorAll('.quiz-question').forEach(function (qEl) {
                var qIndex = parseInt(qEl.dataset.qindex || '0')
                var correctIdx = parseInt(qEl.dataset.correct || '0')
                var answeredCorrectly = false
                /** @type {HTMLElement} */
                var feedbackEl = qEl.querySelector('.quiz-feedback')

                qEl.querySelectorAll('input[type="radio"]').forEach(function (radio) {
                    radio.addEventListener('change', function () {
                        if (answeredCorrectly) return

                        var selectedIdx = parseInt(this.value)
                        var isCorrect = selectedIdx === correctIdx

                        qEl.querySelectorAll('.quiz-option').forEach(function (optEl) {
                            optEl.className =
                                'quiz-option flex items-start gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer transition-all duration-150 hover:border-[#3776AB]/40 hover:bg-blue-50/30'
                            var radioInput = /** @type {HTMLInputElement|null} */ (optEl.querySelector('input'))
                            if (radioInput) radioInput.disabled = false
                        })

                        if (isCorrect) {
                            answeredCorrectly = true
                            qEl.querySelectorAll('.quiz-option').forEach(function (optEl) {
                                var lbl = /** @type {HTMLLabelElement} */ (optEl)
                                var optIdx = parseInt(lbl.dataset.optindex || '0')
                                if (optIdx === correctIdx) {
                                    lbl.className =
                                        'quiz-option flex items-start gap-3 p-3 rounded-xl border-2 border-emerald-400 bg-emerald-50'
                                } else {
                                    lbl.className =
                                        'quiz-option flex items-start gap-3 p-3 rounded-xl border border-slate-100 bg-slate-50/50 opacity-60'
                                }
                                /** @type {HTMLInputElement} */ lbl.querySelector('input').disabled = true
                            })
                            correctCount++
                        } else {
                            qEl.querySelectorAll('.quiz-option').forEach(function (optEl) {
                                var optIdx = parseInt(/** @type {HTMLElement} */ (optEl).dataset.optindex || '0')
                                if (optIdx === selectedIdx) {
                                    /** @type {HTMLLabelElement} */ optEl.className =
                                        'quiz-option flex items-start gap-3 p-3 rounded-xl border-2 border-red-300 bg-red-50'
                                }
                            })
                        }

                        if (feedbackEl) {
                            var q = quizQuestions[qIndex]
                            if (isCorrect) {
                                feedbackEl.className =
                                    'quiz-feedback ml-8 mt-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 bg-emerald-50 border border-emerald-200 text-emerald-700'
                                feedbackEl.innerHTML = '✅ <strong>Đúng!</strong> ' + escapeHtml(q.explanation)
                            } else {
                                feedbackEl.className =
                                    'quiz-feedback ml-8 mt-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 bg-red-50 border border-red-200 text-red-700'
                                feedbackEl.innerHTML =
                                    '❌ <strong>Sai!</strong> Đáp án đúng là <strong>' +
                                    escapeHtml(q.options[correctIdx]) +
                                    '</strong>. ' +
                                    escapeHtml(q.explanation)
                            }
                            feedbackEl.classList.remove('hidden')
                        }

                        var headerEl = document.getElementById('quiz-header-title')
                        if (headerEl) {
                            var remaining = totalQuestions - correctCount
                            if (remaining === 0) {
                                headerEl.textContent =
                                    '🎉 Hoàn thành! Bạn đã trả lời đúng ' +
                                    correctCount +
                                    '/' +
                                    totalQuestions +
                                    ' câu.'
                                headerEl.className = 'text-emerald-200 text-xs mt-1'
                            } else if (correctCount > 0) {
                                headerEl.textContent =
                                    '✅ Đã đúng ' + correctCount + '/' + totalQuestions + ' — còn ' + remaining + ' câu'
                            } else {
                                headerEl.textContent = '📝 Đây là bài tự kiểm tra — nhấn "Hoàn thành bài" để hoàn thành'
                            }
                        }
                    })
                })
            })
        }
    })
</script>

