---
import MainLayout from '../../../../layouts/MainLayout.astro'
import { TC_TITLE } from '../../../../common/TextConst'
import { marked } from 'marked'

// ── Neon DB ───────────────────────────────────────────────────────────
const { neon } = await import('@neondatabase/serverless')
const sql = neon(import.meta.env.DATABASE_URL)

const { courseSlug, lessonSlug } = Astro.params

interface Lesson {
    id: string
    title: string
    slug: string
    description: string
    lesson_type: 'theory' | 'practice' | 'quiz' | 'project'
    content_markdown: string
    starter_code: string
    difficulty: 'easy' | 'medium' | 'hard'
    xp_reward: number
    estimated_minutes: number
    comparison_mode: 'exact' | 'float' | 'custom'
    float_epsilon: number
    time_limit_ms: number
    course_title: string
    course_slug: string
}

interface TestCase {
    id: string
    stdin: string
    expected_output: string
    is_hidden: boolean
    order_index: number
}

interface QuizQuestion {
    id: string
    question_text: string
    options: string[]
    correct_index: number
    explanation: string
    order_index: number
}

// Fetch lesson
const [lesson]: (Lesson | undefined)[] = await sql`
    SELECT
        l.id, l.title, l.slug, l.description, l.lesson_type,
        l.content_markdown, l.starter_code, l.difficulty,
        l.xp_reward, l.estimated_minutes, l.comparison_mode,
        l.float_epsilon, l.time_limit_ms,
        c.title AS course_title, c.slug AS course_slug
    FROM error404labs.py_lessons l
    JOIN error404labs.py_chapters ch ON ch.id = l.chapter_id
    JOIN error404labs.py_courses c ON c.id = ch.course_id
    WHERE l.slug = ${lessonSlug} AND c.slug = ${courseSlug} AND l.published = true
    LIMIT 1
`

if (!lesson) {
    return Astro.redirect('/404', 404)
}

// Fetch test cases
const testCases: TestCase[] = await sql`
    SELECT id, stdin, expected_output, is_hidden, order_index
    FROM error404labs.py_test_cases
    WHERE lesson_id = ${lesson.id}
    ORDER BY order_index ASC
`

// Fetch quiz questions (chỉ cho theory lessons)
const quizQuestions: QuizQuestion[] = lesson.lesson_type === 'theory' ? await sql`
    SELECT id, question_text, options, correct_index, explanation, order_index
    FROM error404labs.py_quiz_questions
    WHERE lesson_id = ${lesson.id}
    ORDER BY order_index ASC
` : []

// Fetch tất cả lessons trong course để biết bài trước/sau
const allLessons: { id: string; slug: string; title: string; order_index: number; chapter_order: number }[] = await sql`
    SELECT l.id, l.slug, l.title, l.order_index, ch.order_index AS chapter_order
    FROM error404labs.py_lessons l
    JOIN error404labs.py_chapters ch ON ch.id = l.chapter_id
    JOIN error404labs.py_courses c ON c.id = ch.course_id
    WHERE c.slug = ${courseSlug} AND l.published = true
    ORDER BY ch.order_index ASC, l.order_index ASC
`

const currentIdx = allLessons.findIndex(l => l.slug === lessonSlug)
const prevLesson = currentIdx > 0 ? allLessons[currentIdx - 1] : null
const nextLesson = currentIdx >= 0 && currentIdx < allLessons.length - 1 ? allLessons[currentIdx + 1] : null

// Render markdown → HTML trên server
const contentHtml = await marked.parse(lesson.content_markdown || '')

// Badge helpers
const typeLabel: Record<string, string> = {
    theory: 'Lý thuyết', practice: 'Thực hành', quiz: 'Quiz', project: 'Dự án',
}
const typeColor: Record<string, string> = {
    theory: 'bg-blue-100 text-blue-700 border-blue-200',
    practice: 'bg-green-100 text-green-700 border-green-200',
    quiz: 'bg-purple-100 text-purple-700 border-purple-200',
    project: 'bg-orange-100 text-orange-700 border-orange-200',
}
const diffLabel: Record<string, string> = { easy: 'Dễ', medium: 'Trung bình', hard: 'Khó' }

// Serialize dữ liệu cho client (dùng JSON để giữ newline)
// Hidden test: chỉ gửi stdin để client chạy, KHÔNG gửi expected_output — tránh lộ đáp án hidden
    const clientTestCases = testCases.map((tc) =>
        tc.is_hidden
            ? { id: tc.id, stdin: tc.stdin, is_hidden: true, order_index: tc.order_index }
            : tc,
    )
    const testCasesJson = JSON.stringify(clientTestCases)
    const lessonIdJson = JSON.stringify(lesson.id)
    const starterCodeJson = JSON.stringify(lesson.starter_code || '# Viết code Python của bạn ở đây\n')
    const xpReward = lesson.xp_reward
    const comparisonMode = lesson.comparison_mode
    const floatEpsilon = lesson.float_epsilon
    const isTheory = lesson.lesson_type === 'theory'
    const hasTests = testCases.length > 0
    const prevLessonJson = JSON.stringify(prevLesson)
    const nextLessonJson = JSON.stringify(nextLesson)
    const quizQuestionsJson = JSON.stringify(quizQuestions)
---

<MainLayout title={`${lesson.title} | Python | ${TC_TITLE}`}>
    <!-- Top bar -->
    <div class="sticky top-26 z-50 bg-white border-b border-slate-200 shadow-sm">
        <div class="max-w-full mx-auto px-4 py-3 flex items-center gap-3">
            <a
                href={`/hoc-python/khoa-hoc/${courseSlug}`}
                class="flex items-center gap-1.5 text-slate-500 hover:text-[#3776AB] font-medium text-sm transition-colors shrink-0"
            >
                <span>←</span>
                <span class="hidden sm:inline">Quay lại</span>
            </a>

            <div class="w-px h-6 bg-slate-200 shrink-0"></div>

            <div class="flex-1 min-w-0 flex items-center gap-2">
                <span class="text-xs text-slate-400 font-medium truncate hidden md:inline">{lesson.course_title}</span>
                <span class="text-xs text-slate-300 hidden md:inline">/</span>
                <h1 class="font-bold text-slate-800 text-sm truncate">{lesson.title}</h1>
            </div>

            <!-- Nav bài trước/sau -->
            <div class="hidden md:flex items-center gap-1 shrink-0" id="lessonNav">
                {prevLesson && (
                    <a href={`/hoc-python/hoc/${courseSlug}/${prevLesson.slug}`}
                       class="text-xs font-medium text-slate-400 hover:text-[#3776AB] px-2 py-1.5 rounded-lg hover:bg-blue-50 transition-colors"
                       title={prevLesson.title}>← Bài trước</a>
                )}
                {nextLesson && (
                    <a href={`/hoc-python/hoc/${courseSlug}/${nextLesson.slug}`}
                       id="nextLessonLink"
                       class="text-xs font-medium text-slate-400 hover:text-[#3776AB] px-2 py-1.5 rounded-lg hover:bg-blue-50 transition-colors"
                       title={nextLesson.title}>Bài tiếp →</a>
                )}
            </div>

            <div class="flex items-center gap-2 shrink-0">
                <span class={`text-[10px] font-bold px-2 py-1 rounded-full border ${typeColor[lesson.lesson_type] || typeColor.practice}`}>
                    {typeLabel[lesson.lesson_type] || 'Thực hành'}
                </span>
                <span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-1 rounded-full">
                    {diffLabel[lesson.difficulty] || 'Dễ'}
                </span>
                <span class="text-[10px] font-bold text-yellow-600 bg-yellow-50 px-2 py-1 rounded-full flex items-center gap-1">
                    ⭐ +{lesson.xp_reward}
                </span>
                <span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-1 rounded-full hidden sm:flex items-center gap-1">
                    ⏱ {lesson.estimated_minutes}p
                </span>
            </div>
        </div>
    </div>

    <!-- Mobile sidebar toggle -->
    <button id="sidebarToggle" class="md:hidden fixed bottom-4 left-4 z-50 bg-[#3776AB] text-white w-12 h-12 rounded-full shadow-lg flex items-center justify-center text-xl font-bold hover:bg-[#2B5E8A] transition-colors active:scale-95">
        📖
    </button>

    <!-- Split screen -->
    <div id="workspace" class="flex flex-col md:flex-row" style="height: calc(100vh - 168px);">
        <!-- LEFT: Lesson content — nâng cấp giao diện -->
        <div id="lesson-panel" class="w-full md:w-[40%] overflow-y-auto bg-gradient-to-b from-slate-50 to-white lesson-content-panel transition-all duration-200">
            <!-- Accent bar -->
            <div class="h-1.5 bg-gradient-to-r from-[#3776AB] via-[#2B5E8A] to-[#FFD43B]"></div>

            <!-- Lesson header card -->
            <div class="p-5 pb-0">
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 mb-4">
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <h2 class="text-xl font-black text-slate-800 leading-tight flex-1">{lesson.title}</h2>
                        <span class="shrink-0 bg-gradient-to-br from-[#3776AB] to-[#2B5E8A] text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-sm">
                            Python 3
                        </span>
                    </div>

                    {lesson.description && (
                        <p class="text-slate-500 text-sm leading-relaxed">{lesson.description}</p>
                    )}

                    <!-- Meta badges -->
                    <div class="flex flex-wrap items-center gap-2 mt-4 pt-3 border-t border-slate-100">
                        <span class={`text-[10px] font-bold px-2.5 py-1 rounded-full border ${lesson.lesson_type === 'theory' ? 'bg-blue-50 text-blue-600 border-blue-200' : lesson.lesson_type === 'practice' ? 'bg-emerald-50 text-emerald-600 border-emerald-200' : lesson.lesson_type === 'quiz' ? 'bg-purple-50 text-purple-600 border-purple-200' : 'bg-orange-50 text-orange-600 border-orange-200'}`}>
                            {lesson.lesson_type === 'theory' ? '📖 Lý thuyết' : lesson.lesson_type === 'practice' ? '⌨️ Thực hành' : lesson.lesson_type === 'quiz' ? '❓ Quiz' : '📦 Dự án'}
                        </span>
                        <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200 flex items-center gap-1">
                            {lesson.difficulty === 'easy' ? '⭐ Dễ' : lesson.difficulty === 'medium' ? '⭐⭐ Trung bình' : '⭐⭐⭐ Khó'}
                        </span>
                        <span class="text-[10px] font-bold text-yellow-600 bg-yellow-50 px-2.5 py-1 rounded-full border border-yellow-200 flex items-center gap-1">
                            🏆 +{lesson.xp_reward} XP
                        </span>
                        <span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full border border-slate-200 flex items-center gap-1">
                            ⏱ {lesson.estimated_minutes} phút
                        </span>
                    </div>
                </div>
            </div>

            <!-- Lesson content với styling đẹp -->
            <div class="px-5 pb-8">
                <div class="prose prose-sm max-w-none
                    prose-headings:font-black prose-headings:text-slate-800 prose-headings:tracking-tight
                    prose-h2:text-lg prose-h2:border-b prose-h2:border-slate-100 prose-h2:pb-2 prose-h2:mb-4
                    prose-h3:text-base prose-h3:text-slate-700
                    prose-p:text-slate-600 prose-p:leading-relaxed prose-p:my-2
                    prose-strong:text-slate-800 prose-strong:font-bold
                    prose-a:text-[#3776AB] prose-a:font-medium prose-a:no-underline hover:prose-a:underline
                    prose-code:text-[#3776AB] prose-code:bg-[#3776AB]/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-[13px] prose-code:font-mono prose-code:font-semibold
                    prose-pre:bg-[#1e1e2e] prose-pre:text-[#cdd6f4] prose-pre:rounded-xl prose-pre:p-4 prose-pre:border prose-pre:border-[#313244] prose-pre:shadow-lg
                    prose-pre:my-4
                    prose-ul:my-2 prose-li:text-slate-600 prose-li:marker:text-[#3776AB]
                    prose-img:rounded-xl prose-img:shadow-md
                    prose-blockquote:border-l-[3px] prose-blockquote:border-[#3776AB] prose-blockquote:bg-[#3776AB]/5 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-blockquote:not-italic prose-blockquote:text-slate-600
                    prose-hr:border-slate-100">
                    <div set:html={contentHtml} />
                </div>
            </div>

            <!-- Quiz questions (chỉ cho theory) -->
            {quizQuestions.length > 0 && (
                <div id="quiz-section" class="px-5 pb-8">
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="bg-gradient-to-r from-[#3776AB] to-[#2B5E8A] px-5 py-3">
                            <h3 class="text-white font-black text-sm flex items-center gap-2">
                                <span>📝</span> Kiểm tra nhanh
                            </h3>
                            <p id="quiz-header-title" class="text-blue-200 text-xs mt-0.5">📝 Đây là bài tự kiểm tra — nhấn "Nộp bài" để hoàn thành</p>
                        </div>
                        <div class="p-5 space-y-6" id="quiz-container">
                            {quizQuestions.map((q, qi) => (
                                <div class="quiz-question" data-qindex={qi} data-correct={q.correct_index}>
                                    <p class="text-sm font-bold text-slate-800 mb-3 flex items-start gap-2">
                                        <span class="shrink-0 w-6 h-6 rounded-full bg-[#3776AB]/10 text-[#3776AB] text-xs font-bold flex items-center justify-center mt-0.5">
                                            {qi + 1}
                                        </span>
                                        <span>{q.question_text}</span>
                                    </p>
                                    <div class="space-y-2 ml-8">
                                        {q.options.map((opt, oi) => (
                                            <label class="quiz-option flex items-start gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer transition-all duration-150 hover:border-[#3776AB]/40 hover:bg-blue-50/30" data-optindex={oi}>
                                                <input type="radio" name={`quiz-q-${qi}`} value={oi} class="mt-0.5 accent-[#3776AB] shrink-0" />
                                                <span class="text-sm text-slate-700 leading-relaxed">{opt}</span>
                                            </label>
                                        ))}
                                    </div>
                                    <div class="quiz-feedback hidden ml-8 mt-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200"></div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            )}
        </div>

        <!-- Split pane resize handle -->
        <div id="split-handle" class="hidden md:flex w-[6px] bg-[#313244] hover:bg-[#3776AB] cursor-col-resize items-center justify-center group transition-colors duration-150 shrink-0 relative">
            <div class="w-[2px] h-8 rounded-full bg-slate-500 group-hover:bg-white transition-colors"></div>
            <div class="absolute inset-y-0 -left-1 -right-1"></div>
        </div>

        <!-- RIGHT: Editor + Console -->
        <div id="editor-panel" class="flex-1 flex flex-col bg-[#1e1e2e] min-w-0">
            <!-- Toolbar -->
            <div class="flex items-center justify-between px-4 py-2 bg-[#181825] border-b border-[#313244] shrink-0">
                <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-500 font-mono font-bold">main.py</span>
                </div>
                <div class="flex items-center gap-2">
                    <button
                        id="resetBtn"
                        class="text-xs text-slate-400 hover:text-white bg-[#313244] hover:bg-[#45475a] px-3 py-1.5 rounded-lg font-medium transition-colors"
                    >
                        ↺ Reset
                    </button>
                    <button
                        id="runBtn"
                        class="text-xs font-bold text-[#1e1e2e] bg-[#a6e3a1] hover:bg-[#94e2d5] px-4 py-1.5 rounded-lg transition-colors flex items-center gap-1.5"
                    >
                        ▶ Chạy
                    </button>
                    <button
                        id="submitBtn"
                        class:list={['text-xs font-bold text-white bg-[#3776AB] hover:bg-[#2B5E8A] px-4 py-1.5 rounded-lg transition-colors flex items-center gap-1.5']}
                    >
                        📤 Nộp bài
                    </button>
                    <button
                        id="nextLessonBtn"
                        class:list={['text-xs font-bold px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5', nextLesson ? 'text-white bg-[#585b70] hover:bg-[#6c7086]' : 'hidden']}
                        data-next-slug={nextLesson?.slug || ''}
                    >
                        → Bài tiếp
                    </button>
                </div>
            </div>

            <!-- CodeMirror container -->
            <div id="cm-editor" class="flex-1 overflow-hidden"></div>

            <!-- Loading overlay cho Pyodide -->
            <div id="pyodide-loading" class="absolute inset-0 bg-[#1e1e2e]/90 flex items-center justify-center z-10 hidden">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-10 w-10 border-3 border-[#3776AB] border-t-transparent mx-auto mb-4"></div>
                    <p class="text-slate-400 text-sm font-medium">Đang tải Python runtime...</p>
                    <p class="text-slate-600 text-xs mt-1">Lần đầu có thể mất vài giây</p>
                </div>
            </div>

            <!-- Bottom: Console + Test Results tabs -->
            <div id="console-panel" class="shrink-0 border-t border-[#313244] bg-[#1e1e2e]" style="height: 200px;">
                <!-- Console resize handle -->
                <div id="console-resize-handle" class="h-[5px] bg-[#313244] hover:bg-[#3776AB] cursor-row-resize group transition-colors flex items-center justify-center">
                    <div class="w-8 h-[2px] rounded-full bg-slate-600 group-hover:bg-white transition-colors"></div>
                </div>
                <!-- Tab bar -->
                <div class="flex items-center justify-between gap-0 px-2 bg-[#181825] border-b border-[#313244]">
                    <div class="flex items-center gap-0">
                        <button class="result-tab active px-4 py-2 text-xs font-bold text-[#a6e3a1] border-b-2 border-[#a6e3a1] bg-transparent transition-colors" data-tab="console">
                            ► Console
                        </button>
                        <button class="result-tab px-4 py-2 text-xs font-bold text-slate-500 border-b-2 border-transparent hover:text-slate-300 bg-transparent transition-colors" data-tab="test-results">
                            <span id="test-tab-label">✓ Kết quả</span>
                        </button>
                    </div>
                    <button id="customInputBtn" class="text-[10px] text-slate-500 hover:text-slate-300 px-2 py-1 rounded hover:bg-[#313244] transition-colors font-medium hidden" title="Thử chạy với input tùy chỉnh">
                        ⌨ Input tùy chỉnh
                    </button>
                </div>

                <!-- Console output -->
                <div id="tab-console" class="result-pane active p-3 overflow-y-auto font-mono text-sm leading-relaxed" style="height: calc(200px - 56px);">
                    <div class="text-slate-500 italic">Nhấn "▶ Chạy" để thực thi code Python...</div>
                </div>

                <!-- Test results -->
                <div id="tab-test-results" class="result-pane p-3 overflow-y-auto text-sm leading-relaxed hidden" style="height: calc(200px - 56px);">
                    <div class="text-slate-500 italic">Nhấn "📤 Nộp bài" để chạy test case...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Custom input overlay (hidden by default) -->
    <div id="custom-input-overlay" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center">
        <div class="bg-[#1e1e2e] border border-[#313244] rounded-2xl p-6 max-w-md mx-4 shadow-2xl w-full">
            <h3 class="text-white font-bold text-base mb-3">Thử chạy với input tùy chỉnh</h3>
            <textarea id="custom-input-text" class="w-full bg-[#181825] border border-[#313244] rounded-xl px-4 py-3 text-slate-200 font-mono text-sm resize-none focus:outline-none focus:border-[#3776AB] transition-colors" rows="4" placeholder="Nhập dữ liệu đầu vào (stdin)..."></textarea>
            <div class="flex justify-end gap-3 mt-4">
                <button id="custom-input-cancel" class="text-sm font-medium text-slate-400 hover:text-white px-4 py-2 rounded-lg bg-[#313244] hover:bg-[#45475a] transition-colors">Hủy</button>
                <button id="custom-input-run" class="text-sm font-bold text-[#1e1e2e] bg-[#a6e3a1] hover:bg-[#94e2d5] px-4 py-2 rounded-lg transition-colors">▶ Chạy</button>
            </div>
        </div>
    </div>

    <!-- Data attributes cho JS -->
    <div
        id="lesson-data"
        data-starter-code={starterCodeJson}
        data-test-cases={testCasesJson}
        data-lesson-id={lessonIdJson}
        data-course-slug={courseSlug}
        data-comparison-mode={comparisonMode}
        data-float-epsilon={floatEpsilon}
        data-xp-reward={xpReward}
        data-is-theory={isTheory ? 'true' : 'false'}
        data-has-tests={hasTests ? 'true' : 'false'}
        data-prev-lesson={prevLessonJson}
        data-next-lesson={nextLessonJson}
        data-quiz-questions={quizQuestionsJson}
    ></div>
</MainLayout>

<script>if(!localStorage.getItem('auth_token')){window.location.href='/?login=true'}</script>
<script>
    // ─────────────────────────────────────────────────────────────────────
    // Client-side logic: CodeMirror 6 + Pyodide + Run/Submit
    // ─────────────────────────────────────────────────────────────────────

    // DOM refs — dùng JSON.parse để giữ nguyên newlines
    const lessonData = document.getElementById('lesson-data')
    const starterCode = JSON.parse(lessonData?.dataset.starterCode || '"# Viết code Python của bạn ở đây\\n"')
    const testCases = JSON.parse(lessonData?.dataset.testCases || '[]')
    const publicTests = testCases.filter(function (tc) { return !tc.is_hidden })
    const hiddenTests = testCases.filter(function (tc) { return tc.is_hidden })
    const lessonId = JSON.parse(lessonData?.dataset.lessonId || '""')
    const courseSlug = lessonData?.dataset.courseSlug || ''
    const prevLesson = JSON.parse(lessonData?.dataset.prevLesson || 'null')
    const nextLesson = JSON.parse(lessonData?.dataset.nextLesson || 'null')
    const quizQuestions = JSON.parse(lessonData?.dataset.quizQuestions || '[]')
    const cmContainer = document.getElementById('cm-editor')
    const consoleEl = document.getElementById('tab-console')
    const testResultsEl = document.getElementById('tab-test-results')
    const loadingEl = document.getElementById('pyodide-loading')
    const runBtn = document.getElementById('runBtn')
    const submitBtn = document.getElementById('submitBtn')
    const resetBtn = document.getElementById('resetBtn')
    const nextLessonBtn = document.getElementById('nextLessonBtn')
    const customInputBtn = document.getElementById('customInputBtn')

    // State
    let editorView = null
    let pyodide = null
    let lessonCompleted = false

    // ── Helper: normalize output (match server-side) ────────────────
    function normalizeOutput(str) {
        return (str || '')
            .replace(/\r\n/g, '\n')
            .split('\n')
            .map(line => line.replace(/\s+$/, ''))
            .join('\n')
            .trim()
            .replace(/\n{3,}/g, '\n\n')
    }

    function compareClientOutputs(actual, expected, mode, epsilon) {
        var normActual = normalizeOutput(actual)
        var normExpected = normalizeOutput(expected)
        if (mode === 'float') {
            var a = parseFloat(normActual)
            var b = parseFloat(normExpected)
            return !isNaN(a) && !isNaN(b) && Math.abs(a - b) < (epsilon || 0.001)
        }
        if (mode === 'contains') {
            return normActual.indexOf(normExpected) !== -1
        }
        return normActual === normExpected
    }

    // ── Helper: HTML-escape ──────────────────────────────────────────
    function escapeHtml(str) {
        if (typeof str !== 'string') return str
        var div = document.createElement('div')
        div.textContent = str
        return div.innerHTML
    }

    // ── Completion tracking ──────────────────────────────────────────
    function markLessonCompleted() {
        lessonCompleted = true
        try {
            var completed = JSON.parse(localStorage.getItem('py_completed') || '{}')
            completed[lessonId] = true
            localStorage.setItem('py_completed', JSON.stringify(completed))
        } catch {}
        updateNextButtonState()
    }

    function isLessonCompleted() {
        if (lessonCompleted) return true
        try {
            var completed = JSON.parse(localStorage.getItem('py_completed') || '{}')
            if (completed[lessonId]) { lessonCompleted = true; return true }
        } catch {}
        return false
    }

    function updateNextButtonState() {
        if (!nextLessonBtn || !nextLesson) return
        if (isLessonCompleted()) {
            nextLessonBtn.className = 'text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-[0.98]'
            nextLessonBtn.innerHTML = '🎉 Bài tiếp →'
        } else {
            nextLessonBtn.className = 'text-xs font-bold text-white bg-[#585b70] hover:bg-[#6c7086] px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5'
            nextLessonBtn.innerHTML = '→ Bài tiếp'
        }
    }

    // ── Skip Warning Modal ───────────────────────────────────────────
    function showSkipWarning() {
        var overlay = document.createElement('div')
        overlay.id = 'skipModal'
        overlay.className = 'fixed inset-0 bg-black/60 z-50 flex items-center justify-center'
        overlay.innerHTML = '<div class="bg-[#1e1e2e] border border-[#313244] rounded-2xl p-6 max-w-sm mx-4 shadow-2xl">' +
            '<div class="text-amber-400 text-3xl mb-3">⚠️</div>' +
            '<h3 class="text-white font-bold text-lg mb-2">Chưa hoàn thành!</h3>' +
            '<p class="text-slate-400 text-sm mb-5">Bạn chưa hoàn thành bài học này. ' +
            'Có thể bạn sẽ bỏ lỡ kiến thức quan trọng nếu bỏ qua. Vẫn muốn tiếp tục?</p>' +
            '<div class="flex gap-3 justify-end">' +
            '<button class="skip-cancel text-sm font-medium text-slate-400 hover:text-white px-4 py-2 rounded-lg bg-[#313244] hover:bg-[#45475a] transition-colors">Ở lại</button>' +
            '<button class="skip-confirm text-sm font-bold text-white bg-amber-600 hover:bg-amber-500 px-4 py-2 rounded-lg transition-colors">Bỏ qua</button>' +
            '</div></div>'
        document.body.appendChild(overlay)

        overlay.querySelector('.skip-cancel').addEventListener('click', function () { overlay.remove() })
        overlay.querySelector('.skip-confirm').addEventListener('click', function () {
            if (nextLesson) window.location.href = '/hoc-python/hoc/' + courseSlug + '/' + nextLesson.slug
        })
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) overlay.remove()
        })
    }

    function goToNextLesson() {
        if (!nextLesson) return
        if (isLessonCompleted()) {
            window.location.href = '/hoc-python/hoc/' + courseSlug + '/' + nextLesson.slug
        } else {
            showSkipWarning()
        }
    }

    // ── CodeMirror 6 (singleton cache) ──────────────────────────────
    async function initEditor() {
        if (editorView) return
        if (cmContainer) cmContainer.innerHTML = ''

        var cmModules
        if (window.__cmModules) {
            cmModules = window.__cmModules
        } else {
            var [cm, state, lang, theme] = await Promise.all([
                import('codemirror'),
                import('@codemirror/state'),
                import('@codemirror/lang-python'),
                import('@codemirror/theme-one-dark'),
            ])
            cmModules = {
                EditorView: cm.EditorView,
                basicSetup: cm.basicSetup,
                EditorState: state.EditorState,
                python: lang.python,
                oneDark: theme.oneDark,
            }
            window.__cmModules = cmModules
        }

        var state = cmModules.EditorState.create({
            doc: starterCode,
            extensions: [
                cmModules.basicSetup,
                cmModules.python(),
                cmModules.oneDark,
                cmModules.EditorView.theme({
                    '&': { height: '100%' },
                    '.cm-scroller': { overflow: 'auto' },
                }),
                cmModules.EditorView.lineWrapping,
            ],
        })

        if (cmContainer) {
            editorView = new cmModules.EditorView({ state, parent: cmContainer })
        }
    }

    // ── Pyodide (singleton cache — avoid reload on SPA navigation) ──
    var pyodideInitPromise = null
    async function initPyodide() {
        if (pyodide) return true
        if (pyodideInitPromise) return pyodideInitPromise
        if (loadingEl) loadingEl.classList.remove('hidden')

        pyodideInitPromise = (async function () {
            try {
                if (!window.__pyodide) {
                    const script = document.createElement('script')
                    script.src = 'https://cdn.jsdelivr.net/npm/pyodide@0.27.3/pyodide.js'
                    await new Promise(function (resolve, reject) {
                        script.onload = resolve
                        script.onerror = function () { reject(new Error('Không thể tải Pyodide từ CDN')) }
                        document.head.appendChild(script)
                    })
                    window.__pyodide = await globalThis.loadPyodide({
                        indexURL: 'https://cdn.jsdelivr.net/npm/pyodide@0.27.3/',
                    })
                }
                pyodide = window.__pyodide
                if (loadingEl) loadingEl.classList.add('hidden')
                appendConsole('✅ Python runtime đã sẵn sàng! (Python ' + pyodide.version + ')')
                return true
            } catch (err) {
                if (loadingEl) loadingEl.classList.add('hidden')
                appendConsole('❌ Lỗi tải Pyodide: ' + err.message)
                console.error('Pyodide init error:', err)
                pyodideInitPromise = null
                return false
            }
        }())
        return pyodideInitPromise
    }

    // ── Console helpers ──────────────────────────────────────────────
    function appendConsole(text, type) {
        if (!consoleEl) return
        var line = document.createElement('div')
        line.className = 'py-0.5 ' + (
            type === 'error' ? 'text-red-400' :
            type === 'success' ? 'text-green-400' :
            type === 'output' ? 'text-slate-100' :
            'text-slate-400'
        )
        line.textContent = text
        consoleEl.appendChild(line)
        consoleEl.scrollTop = consoleEl.scrollHeight
    }

    function clearConsole() {
        if (consoleEl) consoleEl.innerHTML = ''
    }

    // ── Run Python helper ───────────────────────────────────────────
    async function runPythonWithStdin(code, stdin) {
        return await pyodide.runPythonAsync(
            'import sys\nfrom io import StringIO\n' +
            'sys.stdin = StringIO(' + JSON.stringify(stdin || '') + ')\n' +
            '_out = StringIO()\nsys.stdout = _out\n' +
            'try:\n    _ = 0\n' +
            code.split('\n').map(function (line) { return '    ' + line }).join('\n') + '\n' +
            'except Exception:\n    import traceback\n    traceback.print_exc()\n' +
            'sys.stdout = sys.__stdout__\n_out.getvalue()'
        )
    }

    // ── Run code — chạy public test cases ────────────────────────────
    async function runCode() {
        if (!pyodide || !editorView) {
            appendConsole('⚠️ Python runtime chưa sẵn sàng. Vui lòng đợi...', 'error')
            if (!pyodide) await initPyodide()
            if (!pyodide) return
        }

        var code = editorView.state.doc.toString()

        if (publicTests.length === 0) {
            clearConsole()
            appendConsole('▶ Đang chạy...')
            try {
                var result = await runPythonWithStdin(code, '')
                var output = (result || '').trim()
                if (output) {
                    output.split('\n').forEach(function (line) { appendConsole(line, 'output') })
                } else {
                    appendConsole('✅ Code chạy thành công (không có output)', 'success')
                }
            } catch (err) {
                appendConsole('❌ Lỗi: ' + (err.message || String(err)), 'error')
            }
            return
        }

        clearConsole()
        appendConsole('▶ Đang chạy ' + publicTests.length + ' test cases...')
        switchTab('test-results')
        showTestResults([], 0, publicTests.length, true)

        var passed = 0
        var results = []

        for (var i = 0; i < publicTests.length; i++) {
            var tc = publicTests[i]
            var testLabel = 'Test: ' + (tc.stdin || '(empty input)')

            try {
                var output = await runPythonWithStdin(code, tc.stdin)
                var actualOutput = (output || '').trim()
                var expected = tc.expected_output.trim()
                var compMode = lessonData?.dataset.comparisonMode || 'exact'
                var epsilon = parseFloat(lessonData?.dataset.floatEpsilon || '0.001')
                var match = compareClientOutputs(actualOutput, expected, compMode, epsilon)

                if (match) {
                    passed++
                    results.push({ index: i, passed: true, label: testLabel })
                } else {
                    results.push({ index: i, passed: false, label: testLabel, expected: expected, actual: actualOutput })
                }
            } catch (err) {
                results.push({ index: i, passed: false, label: testLabel, error: err.message || String(err) })
            }
            showTestResults(results, passed, publicTests.length)
        }

        showTestResults(results, passed, publicTests.length)

        if (passed === publicTests.length) {
            appendConsole('✅ ' + passed + '/' + publicTests.length + ' test case đúng! Hãy nhấn "Nộp bài" để chạy ẩn test.', 'success')
        } else {
            appendConsole('📊 ' + passed + '/' + publicTests.length + ' test case đúng — sửa code rồi chạy lại.', 'info')
        }
    }

    // ── Run with custom input ───────────────────────────────────────
    async function runWithCustomInput(stdin) {
        if (!pyodide || !editorView) {
            appendConsole('⚠️ Python runtime chưa sẵn sàng.', 'error')
            return
        }
        var code = editorView.state.doc.toString()
        clearConsole()
        appendConsole('▶ Đang chạy với input tùy chỉnh...')
        switchTab('console')
        try {
            var result = await runPythonWithStdin(code, stdin)
            var output = (result || '').trim()
            if (output) {
                output.split('\n').forEach(function (line) { appendConsole(line, 'output') })
            } else {
                appendConsole('✅ Code chạy thành công (không có output)', 'success')
            }
        } catch (err) {
            appendConsole('❌ Lỗi: ' + (err.message || String(err)), 'error')
        }
    }

    // ── Submit (chạy test cases) ─────────────────────────────────────
    async function submitCode() {
        if (!pyodide || !editorView) {
            appendConsole('⚠️ Python runtime chưa sẵn sàng.', 'error')
            return
        }

        var code = editorView.state.doc.toString()

        if (testCases.length === 0) {
            clearConsole()
            appendConsole('📤 Đang đánh dấu bài học...')
            try {
                var token = localStorage.getItem('auth_token')
                if (!token) {
                    appendConsole('⚠️ Vui lòng đăng nhập để lưu tiến độ.', 'error')
                    return
                }
                var res = await fetch('/api/hoc-python/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ lessonId: lessonId, sourceCode: code, outputs: [] }),
                })
                var data = await res.json()
                if (data.passed !== false) {
                    appendConsole('✅ Đã đánh dấu bài học là hoàn thành! +' + (data.xpAwarded || 0) + ' XP', 'success')
                    var quizCorrect = 0
                    var quizTotal = quizQuestions.length
                    if (quizTotal > 0) {
                        document.querySelectorAll('.quiz-question').forEach(function (qEl) {
                            var correctIdx = parseInt(qEl.dataset.correct || '0')
                            var correctRadio = qEl.querySelector('input[type="radio"][value="' + correctIdx + '"]')
                            if (correctRadio && correctRadio.checked) quizCorrect++
                        })
                        if (quizCorrect === quizTotal) {
                            appendConsole('🎯 Trắc nghiệm: ' + quizCorrect + '/' + quizTotal + ' — xuất sắc!', 'success')
                        } else {
                            appendConsole('📊 Trắc nghiệm: ' + quizCorrect + '/' + quizTotal + ' câu đúng', 'info')
                        }
                    }
                    if (data.newAchievements && data.newAchievements.length > 0) {
                        appendConsole('🏅 Mở khoá thành tích: ' + data.newAchievements.join(', '), 'success')
                    }
                    markLessonCompleted()
                } else {
                    appendConsole('⚠️ ' + (data.error || 'Lỗi không xác định'), 'error')
                }
            } catch (err) {
                appendConsole('❌ Lỗi kết nối: ' + err.message, 'error')
            }
            return
        }

        clearConsole()
        var totalTests = testCases.length
        var hiddenCount = hiddenTests.length
        appendConsole('📤 Đang nộp bài và chạy ' + totalTests + ' test cases (trong đó ' + hiddenCount + ' ẩn)...')

        switchTab('test-results')
        showTestResults([], 0, totalTests, true)

        var passed = 0
        var results = []
        var outputs = []

        for (var i = 0; i < testCases.length; i++) {
            var tc = testCases[i]
            var testLabel = tc.is_hidden ? 'Test #' + (i + 1) + ' (ẩn)' : 'Test: ' + (tc.stdin || '(empty input)')

            try {
                var output = await runPythonWithStdin(code, tc.stdin)
                var actualOutput = (output || '').trim()
                outputs.push(actualOutput)

                if (tc.is_hidden) {
                    // Hidden test: chỉ chạy để lấy output, KHÔNG chấm trên client (không có đáp án) — server chấm
                    results.push({ index: i, pending: true, label: testLabel })
                } else {
                    var expected = tc.expected_output.trim()
                    var compMode = lessonData?.dataset.comparisonMode || 'exact'
                    var epsilon = parseFloat(lessonData?.dataset.floatEpsilon || '0.001')
                    var match = compareClientOutputs(actualOutput, expected, compMode, epsilon)

                    if (match) {
                        passed++
                        results.push({ index: i, passed: true, label: testLabel })
                    } else {
                        results.push({ index: i, passed: false, label: testLabel, expected: expected, actual: actualOutput })
                    }
                }
            } catch (err) {
                outputs.push('')
                results.push({ index: i, passed: false, label: testLabel, error: err.message || String(err) })
            }
            showTestResults(results, passed, testCases.length)
        }

        // Gửi output lên server để chấm (kể cả hidden tests) — kết quả chính thức từ server
        var token = localStorage.getItem('auth_token')
        var data = null
        try {
            var res = await fetch('/api/hoc-python/submit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token ? { Authorization: 'Bearer ' + token } : {}),
                },
                body: JSON.stringify({ lessonId: lessonId, sourceCode: code, outputs: outputs }),
            })
            data = await res.json()

            if (res.status === 401 && data.error === 'Unauthorized') {
                localStorage.removeItem('auth_token')
                window.location.href = '/?login=true'
                return
            }
        } catch (err) {
            appendConsole('❌ Lỗi kết nối: ' + (err.message || String(err)), 'error')
        }

        if (data && Array.isArray(data.results)) {
            // Hiển thị kết quả chính thức — hidden test không lộ expected/actual
            var serverResults = data.results.map(function (r, idx) {
                var tc = testCases[idx]
                var label = tc ? (tc.is_hidden ? 'Test #' + (idx + 1) + ' (ẩn)' : 'Test: ' + (tc.stdin || '(empty input)')) : 'Test #' + (idx + 1)
                var obj = { index: idx, passed: !!r.passed, label: label }
                if (r.error) obj.error = r.error
                if (!tc || !tc.is_hidden) {
                    if (r.expected !== undefined) obj.expected = r.expected
                    if (r.actual !== undefined) obj.actual = r.actual
                }
                return obj
            })
            var serverPassed = serverResults.filter(function (r) { return r.passed }).length
            showTestResults(serverResults, serverPassed, testCases.length)

            if (data.passed) {
                appendConsole('🎉 Hoàn thành ' + serverPassed + '/' + testCases.length + ' test case (gồm ' + hiddenCount + ' ẩn)!', 'success')
                markLessonCompleted()
            } else {
                appendConsole('📊 Kết quả: ' + serverPassed + '/' + testCases.length + ' test case đúng', 'info')
            }
            if (data.xpAwarded > 0) appendConsole('🏆 Đã nhận +' + data.xpAwarded + ' XP!', 'success')
            if (data.newAchievements && data.newAchievements.length > 0)
                appendConsole('🏅 Mở khoá thành tích: ' + data.newAchievements.join(', '), 'success')
            if (data.error) appendConsole('⚠️ ' + data.error, 'error')
        } else if (data && data.error) {
            appendConsole('⚠️ ' + data.error, 'error')
        }
    }

    // ── Test results UI (enhanced with diff view) ───────────────────
    function showTestResults(results, passed, total, loading) {
        if (!testResultsEl) return

        var label = document.getElementById('test-tab-label')
        if (label) label.textContent = '✓ ' + passed + '/' + total

        if (loading) {
            testResultsEl.innerHTML =
                '<div class="text-slate-400 text-center py-4">' +
                '<div class="animate-spin rounded-full h-6 w-6 border-2 border-[#3776AB] border-t-transparent mx-auto mb-2"></div>' +
                'Đang chạy test cases...</div>'
            return
        }

        var allPassed = total > 0 && passed === total
        var html = '<div class="mb-3 flex items-center gap-2 text-sm font-bold">' +
            '<span class="' + (allPassed ? 'text-green-400' : total > 0 ? 'text-yellow-400' : 'text-slate-400') + '">' +
            (allPassed ? '✅' : total > 0 ? '⚠️' : '—') + '</span>' +
            '<span class="text-slate-200">' + passed + '/' + total + '</span>' +
            '<span class="text-slate-400 font-normal">test case đúng</span></div>'

        if (results.length === 0) {
            html += '<div class="text-slate-500 italic">Không có test case nào.</div>'
        }

        results.forEach(function (r, idx) {
            if (r.pending) {
                html += '<div class="flex items-center gap-2 py-1.5 text-slate-400">' +
                    '<span class="shrink-0 w-5 h-5 rounded-full bg-slate-500/10 flex items-center justify-center text-xs">⏳</span>' +
                    '<span class="text-xs">' + escapeHtml(r.label) + ' — đang chờ kết quả server</span></div>'
                return
            }
            if (r.passed) {
                html += '<div class="flex items-center gap-2 py-1.5 text-green-400">' +
                    '<span class="shrink-0 w-5 h-5 rounded-full bg-green-500/10 flex items-center justify-center text-xs">✓</span>' +
                    '<span class="text-xs">' + escapeHtml(r.label) + '</span></div>'
            } else {
                html += '<div class="py-1.5 border-b border-[#313244] last:border-b-0">' +
                    '<div class="flex items-center gap-2 text-red-400">' +
                    '<span class="shrink-0 w-5 h-5 rounded-full bg-red-500/10 flex items-center justify-center text-xs">✗</span>' +
                    '<span class="text-xs font-medium">' + escapeHtml(r.label) + '</span></div>' +
                    '<div class="ml-7 text-xs space-y-1 mt-1.5">'

                if (r.error) {
                    html += '<div class="text-red-400 bg-red-500/5 px-2 py-1 rounded font-mono text-[11px]">Lỗi: ' + escapeHtml(r.error) + '</div>'
                }
                if (r.expected !== undefined) {
                    html += '<div class="flex items-start gap-2"><span class="text-slate-500 shrink-0 mt-0.5">Kỳ vọng:</span>' +
                        '<span class="text-slate-200 bg-slate-800/50 px-2 py-0.5 rounded font-mono text-[11px] whitespace-pre-wrap">' + escapeHtml(r.expected) + '</span></div>'
                }
                if (r.actual !== undefined) {
                    html += '<div class="flex items-start gap-2"><span class="text-slate-500 shrink-0 mt-0.5">Nhận được:</span>' +
                        '<span class="text-yellow-300 bg-yellow-500/5 px-2 py-0.5 rounded font-mono text-[11px] whitespace-pre-wrap">' + escapeHtml(r.actual) + '</span></div>'
                }

                if (r.expected !== undefined && r.actual !== undefined && !r.error) {
                    var linesExpected = r.expected.split('\n')
                    var linesActual = r.actual.split('\n')
                    var diffHtml = ''
                    var maxLines = Math.max(linesExpected.length, linesActual.length)
                    for (var d = 0; d < Math.min(maxLines, 5); d++) {
                        var eLine = linesExpected[d] || ''
                        var aLine = linesActual[d] || ''
                        if (eLine !== aLine) {
                            diffHtml += '<div class="flex gap-2">' +
                                '<span class="text-red-400/70">- ' + escapeHtml(eLine || '(trống)') + '</span></div>' +
                                '<div class="flex gap-2">' +
                                '<span class="text-green-400/70">+ ' + escapeHtml(aLine || '(trống)') + '</span></div>'
                        } else {
                            diffHtml += '<div class="text-slate-600">  ' + escapeHtml(eLine) + '</div>'
                        }
                    }
                    if (diffHtml) {
                        html += '<details class="mt-1"><summary class="text-slate-500 hover:text-slate-300 cursor-pointer text-[11px]">Xem diff chi tiết</summary>' +
                            '<pre class="bg-[#11111b] rounded-lg p-2 mt-1 text-[11px] font-mono leading-relaxed border border-[#313244]">' + diffHtml + '</pre></details>'
                    }
                }

                html += '</div></div>'
            }
        })

        if (allPassed && !nextLesson) {
            html += '<div class="mt-5 pt-4 border-t border-[#313244]">' +
                '<div class="text-sm text-green-400 font-semibold">🎉 Chúc mừng! Bạn đã hoàn thành khóa học!</div>' +
                '<a href="/hoc-python/khoa-hoc/' + courseSlug + '" class="mt-2 inline-flex items-center gap-2 text-sm font-medium text-slate-400 hover:text-white transition-colors">← Về trang khóa học</a></div>'
        }

        testResultsEl.innerHTML = html
    }

    // ── Tab switching ────────────────────────────────────────────────
    function switchTab(tabId) {
        document.querySelectorAll('.result-tab').forEach(function (t) {
            t.classList.remove('active', 'text-[#a6e3a1]', 'border-[#a6e3a1]')
            t.classList.add('text-slate-500', 'border-transparent')
        })
        document.querySelectorAll('.result-pane').forEach(function (p) { p.classList.add('hidden') })

        var tabBtn = document.querySelector('.result-tab[data-tab="' + tabId + '"]')
        if (tabBtn) {
            tabBtn.classList.remove('text-slate-500', 'border-transparent')
            tabBtn.classList.add('text-[#a6e3a1]', 'border-[#a6e3a1]')
        }

        var pane = document.getElementById('tab-' + tabId)
        if (pane) pane.classList.remove('hidden')
    }

    // ── Reset code ────────────────────────────────────────────────────
    function resetCode() {
        if (editorView) {
            editorView.dispatch({ changes: { from: 0, to: editorView.state.doc.length, insert: starterCode } })
        }
    }

    // ── Split Pane Resize ────────────────────────────────────────────
    function initSplitPane() {
        var handle = document.getElementById('split-handle')
        var lessonPanel = document.getElementById('lesson-panel')
        var editorPanel = document.getElementById('editor-panel')
        var workspace = document.getElementById('workspace')
        if (!handle || !lessonPanel || !editorPanel || !workspace) return

        var dragging = false
        var startX = 0
        var startWidth = 0

        handle.addEventListener('mousedown', function (e) {
            e.preventDefault()
            dragging = true
            startX = e.clientX
            startWidth = lessonPanel.getBoundingClientRect().width
            document.body.style.cursor = 'col-resize'
            document.body.style.userSelect = 'none'
        })

        document.addEventListener('mousemove', function (e) {
            if (!dragging) return
            var dx = e.clientX - startX
            var totalWidth = workspace.getBoundingClientRect().width
            var newWidth = Math.max(280, Math.min(totalWidth - 300, startWidth + dx))
            var pct = (newWidth / totalWidth * 100).toFixed(1)
            lessonPanel.style.width = pct + '%'
            lessonPanel.style.flexShrink = '0'
            editorPanel.style.flex = '1'
        })

        document.addEventListener('mouseup', function () {
            if (dragging) {
                dragging = false
                document.body.style.cursor = ''
                document.body.style.userSelect = ''
            }
        })

        // Touch support
        handle.addEventListener('touchstart', function (e) {
            dragging = true
            startX = e.touches[0].clientX
            startWidth = lessonPanel.getBoundingClientRect().width
        }, { passive: true })

        document.addEventListener('touchmove', function (e) {
            if (!dragging) return
            var dx = e.touches[0].clientX - startX
            var totalWidth = workspace.getBoundingClientRect().width
            var newWidth = Math.max(280, Math.min(totalWidth - 300, startWidth + dx))
            var pct = (newWidth / totalWidth * 100).toFixed(1)
            lessonPanel.style.width = pct + '%'
            lessonPanel.style.flexShrink = '0'
            editorPanel.style.flex = '1'
        }, { passive: true })

        document.addEventListener('touchend', function () { dragging = false })
    }

    // ── Console Resize ──────────────────────────────────────────────
    function initConsoleResize() {
        var handle = document.getElementById('console-resize-handle')
        var consolePanel = document.getElementById('console-panel')
        if (!handle || !consolePanel) return

        var dragging = false
        var startY = 0
        var startHeight = 0

        handle.addEventListener('mousedown', function (e) {
            e.preventDefault()
            dragging = true
            startY = e.clientY
            startHeight = consolePanel.getBoundingClientRect().height
            document.body.style.cursor = 'row-resize'
            document.body.style.userSelect = 'none'
        })

        document.addEventListener('mousemove', function (e) {
            if (!dragging) return
            var dy = startY - e.clientY
            var newHeight = Math.max(100, Math.min(500, startHeight + dy))
            consolePanel.style.height = newHeight + 'px'
            var panes = consolePanel.querySelectorAll('.result-pane')
            var tabHeight = consolePanel.querySelector('.bg-\\[\\#181825\\]')
            var reserved = tabHeight ? tabHeight.getBoundingClientRect().height + 5 : 56
            panes.forEach(function (p) { p.style.height = 'calc(' + newHeight + 'px - ' + reserved + 'px)' })
        })

        document.addEventListener('mouseup', function () {
            if (dragging) {
                dragging = false
                document.body.style.cursor = ''
                document.body.style.userSelect = ''
            }
        })
    }

    // ── Mobile sidebar toggle ───────────────────────────────────────
    function initMobileSidebar() {
        var toggle = document.getElementById('sidebarToggle')
        var lessonPanel = document.getElementById('lesson-panel')
        var editorPanel = document.getElementById('editor-panel')
        if (!toggle || !lessonPanel || !editorPanel) return

        var showingLesson = true

        toggle.addEventListener('click', function () {
            showingLesson = !showingLesson
            if (showingLesson) {
                lessonPanel.style.display = ''
                editorPanel.style.height = ''
                toggle.textContent = '💻'
            } else {
                lessonPanel.style.display = 'none'
                editorPanel.style.height = '100%'
                toggle.textContent = '📖'
            }
        })
    }

    // ── Custom Input Modal ──────────────────────────────────────────
    function initCustomInput() {
        var overlay = document.getElementById('custom-input-overlay')
        var cancelBtn = document.getElementById('custom-input-cancel')
        var runBtnCustom = document.getElementById('custom-input-run')
        var inputField = document.getElementById('custom-input-text')

        if (!overlay || !cancelBtn || !runBtnCustom || !inputField) return

        if (publicTests.length === 0 && customInputBtn) {
            customInputBtn.classList.remove('hidden')
        }

        customInputBtn?.addEventListener('click', function () {
            overlay.classList.remove('hidden')
            inputField.focus()
        })

        cancelBtn.addEventListener('click', function () { overlay.classList.add('hidden') })
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) overlay.classList.add('hidden')
        })
        runBtnCustom.addEventListener('click', function () {
            overlay.classList.add('hidden')
            runWithCustomInput(inputField.value)
        })
    }

    // ── Event Listeners ──────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', async function () {
        document.querySelectorAll('.result-tab').forEach(function (tab) {
            tab.addEventListener('click', function () { switchTab(tab.dataset.tab) })
        })

        await initEditor()
        initPyodide()
        initSplitPane()
        initConsoleResize()
        initMobileSidebar()
        initCustomInput()

        if (lessonData?.dataset.isTheory === 'true') {
            appendConsole('📖 Đây là bài học lý thuyết. Đọc nội dung bên trái và thử chạy code mẫu bằng nút "▶ Chạy"!', 'info')
        }

        runBtn?.addEventListener('click', runCode)
        submitBtn?.addEventListener('click', submitCode)
        resetBtn?.addEventListener('click', resetCode)
        nextLessonBtn?.addEventListener('click', goToNextLesson)

        var nextLink = document.getElementById('nextLessonLink')
        if (nextLink) {
            nextLink.addEventListener('click', function (e) {
                if (!isLessonCompleted()) { e.preventDefault(); showSkipWarning() }
            })
        }

        updateNextButtonState()

        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); runCode() }
        })

        // ── Quiz interaction ──────────────────────────────────────────
        if (quizQuestions.length > 0) {
            var correctCount = 0
            var totalQuestions = quizQuestions.length
            var quizContainer = document.getElementById('quiz-container')

            quizContainer?.querySelectorAll('.quiz-question').forEach(function (qEl) {
                var qIndex = parseInt(qEl.dataset.qindex || '0')
                var correctIdx = parseInt(qEl.dataset.correct || '0')
                var answeredCorrectly = false
                /** @type {HTMLElement} */
                var feedbackEl = qEl.querySelector('.quiz-feedback')

                qEl.querySelectorAll('input[type="radio"]').forEach(function (radio) {
                    radio.addEventListener('change', function () {
                        if (answeredCorrectly) return

                        var selectedIdx = parseInt(this.value)
                        var isCorrect = selectedIdx === correctIdx

                        qEl.querySelectorAll('.quiz-option').forEach(function (optEl) {
                            optEl.className = 'quiz-option flex items-start gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer transition-all duration-150 hover:border-[#3776AB]/40 hover:bg-blue-50/30'
                            var radioInput = /** @type {HTMLInputElement|null} */ (optEl.querySelector('input'))
                            if (radioInput) radioInput.disabled = false
                        })

                        if (isCorrect) {
                            answeredCorrectly = true
                            qEl.querySelectorAll('.quiz-option').forEach(function (optEl) {
                                var lbl = /** @type {HTMLLabelElement} */ (optEl)
                                var optIdx = parseInt(lbl.dataset.optindex || '0')
                                if (optIdx === correctIdx) {
                                    lbl.className = 'quiz-option flex items-start gap-3 p-3 rounded-xl border-2 border-emerald-400 bg-emerald-50'
                                } else {
                                    lbl.className = 'quiz-option flex items-start gap-3 p-3 rounded-xl border border-slate-100 bg-slate-50/50 opacity-60'
                                }
                                /** @type {HTMLInputElement} */ (lbl.querySelector('input')).disabled = true
                            })
                            correctCount++
                        } else {
                            qEl.querySelectorAll('.quiz-option').forEach(function (optEl) {
                                var optIdx = parseInt(/** @type {HTMLElement} */ (optEl).dataset.optindex || '0')
                                if (optIdx === selectedIdx) {
                                    /** @type {HTMLLabelElement} */ (optEl).className = 'quiz-option flex items-start gap-3 p-3 rounded-xl border-2 border-red-300 bg-red-50'
                                }
                            })
                        }

                        if (feedbackEl) {
                            var q = quizQuestions[qIndex]
                            if (isCorrect) {
                                feedbackEl.className = 'quiz-feedback ml-8 mt-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 bg-emerald-50 border border-emerald-200 text-emerald-700'
                                feedbackEl.innerHTML = '✅ <strong>Đúng!</strong> ' + escapeHtml(q.explanation)
                            } else {
                                feedbackEl.className = 'quiz-feedback ml-8 mt-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 bg-red-50 border border-red-200 text-red-700'
                                feedbackEl.innerHTML = '❌ <strong>Sai!</strong> Đáp án đúng là <strong>' + escapeHtml(q.options[correctIdx]) + '</strong>. ' + escapeHtml(q.explanation)
                            }
                            feedbackEl.classList.remove('hidden')
                        }

                        var headerEl = document.getElementById('quiz-header-title')
                        if (headerEl) {
                            var remaining = totalQuestions - correctCount
                            if (remaining === 0) {
                                headerEl.textContent = '🎉 Hoàn thành! Bạn đã trả lời đúng ' + correctCount + '/' + totalQuestions + ' câu.'
                                headerEl.className = 'text-emerald-200 text-xs mt-0.5'
                            } else if (correctCount > 0) {
                                headerEl.textContent = '✅ Đã đúng ' + correctCount + '/' + totalQuestions + ' — còn ' + remaining + ' câu'
                            } else {
                                headerEl.textContent = '📝 Đây là bài tự kiểm tra — nhấn "Nộp bài" để hoàn thành'
                            }
                        }
                    })
                })
            })
        }
    })
</script>

