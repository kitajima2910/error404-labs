---
import MainLayout from '../../../layouts/MainLayout.astro'
import PyNav from '../../../components/python/PyNav.astro'
import PyIcon from '../../../components/python/PyIcon.astro'
import IconPython from '../../../icons/IconPython.astro'
import { TC_TITLE } from '../../../common/TextConst'

// ── Neon DB ───────────────────────────────────────────────────────────
const { neon } = await import('@neondatabase/serverless')
const sql = neon(import.meta.env.DATABASE_URL)

const { slug } = Astro.params

interface Course {
    id: string
    title: string
    slug: string
    description: string
    difficulty: 'beginner' | 'intermediate' | 'advanced'
}

interface Chapter {
    id: string
    title: string
    description: string
    order_index: number
    min_level: number
    lessons: Lesson[]
}

interface Lesson {
    id: string
    title: string
    slug: string
    lesson_type: 'theory' | 'practice' | 'quiz' | 'project'
    difficulty: 'easy' | 'medium' | 'hard'
    xp_reward: number
    estimated_minutes: number
    order_index: number
    published: boolean
}

// Fetch course
const [course]: (Course | undefined)[] = await sql`
    SELECT id, title, slug, description, difficulty
    FROM error404labs.py_courses
    WHERE slug = ${slug} AND published = true
    LIMIT 1
`

if (!course) {
    return Astro.redirect('/404', 404)
}

// Fetch chapters + lessons
const chapters: Chapter[] = await sql`
    SELECT
        ch.id,
        ch.title,
        ch.description,
        ch.order_index,
        ch.min_level,
        COALESCE(
            json_agg(
                json_build_object(
                    'id', l.id,
                    'title', l.title,
                    'slug', l.slug,
                    'lesson_type', l.lesson_type,
                    'difficulty', l.difficulty,
                    'xp_reward', l.xp_reward,
                    'estimated_minutes', l.estimated_minutes,
                    'order_index', l.order_index,
                    'published', l.published
                )
                ORDER BY l.order_index ASC
            ) FILTER (WHERE l.id IS NOT NULL),
            '[]'::json
        ) AS lessons
    FROM error404labs.py_chapters ch
    LEFT JOIN error404labs.py_lessons l ON l.chapter_id = ch.id AND l.published = true
    WHERE ch.course_id = ${course.id}
    GROUP BY ch.id, ch.title, ch.description, ch.order_index, ch.min_level
    ORDER BY ch.order_index ASC
`

const diffLabel: Record<string, string> = {
    beginner: 'Cơ bản',
    intermediate: 'Trung cấp',
    advanced: 'Nâng cao',
}

const diffChip: Record<string, string> = {
    beginner: 'bg-emerald-500/15 text-emerald-200 border-emerald-300/30',
    intermediate: 'bg-amber-500/15 text-amber-200 border-amber-300/30',
    advanced: 'bg-rose-500/15 text-rose-200 border-rose-300/30',
}

const typeLabel: Record<string, string> = {
    theory: 'Lý thuyết',
    practice: 'Thực hành',
    quiz: 'Quiz',
    project: 'Dự án',
}

const typeColor: Record<string, string> = {
    theory: 'bg-sky-50 text-sky-700 border-sky-200',
    practice: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    quiz: 'bg-violet-50 text-violet-700 border-violet-200',
    project: 'bg-orange-50 text-orange-700 border-orange-200',
}

const typeIconColor: Record<string, string> = {
    theory: 'bg-sky-50 text-sky-600',
    practice: 'bg-emerald-50 text-emerald-600',
    quiz: 'bg-violet-50 text-violet-600',
    project: 'bg-orange-50 text-orange-600',
}

const diffLessonLabel: Record<string, string> = {
    easy: 'Dễ',
    medium: 'Trung bình',
    hard: 'Khó',
}

const diffLessonColor: Record<string, string> = {
    easy: 'text-emerald-600',
    medium: 'text-amber-600',
    hard: 'text-rose-600',
}

const totalLessons = chapters.reduce((sum, ch) => sum + ch.lessons.length, 0)
const totalXP = chapters.reduce((sum, ch) => sum + ch.lessons.reduce((s, l) => s + l.xp_reward, 0), 0)
const totalMinutes = chapters.reduce(
    (sum, ch) => sum + ch.lessons.reduce((s, l) => s + (l.estimated_minutes || 0), 0),
    0,
)
const firstLessonSlug = chapters[0]?.lessons?.[0]?.slug ?? null

// Đếm số bài theo loại để hiển thị "Khóa học bao gồm"
const typeCounts = chapters
    .flatMap((ch) => ch.lessons)
    .reduce<Record<string, number>>((acc, l) => {
        acc[l.lesson_type] = (acc[l.lesson_type] || 0) + 1
        return acc
    }, {})

const formatDuration = (minutes: number) => {
    if (!minutes) return '—'
    const h = Math.floor(minutes / 60)
    const m = minutes % 60
    return h > 0 ? `${h} giờ${m ? ` ${m} phút` : ''}` : `${m} phút`
}
---

<MainLayout title={`${course.title} | ${TC_TITLE}`} description={course.description || undefined}>
    <PyNav active="courses" />

    <!-- ── HERO ─────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden bg-[#0B1E33] text-white">
        <div
            class="absolute -top-32 -left-24 w-[420px] h-[420px] rounded-full bg-[#3776AB]/35 blur-[130px] pointer-events-none"
        >
        </div>
        <div class="relative max-w-7xl mx-auto px-4 py-10 md:py-14">
            <div class="lg:w-2/3 lg:pr-10">
                <nav
                    class="flex items-center gap-2 text-xs md:text-sm text-slate-400 mb-5 flex-wrap"
                    aria-label="Breadcrumb"
                >
                    <a href="/hoc-python" class="hover:text-white transition-colors no-underline">Học Python</a>
                    <span>/</span>
                    <a href="/hoc-python/khoa-hoc" class="hover:text-white transition-colors no-underline">Khóa học</a>
                    <span>/</span>
                    <span class="text-slate-200 truncate">{course.title}</span>
                </nav>

                <span
                    class={`inline-flex text-xs font-bold px-3 py-1 rounded-full border mb-4 ${diffChip[course.difficulty] || diffChip.beginner}`}
                >
                    {diffLabel[course.difficulty] || 'Cơ bản'}
                </span>

                <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight mb-4">{course.title}</h1>

                <p class="text-slate-300 text-base md:text-lg leading-relaxed mb-6">
                    {course.description || 'Không có mô tả'}
                </p>

                <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-slate-300">
                    <span class="inline-flex items-center gap-2"
                        ><PyIcon name="stack" class="w-4 h-4 text-[#FFD43B]" /> {chapters.length} chương</span
                    >
                    <span class="inline-flex items-center gap-2"
                        ><PyIcon name="theory" class="w-4 h-4 text-[#FFD43B]" /> {totalLessons} bài học</span
                    >
                    <span class="inline-flex items-center gap-2"
                        ><PyIcon name="clock" class="w-4 h-4 text-[#FFD43B]" /> {formatDuration(totalMinutes)}</span
                    >
                    <span class="inline-flex items-center gap-2"
                        ><PyIcon name="bolt" class="w-4 h-4 text-[#FFD43B]" /> {totalXP} XP</span
                    >
                </div>
            </div>
        </div>
    </section>

    <section class="bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 py-8 md:py-10 grid lg:grid-cols-3 gap-8 items-start">
            <!-- ── SIDEBAR CARD ─────────────────────────────────────── -->
            <aside class="lg:col-start-3 lg:row-start-1 lg:-mt-56 lg:sticky lg:top-[calc(var(--nav-h)+4.5rem)] relative z-10">
                <div
                    class="bg-white rounded-2xl border border-slate-200 shadow-[0_20px_50px_rgba(15,23,42,0.12)] overflow-hidden"
                >
                    <div
                        class="relative aspect-[16/9] bg-gradient-to-br from-[#3776AB] via-[#2B5E8A] to-[#1E4D73] flex items-center justify-center overflow-hidden"
                    >
                        <div class="absolute inset-0 py-cover-grid opacity-30"></div>
                        <div class="absolute w-40 h-40 rounded-full bg-[#FFD43B]/20 blur-3xl"></div>
                        <div
                            class="relative w-20 h-20 rounded-2xl bg-white/10 border border-white/15 backdrop-blur flex items-center justify-center shadow-2xl"
                        >
                            <IconPython class="w-12 h-12 text-[#FFD43B]" />
                        </div>
                    </div>

                    <div class="p-5 md:p-6">
                        <!-- Tiến độ (JS hiển thị khi đã đăng nhập) -->
                        <div id="courseProgress" class="hidden mb-5">
                            <div class="flex items-end justify-between mb-2">
                                <div>
                                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                        Tiến độ của bạn
                                    </p>
                                    <p class="text-sm text-slate-700 mt-0.5">
                                        <strong id="progressDone" class="text-slate-900">0</strong>/{totalLessons} bài hoàn
                                        thành
                                    </p>
                                </div>
                                <span id="progressPct" class="text-2xl font-extrabold text-[#3776AB]">0%</span>
                            </div>
                            <div class="h-2.5 bg-slate-100 rounded-full overflow-hidden">
                                <div
                                    id="progressBar"
                                    class="h-full bg-gradient-to-r from-[#3776AB] to-emerald-500 rounded-full transition-all duration-700"
                                    style="width: 0%"
                                >
                                </div>
                            </div>
                        </div>

                        {
                            chapters.length > 0 && firstLessonSlug && (
                                <a
                                    id="ctaBtn"
                                    href="#"
                                    data-course-slug={course.slug}
                                    data-auth-href={`/hoc-python/hoc/${course.slug}/${firstLessonSlug}`}
                                    class="py-cta py-cta-primary"
                                >
                                    Đăng ký miễn phí
                                </a>
                            )
                        }

                        <div class="grid grid-cols-2 gap-2 mt-3">
                            <a
                                href="/hoc-python/ca-nhan"
                                class="flex items-center justify-center gap-1.5 text-sm font-semibold text-slate-600 border border-slate-200 rounded-xl py-2.5 hover:border-[#3776AB] hover:text-[#3776AB] transition-colors no-underline"
                            >
                                👤 Thành tích
                            </a>
                            <a
                                href="/hoc-python/bang-xep-hang"
                                class="flex items-center justify-center gap-1.5 text-sm font-semibold text-slate-600 border border-slate-200 rounded-xl py-2.5 hover:border-[#3776AB] hover:text-[#3776AB] transition-colors no-underline"
                            >
                                🏆 Xếp hạng
                            </a>
                        </div>

                        <div class="mt-6 pt-5 border-t border-slate-100">
                            <p class="text-sm font-extrabold text-slate-800 mb-3">Khóa học bao gồm</p>
                            <ul class="space-y-2.5 text-sm text-slate-600">
                                <li class="flex items-start gap-2.5">
                                    <PyIcon name="theory" class="w-4 h-4 text-slate-400 mt-0.5 shrink-0" />
                                    <span>
                                        {totalLessons} bài học
                                        {
                                            Object.keys(typeCounts).length > 1 && (
                                                <span class="text-slate-400">
                                                    (
                                                    {Object.entries(typeCounts)
                                                        .map(([t, n]) => `${n} ${(typeLabel[t] || t).toLowerCase()}`)
                                                        .join(' · ')}
                                                    )
                                                </span>
                                            )
                                        }
                                    </span>
                                </li>
                                <li class="flex items-center gap-2.5">
                                    <PyIcon name="clock" class="w-4 h-4 text-slate-400 shrink-0" /> Thời lượng khoảng {
                                        formatDuration(totalMinutes)
                                    }
                                </li>
                                <li class="flex items-center gap-2.5">
                                    <PyIcon name="bolt" class="w-4 h-4 text-slate-400 shrink-0" /> Tổng cộng {totalXP} XP
                                </li>
                                <li class="flex items-center gap-2.5">
                                    <PyIcon name="check" class="w-4 h-4 text-slate-400 shrink-0" /> Chấm điểm tự động bằng
                                    test case
                                </li>
                                <li class="flex items-center gap-2.5">
                                    <PyIcon name="practice" class="w-4 h-4 text-slate-400 shrink-0" /> Code trực tiếp trên
                                    trình duyệt
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- ── MAIN ─────────────────────────────────────────────── -->
            <div class="lg:col-span-2 lg:row-start-1 space-y-8 min-w-0">
                {
                    chapters.length > 0 && (
                        <div class="bg-white rounded-2xl border border-slate-200 p-5 md:p-7">
                            <h2 class="text-xl font-extrabold text-slate-900 mb-5">Bạn sẽ học được gì?</h2>
                            <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-4">
                                {chapters.map((chapter) => (
                                    <li class="flex items-start gap-3">
                                        <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                                            <PyIcon name="check" class="w-3.5 h-3.5" />
                                        </span>
                                        <div>
                                            <p class="text-sm font-bold text-slate-800">{chapter.title}</p>
                                            {chapter.description && (
                                                <p class="text-sm text-slate-500 leading-relaxed mt-0.5">
                                                    {chapter.description}
                                                </p>
                                            )}
                                        </div>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )
                }

                <div>
                    <div class="flex items-end justify-between gap-4 mb-4">
                        <div>
                            <h2 class="text-xl font-extrabold text-slate-900">Nội dung khóa học</h2>
                            <p class="text-sm text-slate-500 mt-1">
                                {chapters.length} chương · {totalLessons} bài học · {formatDuration(totalMinutes)}
                            </p>
                        </div>
                        {
                            chapters.length > 1 && (
                                <button
                                    id="toggleAllChapters"
                                    type="button"
                                    class="text-sm font-bold text-[#3776AB] hover:underline shrink-0"
                                >
                                    Mở rộng tất cả
                                </button>
                            )
                        }
                    </div>

                    <!-- Chapter List -->
                    <div class="space-y-3">
                        {
                            chapters.map((chapter, idx) => (
                                <details
                                    class="chapter-item group bg-white rounded-2xl border border-slate-200 overflow-hidden open:shadow-md transition-shadow duration-300"
                                    open={idx === 0}
                                >
                                    <summary class="flex items-center gap-4 px-5 py-4 cursor-pointer hover:bg-slate-50 transition-colors list-none [&::-webkit-details-marker]:hidden">
                                        <span class="w-10 h-10 rounded-xl bg-[#3776AB]/10 text-[#3776AB] font-extrabold text-sm flex items-center justify-center shrink-0">
                                            {String(idx + 1).padStart(2, '0')}
                                        </span>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <h3 class="font-bold text-slate-800 text-base">{chapter.title}</h3>
                                                {chapter.min_level > 1 && (
                                                    <span
                                                        class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200"
                                                        title="Yêu cầu cấp độ"
                                                    >
                                                        <PyIcon name="lock" class="w-3 h-3" /> Level {chapter.min_level}
                                                        +
                                                    </span>
                                                )}
                                            </div>
                                            <p class="text-xs text-slate-500 mt-0.5">
                                                {chapter.lessons.length} bài học
                                                <span class="chapter-progress" data-chapter-id={chapter.id} />
                                            </p>
                                        </div>
                                        <PyIcon
                                            name="chevron"
                                            class="w-5 h-5 text-slate-400 shrink-0 transition-transform duration-300 group-open:rotate-180"
                                        />
                                    </summary>

                                    <div class="border-t border-slate-100">
                                        {chapter.lessons.length === 0 && (
                                            <p class="p-5 text-sm text-slate-400 text-center">
                                                Chưa có bài học nào trong chương này.
                                            </p>
                                        )}

                                        <ol>
                                            {chapter.lessons.map((lesson, li) => (
                                                <li class="border-b border-slate-100 last:border-b-0">
                                                    <a
                                                        href={`/hoc-python/hoc/${course.slug}/${lesson.slug}`}
                                                        data-lesson-slug={lesson.slug}
                                                        data-chapter-id={chapter.id}
                                                        class="lesson-row flex items-center gap-4 px-5 py-3.5 hover:bg-[#3776AB]/[0.04] transition-colors group/lesson no-underline"
                                                    >
                                                        <span
                                                            class={`lesson-icon w-9 h-9 rounded-lg flex items-center justify-center shrink-0 transition-colors ${typeIconColor[lesson.lesson_type] || typeIconColor.practice}`}
                                                        >
                                                            <PyIcon
                                                                name={
                                                                    (lesson.lesson_type in typeLabel
                                                                        ? lesson.lesson_type
                                                                        : 'practice') as 'theory'
                                                                }
                                                                class="w-4 h-4"
                                                            />
                                                        </span>

                                                        <div class="flex-1 min-w-0">
                                                            <p class="font-semibold text-slate-700 text-sm group-hover/lesson:text-[#3776AB] transition-colors truncate">
                                                                <span class="text-slate-400 font-medium mr-1">
                                                                    {idx + 1}.{li + 1}
                                                                </span>
                                                                {lesson.title}
                                                            </p>
                                                            <div class="flex items-center gap-2 mt-1 flex-wrap">
                                                                <span
                                                                    class={`text-[10px] font-bold px-2 py-0.5 rounded-full border ${typeColor[lesson.lesson_type] || typeColor.practice}`}
                                                                >
                                                                    {typeLabel[lesson.lesson_type] || 'Thực hành'}
                                                                </span>
                                                                <span
                                                                    class={`text-[11px] font-semibold ${diffLessonColor[lesson.difficulty] || diffLessonColor.easy}`}
                                                                >
                                                                    {diffLessonLabel[lesson.difficulty] || 'Dễ'}
                                                                </span>
                                                                <span class="lesson-status text-[11px] font-semibold" />
                                                            </div>
                                                        </div>

                                                        <div class="hidden sm:flex items-center gap-4 text-xs text-slate-500 font-medium shrink-0">
                                                            <span class="inline-flex items-center gap-1 text-amber-600">
                                                                <PyIcon name="bolt" class="w-3.5 h-3.5" /> +
                                                                {lesson.xp_reward ?? 0}
                                                            </span>
                                                            <span class="inline-flex items-center gap-1 w-16 whitespace-nowrap">
                                                                <PyIcon
                                                                    name="clock"
                                                                    class="w-3.5 h-3.5 text-slate-400"
                                                                />{' '}
                                                                {lesson.estimated_minutes ?? '?'} phút
                                                            </span>
                                                        </div>
                                                        <span
                                                            class="text-slate-300 group-hover/lesson:text-[#3776AB] group-hover/lesson:translate-x-0.5 transition-all shrink-0"
                                                            aria-hidden="true"
                                                        >
                                                            <PyIcon name="play" class="w-4 h-4" />
                                                        </span>
                                                    </a>
                                                </li>
                                            ))}
                                        </ol>
                                    </div>
                                </details>
                            ))
                        }
                    </div>

                    {
                        chapters.length === 0 && (
                            <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-slate-300">
                                <div class="text-5xl mb-4">📭</div>
                                <h2 class="text-xl font-bold text-slate-600">Chương trình đang được xây dựng</h2>
                                <p class="text-slate-400 mt-2">Nội dung khóa học sẽ sớm được cập nhật.</p>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<script is:inline>
    ;(function () {
        var courseSlug = document.getElementById('ctaBtn')?.getAttribute('data-course-slug') || ''

        // Icon SVG dùng khi cập nhật trạng thái bài học
        var ICON_CHECK =
            '<svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>'
        var ICON_LOCK =
            '<svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/></svg>'

        // Trạng thái nút CTA
        var CTA_BASE = 'py-cta '
        function setCta(btn, variant, text) {
            btn.className = CTA_BASE + variant
            btn.textContent = text
        }

        function setGuestMode(btn) {
            setCta(btn, 'py-cta-primary', 'Đăng ký miễn phí')
            btn.href = '#'
            btn.onclick = function (e) {
                e.preventDefault()
                var m = document.getElementById('loginModal')
                if (m) {
                    m.classList.remove('hidden')
                    m.classList.add('flex')
                    document.body.classList.add('overflow-hidden')
                }
            }
        }

        function setContinueMode(btn, token) {
            // Fetch progress để tìm bài chưa hoàn thành đầu tiên
            fetch('/api/hoc-python/progress?courseSlug=' + encodeURIComponent(courseSlug), {
                headers: { Authorization: 'Bearer ' + token },
            })
                .then(function (r) {
                    return r.json()
                })
                .then(function (data) {
                    if (data.progress) {
                        var lessons = Object.entries(data.progress)
                        var firstIncomplete = lessons.find(function (e) {
                            return e[1] !== 'completed'
                        })
                        if (firstIncomplete) {
                            var started = lessons.some(function (e) {
                                return e[1] === 'completed'
                            })
                            setCta(btn, 'py-cta-primary', started ? 'Tiếp tục học →' : 'Bắt đầu học →')
                            btn.href = '/hoc-python/hoc/' + courseSlug + '/' + firstIncomplete[0]
                            btn.onclick = null
                        } else {
                            setCompletedMode(btn)
                        }
                    } else {
                        setEnrolledStatic(btn)
                    }
                })
                .catch(function () {
                    setEnrolledStatic(btn)
                })
        }

        function setCompletedMode(btn) {
            setCta(btn, 'py-cta-success', '✓ Đã hoàn thành khóa học')
            btn.href = '#'
            btn.onclick = function (e) {
                e.preventDefault()
            }
        }

        function setEnrolledStatic(btn) {
            setCta(btn, 'py-cta-success', 'Đã đăng ký ✓')
            btn.href = '#'
            btn.onclick = function (e) {
                e.preventDefault()
            }
        }

        function setNotEnrolledMode(btn, token) {
            var self = function (e) {
                e.preventDefault()
                setCta(btn, 'py-cta-primary', 'Đang đăng ký...')
                btn.onclick = null
                fetch('/api/hoc-python/enroll', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
                    body: JSON.stringify({ courseSlug: courseSlug }),
                })
                    .then(function (r) {
                        return r.json()
                    })
                    .then(function (data) {
                        if (data.success) {
                            setContinueMode(btn, token)
                            updateLessonStatus()
                        } else {
                            setCta(btn, 'py-cta-primary', 'Đăng ký miễn phí')
                            btn.onclick = self
                        }
                    })
                    .catch(function () {
                        setCta(btn, 'py-cta-primary', 'Đăng ký miễn phí')
                        btn.onclick = self
                    })
            }
            setCta(btn, 'py-cta-primary', 'Đăng ký miễn phí')
            btn.onclick = self
        }

        function checkEnrollmentAndUpdate(btn, token) {
            fetch('/api/hoc-python/enrollment?courseSlug=' + encodeURIComponent(courseSlug), {
                headers: { Authorization: 'Bearer ' + token },
            })
                .then(function (r) {
                    if (r.status === 401) {
                        localStorage.removeItem('auth_token')
                        setGuestMode(btn)
                        return null
                    }
                    return r.json()
                })
                .then(function (data) {
                    if (data === null) return
                    if (data.enrolled) setContinueMode(btn, token)
                    else setNotEnrolledMode(btn, token)
                })
                .catch(function () {
                    localStorage.removeItem('auth_token')
                    setGuestMode(btn)
                })
        }

        function updateCta() {
            var btn = document.getElementById('ctaBtn')
            if (!btn) return
            var token = localStorage.getItem('auth_token')
            if (token) {
                checkEnrollmentAndUpdate(btn, token)
            } else {
                setGuestMode(btn)
            }
        }

        updateCta()

        // ── Cập nhật trạng thái bài học + tiến độ ─────────────────────
        function updateLessonStatus() {
            var token = localStorage.getItem('auth_token')
            if (!token) return
            fetch('/api/hoc-python/progress?courseSlug=' + encodeURIComponent(courseSlug), {
                headers: { Authorization: 'Bearer ' + token },
            })
                .then(function (r) {
                    return r.json()
                })
                .then(function (data) {
                    if (!data.progress) return
                    var chapterDone = {}
                    var done = 0
                    var total = 0
                    var currentMarked = false
                    document.querySelectorAll('a[data-lesson-slug]').forEach(function (link) {
                        var slug = link.getAttribute('data-lesson-slug')
                        var chapterId = link.getAttribute('data-chapter-id')
                        var status = data.progress[slug]
                        var icon = link.querySelector('.lesson-icon')
                        var statusEl = link.querySelector('.lesson-status')
                        total++
                        if (!(chapterId in chapterDone)) chapterDone[chapterId] = 0
                        if (status === 'completed') {
                            done++
                            chapterDone[chapterId]++
                            if (icon) {
                                icon.innerHTML = ICON_CHECK
                                icon.className =
                                    'lesson-icon w-9 h-9 rounded-lg flex items-center justify-center shrink-0 bg-emerald-500 text-white'
                            }
                            if (statusEl) {
                                statusEl.textContent = '· Đã hoàn thành'
                                statusEl.className = 'lesson-status text-[11px] font-semibold text-emerald-600'
                            }
                        } else if (status === 'locked' || status === 'level_locked') {
                            if (icon) {
                                icon.innerHTML = ICON_LOCK
                                icon.className =
                                    'lesson-icon w-9 h-9 rounded-lg flex items-center justify-center shrink-0 bg-slate-100 text-slate-400'
                            }
                            if (statusEl) {
                                statusEl.textContent = status === 'level_locked' ? '· Cần lên cấp' : '· Chưa mở khóa'
                                statusEl.className = 'lesson-status text-[11px] font-semibold text-slate-400'
                            }
                        } else if (!currentMarked) {
                            currentMarked = true
                            link.classList.add('bg-[#3776AB]/[0.06]')
                            if (icon) icon.className += ' ring-2 ring-[#3776AB] ring-offset-2'
                            if (statusEl) {
                                statusEl.textContent = '· Đang học'
                                statusEl.className = 'lesson-status text-[11px] font-bold text-[#3776AB]'
                            }
                        }
                    })

                    document.querySelectorAll('.chapter-progress').forEach(function (el) {
                        var id = el.getAttribute('data-chapter-id')
                        var count = document.querySelectorAll('a[data-chapter-id="' + id + '"]').length
                        if (count && chapterDone[id] !== undefined) {
                            el.textContent = ' · ' + chapterDone[id] + '/' + count + ' hoàn thành'
                            if (chapterDone[id] === count)
                                el.className = 'chapter-progress text-emerald-600 font-semibold'
                        }
                    })

                    var wrap = document.getElementById('courseProgress')
                    if (wrap && total > 0) {
                        var pct = Math.round((done / total) * 100)
                        wrap.classList.remove('hidden')
                        var doneEl = document.getElementById('progressDone')
                        var pctEl = document.getElementById('progressPct')
                        var bar = document.getElementById('progressBar')
                        if (doneEl) doneEl.textContent = String(done)
                        if (pctEl) pctEl.textContent = pct + '%'
                        if (bar) bar.style.width = pct + '%'
                    }
                })
                .catch(function () {})
        }

        updateLessonStatus()
        window.addEventListener('user-login', function () {
            updateCta()
            updateLessonStatus()
        })
        window.addEventListener('user-logout', function () {
            location.reload()
        })

        // ── Mở rộng / thu gọn tất cả chương ──────────────────────────
        var toggleAll = document.getElementById('toggleAllChapters')
        if (toggleAll) {
            toggleAll.addEventListener('click', function () {
                var items = document.querySelectorAll('.chapter-item')
                var anyClosed = Array.prototype.some.call(items, function (d) {
                    return !d.open
                })
                items.forEach(function (d) {
                    d.open = anyClosed
                })
                toggleAll.textContent = anyClosed ? 'Thu gọn tất cả' : 'Mở rộng tất cả'
            })
        }

        // Lesson links
        document.addEventListener('click', function (e) {
            var link = e.target.closest('a[href*="/hoc-python/hoc/"]')
            if (link && !localStorage.getItem('auth_token')) {
                e.preventDefault()
                var toast = document.getElementById('toastNotification')
                var msg = document.getElementById('toastMessage')
                var title = document.getElementById('toastTitle')
                var icon = document.getElementById('toastIcon')
                if (toast && msg && title && icon) {
                    var p = icon.querySelector('path')
                    toast.className = toast.className.replace(/border-\w+-\d+/g, '') + ' border-amber-500'
                    icon.className = 'text-amber-500'
                    if (p) p.setAttribute('d', 'M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z')
                    title.textContent = 'Cần đăng ký!'
                    msg.textContent = 'Vui lòng đăng ký miễn phí để học bài này.'
                    toast.classList.remove('translate-x-full', 'opacity-0')
                    setTimeout(function () {
                        toast.classList.add('translate-x-full', 'opacity-0')
                    }, 3000)
                }
            }
        })
    })()
</script>

