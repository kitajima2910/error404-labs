---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout title="HTML5 Editor Online" description="Trình soạn thảo HTML/CSS/JS trực tuyến với xem trước trực tiếp">
    <section class="min-h-screen bg-slate-50 py-8 px-4 md:px-8">
        <div class="max-w-[1600px] mx-auto h-[85vh]">
            <div class="flex flex-col md:flex-row gap-6 h-full">
                <aside class="w-full md:w-[450px] flex flex-col gap-4">
                    <div class="flex items-center justify-between gap-2">
                        <h2 class="text-2xl font-black text-slate-800 tracking-tight text-gradient">HTML5 EDITOR</h2>
                        <button id="runBtn" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg shadow transition-colors cursor-pointer">Chạy</button>
                    </div>
                    <div class="editor-panel flex-1 flex flex-col gap-2">
                        <label for="html" class="text-sm font-semibold text-slate-700">HTML</label>
                        <textarea id="html" class="flex-1 p-2 font-mono text-xs resize-none border border-slate-300 rounded-md" placeholder="Nhập HTML ở đây...">&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
&lt;meta charset="UTF-8"&gt;
&lt;title&gt;Tiêu đề&lt;/title&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;h1&gt;Chào thế giới!&lt;/h1&gt;
&lt;/body&gt;
&lt;/html&gt;</textarea>
                    </div>
                    <div class="editor-panel flex-1 flex flex-col gap-2">
                        <label for="css" class="text-sm font-semibold text-slate-700">CSS</label>
                        <textarea id="css" class="flex-1 p-2 font-mono text-xs resize-none border border-slate-300 rounded-md" placeholder="Nhập CSS ở đây...">body &#123;
    font-family: Arial, sans-serif;
    margin: 20px;
    background-color: #f4f4f4;
&#125;
h1 &#123;
    color: #333;
&#125;</textarea>
                    </div>
                    <div class="editor-panel flex-1 flex flex-col gap-2">
                        <label for="js" class="text-sm font-semibold text-slate-700">JS</label>
                        <textarea id="js" class="flex-1 p-2 font-mono text-xs resize-none border border-slate-300 rounded-md" placeholder="Nhập JavaScript ở đây...">document.addEventListener('DOMContentLoaded', function() &#123;
    console.log('JavaScript đã được loaded');
&#125;);</textarea>
                    </div>
                </aside>
                <main class="flex-1 flex flex-col bg-white rounded-3xl overflow-hidden shadow-2xl border border-slate-200">
                    <iframe id="preview" class="flex-1 w-full bg-slate-50 border-none" sandbox="allow-scripts allow-same-origin"></iframe>
                </main>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    .text-gradient {
        background: linear-gradient(to right, #1e293b, #4f46e5);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>

<script is:inline>
    const htmlEditor = document.getElementById('html');
    const cssEditor = document.getElementById('css');
    const jsEditor = document.getElementById('js');
    const previewIframe = document.getElementById('preview');

    function updatePreview() {
        const html = htmlEditor.value;
        const css = cssEditor.value;
        const js = jsEditor.value;

        // Create a full HTML document with the user's CSS and JS
        const fullHtml = '<!DOCTYPE html><html><head><meta charset="UTF-8"><style>' + css + '</style></head><body>' + html + '<script>' + js + '<\/script></body></html>';

        // Write directly into iframe document to avoid CSP restrictions on srcdoc
        const doc = previewIframe.contentDocument;
        doc.open();
        doc.write(fullHtml);
        doc.close();
    }

    // Update preview when Run button is clicked
    document.getElementById('runBtn').addEventListener('click', updatePreview);
</script>