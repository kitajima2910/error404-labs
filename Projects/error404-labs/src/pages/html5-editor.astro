---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout title="HTML5 Editor Online" description="Trình soạn thảo HTML/CSS/JS trực tuyến với xem trước trực tiếp">
    <section class="editor-wrap">
        <div class="editor-header">
            <h1 class="editor-logo">⟨/⟩ HTML5 Editor</h1>
            <button id="runBtn" class="run-btn">▶ Chạy</button>
        </div>
        <div class="editor-body">
            <div class="editor-left">
                <div class="tab-bar">
                    <button class="tab active" data-target="html">HTML</button>
                    <button class="tab" data-target="css">CSS</button>
                    <button class="tab" data-target="js">JS</button>
                </div>
                <div class="tab-content">
                    <textarea id="html" class="tab-pane active" placeholder="Nhập HTML ở đây...">&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
&lt;meta charset="UTF-8"&gt;
&lt;title&gt;Tiêu đề&lt;/title&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;h1&gt;Chào thế giới!&lt;/h1&gt;
&lt;/body&gt;
&lt;/html&gt;</textarea>
                    <textarea id="css" class="tab-pane" placeholder="Nhập CSS ở đây...">body &#123;
    font-family: Arial, sans-serif;
    margin: 20px;
    background-color: #f4f4f4;
&#125;
h1 &#123;
    color: #333;
&#125;</textarea>
                    <textarea id="js" class="tab-pane" placeholder="Nhập JavaScript ở đây...">document.addEventListener('DOMContentLoaded', function() &#123;
    console.log('JavaScript đã được loaded');
&#125;);</textarea>
                </div>
            </div>
            <div class="editor-right">
                <div class="preview-bar">
                    <span class="preview-label">Kết quả</span>
                </div>
                <iframe id="preview" name="preview-frame" class="preview-frame" sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-modals" src="/api/render"></iframe>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    .editor-wrap {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #1e1e2e;
    }
    .editor-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 20px;
        background: #181825;
        border-bottom: 1px solid #313244;
    }
    .editor-logo {
        font-size: 16px;
        font-weight: 700;
        color: #cdd6f4;
        letter-spacing: 0.5px;
    }
    .run-btn {
        padding: 8px 22px;
        background: #a6e3a1;
        color: #1e1e2e;
        font-weight: 700;
        font-size: 14px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
    }
    .run-btn:hover {
        background: #94e2d5;
    }
    .editor-body {
        flex: 1;
        display: flex;
        overflow: hidden;
    }
    .editor-left {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .tab-bar {
        display: flex;
        background: #1e1e2e;
        border-bottom: 1px solid #313244;
        padding: 0 12px;
    }
    .tab {
        padding: 10px 18px;
        font-size: 13px;
        font-weight: 600;
        color: #6c7086;
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s;
    }
    .tab:hover {
        color: #cdd6f4;
    }
    .tab.active {
        color: #a6e3a1;
        border-bottom-color: #a6e3a1;
    }
    .tab-content {
        flex: 1;
        position: relative;
        overflow: hidden;
    }
    .tab-pane {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        padding: 14px 16px;
        font-family: 'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'Consolas', monospace;
        font-size: 13px;
        line-height: 1.6;
        color: #cdd6f4;
        background: #1e1e2e;
        border: none;
        outline: none;
        resize: none;
        display: none;
    }
    .tab-pane.active {
        display: block;
    }
    .tab-pane::placeholder {
        color: #585b70;
    }
    .editor-right {
        width: 45%;
        min-width: 320px;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-left: 1px solid #313244;
    }
    .preview-bar {
        padding: 8px 16px;
        background: #f5f5f5;
        border-bottom: 1px solid #e0e0e0;
    }
    .preview-label {
        font-size: 12px;
        font-weight: 600;
        color: #555;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .preview-frame {
        flex: 1;
        width: 100%;
        border: none;
        background: #fff;
    }
</style>

<script is:inline>
    const htmlEditor = document.getElementById('html');
    const cssEditor = document.getElementById('css');
    const jsEditor = document.getElementById('js');
    const previewIframe = document.getElementById('preview');

    function updatePreview() {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/api/render';
        form.target = 'preview-frame';
        form.style.display = 'none';

        ['html', 'css', 'js'].forEach(function(name) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = document.getElementById(name).value;
            form.appendChild(input);
        });

        document.body.appendChild(form);
        form.submit();
        document.body.removeChild(form);
    }

    document.getElementById('runBtn').addEventListener('click', updatePreview);

    document.querySelectorAll('.tab').forEach(function(btn) {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.tab').forEach(function(b) { b.classList.remove('active'); });
            document.querySelectorAll('.tab-pane').forEach(function(p) { p.classList.remove('active'); });
            btn.classList.add('active');
            document.getElementById(btn.getAttribute('data-target')).classList.add('active');
        });
    });
</script>
