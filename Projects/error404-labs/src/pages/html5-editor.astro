---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'

const defaultHtml = `<!doctype html>
<html lang="vi">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Tiêu đề</title>
    </head>

    <body>
        <h1>Chào thế giới!</h1>
        <p>Bắt đầu viết HTML/CSS/JS ở đây.</p>
    </body>
</html>
`

const defaultCss = `:root {
    color-scheme: light;
}

body {
    margin: 0;
    padding: 24px;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    line-height: 1.6;
    background: #f6f7fb;
    color: #111827;
}

h1 {
    margin: 0 0 12px;
    font-size: 28px;
    letter-spacing: -0.02em;
}

p {
    margin: 0;
    color: #374151;
}
`

const defaultJs = `document.addEventListener('DOMContentLoaded', () => {
    console.log('JavaScript đã được load');
});
`

// Icon nét 24px (Heroicons) cho thanh công cụ
const ICON_CODE = 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5'
const ICON_FORMAT = 'M3.75 6.75h16.5M3.75 12H12m-8.25 5.25h16.5'
const ICON_RESET =
    'M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99'
const ICON_TRASH =
    'm14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0'
---

<MainLayout
    title={`HTML5 Editor – Viết HTML, CSS, JS trực tuyến | ${TC_TITLE}`}
    description="Trình soạn thảo HTML/CSS/JS trực tuyến với xem trước trực tiếp"
>
    <section class="editor-wrap">
        <div class="editor-header">
            <div class="editor-brand">
                <span class="editor-brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d={ICON_CODE}></path>
                    </svg>
                </span>
                <div class="editor-brand-text">
                    <h1 class="editor-logo">HTML5 Editor</h1>
                    <p class="editor-subtitle">
                        Viết HTML, CSS, JavaScript rồi bấm <strong>▶ Chạy</strong> để xem kết quả
                    </p>
                </div>
            </div>
            <div class="header-actions">
                <button id="formatBtn" class="action-btn" type="button" title="Căn lề lại code trong file đang mở">
                    <svg
                        class="action-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" d={ICON_FORMAT}></path>
                    </svg>
                    Định dạng
                </button>
                <button id="resetBtn" class="action-btn" type="button" title="Khôi phục code mẫu cho file đang mở">
                    <svg
                        class="action-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" d={ICON_RESET}></path>
                    </svg>
                    Khôi phục
                </button>
                <button
                    id="clearBtn"
                    class="action-btn action-btn-danger"
                    type="button"
                    title="Xóa trắng code trong file đang mở"
                >
                    <svg
                        class="action-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" d={ICON_TRASH}></path>
                    </svg>
                    Xóa
                </button>
                <button id="runBtn" class="run-btn" type="button" title="Chạy code và xem kết quả">▶ Chạy</button>
            </div>
        </div>
        <div class="editor-body">
            <div class="editor-left">
                <div class="tab-bar">
                    <div class="file-explorer-title">Tệp của bạn</div>
                    <button class="tab active" data-target="html" type="button" aria-current="true">
                        <span class="file-badge file-badge-html" aria-hidden="true">&lt;/&gt;</span>
                        index.html
                    </button>
                    <button class="tab" data-target="css" type="button">
                        <span class="file-badge file-badge-css" aria-hidden="true">#</span>
                        style.css
                    </button>
                    <button class="tab" data-target="js" type="button">
                        <span class="file-badge file-badge-js" aria-hidden="true">JS</span>
                        script.js
                    </button>
                    <div class="tab-hint">
                        <p class="tab-hint-title">💡 Mẹo nhỏ</p>
                        <p><kbd>Ctrl</kbd> + <kbd>Space</kbd> để gợi ý code.</p>
                        <p>Đổi file ở đây, bấm <strong>▶ Chạy</strong> để cập nhật kết quả.</p>
                    </div>
                </div>
                <div class="tab-content">
                    <textarea id="html" class="tab-pane active" placeholder="Nhập HTML ở đây...">{defaultHtml}</textarea
                    >
                    <textarea id="css" class="tab-pane" placeholder="Nhập CSS ở đây...">{defaultCss}</textarea>
                    <textarea id="js" class="tab-pane" placeholder="Nhập JavaScript ở đây...">{defaultJs}</textarea>
                </div>
            </div>
            <div class="editor-right">
                <div class="preview-bar">
                    <span class="preview-label"><span class="preview-dot" aria-hidden="true"></span>Kết quả</span>
                    <button id="fullscreenBtn" class="preview-fullscreen-btn" type="button">⛶ Phóng to</button>
                </div>
                <iframe
                    id="preview"
                    name="preview-frame"
                    class="preview-frame"
                    title="Kết quả code của bạn"
                    sandbox="allow-scripts allow-forms allow-popups allow-modals"
                    allow="autoplay"
                    src="/api/render"></iframe>
            </div>
        </div>

        <!-- Hộp thoại xác nhận -->
        <div id="customConfirm" class="modal-overlay">
            <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
                <h3 id="modalTitle" class="modal-title">Xác nhận</h3>
                <p id="modalMessage" class="modal-message">Bạn có chắc chắn?</p>
                <div class="modal-actions">
                    <button id="modalCancelBtn" class="modal-btn cancel" type="button">Hủy</button>
                    <button id="modalConfirmBtn" class="modal-btn confirm" type="button">Đồng ý</button>
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    /* ── Khung tổng: chiếm trọn chiều cao dưới thanh điều hướng ── */
    .editor-wrap {
        min-height: calc(100dvh - var(--nav-h));
        display: flex;
        flex-direction: column;
        background: #0b1e33;
    }

    /* ── Thanh tiêu đề + nút thao tác (dính dưới nav) ── */
    .editor-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 20px;
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        box-shadow: 0 1px 8px rgba(15, 23, 42, 0.04);
        position: sticky;
        top: var(--nav-h);
        z-index: 40;
    }
    .editor-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }
    .editor-brand-icon {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        background: linear-gradient(135deg, #3b82f6, #4f46e5);
        box-shadow: 0 8px 18px -8px rgba(37, 99, 235, 0.7);
    }
    .editor-brand-icon svg {
        width: 22px;
        height: 22px;
    }
    .editor-brand-text {
        min-width: 0;
    }
    .editor-logo {
        font-size: 17px;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: #0f172a;
    }
    .editor-subtitle {
        margin-top: 2px;
        font-size: 12.5px;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .editor-subtitle strong {
        color: #1d4ed8;
        font-weight: 700;
    }
    .header-actions {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-shrink: 0;
    }
    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 40px;
        padding: 0 14px;
        background: #ffffff;
        color: #334155;
        font-weight: 700;
        font-size: 13px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        cursor: pointer;
        white-space: nowrap;
        transition:
            background 0.15s,
            border-color 0.15s,
            color 0.15s;
    }
    .action-icon {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }
    .action-btn:hover {
        border-color: #93c5fd;
        color: #1d4ed8;
        background: #eff6ff;
    }
    .action-btn-danger:hover {
        border-color: #fda4af;
        color: #be123c;
        background: #fff1f2;
    }
    .run-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 40px;
        padding: 0 22px;
        background: #2563eb;
        color: #ffffff;
        font-weight: 800;
        font-size: 14px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        white-space: nowrap;
        box-shadow: 0 8px 20px -8px rgba(37, 99, 235, 0.7);
        transition:
            background 0.15s,
            transform 0.15s;
    }
    .run-btn:hover {
        background: #1d4ed8;
    }
    .run-btn:active {
        transform: scale(0.97);
    }

    /* ── Vùng soạn thảo ── */
    .editor-body {
        flex: 1;
        display: flex;
        overflow: hidden;
    }
    .editor-left {
        flex: 1;
        display: flex;
        flex-direction: row;
        min-width: 0;
    }
    .file-explorer-title {
        font-size: 11px;
        font-weight: 800;
        color: #7d8ba1;
        padding: 14px 18px 8px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }
    .tab-bar {
        display: flex;
        flex-direction: column;
        width: 190px;
        flex-shrink: 0;
        background: #0b1e33;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 4px;
    }
    .tab {
        margin: 1px 8px;
        padding: 9px 10px;
        font-size: 13px;
        font-weight: 600;
        color: #b6c2d4;
        background: none;
        border: none;
        border-left: 3px solid transparent;
        border-radius: 8px;
        text-align: left;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        gap: 10px;
        white-space: nowrap;
    }
    .tab:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.06);
    }
    .tab.active {
        color: #ffffff;
        border-left-color: #ffd43b;
        background: rgba(59, 130, 246, 0.18);
    }
    .file-badge {
        flex-shrink: 0;
        min-width: 26px;
        height: 18px;
        padding: 0 4px;
        border-radius: 5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 800;
        line-height: 1;
    }
    .file-badge-html {
        background: rgba(249, 115, 22, 0.18);
        color: #fdba74;
    }
    .file-badge-css {
        background: rgba(59, 130, 246, 0.22);
        color: #93c5fd;
    }
    .file-badge-js {
        background: rgba(250, 204, 21, 0.18);
        color: #fde047;
    }
    .tab-hint {
        margin: auto 12px 14px;
        padding: 12px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 11.5px;
        line-height: 1.55;
        color: #93a3b8;
    }
    .tab-hint p + p {
        margin-top: 4px;
    }
    .tab-hint .tab-hint-title {
        font-weight: 800;
        color: #e2e8f0;
    }
    .tab-hint strong {
        color: #ffd43b;
    }
    .tab-hint kbd {
        font-family: var(--font-mono);
        font-size: 10.5px;
        padding: 1px 5px;
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #e2e8f0;
    }
    .tab-content {
        flex: 1;
        position: relative;
        overflow: hidden;
        background: #0f2740;
    }
    .tab-pane {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        padding: 14px 16px;
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1.6;
        color: #e2e8f0;
        background: #0f2740;
        border: none;
        outline: none;
        resize: none;
        display: none !important;
    }
    :global(.CodeMirror) {
        position: absolute !important;
        inset: 0 !important;
        width: 100% !important;
        height: 100% !important;
        display: none !important;
        font-family: var(--font-mono) !important;
        font-size: 14px !important;
        line-height: 1.6 !important;
        background: #0f2740 !important;
    }
    /* Ghi đè nền theme dracula bằng màu navy của site (độ ưu tiên cao hơn file theme) */
    .tab-content :global(.cm-s-dracula.CodeMirror) {
        background: #0f2740 !important;
    }
    :global(.CodeMirror-gutters) {
        background: #0b1e33 !important;
        border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
    .tab-content :global(.cm-s-dracula .CodeMirror-gutters) {
        background: #0b1e33 !important;
    }
    .tab-pane.active + :global(.CodeMirror) {
        display: block !important;
    }

    /* ── Khung kết quả ── */
    .editor-right {
        width: 45%;
        min-width: 320px;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-left: 1px solid rgba(255, 255, 255, 0.08);
    }
    .preview-bar {
        padding: 8px 12px 8px 16px;
        min-height: 48px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .preview-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 800;
        color: #334155;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .preview-dot {
        width: 8px;
        height: 8px;
        border-radius: 9999px;
        background: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18);
    }
    .preview-frame {
        flex: 1;
        width: 100%;
        border: none;
        background: #fff;
    }

    .preview-fullscreen-btn {
        display: inline-flex;
        align-items: center;
        height: 32px;
        padding: 0 12px;
        background: #ffffff;
        color: #334155;
        font-weight: 700;
        font-size: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        cursor: pointer;
        transition:
            background 0.15s,
            border-color 0.15s,
            color 0.15s;
        white-space: nowrap;
    }
    .preview-fullscreen-btn:hover {
        border-color: #93c5fd;
        color: #1d4ed8;
        background: #eff6ff;
    }

    .editor-right:fullscreen {
        width: 100%;
        height: 100%;
        border-left: none;
    }
    .editor-right:fullscreen .preview-frame {
        width: 100%;
        height: 100%;
    }
    .editor-right:-webkit-full-screen {
        width: 100%;
        height: 100%;
        border-left: none;
    }
    .editor-right:-webkit-full-screen .preview-frame {
        width: 100%;
        height: 100%;
    }

    /* ── Hộp thoại xác nhận ── */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(11, 30, 51, 0.6);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
        z-index: 1000;
        backdrop-filter: blur(3px);
    }
    .modal-overlay.show {
        display: flex;
    }
    .modal-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 24px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 30px 60px -20px rgba(15, 23, 42, 0.45);
        color: #0f172a;
    }
    .modal-title {
        margin: 0 0 8px 0;
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -0.01em;
    }
    .modal-message {
        margin: 0 0 22px 0;
        font-size: 14px;
        color: #475569;
        line-height: 1.6;
    }
    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
    .modal-btn {
        height: 40px;
        padding: 0 18px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition:
            background 0.15s,
            border-color 0.15s;
    }
    .modal-btn.cancel {
        background: #ffffff;
        color: #334155;
        border: 1px solid #e2e8f0;
    }
    .modal-btn.cancel:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
    }
    .modal-btn.confirm {
        background: #e11d48;
        color: #ffffff;
        border: 1px solid #e11d48;
    }
    .modal-btn.confirm:hover {
        background: #be123c;
        border-color: #be123c;
    }

    /* ── Màn hình vừa & nhỏ: tab tệp nằm ngang phía trên vùng code ── */
    @media (max-width: 1023.98px) {
        .editor-subtitle {
            display: none;
        }
        .editor-left {
            flex-direction: column;
        }
        .tab-bar {
            width: 100%;
            flex-direction: row;
            align-items: stretch;
            gap: 2px;
            padding: 0 6px;
            border-right: none;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            overflow-x: auto;
            scrollbar-width: none;
        }
        .file-explorer-title,
        .tab-hint {
            display: none;
        }
        .tab {
            flex-shrink: 0;
            margin: 0;
            padding: 12px 12px 10px;
            border-left: none;
            border-bottom: 3px solid transparent;
            border-radius: 0;
            gap: 8px;
        }
        .tab.active {
            border-bottom-color: #ffd43b;
            background: rgba(59, 130, 246, 0.14);
        }
    }

    /* ── Điện thoại: kết quả xếp bên dưới vùng code ── */
    @media (max-width: 767.98px) {
        .editor-header {
            flex-wrap: wrap;
            gap: 10px;
            padding: 10px 12px;
        }
        .editor-brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
        }
        .editor-brand-icon svg {
            width: 18px;
            height: 18px;
        }
        .editor-logo {
            font-size: 15px;
        }
        .header-actions {
            width: 100%;
            gap: 6px;
        }
        .action-btn {
            flex: 1 1 auto;
            height: 38px;
            padding: 0 8px;
            font-size: 12.5px;
        }
        .action-icon {
            display: none;
        }
        .run-btn {
            flex: 1 1 auto;
            height: 38px;
            padding: 0 14px;
        }
        .editor-body {
            flex-direction: column;
            overflow: visible;
        }
        .editor-left {
            flex: none;
        }
        .tab-content {
            flex: none;
            height: 55dvh;
            min-height: 300px;
        }
        .editor-right {
            width: 100%;
            min-width: 0;
            height: 50dvh;
            min-height: 300px;
            border-left: none;
            border-top: 1px solid #e2e8f0;
        }
    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/theme/dracula.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/show-hint.min.css" />

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/xml/xml.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/css/css.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/javascript/javascript.min.js"
></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/htmlmixed/htmlmixed.min.js"
></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/show-hint.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/xml-hint.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/html-hint.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/css-hint.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/javascript-hint.min.js"
></script>

<script is:inline>
    const htmlEditor = document.getElementById('html')
    const cssEditor = document.getElementById('css')
    const jsEditor = document.getElementById('js')
    const previewIframe = document.getElementById('preview')
    const fullscreenBtn = document.getElementById('fullscreenBtn')
    const previewContainer = document.querySelector('.editor-right')

    const cmOptions = {
        theme: 'dracula',
        lineNumbers: true,
        indentUnit: 4,
        tabSize: 4,
        indentWithTabs: false,
        extraKeys: { 'Ctrl-Space': 'autocomplete' },
    }

    const cmHtml = CodeMirror.fromTextArea(htmlEditor, { ...cmOptions, mode: 'htmlmixed' })
    const cmCss = CodeMirror.fromTextArea(cssEditor, { ...cmOptions, mode: 'css' })
    const cmJs = CodeMirror.fromTextArea(jsEditor, { ...cmOptions, mode: 'javascript' })

    ;[
        cmHtml,
        cmCss,
        cmJs,
    ].forEach((cm) => {
        cm.on('change', () => cm.save())
        cm.on('inputRead', function (editor, change) {
            if (change.origin !== '+input' && change.origin !== '*compose') return
            if (change.text[0].match(/[a-zA-Z0-9_<>]/)) {
                editor.showHint({ completeSingle: false })
            }
        })
    })

    // Initialize iframe with default content
    updatePreview()

    function isFullscreenActive() {
        return !!(document.fullscreenElement || document.webkitFullscreenElement)
    }

    function updateFullscreenButtonLabel() {
        if (!fullscreenBtn) return
        fullscreenBtn.textContent = isFullscreenActive() ? '🗗 Thu nhỏ' : '⛶ Phóng to'
    }

    async function requestFullscreen(el) {
        if (!el) return
        if (el.requestFullscreen) return el.requestFullscreen()
        if (el.webkitRequestFullscreen) return el.webkitRequestFullscreen()
    }

    async function exitFullscreen() {
        if (document.exitFullscreen) return document.exitFullscreen()
        if (document.webkitExitFullscreen) return document.webkitExitFullscreen()
    }

    if (fullscreenBtn && previewContainer) {
        fullscreenBtn.addEventListener('click', async () => {
            if (isFullscreenActive()) {
                await exitFullscreen()
                return
            }
            await requestFullscreen(previewContainer)
        })

        document.addEventListener('fullscreenchange', updateFullscreenButtonLabel)
        document.addEventListener('webkitfullscreenchange', updateFullscreenButtonLabel)
        updateFullscreenButtonLabel()
    }

    // Refresh CodeMirror when tab becomes visible
    function refreshActiveEditor(targetId) {
        setTimeout(() => {
            if (targetId === 'html') cmHtml.refresh()
            if (targetId === 'css') cmCss.refresh()
            if (targetId === 'js') cmJs.refresh()
        }, 10)
    }

    function updatePreview() {
        const form = document.createElement('form')
        form.method = 'POST'
        form.action = '/api/render'
        form.target = 'preview-frame'
        form.style.display = 'none'

        const html = document.getElementById('html').value
        const css = document.getElementById('css').value
        const js = document.getElementById('js').value

        const mockStorageScript = `
            (function () {
                var store = {};
                var mock = {
                    getItem: function(k) { return store[k] || null; },
                    setItem: function(k, v) { store[k] = String(v); },
                    removeItem: function(k) { delete store[k]; },
                    clear: function() { store = {}; }
                };

                try { Object.defineProperty(window, 'localStorage', { get: function() { return mock; }, configurable: true }); } catch (e) {}
                try { Object.defineProperty(window, 'sessionStorage', { get: function() { return mock; }, configurable: true }); } catch (e) {}
                try { window.localStorage = mock; } catch (e) {}
                try { window.sessionStorage = mock; } catch (e) {}
                try { localStorage = mock; } catch (e) {}
                try { sessionStorage = mock; } catch (e) {}

                var OriginalAudioContext = window.AudioContext || window.webkitAudioContext;
                if (!OriginalAudioContext) return;

                var contexts = [];
                function WrappedAudioContext() {
                    var ctx = new OriginalAudioContext(...Array.from(arguments));
                    contexts.push(ctx);
                    return ctx;
                }
                WrappedAudioContext.prototype = OriginalAudioContext.prototype;
                window.AudioContext = WrappedAudioContext;
                if (window.webkitAudioContext) window.webkitAudioContext = WrappedAudioContext;

                function resumeAll() {
                    contexts.forEach(function (ctx) {
                        try { if (ctx && ctx.state === 'suspended') ctx.resume(); } catch (e) {}
                    });
                }
                window.addEventListener('pointerdown', resumeAll, { once: true, capture: true });
                window.addEventListener('keydown', resumeAll, { once: true, capture: true });
            })();
        `

        const storageShim = `<script>${mockStorageScript}<\/script>`
        const htmlWithShim = storageShim + html

        const inputHtml = document.createElement('input')
        inputHtml.type = 'hidden'
        inputHtml.name = 'html'
        inputHtml.value = htmlWithShim

        const inputCss = document.createElement('input')
        inputCss.type = 'hidden'
        inputCss.name = 'css'
        inputCss.value = css

        const inputJs = document.createElement('input')
        inputJs.type = 'hidden'
        inputJs.name = 'js'
        inputJs.value = js

        form.appendChild(inputHtml)
        form.appendChild(inputCss)
        form.appendChild(inputJs)

        document.body.appendChild(form)
        form.submit()
        document.body.removeChild(form)
    }

    document.getElementById('runBtn').addEventListener('click', updatePreview)

    document.querySelectorAll('.tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.tab').forEach(function (b) {
                b.classList.remove('active')
                b.removeAttribute('aria-current')
            })
            document.querySelectorAll('.tab-pane').forEach(function (p) {
                p.classList.remove('active')
            })
            btn.classList.add('active')
            btn.setAttribute('aria-current', 'true')
            const target = btn.getAttribute('data-target')
            document.getElementById(target).classList.add('active')
            refreshActiveEditor(target)
        })
    })

    // --- Thêm chức năng cho các nút Format, Reset, Clear ---
    const defaultContents = {
        html: htmlEditor.value,
        css: cssEditor.value,
        js: jsEditor.value,
    }

    function getActiveEditorData() {
        const activeTab = document.querySelector('.tab.active')
        const target = activeTab ? activeTab.getAttribute('data-target') : 'html'
        const cm = target === 'css' ? cmCss : target === 'js' ? cmJs : cmHtml
        return { target, cm }
    }

    document.getElementById('formatBtn').addEventListener('click', () => {
        const { cm } = getActiveEditorData()
        const totalLines = cm.lineCount()
        for (let i = 0; i < totalLines; i++) {
            cm.indentLine(i, 'smart')
        }
    })

    // Logic Custom Modal
    let confirmActionCallback = null
    // Phần tử đang được focus trước khi mở hộp thoại (để trả focus lại khi đóng)
    let lastFocusedBeforeConfirm = null

    function showConfirm(title, message, callback) {
        document.getElementById('modalTitle').textContent = title
        document.getElementById('modalMessage').textContent = message
        lastFocusedBeforeConfirm = document.activeElement
        document.getElementById('customConfirm').classList.add('show')
        confirmActionCallback = callback
        document.getElementById('modalCancelBtn').focus()
    }

    function closeConfirm() {
        const overlay = document.getElementById('customConfirm')
        const wasOpen = overlay.classList.contains('show')
        overlay.classList.remove('show')
        confirmActionCallback = null
        if (wasOpen && lastFocusedBeforeConfirm && typeof lastFocusedBeforeConfirm.focus === 'function') {
            lastFocusedBeforeConfirm.focus()
        }
        lastFocusedBeforeConfirm = null
    }

    // Nhấn Esc để đóng hộp thoại xác nhận
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.getElementById('customConfirm').classList.contains('show')) {
            closeConfirm()
        }
    })

    document.getElementById('modalCancelBtn').addEventListener('click', closeConfirm)
    document.getElementById('modalConfirmBtn').addEventListener('click', () => {
        if (confirmActionCallback) confirmActionCallback()
        closeConfirm()
    })

    document.getElementById('resetBtn').addEventListener('click', () => {
        showConfirm(
            'Khôi phục mặc định',
            'Bạn có chắc chắn muốn khôi phục mã mặc định cho file này? Toàn bộ thay đổi hiện tại sẽ bị mất.',
            () => {
                const { target, cm } = getActiveEditorData()
                cm.setValue(defaultContents[target])
            },
        )
    })

    document.getElementById('clearBtn').addEventListener('click', () => {
        showConfirm(
            'Xóa toàn bộ mã',
            'Bạn có chắc chắn muốn xóa trắng toàn bộ mã trong file này? Hành động này không thể hoàn tác.',
            () => {
                const { cm } = getActiveEditorData()
                cm.setValue('')
            },
        )
    })
</script>
