---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout title="HTML5 Editor Online" description="Trình soạn thảo HTML/CSS/JS trực tuyến với xem trước trực tiếp">
    <section class="editor-wrap">
        <div class="editor-header">
            <h1 class="editor-logo">⟨/⟩ HTML5 Editor</h1>
            <div class="header-actions">
                <button id="formatBtn" class="action-btn">✨ Format</button>
                <button id="resetBtn" class="action-btn">🔄 Reset</button>
                <button id="clearBtn" class="action-btn">🗑️ Clear</button>
                <button id="runBtn" class="run-btn">▶ Chạy</button>
            </div>
        </div>
        <div class="editor-body">
            <div class="editor-left">
                <div class="tab-bar">
                    <div class="file-explorer-title">FILES</div>
                    <button class="tab active" data-target="html">📄 index.html</button>
                    <button class="tab" data-target="css">📄 style.css</button>
                    <button class="tab" data-target="js">📄 script.js</button>
                </div>
                <div class="tab-content">
                    <textarea id="html" class="tab-pane active" placeholder="Nhập HTML ở đây...">&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
&lt;meta charset="UTF-8"&gt;
&lt;title&gt;Tiêu đề&lt;/title&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;h1&gt;Chào thế giới!&lt;/h1&gt;
&lt;/body&gt;
&lt;/html&gt;</textarea>
                    <textarea id="css" class="tab-pane" placeholder="Nhập CSS ở đây...">body &#123;
    font-family: Arial, sans-serif;
    margin: 20px;
    background-color: #f4f4f4;
&#125;
h1 &#123;
    color: #333;
&#125;</textarea>
                    <textarea id="js" class="tab-pane" placeholder="Nhập JavaScript ở đây...">document.addEventListener('DOMContentLoaded', function() &#123;
    console.log('JavaScript đã được loaded');
&#125;);</textarea>
                </div>
            </div>
            <div class="editor-right">
                <div class="preview-bar">
                    <span class="preview-label">Kết quả</span>
                </div>
                <iframe id="preview" name="preview-frame" class="preview-frame" sandbox="allow-scripts allow-forms allow-popups allow-modals" src="/api/render"></iframe>
            </div>
        </div>

        <!-- Custom Confirm Modal -->
        <div id="customConfirm" class="modal-overlay">
            <div class="modal-box">
                <h3 id="modalTitle" class="modal-title">Xác nhận</h3>
                <p id="modalMessage" class="modal-message">Bạn có chắc chắn?</p>
                <div class="modal-actions">
                    <button id="modalCancelBtn" class="modal-btn cancel">Hủy</button>
                    <button id="modalConfirmBtn" class="modal-btn confirm">Đồng ý</button>
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    .editor-wrap {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #1e1e2e;
    }
    .editor-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 20px;
        background: #181825;
        border-bottom: 1px solid #313244;
    }
    .editor-logo {
        font-size: 16px;
        font-weight: 700;
        color: #cdd6f4;
        letter-spacing: 0.5px;
    }
    .header-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }
    .action-btn {
        padding: 8px 16px;
        background: #313244;
        color: #cdd6f4;
        font-weight: 600;
        font-size: 13px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
    }
    .action-btn:hover {
        background: #45475a;
    }
    .run-btn {
        padding: 8px 22px;
        background: #a6e3a1;
        color: #1e1e2e;
        font-weight: 700;
        font-size: 14px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
    }
    .run-btn:hover {
        background: #94e2d5;
    }
    .editor-body {
        flex: 1;
        display: flex;
        overflow: hidden;
    }
    .editor-left {
        flex: 1;
        display: flex;
        flex-direction: row;
        min-width: 0;
    }
    .file-explorer-title {
        font-size: 11px;
        font-weight: 700;
        color: #6c7086;
        padding: 12px 18px 8px;
        letter-spacing: 1px;
    }
    .tab-bar {
        display: flex;
        flex-direction: column;
        width: 180px;
        background: #181825;
        border-right: 1px solid #313244;
        padding-top: 5px;
    }
    .tab {
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 500;
        color: #bac2de;
        background: none;
        border: none;
        border-left: 2px solid transparent;
        text-align: left;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .tab:hover {
        color: #cdd6f4;
        background: rgba(255,255,255,0.05);
    }
    .tab.active {
        color: #a6e3a1;
        border-left-color: #a6e3a1;
        background: rgba(255,255,255,0.05);
    }
    .tab-content {
        flex: 1;
        position: relative;
        overflow: hidden;
    }
    .tab-pane {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        padding: 14px 16px;
        font-family: 'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'Consolas', monospace;
        font-size: 13px;
        line-height: 1.6;
        color: #cdd6f4;
        background: #1e1e2e;
        border: none;
        outline: none;
        resize: none;
        display: none !important;
    }
    :global(.CodeMirror) {
        position: absolute !important;
        inset: 0 !important;
        width: 100% !important;
        height: 100% !important;
        display: none !important;
        font-family: 'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'Consolas', monospace !important;
        font-size: 14px !important;
        background: #1e1e2e !important;
    }
    :global(.CodeMirror-gutters) {
        background: #181825 !important;
        border-right: 1px solid #313244 !important;
    }
    .tab-pane.active + :global(.CodeMirror) {
        display: block !important;
    }
    .editor-right {
        width: 45%;
        min-width: 320px;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-left: 1px solid #313244;
    }
    .preview-bar {
        padding: 8px 16px;
        background: #f5f5f5;
        border-bottom: 1px solid #e0e0e0;
    }
    .preview-label {
        font-size: 12px;
        font-weight: 600;
        color: #555;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .preview-frame {
        flex: 1;
        width: 100%;
        border: none;
        background: #fff;
    }
    
    /* Custom Modal */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(2px);
    }
    .modal-overlay.show {
        display: flex;
    }
    .modal-box {
        background: #1e1e2e;
        border: 1px solid #313244;
        border-radius: 10px;
        padding: 24px;
        width: 340px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        color: #cdd6f4;
    }
    .modal-title {
        margin: 0 0 10px 0;
        font-size: 16px;
        font-weight: 700;
    }
    .modal-message {
        margin: 0 0 20px 0;
        font-size: 14px;
        color: #bac2de;
        line-height: 1.5;
    }
    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }
    .modal-btn {
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
    }
    .modal-btn.cancel {
        background: #313244;
        color: #cdd6f4;
    }
    .modal-btn.cancel:hover {
        background: #45475a;
    }
    .modal-btn.confirm {
        background: #f38ba8;
        color: #1e1e2e;
    }
    .modal-btn.confirm:hover {
        background: #eba0ac;
    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/theme/dracula.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/show-hint.min.css">

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/xml/xml.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/css/css.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/javascript/javascript.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/htmlmixed/htmlmixed.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/show-hint.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/xml-hint.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/html-hint.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/css-hint.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/addon/hint/javascript-hint.min.js"></script>

<script is:inline>
    const htmlEditor = document.getElementById('html');
    const cssEditor = document.getElementById('css');
    const jsEditor = document.getElementById('js');
    const previewIframe = document.getElementById('preview');

    const cmOptions = {
        theme: 'dracula',
        lineNumbers: true,
        extraKeys: {"Ctrl-Space": "autocomplete"}
    };

    const cmHtml = CodeMirror.fromTextArea(htmlEditor, { ...cmOptions, mode: 'htmlmixed' });
    const cmCss = CodeMirror.fromTextArea(cssEditor, { ...cmOptions, mode: 'css' });
    const cmJs = CodeMirror.fromTextArea(jsEditor, { ...cmOptions, mode: 'javascript' });

    [cmHtml, cmCss, cmJs].forEach(cm => {
        cm.on("change", () => cm.save());
        cm.on("inputRead", function(editor, change) {
            if (change.origin !== "+input" && change.origin !== "*compose") return;
            if (change.text[0].match(/[a-zA-Z0-9_<>]/)) {
                editor.showHint({completeSingle: false});
            }
        });
    });

    // Initialize iframe with default content
    updatePreview();

    // Refresh CodeMirror when tab becomes visible
    function refreshActiveEditor(targetId) {
        setTimeout(() => {
            if (targetId === 'html') cmHtml.refresh();
            if (targetId === 'css') cmCss.refresh();
            if (targetId === 'js') cmJs.refresh();
        }, 10);
    }

    function updatePreview() {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/api/render';
        form.target = 'preview-frame';
        form.style.display = 'none';

        const html = document.getElementById('html').value;
        const css = document.getElementById('css').value;
        const js = document.getElementById('js').value;

        const mockStorageScript = `
            try { window.localStorage; } catch(e) {
                var store = {};
                var mock = {
                    getItem: function(k) { return store[k] || null; },
                    setItem: function(k, v) { store[k] = String(v); },
                    removeItem: function(k) { delete store[k]; },
                    clear: function() { store = {}; }
                };
                Object.defineProperty(Window.prototype, 'localStorage', { get: function() { return mock; }, configurable: true });
                Object.defineProperty(Window.prototype, 'sessionStorage', { get: function() { return mock; }, configurable: true });
            }
        `;

        const storageShim = `<script>${mockStorageScript}<\/script>`;
        const htmlWithShim = storageShim + html;

        const inputHtml = document.createElement('input');
        inputHtml.type = 'hidden';
        inputHtml.name = 'html';
        inputHtml.value = htmlWithShim;

        const inputCss = document.createElement('input');
        inputCss.type = 'hidden';
        inputCss.name = 'css';
        inputCss.value = css;

        const inputJs = document.createElement('input');
        inputJs.type = 'hidden';
        inputJs.name = 'js';
        inputJs.value = js;

        form.appendChild(inputHtml);
        form.appendChild(inputCss);
        form.appendChild(inputJs);

        document.body.appendChild(form);
        form.submit();
        document.body.removeChild(form);
    }

    document.getElementById('runBtn').addEventListener('click', updatePreview);

    document.querySelectorAll('.tab').forEach(function(btn) {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.tab').forEach(function(b) { b.classList.remove('active'); });
            document.querySelectorAll('.tab-pane').forEach(function(p) { p.classList.remove('active'); });
            btn.classList.add('active');
            const target = btn.getAttribute('data-target');
            document.getElementById(target).classList.add('active');
            refreshActiveEditor(target);
        });
    });

    // --- Thêm chức năng cho các nút Format, Reset, Clear ---
    const defaultContents = {
        html: htmlEditor.value,
        css: cssEditor.value,
        js: jsEditor.value
    };

    function getActiveEditorData() {
        const activeTab = document.querySelector('.tab.active');
        const target = activeTab ? activeTab.getAttribute('data-target') : 'html';
        const cm = target === 'css' ? cmCss : (target === 'js' ? cmJs : cmHtml);
        return { target, cm };
    }

    document.getElementById('formatBtn').addEventListener('click', () => {
        const { cm } = getActiveEditorData();
        const totalLines = cm.lineCount();
        for (let i = 0; i < totalLines; i++) {
            cm.indentLine(i, "smart");
        }
    });

    // Logic Custom Modal
    let confirmActionCallback = null;

    function showConfirm(title, message, callback) {
        document.getElementById('modalTitle').textContent = title;
        document.getElementById('modalMessage').textContent = message;
        document.getElementById('customConfirm').classList.add('show');
        confirmActionCallback = callback;
    }

    function closeConfirm() {
        document.getElementById('customConfirm').classList.remove('show');
        confirmActionCallback = null;
    }

    document.getElementById('modalCancelBtn').addEventListener('click', closeConfirm);
    document.getElementById('modalConfirmBtn').addEventListener('click', () => {
        if (confirmActionCallback) confirmActionCallback();
        closeConfirm();
    });

    document.getElementById('resetBtn').addEventListener('click', () => {
        showConfirm('Khôi phục mặc định', 'Bạn có chắc chắn muốn khôi phục mã mặc định cho file này? Toàn bộ thay đổi hiện tại sẽ bị mất.', () => {
            const { target, cm } = getActiveEditorData();
            cm.setValue(defaultContents[target]);
        });
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
        showConfirm('Xoá toàn bộ mã', 'Bạn có chắc chắn muốn xoá trắng toàn bộ mã trong file này? Hành động này không thể hoàn tác.', () => {
            const { cm } = getActiveEditorData();
            cm.setValue('');
        });
    });
</script>
