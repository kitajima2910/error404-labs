---
import { TC_TITLE } from '../common/TextConst'
import Link from '../components/Link.astro'
import PostCard from '../components/PostCard.astro'
import IconAbout from '../icons/IconAbout.astro'
import { formatBlogPost } from '../js/utils'
import MainLayout from '../layouts/MainLayout.astro'

const allPosts = Object.values(
    import.meta.glob<any>('./bai-viet/*.md', { eager: true }),
)

const formattedPosts: any[] = formatBlogPost(allPosts, {
    limit: 3,
    filterOutDrafts: true,
    sortByDate: !true,
})

const length = formattedPosts.length
---

<MainLayout title=`${TC_TITLE}`>
    <div class="flex flex-col mt-15">
        <section
            aria-label="Giới thiệu"
            class="mx-auto
      max-w-5xl
      px-4
      grid
      grid-cols-1
      md:grid-cols-[auto_1fr]
      items-center
      gap-10"
        >
            <img
                src="/images/me.png"
                alt="Kitajima2910"
                class="shadow-xl/30
    rounded-4xl
    justify-self-center
    md:justify-self-start
    max-w-60
    md:max-w-none"
            />

            <div class="text-center md:text-left space-y-6">
                <h1 class="font-bold text-2xl">Bài Viết Của Tôi</h1>

                <p class="text-[16px] font-medium max-w-prose mx-auto md:mx-0">
                    Lorem, ipsum dolor sit amet consectetur adipisicing elit.
                    Pariatur perferendis vel natus suscipit debitis id quam
                    quibusdam tenetur aspernatur sed consectetur fugiat, neque
                    labore? Sint!
                </p>

                <div class="flex justify-center md:justify-start">
                    <Link
                        text="Giới Thiệu"
                        style="primary"
                        isFilled={false}
                        borderVisible={true}
                        href="/gioi-thieu"
                        target="_blank"
                        icon={{
                            component: IconAbout,
                            side: 'left',
                        }}
                    />
                </div>
            </div>
        </section>
        <section class="my-5 mb-15 w-10/12 mx-auto" aria-label="Bài Viết Mới">
            <h2 class="text-5xl font-semibold mb-10 mt-10">
                Bài Viết Dành Cho Bạn
            </h2>
            <div
                class="custom-grid"
                style={`max-width: ${length > 1 ? '100%' : '400px'}`}
            >
                {
                    formattedPosts.map((post) => (
                        <PostCard
                            frontmatter={post.frontmatter}
                            url={post.url}
                            tagType="h3"
                        />
                    ))
                }
                <!-- {
            (
                <PostCard
                    frontmatter={allPosts[0].frontmatter}
                    url={allPosts[0].url}
                    tagType="h2"
                />
            )
        } -->
            </div>
        </section>
    </div>
</MainLayout>

<style>
    .custom-grid {
        display: grid;
        gap: 40px;
        justify-content: center;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
        width: 100%;
    }
</style>
