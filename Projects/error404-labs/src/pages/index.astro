---
import { TC_TITLE } from '../common/TextConst'
import Link from '../components/Link.astro'
import PostCard from '../components/PostCard.astro'
import IconAbout from '../icons/IconAbout.astro'
import IconDonate from '../icons/IconDonate.astro'
import IconFacebook from '../icons/IconFacebook.astro'
import IconWeb from '../icons/IconWeb.astro'
import { formatBlogPost } from '../js/utils'
import MainLayout from '../layouts/MainLayout.astro'

const allPosts = Object.values(import.meta.glob<any>('./bai-viet/*.md', { eager: true }))

const formattedPosts: any[] = formatBlogPost(allPosts, {
    limit: 3,
    filterOutDrafts: true,
    sortByDate: false,
})

const length = formattedPosts.length

const Facebook = 'https://www.facebook.com/kitajima2910'
---

<MainLayout title=`${TC_TITLE}`>
    <div class="flex flex-col mt-15">
        <section
            aria-label="Giới thiệu"
            class="mx-auto
      max-w-5xl
      px-4
      pt-0
      grid
      grid-cols-1
      md:grid-cols-[auto_1fr]
      items-center
      gap-10"
        >
            <img
                src="/Hoai-An.avif"
                alt="Me và Cỏ"
                width="120"
                class="shadow-xl/30
    rounded-2xl
    justify-self-center
    md:justify-self-start
    max-w-60
    md:max-w-none
    cursor-pointer
    transition-transform
    duration-300
    hover:scale-105"
                onclick="openLightbox(this)"
            />
            <!--
            <video
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                width="120"
                class="shadow-xl/30
           rounded-4xl
           justify-self-center
           md:justify-self-start
           max-w-60
           md:max-w-none"
            >
                <source src="/me_co.webm" type="video/webm" />
                <source src="/me_co.mp4" type="video/mp4" />
            </video>
            -->

            <div class="text-center md:text-left space-y-6">
                <h1 class="font-bold text-2xl">Bài Viết Của Tôi</h1>

                <p class="text-[16px] font-medium max-w-prose mx-auto md:mx-0">
                    Error404-Labs là nơi chia sẻ kiến thức lập trình C/C++, Web, Game, Mobile & AI, tập trung vào tư duy
                    R&D, học từ dự án thực tế, code dễ hiểu, áp dụng được ngay cho người mới lẫn dev đang lên trình 🚀
                </p>

                <div class="flex justify-center md:justify-start gap-3 flex-wrap">
                    <Link
                        text="Donate"
                        style="primary"
                        isFilled={false}
                        borderVisible={true}
                        href="/donate"
                        target="_blank"
                        icon={{
                            component: IconDonate,
                            side: 'left',
                        }}
                    />
                    <Link
                        text="Lý Thuyết Điểm Giao By Cô Cỏ"
                        style="primary"
                        isFilled={false}
                        borderVisible={true}
                        href="https://cococuatuinho.com"
                        target="_blank"
                        icon={{
                            component: IconWeb,
                            side: 'left',
                        }}
                    />
                    <Link
                        text="Liên Hệ"
                        style="primary"
                        isFilled={false}
                        borderVisible={true}
                        href={Facebook}
                        target="_blank"
                        icon={{
                            component: IconFacebook,
                            side: 'left',
                        }}
                    />
                </div>
            </div>
        </section>
        <section class="my-5 mb-15 w-10/12 mx-auto" aria-label="Bài Viết Dành Cho Bạn">
            <h2 class="text-5xl font-semibold mb-10 mt-10">Bài Viết Dành Cho Bạn</h2>
            <div class="custom-grid" style={`max-width: ${length > 1 ? '100%' : '400px'}`}>
                {formattedPosts.map((post) => <PostCard frontmatter={post.frontmatter} url={post.url} tagType="h3" />)}
            </div>
        </section>
    </div>

    <div id="lightbox" class="lightbox" onclick="closeLightbox(event)" onkeydown="handleLightboxKey(event)" tabindex="-1">
        <img id="lightbox-img" src="" alt="" />
    </div>
</MainLayout>

<style>
    .custom-grid {
        display: grid;
        gap: 40px;
        justify-content: center;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
        width: 100%;
    }

    .lightbox {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0, 0, 0, 0.95);
        backdrop-filter: blur(8px);
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .lightbox.active {
        display: flex;
        opacity: 1;
    }

    .lightbox img {
        max-width: 90%;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 8px;
        transform: scale(0.9);
        transition: transform 0.3s ease;
    }

    .lightbox.active img {
        transform: scale(1);
    }

    body.lightbox-open {
        overflow: hidden;
    }
</style>

<script is:inline>
    function openLightbox(img) {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightbox.classList.add('active');
        document.body.classList.add('lightbox-open');
        lightbox.focus();
    }

    function closeLightbox(event) {
        if (event && event.target !== event.currentTarget) return;
        const lightbox = document.getElementById('lightbox');
        lightbox.classList.remove('active');
        document.body.classList.remove('lightbox-open');
    }

    function handleLightboxKey(event) {
        if (event.key === 'Escape') {
            closeLightbox(event);
        }
    }
</script>
