---
import type { GetStaticPaths } from 'astro'
import {
    formatBlogPost,
    slugify,
    formatDate,
    isCourseCategory,
    readingTime,
    countPostsByCategory,
} from '../../js/utils'
import MainLayout from '../../layouts/MainLayout.astro'
import { TC_TITLE } from '../../common/TextConst'
import PostCard from '../../components/PostCard.astro'
import { getCategoryMeta } from '../../data/categoryMeta'

export const prerender = true

export const getStaticPaths = (() => {
    const posts = Object.values(import.meta.glob<any>('../bai-viet/*.md', { eager: true }))

    const authors = [...new Set(posts.map((p) => p.frontmatter.author).flat())]

    return authors.map((author) => ({
        params: { author: slugify(author) },
        props: { name: author, posts },
    }))
}) satisfies GetStaticPaths

const { name, posts } = Astro.props

const allPosts = posts.filter((post) => post.frontmatter.author.toLowerCase() === name.toLowerCase())

// Hiển thị TOÀN BỘ bài của tác giả (trước đây bị giới hạn 3 bài)
const formattedPosts: any[] = formatBlogPost(allPosts, {
    limit: allPosts.length,
    filterOutDrafts: true,
    sortByDate: true,
})

// Hồ sơ tác giả (thông tin thật, giữ nguyên văn)
const profiles: Record<
    string,
    {
        photo: string
        role: string
        tagline: string
        bio: string
        facebook?: string
        zalo?: string
    }
> = {
    'Phạm Xuân Hoài': {
        photo: '/images/me.png',
        role: 'Research & Developer',
        tagline: 'Người sáng lập Error404 Labs',
        bio: 'Xin chào 👋 Mình là một lập trình viên theo hướng Research & Development, thích đào sâu vấn đề và biến ý tưởng thành sản phẩm chạy được thật. Tại Error404-Labs, mình chia sẻ kiến thức về C/C++, Web, Game, Mobile và AI, kèm kinh nghiệm thực chiến để giúp bạn học lập trình bớt mơ hồ và đỡ “lạc lối” hơn 🚀',
        facebook: 'https://www.facebook.com/kitajima2910',
        zalo: 'https://zalo.me/0373306966',
    },
}
const profile = profiles[name]
const nameWords = String(name).trim().split(/\s+/)
const initials = (nameWords[0]?.[0] || '') + (nameWords.length > 1 ? nameWords[nameWords.length - 1][0] : '')

// Thời gian đọc ước tính (tính trên module gốc vì formatBlogPost làm mất rawContent)
const minutesByUrl: Record<string, number> = {}
for (const post of allPosts) {
    minutesByUrl[post.url] = readingTime(typeof post.rawContent === 'function' ? post.rawContent() : '')
}

// Nhóm bài theo chủ đề: nhiều bài nhất trước; chuỗi bài học xếp từ bài 1
const groups = countPostsByCategory(formattedPosts)
    .sort((a, b) => b.count - a.count)
    .map((item) => {
        const isCourse = isCourseCategory(item.name)
        const items = formattedPosts.filter((post) => post.frontmatter.category === item.name)
        return {
            ...item,
            isCourse,
            meta: getCategoryMeta(item.name),
            href: `/danh-muc/${slugify(item.name)}`,
            anchor: `chu-de-${slugify(item.name)}`,
            items: isCourse ? [...items].reverse() : items,
        }
    })

const latestPosts = formattedPosts.slice(0, 3)
const VISIBLE_ROWS = 5

const stats: { value: string; label: string; compact?: boolean }[] = [
    { value: String(formattedPosts.length), label: 'Bài viết' },
    { value: String(groups.length), label: 'Chủ đề' },
    { value: String(groups.filter((group) => group.isCourse).length), label: 'Chuỗi bài học' },
    {
        value: latestPosts[0]
            ? new Date(latestPosts[0].frontmatter.date).toLocaleDateString('vi-VN', {
                  day: '2-digit',
                  month: '2-digit',
                  year: 'numeric',
              })
            : '—',
        label: 'Cập nhật gần nhất',
        compact: true,
    },
]
---

<MainLayout
    title={`${name} | ${TC_TITLE}`}
    description={profile ? `${name} — ${profile.role}. ${profile.bio}` : `Các bài viết của ${name} trên Error404 Labs.`}
>
    <!-- ── HỒ SƠ TÁC GIẢ ────────────────────────────────────────────── -->
    <section class="relative overflow-hidden bg-navy-950 text-white">
        <div class="absolute inset-0 bg-grid-dark opacity-60 pointer-events-none" aria-hidden="true"></div>
        <div
            class="absolute -top-40 -right-32 w-[520px] h-[520px] rounded-full bg-blue-600/30 blur-[130px] pointer-events-none"
            aria-hidden="true"
        >
        </div>
        <div
            class="absolute -bottom-48 -left-24 w-[380px] h-[380px] rounded-full bg-sun-400/10 blur-[130px] pointer-events-none"
            aria-hidden="true"
        >
        </div>

        <div class="relative container-site py-10 md:py-16">
            <nav
                class="flex items-center gap-2 text-xs md:text-sm text-slate-400 mb-8 flex-wrap"
                aria-label="Breadcrumb"
                data-pagefind-ignore
            >
                <a href="/" class="hover:text-white transition-colors no-underline">Trang chủ</a>
                <span aria-hidden="true">/</span>
                <a href="/bai-viet" class="hover:text-white transition-colors no-underline">Bài viết</a>
                <span aria-hidden="true">/</span>
                <span class="text-slate-200" aria-current="page">{name}</span>
            </nav>

            <div class="grid grid-cols-1 md:grid-cols-[auto_minmax(0,1fr)] gap-6 md:gap-10 items-center">
                <!-- Ảnh đại diện -->
                <div class="relative w-32 h-32 md:w-44 md:h-44 lg:w-52 lg:h-52 shrink-0">
                    <div
                        class="absolute -inset-2 rounded-full bg-gradient-to-br from-sun-400 via-blue-500 to-blue-700 opacity-80 blur-md"
                        aria-hidden="true"
                    >
                    </div>
                    {
                        profile ? (
                            <img
                                src={profile.photo}
                                alt={`Ảnh của ${name}`}
                                width="200"
                                height="200"
                                class="relative w-full h-full rounded-full object-cover ring-4 ring-navy-950"
                            />
                        ) : (
                            <span class="relative w-full h-full rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 ring-4 ring-navy-950 flex items-center justify-center text-4xl md:text-6xl font-extrabold">
                                {initials}
                            </span>
                        )
                    }
                    <span
                        class="absolute bottom-1 right-1 md:bottom-3 md:right-3 w-9 h-9 md:w-11 md:h-11 rounded-full bg-white text-xl md:text-2xl flex items-center justify-center shadow-lg"
                        aria-hidden="true"
                    >
                        👋
                    </span>
                </div>

                <div class="min-w-0">
                    <span
                        class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-sun-400 text-xs font-bold px-3 py-1.5 rounded-full mb-4 uppercase tracking-wider"
                    >
                        <span class="w-1.5 h-1.5 rounded-full bg-sun-400" aria-hidden="true"></span>
                        Tác giả{profile ? ` · ${profile.tagline}` : ''}
                    </span>
                    <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight">{name}</h1>
                    {profile && <p class="mt-2 text-base md:text-lg font-bold text-sun-400">{profile.role}</p>}
                    {
                        profile && (
                            <p class="mt-4 text-slate-300 text-base md:text-lg leading-relaxed max-w-3xl">
                                {profile.bio}
                            </p>
                        )
                    }

                    <div class="mt-7 grid grid-cols-2 sm:flex sm:flex-wrap gap-3" data-pagefind-ignore>
                        <a href="/khoa-hoc" class="btn btn-sun col-span-2">
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.8"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"
                                ></path>
                            </svg>
                            Xem lớp học
                        </a>
                        {
                            profile?.facebook && (
                                <a href={profile.facebook} target="_blank" rel="noopener" class="btn btn-ghost-light">
                                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07" />
                                    </svg>
                                    Facebook
                                </a>
                            )
                        }
                        {
                            profile?.zalo && (
                                <a href={profile.zalo} target="_blank" rel="noopener" class="btn btn-ghost-light">
                                    <span aria-hidden="true">💬</span>
                                    Zalo
                                </a>
                            )
                        }
                    </div>
                </div>
            </div>

            <!-- Thống kê (tính từ dữ liệu bài viết) -->
            <dl class="mt-10 md:mt-14 grid grid-cols-2 md:grid-cols-4 gap-3" data-pagefind-ignore>
                {
                    stats.map((stat) => (
                        <div class="rounded-2xl bg-white/[0.06] border border-white/10 px-4 py-4 md:px-5">
                            <dt class="text-xs md:text-sm text-slate-400">{stat.label}</dt>
                            <dd
                                class:list={[
                                    'mt-1 font-extrabold tracking-tight text-white',
                                    stat.compact ? 'text-xl sm:text-2xl md:text-3xl' : 'text-2xl md:text-3xl',
                                ]}
                            >
                                {stat.value}
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </div>
    </section>

    <!-- ── BÀI VIẾT MỚI NHẤT ───────────────────────────────────────── -->
    {
        latestPosts.length > 0 && (
            <section class="bg-slate-50" aria-labelledby="latest-heading">
                <div class="container-site pt-12 md:pt-16 pb-4">
                    <span class="eyebrow">Mới cập nhật</span>
                    <h2
                        id="latest-heading"
                        class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mt-1 mb-6 md:mb-8"
                    >
                        Bài viết mới nhất
                    </h2>
                    {/* Điện thoại: vuốt ngang; màn hình rộng: lưới */}
                    <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory -mx-4 px-4 scroll-px-4 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:grid sm:grid-cols-2 lg:grid-cols-3 sm:gap-6 sm:overflow-visible sm:mx-0 sm:px-0 sm:pb-0">
                        {latestPosts.map((post) => (
                            <div class="w-[84%] shrink-0 snap-start sm:w-auto">
                                <PostCard frontmatter={post.frontmatter} url={post.url} tagType="h3" />
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        )
    }

    <!-- ── TẤT CẢ BÀI VIẾT THEO CHỦ ĐỀ ─────────────────────────────── -->
    <section class="bg-slate-50" aria-labelledby="all-posts-heading">
        <div class="container-site py-12 md:py-16">
            <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 mb-5">
                <div>
                    <span class="eyebrow">Thư viện</span>
                    <h2
                        id="all-posts-heading"
                        class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mt-1"
                    >
                        Tất cả bài viết theo chủ đề
                    </h2>
                </div>
                <p class="text-sm text-slate-500" data-pagefind-ignore>
                    <strong class="text-slate-800">{formattedPosts.length}</strong> bài viết · {groups.length} chủ đề
                </p>
            </div>

            <!-- Nhảy nhanh tới từng chủ đề -->
            <ul
                class="flex gap-2 mb-8 overflow-x-auto -mx-4 px-4 py-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:flex-wrap sm:overflow-visible sm:mx-0 sm:px-0"
                aria-label="Chọn chủ đề"
                data-pagefind-ignore
            >
                {
                    groups.map((group) => (
                        <li class="shrink-0">
                            <a
                                href={`#${group.anchor}`}
                                class="group inline-flex items-center gap-2 min-h-10 pl-3 pr-3.5 rounded-full border bg-white border-slate-200 text-sm font-semibold text-slate-700 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 no-underline transition-colors"
                            >
                                <span aria-hidden="true">{group.meta.icon}</span>
                                {group.meta.label}
                                <span class="inline-flex items-center justify-center min-w-6 h-6 px-1.5 rounded-full text-xs font-bold bg-slate-100 text-slate-500 group-hover:bg-blue-100 group-hover:text-blue-700">
                                    {group.count}
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
                {
                    groups.map((group) => (
                        <article id={group.anchor} class="card p-5 md:p-6" aria-labelledby={`${group.anchor}-title`}>
                            <header class="flex items-center gap-3 pb-4 mb-1 border-b border-slate-100">
                                <span
                                    class={`w-11 h-11 shrink-0 rounded-xl border ${group.meta.chip} flex items-center justify-center text-xl shadow-md`}
                                    aria-hidden="true"
                                >
                                    {group.meta.icon}
                                </span>
                                <div class="min-w-0 flex-1">
                                    <h3
                                        id={`${group.anchor}-title`}
                                        class="text-lg font-extrabold text-slate-900 leading-tight truncate"
                                    >
                                        {group.meta.label}
                                    </h3>
                                    <p class="text-xs font-semibold text-slate-400 mt-0.5">
                                        {group.count} {group.isCourse ? 'bài học · Chuỗi bài học' : 'bài viết'}
                                    </p>
                                </div>
                                <a
                                    href={group.href}
                                    class="shrink-0 inline-flex items-center gap-1 h-10 px-3 rounded-xl text-sm font-bold text-blue-600 hover:bg-blue-50 no-underline transition-colors"
                                    data-pagefind-ignore
                                >
                                    Xem<span class="hidden sm:inline"> chủ đề</span>
                                    <span aria-hidden="true">→</span>
                                </a>
                            </header>

                            <ol class="divide-y divide-slate-100">
                                {group.items.slice(0, VISIBLE_ROWS).map((post, index) => (
                                    <li>
                                        <a href={post.url} class="group/row flex items-center gap-3 py-3 no-underline">
                                            <img
                                                src={post.frontmatter.image?.src}
                                                alt=""
                                                width="96"
                                                height="54"
                                                loading="lazy"
                                                decoding="async"
                                                class="w-20 sm:w-24 aspect-video shrink-0 rounded-lg object-cover bg-slate-100 border border-slate-100"
                                            />
                                            <div class="min-w-0 flex-1">
                                                <p class="text-sm font-semibold text-slate-800 leading-snug line-clamp-2 group-hover/row:text-blue-700 transition-colors">
                                                    {group.isCourse && (
                                                        <span class="font-extrabold text-blue-600">
                                                            Bài {index + 1} ·{' '}
                                                        </span>
                                                    )}
                                                    {post.frontmatter.title}
                                                </p>
                                                <p class="mt-1 text-xs text-slate-400">
                                                    {`${formatDate(post.frontmatter.date, 'vi-VN')} · ~${minutesByUrl[post.url] || 1} phút đọc`}
                                                </p>
                                            </div>
                                        </a>
                                    </li>
                                ))}
                            </ol>

                            {group.items.length > VISIBLE_ROWS && (
                                <details class="group/more border-t border-slate-100">
                                    <summary class="list-none [&::-webkit-details-marker]:hidden mt-3 flex items-center justify-center gap-1.5 h-10 rounded-xl border border-dashed border-slate-300 text-sm font-bold text-slate-600 hover:border-blue-300 hover:text-blue-700 hover:bg-blue-50/50 transition-colors">
                                        <span class="group-open/more:hidden">
                                            Xem thêm {group.items.length - VISIBLE_ROWS} bài
                                        </span>
                                        <span class="hidden group-open/more:inline">Thu gọn</span>
                                        <svg
                                            class="w-4 h-4 transition-transform group-open/more:rotate-180"
                                            viewBox="0 0 20 20"
                                            fill="currentColor"
                                            aria-hidden="true"
                                        >
                                            <path
                                                fill-rule="evenodd"
                                                d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                                                clip-rule="evenodd"
                                            />
                                        </svg>
                                    </summary>
                                    <ol class="divide-y divide-slate-100 mt-1">
                                        {group.items.slice(VISIBLE_ROWS).map((post, index) => (
                                            <li>
                                                <a
                                                    href={post.url}
                                                    class="group/row flex items-center gap-3 py-3 no-underline"
                                                >
                                                    <img
                                                        src={post.frontmatter.image?.src}
                                                        alt=""
                                                        width="96"
                                                        height="54"
                                                        loading="lazy"
                                                        decoding="async"
                                                        class="w-20 sm:w-24 aspect-video shrink-0 rounded-lg object-cover bg-slate-100 border border-slate-100"
                                                    />
                                                    <div class="min-w-0 flex-1">
                                                        <p class="text-sm font-semibold text-slate-800 leading-snug line-clamp-2 group-hover/row:text-blue-700 transition-colors">
                                                            {group.isCourse && (
                                                                <span class="font-extrabold text-blue-600">
                                                                    Bài {index + VISIBLE_ROWS + 1} ·{' '}
                                                                </span>
                                                            )}
                                                            {post.frontmatter.title}
                                                        </p>
                                                        <p class="mt-1 text-xs text-slate-400">
                                                            {`${formatDate(post.frontmatter.date, 'vi-VN')} · ~${minutesByUrl[post.url] || 1} phút đọc`}
                                                        </p>
                                                    </div>
                                                </a>
                                            </li>
                                        ))}
                                    </ol>
                                </details>
                            )}
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ── HỌC TRỰC TIẾP ────────────────────────────────────────────── -->
    {
        profile && (
            <section class="bg-white" aria-labelledby="class-heading" data-pagefind-ignore>
                <div class="container-site py-12 md:py-16">
                    <div class="relative overflow-hidden rounded-3xl bg-navy-950 text-white p-6 md:p-10 lg:p-12">
                        <div class="absolute inset-0 bg-grid-dark opacity-50 pointer-events-none" aria-hidden="true" />
                        <div
                            class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-blue-600/40 blur-[100px] pointer-events-none"
                            aria-hidden="true"
                        />
                        <div class="relative grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] gap-8 lg:gap-12 items-center">
                            <div>
                                <span class="text-xs font-extrabold uppercase tracking-[0.12em] text-sun-400">
                                    Học trực tiếp cùng tác giả
                                </span>
                                <h2
                                    id="class-heading"
                                    class="mt-2 text-2xl md:text-4xl font-extrabold tracking-tight leading-tight"
                                >
                                    Tư duy sáng tạo qua lập trình Web &amp; Game
                                </h2>
                                <p class="mt-3 text-slate-300 max-w-2xl">
                                    HTML, CSS &amp; JAVASCRIPT – Hành trình sáng tạo công nghệ. Học qua dự án thực tế,
                                    không học thuộc lòng.
                                </p>
                                <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                                    <li class="flex items-start gap-3 rounded-2xl bg-white/[0.06] border border-white/10 p-4">
                                        <span class="text-xl leading-none" aria-hidden="true">
                                            🏫
                                        </span>
                                        <span>
                                            <strong class="block text-white">Offline</strong>
                                            <span class="text-slate-300">3 - 5 học sinh / lớp (kèm sát)</span>
                                        </span>
                                    </li>
                                    <li class="flex items-start gap-3 rounded-2xl bg-white/[0.06] border border-white/10 p-4">
                                        <span class="text-xl leading-none" aria-hidden="true">
                                            💻
                                        </span>
                                        <span>
                                            <strong class="block text-white">Online</strong>
                                            <span class="text-slate-300">1 kèm 1 trực tiếp (tương tác cao)</span>
                                        </span>
                                    </li>
                                    <li class="flex items-start gap-3 rounded-2xl bg-white/[0.06] border border-white/10 p-4">
                                        <span class="text-xl leading-none" aria-hidden="true">
                                            🗓️
                                        </span>
                                        <span>
                                            <strong class="block text-white">Lịch học</strong>
                                            <span class="text-slate-300">2 buổi / tuần</span>
                                        </span>
                                    </li>
                                    <li class="flex items-start gap-3 rounded-2xl bg-white/[0.06] border border-white/10 p-4">
                                        <span class="text-xl leading-none" aria-hidden="true">
                                            📍
                                        </span>
                                        <span>
                                            <strong class="block text-white">Địa chỉ</strong>
                                            <span class="text-slate-300">308 Đ. TX 25, Thạnh Xuân, Q.12, TP.HCM</span>
                                        </span>
                                    </li>
                                </ul>
                            </div>
                            <div class="flex flex-col sm:flex-row lg:flex-col gap-3 lg:min-w-[240px]">
                                <a href="/khoa-hoc" class="btn btn-sun btn-lg">
                                    Xem lớp học
                                    <span aria-hidden="true">→</span>
                                </a>
                                <a
                                    href="https://zalo.me/0373306966"
                                    target="_blank"
