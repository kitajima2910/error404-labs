            // Prompt Access Logic
            async function loadPromptsData() {
                try {
                    const res = await fetch('/api/get-prompt?type=list', {
                        headers: { Authorization: `Bearer ${localStorage.getItem('auth_token')}` },
                    })
                    if (res.ok) {
                        const data = await res.json()
                        allPromptsData = data.prompts || []
                    }
                } catch {}
                // Merge vibe prompts (injected from server)
                const vibePrompts = window.__VIBE_PROMPTS__ || []
                // Remove any stale vibe_ entries then re-add fresh ones
                allPromptsData = allPromptsData.filter((p) => !String(p.id).startsWith('vibe_'))
                allPromptsData = allPromptsData.concat(vibePrompts)
            }

            function renderPromptAccessList(filterText = '', tab = currentTab) {
                promptAccessList.innerHTML = ''
                const filter = filterText.toLowerCase()
                let filteredByTab = allPromptsData
                if (tab === 'tools')
                    filteredByTab = allPromptsData.filter(
                        (p) => !String(p.id).startsWith('roadmap_') && !String(p.id).startsWith('vibe_'),
                    )
                else if (tab === 'roadmap')
                    filteredByTab = allPromptsData.filter((p) => String(p.id).startsWith('roadmap_'))
                else if (tab === 'vibe') filteredByTab = allPromptsData.filter((p) => String(p.id).startsWith('vibe_'))

                const filteredPrompts = filteredByTab.filter(
                    (p) => p.text.toLowerCase().includes(filter) || String(p.id).includes(filter),
                )
                if (filteredPrompts.length === 0) {
                    promptAccessList.innerHTML =
                        '<div class="text-center text-slate-400 py-8">Không tìm thấy prompt nào</div>'
                    return
                }

                filteredPrompts.forEach((p) => {
                    const isChecked = currentPromptAccessList.includes(String(p.id))
                    const label = document.createElement('label')
                    const isVibe = String(p.id).startsWith('vibe_')
                    label.className = `flex items-center gap-3 p-3 rounded-xl border transition-all cursor-pointer ${isChecked ? (isVibe ? 'bg-purple-50 border-purple-200' : 'bg-emerald-50 border-emerald-200') : 'bg-white border-slate-100 hover:border-slate-300'}`
                    label.innerHTML = `<input type="checkbox" class="w-4 h-4 ${isVibe ? 'text-purple-600' : 'text-emerald-600'} rounded border-slate-300 focus:ring-purple-500 cursor-pointer" ${isChecked ? 'checked' : ''}><span class="flex-1 text-sm font-medium text-slate-700">${isVibe ? '🍄 ' : ''}${p.text}</span><span class="text-xs font-bold px-2 py-0.5 rounded ${isVibe ? 'bg-purple-50 text-purple-500' : 'bg-slate-100 text-slate-500'}">#${p.id}</span>`
                    label.querySelector('input').onchange = (e) => {
                        if (e.target.checked) {
                            if (!currentPromptAccessList.includes(String(p.id)))
                                currentPromptAccessList.push(String(p.id))
                        } else currentPromptAccessList = currentPromptAccessList.filter((id) => id !== String(p.id))
                        label.className = `flex items-center gap-3 p-3 rounded-xl border transition-all cursor-pointer ${e.target.checked ? (isVibe ? 'bg-purple-50 border-purple-200' : 'bg-emerald-50 border-emerald-200') : 'bg-white border-slate-100 hover:border-slate-300'}`
                    }
                    promptAccessList.appendChild(label)
                })
            }

