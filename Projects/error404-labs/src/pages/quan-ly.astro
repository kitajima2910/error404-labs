                               ${canEdit ? `<button onclick="window.editMember(${m.id})" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-xl transition-all cursor-pointer" title="Chỉnh sửa"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" /></svg></button>` : ''}
                               ${canDelete ? `<button onclick="window.toggleMemberStatus(${m.id})" class="p-2 rounded-xl transition-all cursor-pointer ${m.status === 'active' ? 'text-red-600 hover:bg-red-50' : 'text-green-600 hover:bg-green-50'}" title="${m.status === 'active' ? 'Khóa tài khoản' : 'Mở khóa tài khoản'}">${m.status === 'active' ? '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>' : '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" /></svg>'}</button>` : ''}
                               ${canDelete ? `<button onclick="window.deleteMember(${m.id}, '${m.member.replace(/'/g, "\\'")}')" class="p-2 text-red-600 hover:bg-red-50 rounded-xl transition-all cursor-pointer" title="Xóa vĩnh viễn tài khoản"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg></button>` : ''}
                           </div>
                       </td>
                  `
                    tableBody.appendChild(tr)
                })
            }

            function renderPagination() {
                const totalPages = Math.ceil(total / limit)
                showingStart.textContent = total === 0 ? 0 : (currentPage - 1) * limit + 1
                showingEnd.textContent = Math.min(currentPage * limit, total)
                totalMembers.textContent = total

                prevPageBtn.disabled = currentPage === 1
                nextPageBtn.disabled = currentPage === totalPages || totalPages === 0

                pageNumbers.innerHTML = ''
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button')
                    btn.textContent = i
                    btn.className = `w-8 h-8 rounded-lg text-sm font-bold transition-all cursor-pointer ${currentPage === i ? 'bg-indigo-600 text-white shadow-md shadow-indigo-100' : 'text-slate-500 hover:bg-white hover:shadow-sm'}`
                    btn.onclick = () => {
                        currentPage = i
                        fetchMembers()
                    }
                    pageNumbers.appendChild(btn)
                }
            }

            function renderLessonPagination() {
                const totalPages = Math.ceil(lessonTotal / 5)
                const lessonShowingStart = document.getElementById('lessonShowingStart')
                const lessonShowingEnd = document.getElementById('lessonShowingEnd')
                const totalLessons = document.getElementById('totalLessons')
                const lessonPrevPage = document.getElementById('lessonPrevPage')
                const lessonNextPage = document.getElementById('lessonNextPage')
                const lessonPageNumbers = document.getElementById('lessonPageNumbers')

                lessonShowingStart.textContent = lessonTotal === 0 ? 0 : (lessonCurrentPage - 1) * 5 + 1
                lessonShowingEnd.textContent = Math.min(lessonCurrentPage * 5, lessonTotal)
                totalLessons.textContent = lessonTotal

                lessonPrevPage.disabled = lessonCurrentPage === 1
                lessonNextPage.disabled = lessonCurrentPage === totalPages || totalPages === 0

                lessonPageNumbers.innerHTML = ''
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button')
                    btn.textContent = i
                    btn.className = `w-8 h-8 rounded-lg text-sm font-bold transition-all cursor-pointer ${lessonCurrentPage === i ? 'bg-indigo-600 text-white shadow-md shadow-indigo-100' : 'text-slate-500 hover:bg-white hover:shadow-sm'}`
                    btn.onclick = () => {
                        lessonCurrentPage = i
                        fetchLessons()
                    }
                    lessonPageNumbers.appendChild(btn)
                }
            }

            // Lesson CRUD Logic
            async function fetchLessons() {
                const offset = (lessonCurrentPage - 1) * 5
                try {
                    const res = await fetch(
                        `/api/admin/lessons?search=${encodeURIComponent(lessonSearchQuery)}&sortBy=${lessonSortBy}&sortOrder=${lessonSortOrder}&limit=5&offset=${offset}`,
                        {
                            headers: { Authorization: `Bearer ${localStorage.getItem('auth_token')}` },
                        },
                    )
                    if (!res.ok) throw new Error('Lỗi khi tải danh sách bài học')
                    const data = await res.json()
                    lessons = data.lessons
                    lessonTotal = data.total
                    renderLessons()
                    renderLessonPagination()
                } catch (err) {
                    lessonTableBody.innerHTML = `<tr><td colspan="5" class="px-6 py-12 text-center text-red-500">${err.message}</td></tr>`
                }
            }

            function renderLessons() {
                lessonTableBody.innerHTML = ''
                if (lessons.length === 0) {
                    lessonTableBody.innerHTML =
                        '<tr><td colspan="6" class="px-6 py-12 text-center text-slate-400 italic">Không tìm thấy bài học nào.</td></tr>'
                    return
                }

                lessons.forEach((lesson) => {
                    const tr = document.createElement('tr')
                    tr.className = 'hover:bg-slate-50 transition-colors'
                    tr.innerHTML = `
                    <td data-label="Ảnh" class="px-2 py-2 sm:px-4 sm:py-3">
                        ${
                            lesson.thumbnail_url
                                ? `<img src="${lesson.thumbnail_url}" alt="${lesson.title}" class="w-12 h-12 object-cover rounded-lg shadow-sm border border-slate-100" loading="lazy" />`
                                : `<div class="w-12 h-12 rounded-lg bg-slate-100 flex items-center justify-center border border-slate-200">
                                <svg class="w-5 h-5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                               </div>`
                        }
                    </td>
                    <td data-label="Tiêu đề" class="px-3 py-2 sm:px-6 sm:py-4 text-sm font-semibold text-slate-900">${lesson.title}</td>
                    <td data-label="Mô tả" class="px-3 py-2 sm:px-6 sm:py-4 text-sm text-slate-600 max-w-xs truncate">${lesson.description || '-'}</td>
                    <td data-label="Người thực hiện" class="px-3 py-2 sm:px-6 sm:py-4 text-sm text-slate-600">${lesson.author || '-'}</td>
                    <td data-label="Liên kết" class="px-3 py-2 sm:px-6 sm:py-4 text-center">
                        <a href="${lesson.url}" target="_blank" class="text-indigo-600 hover:text-indigo-800 font-medium flex items-center justify-center gap-1">
                            Xem bài học
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                        </a>
                    </td>
                    <td data-label="Thao tác" class="px-3 py-2 sm:px-6 sm:py-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                            <button onclick="window.editLesson(${lesson.id})" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-xl transition-all cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                </svg>
                            </button>
                            <button onclick="window.deleteLesson(${lesson.id})" class="p-2 text-red-600 hover:bg-red-50 rounded-xl transition-all cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </td>
                `
                    lessonTableBody.appendChild(tr)
                })
            }

            // ─────────────────────────────────────────────────────────────────────
            // 3. EVENT LISTENERS
            // ─────────────────────────────────────────────────────────────────────

            // Search & Filters Listeners
            memberSearch.oninput = (e) => {
                clearTimeout(searchTimeout)
                searchTimeout = setTimeout(() => {
                    search = e.target.value
                    currentPage = 1
                    fetchMembers()
                }, 300)
            }
            roleFilterSelect.onchange = (e) => {
                roleFilter = e.target.value
                currentPage = 1
                fetchMembers()
            }
            statusFilterSelect.onchange = (e) => {
                statusFilter = e.target.value
                currentPage = 1
                fetchMembers()
            }

            sortHeaders.forEach((header) => {
                header.onclick = () => {
                    const newSortBy = header.dataset.sort
                    if (sortBy === newSortBy) sortOrder = sortOrder === 'ASC' ? 'DESC' : 'ASC'
                    else {
                        sortBy = newSortBy
                        sortOrder = 'ASC'
                    }
                    sortHeaders.forEach((h) => {
                        const icon = h.querySelector('.sort-icon')
                        if (h === header) {
                            icon.textContent = sortOrder === 'ASC' ? '↑' : '↓'
                            icon.classList.remove('opacity-20')
                        } else {
                            icon.textContent = '⇅'
                            icon.classList.add('opacity-20')
                        }
                    })
                    fetchMembers()
                }
            })

            prevPageBtn.onclick = () => {
                if (currentPage > 1) {
                    currentPage--
                    fetchMembers()
                }
            }
            nextPageBtn.onclick = () => {
                if (currentPage < Math.ceil(total / limit)) {
                    currentPage++
                    fetchMembers()
                }
            }

            // Member Modal Logic
            function openModal(isEdit = false, data = null) {
                modalTitle.textContent = isEdit ? 'Chỉnh sửa tài khoản' : 'Thêm tài khoản mới'
                passwordHint.classList.toggle('hidden', isEdit)
                document.getElementById('mPassword').required = !isEdit
                if (isEdit && data) {
                    document.getElementById('memberId').value = data.id
                    document.getElementById('mUsername').value = data.member
                    document.getElementById('mDisplayName').value = data.display_name || ''
                    document.getElementById('mRole').value = data.roles
                    document.getElementById('mPassword').value = ''
                } else {
                    memberForm.reset()
                    document.getElementById('memberId').value = ''
                    document.getElementById('mRole').value = 'member'
                }
                modal.classList.remove('hidden')
                modal.classList.add('flex')
                setTimeout(() => {
                    modalContent.classList.remove('scale-95', 'opacity-0')
                    modalContent.classList.add('scale-100', 'opacity-100')
                }, 10)
                document.body.style.overflow = 'hidden'
            }

            function closeModal() {
                modalContent.classList.add('scale-95', 'opacity-0')
                modalContent.classList.remove('scale-100', 'opacity-100')
                setTimeout(() => {
                    modal.classList.add('hidden')
                    modal.classList.remove('flex')
                    document.body.style.overflow = ''
                }, 200)
            }

            // Roadmap Modal Logic
            window.openRoadmapModal = function (memberId, memberName, editLabel = null) {
                if (roadmapMemberId) roadmapMemberId.value = memberId

                const modalTitleEl = document.querySelector('#roadmapModalContent h3')

                if (editLabel) {
                    // Parse label "LTH52026-T1" thành year và month
                    const match = editLabel.match(/LTH5(\d{4})-T(\d{1,2})/)
                    if (match) {
                        if (roadmapYear) roadmapYear.value = match[1]
                        if (roadmapMonth) roadmapMonth.value = match[2]
                    }
                    window.currentEditLabel = editLabel
                    if (modalTitleEl) modalTitleEl.textContent = 'Chỉnh sửa nhãn lộ trình'
                } else {
                    if (roadmapYear) roadmapYear.value = '2026'
                    if (roadmapMonth) roadmapMonth.value = '1'
                    window.currentEditLabel = null
                    if (modalTitleEl) modalTitleEl.textContent = 'Đánh dấu lộ trình'
                }

                if (roadmapModal) {
                    roadmapModal.classList.remove('hidden')
                    roadmapModal.classList.add('flex')
                }
                if (roadmapModalContent) {
                    setTimeout(() => {
                        roadmapModalContent.classList.remove('scale-95', 'opacity-0')
                        roadmapModalContent.classList.add('scale-100', 'opacity-100')
                    }, 10)
                }
                document.body.style.overflow = 'hidden'
            }

            function closeRoadmapModalFunc() {
                if (roadmapModalContent) {
                    roadmapModalContent.classList.add('scale-95', 'opacity-0')
                    roadmapModalContent.classList.remove('scale-100', 'opacity-100')
                }
                setTimeout(() => {
                    if (roadmapModal) {
                        roadmapModal.classList.add('hidden')
                        roadmapModal.classList.remove('flex')
                    }
                    document.body.style.overflow = ''
                }, 200)
            }

            if (closeRoadmapModal) closeRoadmapModal.onclick = closeRoadmapModalFunc
            if (cancelRoadmapModal) cancelRoadmapModal.onclick = closeRoadmapModalFunc
            if (roadmapModal)
                roadmapModal.onclick = (e) => {
                    if (e.target === roadmapModal) closeRoadmapModalFunc()
                }

            if (roadmapForm) {
                roadmapForm.onsubmit = async (e) => {
                    e.preventDefault()
                    const memberId = roadmapMemberId?.value
                    const year = roadmapYear?.value
                    const month = roadmapMonth?.value
                    const newLabel = `LTH5${year}-T${month}`

                    // Tìm member hiện tại
                    const member = members.find((m) => m.id == memberId)
                    if (!member) return

                    // Kiểm tra trùng lặp cho cả thêm mới và sửa
                    const currentRoadmap = Array.isArray(member.roadmap_h5) ? [...member.roadmap_h5] : []
                    const isDuplicate = window.currentEditLabel
                        ? newLabel !== window.currentEditLabel && currentRoadmap.includes(newLabel)
                        : currentRoadmap.includes(newLabel)
                    if (isDuplicate) {
                        showToast('Nhãn này đã tồn tại', 'warning')
                        return
                    }

                    let payload
                    if (window.currentEditLabel) {
                        // Chế độ sửa: tìm index và thay thế trực tiếp
                        const idx = currentRoadmap.indexOf(window.currentEditLabel)
                        if (idx !== -1) {
                            currentRoadmap[idx] = newLabel
                        } else {
                            currentRoadmap.push(newLabel)
                        }
                        payload = { id: memberId, roadmap_h5: currentRoadmap }
                    } else {
                        // Chế độ thêm mới
                        currentRoadmap.push(newLabel)
                        payload = { id: memberId, roadmap_h5: currentRoadmap }
                    }

                    try {
                        const res = await fetch('/api/admin/members', {
                            method: 'PUT',
                            headers: {
                                'Content-Type': 'application/json',
                                Authorization: `Bearer ${localStorage.getItem('auth_token')}`,
                            },
                            body: JSON.stringify(payload),
                        })
                        if (res.ok) {
                            showToast(
                                window.currentEditLabel
                                    ? `Đã cập nhật nhãn thành ${newLabel}`
                                    : `Đã thêm nhãn lộ trình ${newLabel}`,
                                'success',
                            )
                            closeRoadmapModalFunc()
                            fetchMembers()
                        } else {
                            const err = await res.json()
                            showToast(err.error || 'Lỗi thao tác', 'error')
                        }
                    } catch {
                        showToast('Lỗi kết nối', 'error')
                    }
                }
            }

            addMemberBtn.onclick = () => openModal(false)
            closeModalBtns.forEach((btn) => (btn.onclick = closeModal))
            modal.onclick = (e) => {
                if (e.target === modal) closeModal()
            }

            memberForm.onsubmit = async (e) => {
                e.preventDefault()
                const formData = new FormData(memberForm)
                const data = Object.fromEntries(formData.entries())
                const isEdit = !!data.id
                try {
                    const res = await fetch('/api/admin/members', {
                        method: isEdit ? 'PUT' : 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            Authorization: `Bearer ${localStorage.getItem('auth_token')}`,
                        },
                        body: JSON.stringify(data),
                    })
                    if (res.ok) {
                        showToast(isEdit ? 'Cập nhật thành công' : 'Thêm mới thành công', 'success')
                        closeModal()
                        fetchMembers()
                    } else {
                        const err = await res.json()
                        showToast(err.error || 'Lỗi thao tác', 'error')
                    }
                } catch {
                    showToast('Lỗi kết nối', 'error')
                }
            }

            async function fetchMembersForSelect() {
                try {
                    const res = await fetch('/api/admin/members?role=member&limit=100', {
                        headers: { Authorization: `Bearer ${localStorage.getItem('auth_token')}` },
                    })
                    if (!res.ok) throw new Error('Không thể tải danh sách thành viên')
                    const data = await res.json()
                    const select = document.getElementById('lAuthor')
                    select.innerHTML = '<option value="">Chọn người thực hiện</option>'
                    data.members.forEach((member) => {
                        const option = document.createElement('option')
                        option.value = member.member
                        option.textContent = member.display_name || member.member
                        select.appendChild(option)
                    })
                } catch (err) {
                    console.error('Lỗi tải danh sách thành viên:', err)
                }
            }

            // Lesson Modal Logic
            async function openLessonModal(isEdit = false, data = null) {
                lessonModalTitle.textContent = isEdit ? 'Chỉnh sửa bài học' : 'Thêm bài học mới'
                await fetchMembersForSelect()

                // Reset thumbnail UI
                resetThumbnailUI()

                if (isEdit && data) {
                    document.getElementById('lessonId').value = data.id
                    document.getElementById('lTitle').value = data.title
                    document.getElementById('lUrl').value = data.url
                    document.getElementById('lDescription').value = data.description || ''
                    document.getElementById('lAuthor').value = data.author || ''
                    document.getElementById('lThumbnailUrl').value = data.thumbnail_url || ''
                    // Hiển thị preview nếu đã có ảnh
                    if (data.thumbnail_url) {
                        showThumbnailPreview(data.thumbnail_url)
                    }
                } else {
                    lessonForm.reset()
                    document.getElementById('lessonId').value = ''
                    document.getElementById('lThumbnailUrl').value = ''
                }
                lessonModal.classList.remove('hidden')
                lessonModal.classList.add('flex')
                setTimeout(() => {
                    lessonModalContent.classList.remove('scale-95', 'opacity-0')
                    lessonModalContent.classList.add('scale-100', 'opacity-100')
                }, 10)
                document.body.style.overflow = 'hidden'
            }

            function closeLessonModal() {
                lessonModalContent.classList.add('scale-95', 'opacity-0')
                lessonModalContent.classList.remove('scale-100', 'opacity-100')
                setTimeout(() => {
                    lessonModal.classList.add('hidden')
                    lessonModal.classList.remove('flex')
                    document.body.style.overflow = ''
                    resetThumbnailUI()
                }, 200)
            }

            function openLessonDeleteModal(id) {
                lessonToDelete = id
                const modal = document.getElementById('lessonDeleteModal')
                const modalContent = document.getElementById('lessonDeleteModalContent')
                modal.classList.remove('hidden')
                modal.classList.add('flex')
                setTimeout(() => {
                    modalContent.classList.remove('scale-95', 'opacity-0')
                    modalContent.classList.add('scale-100', 'opacity-100')
                }, 10)
                document.body.style.overflow = 'hidden'
            }

            function closeLessonDeleteModal() {
                const modal = document.getElementById('lessonDeleteModal')
                const modalContent = document.getElementById('lessonDeleteModalContent')
                modalContent.classList.add('scale-95', 'opacity-0')
                modalContent.classList.remove('scale-100', 'opacity-100')
                setTimeout(() => {
                    modal.classList.add('hidden')
                    modal.classList.remove('flex')
                    document.body.style.overflow = ''
                    lessonToDelete = null
                }, 200)
            }

            window.editMember = (id) => {
                const member = members.find((m) => m.id === id)
                if (member) openModal(true, member)
            }
            window.toggleMemberStatus = (id) => openDeleteModal(id)
            window.deleteMember = (id, memberName) => openMemberDeleteModal(id, memberName)
            window.editLesson = async (id) => {
                const lesson = lessons.find((l) => l.id === id)
                if (lesson) await openLessonModal(true, lesson)
            }
            window.deleteRoadmapLabel = async (memberId, labelToDelete) => {
                const member = members.find((m) => m.id == memberId)
                if (!member) return

                const currentRoadmap = Array.isArray(member.roadmap_h5) ? [...member.roadmap_h5] : []
                const idx = currentRoadmap.indexOf(labelToDelete)
                if (idx !== -1) currentRoadmap.splice(idx, 1)
                const updatedRoadmap = currentRoadmap

                try {
                    const res = await fetch('/api/admin/members', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            Authorization: `Bearer ${localStorage.getItem('auth_token')}`,
                        },
                        body: JSON.stringify({ id: memberId, roadmap_h5: updatedRoadmap }),
                    })
                    if (res.ok) {
                        showToast('Đã xóa nhãn lộ trình', 'success')
                        fetchMembers()
                    } else {
                        const err = await res.json()
                        showToast(err.error || 'Lỗi xóa nhãn', 'error')
                    }
                } catch {
                    showToast('Lỗi kết nối', 'error')
                }
            }

            function openMemberDeleteModal(id, memberName) {
                memberToDelete = id
                memberToDeleteName = memberName
                const m = document.getElementById('memberDeleteModal')
                const mc = document.getElementById('memberDeleteModalContent')
                const nameEl = document.getElementById('memberDeleteTargetName')
                if (nameEl) nameEl.textContent = memberName
                m.classList.remove('hidden')
                m.classList.add('flex')
                setTimeout(() => {
                    mc.classList.remove('scale-95', 'opacity-0')
                    mc.classList.add('scale-100', 'opacity-100')
                }, 10)
                document.body.style.overflow = 'hidden'
            }

            function closeMemberDeleteModal() {
                const m = document.getElementById('memberDeleteModal')
                const mc = document.getElementById('memberDeleteModalContent')
                mc.classList.add('scale-95', 'opacity-0')
                mc.classList.remove('scale-100', 'opacity-100')
                setTimeout(() => {
                    m.classList.add('hidden')
                    m.classList.remove('flex')
                    document.body.style.overflow = ''
                    memberToDelete = null
                    memberToDeleteName = ''
                }, 200)
            }

            document.getElementById('confirmMemberDeleteBtn').onclick = async () => {
                if (!memberToDelete) return
                try {
                    const res = await fetch('/api/admin/members', {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                            Authorization: `Bearer ${localStorage.getItem('auth_token')}`,
                        },
