                roadmapGameForm.reset()
                resetRgUI()
                document.getElementById('roadmapGameId').value = data?.id || ''
                document.getElementById('rgName').value = data?.name || ''
                document.getElementById('rgGenre').value = data?.genre || ''
                document.getElementById('rgImageUrl').value = data?.image_url || ''
                document.getElementById('rgImageFileId').value = data?.image_file_id || ''
                document.getElementById('rgDesignUrl').value = data?.design_url || ''
                document.getElementById('rgYoutubeUrl').value = data?.youtube_url || ''
                document.getElementById('rgPromptContent').value = data?.prompt_content || ''
                document.getElementById('rgIsVerified').checked = !!data?.is_verified
                if (data?.image_url) {
                    showRgPreview(data.image_url)
                }
                roadmapGameModal.classList.remove('hidden')
                roadmapGameModal.classList.add('flex')
                setTimeout(() => {
                    roadmapGameModalContent.classList.remove('scale-95', 'opacity-0')
                    roadmapGameModalContent.classList.add('scale-100', 'opacity-100')
                }, 10)
            }

            function closeRoadmapGameModal() {
                roadmapGameModalContent.classList.add('scale-95', 'opacity-0')
                roadmapGameModalContent.classList.remove('scale-100', 'opacity-100')
                setTimeout(() => {
                    roadmapGameModal.classList.add('hidden')
                    roadmapGameModal.classList.remove('flex')
                }, 200)
            }

            window.editRoadmapGame = (id) => {
                const game = roadmapGames.find((item) => item.id === id)
                if (game) openRoadmapGameModal(true, game)
            }

            window.deleteRoadmapGame = (id) => {
                roadmapGameToDelete = id
                const modal = document.getElementById('roadmapGameDeleteModal')
                const modalContent = document.getElementById('roadmapGameDeleteModalContent')
                modal.classList.remove('hidden')
                modal.classList.add('flex')
                setTimeout(() => {
                    modalContent.classList.remove('scale-95', 'opacity-0')
                    modalContent.classList.add('scale-100', 'opacity-100')
                }, 10)
            }

            function closeRoadmapGameDeleteModal() {
                const modal = document.getElementById('roadmapGameDeleteModal')
                const modalContent = document.getElementById('roadmapGameDeleteModalContent')
                modalContent.classList.add('scale-95', 'opacity-0')
                modalContent.classList.remove('scale-100', 'opacity-100')
                setTimeout(() => {
                    modal.classList.add('hidden')
                    modal.classList.remove('flex')
                    roadmapGameToDelete = null
                }, 200)
            }

            if (addRoadmapGameBtn) addRoadmapGameBtn.onclick = () => openRoadmapGameModal(false)
            closeRoadmapGameModalBtns.forEach((btn) => (btn.onclick = closeRoadmapGameModal))

            document.getElementById('rgImageFile')?.addEventListener('change', function () {
                const file = this.files?.[0]
                if (!file) return
                const reader = new FileReader()
                reader.onload = (e) => showRgPreview(e.target.result)
                reader.readAsDataURL(file)
                const status = document.getElementById('rgUploadStatus')
                status.classList.add('hidden')
            })

            document.getElementById('removeRgImageBtn')?.addEventListener('click', function (e) {
                e.stopPropagation()
                resetRgUI()
                document.getElementById('rgImageUrl').value = ''
                document.getElementById('rgImageFileId').value = ''
            })

            // Roadmap Game delete modal
            document.getElementById('confirmRoadmapGameDeleteBtn').onclick = async () => {
                if (!roadmapGameToDelete) return
                try {
                    const res = await fetch('/api/admin/roadmap-games', {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                            Authorization: `Bearer ${localStorage.getItem('auth_token')}`,
                        },
                        body: JSON.stringify({ id: roadmapGameToDelete }),
                    })
                    if (res.ok) {
                        showToast('Đã xóa roadmap game', 'success')
                        fetchRoadmapGames()
                        closeRoadmapGameDeleteModal()
                    } else {
                        const data = await res.json()
                        showToast(data.error || 'Không thể xóa roadmap game', 'error')
                    }
                } catch {
                    showToast('Lỗi kết nối', 'error')
                }
            }
            document.getElementById('cancelRoadmapGameDeleteBtn').onclick = closeRoadmapGameDeleteModal
            document.getElementById('roadmapGameDeleteModal').onclick = (e) => {
                if (e.target === document.getElementById('roadmapGameDeleteModal')) closeRoadmapGameDeleteModal()
            }

            if (roadmapGameModal) roadmapGameModal.onclick = (e) => {
                if (e.target === roadmapGameModal) closeRoadmapGameModal()
            }
            if (roadmapGamePrevPage) roadmapGamePrevPage.onclick = () => {
                if (roadmapGameCurrentPage > 1) {
                    roadmapGameCurrentPage--
                    fetchRoadmapGames()
                }
            }
            if (roadmapGameNextPage) roadmapGameNextPage.onclick = () => {
                if (roadmapGameCurrentPage < Math.ceil(roadmapGameTotalCount / limit)) {
                    roadmapGameCurrentPage++
                    fetchRoadmapGames()
                }
            }
            if (roadmapGameSearch) roadmapGameSearch.oninput = (e) => {
                clearTimeout(roadmapGameSearchTimeout)
                roadmapGameSearchTimeout = setTimeout(() => {
                    roadmapGameSearchQuery = e.target.value
                    roadmapGameCurrentPage = 1
                    fetchRoadmapGames()
                }, 300)
            }
            if (roadmapGameForm) roadmapGameForm.onsubmit = async (e) => {
                e.preventDefault()
                const formData = new FormData(roadmapGameForm)
                const data = Object.fromEntries(formData.entries())
                data.image_url = data.imageUrl
                data.isVerified = document.getElementById('rgIsVerified').checked
                data.is_verified = data.isVerified
                const isEdit = !!data.id

                // Upload ảnh nếu có file mới được chọn
                const fileInput = document.getElementById('rgImageFile')
                const file = fileInput?.files?.[0]
                if (file) {
                    const uploadStatus = document.getElementById('rgUploadStatus')
                    uploadStatus.textContent = '⏳ Đang tải ảnh lên...'
                    uploadStatus.className = 'mt-2 text-xs font-medium text-indigo-600'
                    uploadStatus.classList.remove('hidden')

                    const submitBtn = document.getElementById('rgSubmitBtn')
                    submitBtn.disabled = true
                    submitBtn.textContent = 'Đang tải ảnh...'

                    try {
                        const imgForm = new FormData()
                        imgForm.append('file', file)
                        imgForm.append('fileName', `roadmap-game-${Date.now()}-${file.name}`)
                        const uploadRes = await fetch('/api/admin/upload-image', {
                            method: 'POST',
                            headers: { Authorization: `Bearer ${localStorage.getItem('auth_token')}` },
                            body: imgForm,
                        })
                        const uploadData = await uploadRes.json()
                        if (!uploadRes.ok || !uploadData.url) {
                            showToast(uploadData.error || 'Lỗi upload ảnh', 'error')
                            uploadStatus.textContent = '❌ Upload thất bại'
                            uploadStatus.className = 'mt-2 text-xs font-medium text-red-500'
                            submitBtn.disabled = false
                            submitBtn.textContent = 'Lưu'
                            return
                        }
                        data.image_url = uploadData.url
                        data.imageUrl = uploadData.url
                        data.image_file_id = uploadData.fileId
                        document.getElementById('rgImageUrl').value = uploadData.url
                        document.getElementById('rgImageFileId').value = uploadData.fileId
                        uploadStatus.textContent = '✅ Tải ảnh thành công'
                        uploadStatus.className = 'mt-2 text-xs font-medium text-emerald-600'
                    } catch {
                        showToast('Lỗi kết nối khi upload ảnh', 'error')
                        document.getElementById('rgSubmitBtn').disabled = false
                        document.getElementById('rgSubmitBtn').textContent = 'Lưu'
                        return
                    }
                }

                // Xóa camelCase để API ưu tiên snake_case
                delete data.imageUrl
                delete data.imageFileId

                const submitBtn = document.getElementById('rgSubmitBtn')
                submitBtn.disabled = true
                submitBtn.textContent = 'Đang lưu...'

                try {
                    const res = await fetch('/api/admin/roadmap-games', {
                        method: isEdit ? 'PUT' : 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            Authorization: `Bearer ${localStorage.getItem('auth_token')}`,
                        },
                        body: JSON.stringify(data),
                    })
                    if (res.ok) {
                        showToast(isEdit ? 'Đã cập nhật roadmap game' : 'Đã thêm roadmap game', 'success')
                        closeRoadmapGameModal()
                        fetchRoadmapGames()
                    } else {
                        const err = await res.json()
                        showToast(err.error || 'Lỗi lưu roadmap game', 'error')
                    }
                } catch {
                    showToast('Lỗi kết nối', 'error')
                } finally {
                    submitBtn.disabled = false
                    submitBtn.textContent = 'Lưu'
                }
            }

            // Roadmap Image Logic
            function loadRoadmapImage(year) {
                if (!roadmapImage || !roadmapImageContainer) return

                // Show loading, hide image & error
                if (roadmapImageLoading) roadmapImageLoading.style.display = 'flex'
                if (roadmapImageError) roadmapImageError.style.display = 'none'
                if (roadmapImage) {
                    roadmapImage.style.display = 'none'
                    roadmapImage.src = ''
                }

                selectedRoadmapYear = year

                // Build image path: /LTH5{year}.png
                const imgSrc = `/LTH5${year}.png`

                // Create new image to preload
                const img = new Image()
                img.onload = () => {
                    if (roadmapImage) {
                        roadmapImage.src = imgSrc
                        roadmapImage.style.display = 'block'
                    }
                    if (roadmapImageLoading) roadmapImageLoading.style.display = 'none'
                }
                img.onerror = () => {
                    if (roadmapImageLoading) roadmapImageLoading.style.display = 'none'
                    if (roadmapImageError) roadmapImageError.style.display = 'flex'
                }
                img.src = imgSrc
            }

            if (roadmapYearSelect) {
                roadmapYearSelect.onchange = (e) => {
                    const year = e.target.value
                    loadRoadmapImage(year)
                }
            }

            // Toast Notification Logic
            window.showToast = function (msg, type = 'success') {
                if (toast) {
                    toastMessage.innerHTML = msg.replace(/\n/g, '<br>')

                    const svgPath = toastIcon.querySelector('path')

                    if (type === 'success') {
                        toast.classList.remove('border-red-500', 'border-blue-500', 'border-amber-500')
                        toast.classList.add('border-emerald-500')
                        toastIcon.className = 'text-emerald-500'
                        if (svgPath) svgPath.setAttribute('d', 'M5 13l4 4L19 7')
                        toastTitle.textContent = 'Thành công!'
                    } else if (type === 'error') {
                        toast.classList.remove('border-emerald-500', 'border-blue-500', 'border-amber-500')
                        toast.classList.add('border-red-500')
                        toastIcon.className = 'text-red-500'
                        if (svgPath) svgPath.setAttribute('d', 'M6 18L18 6M6 6l12 12')
                        toastTitle.textContent = 'Lỗi!'
                    } else if (type === 'info') {
                        toast.classList.remove('border-emerald-500', 'border-red-500', 'border-amber-500')
                        toast.classList.add('border-blue-500')
                        toastIcon.className = 'text-blue-500'
                        if (svgPath)
                            svgPath.setAttribute('d', 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z')
                        toastTitle.textContent = 'Thông báo'
                    } else if (type === 'warning') {
                        toast.classList.remove('border-emerald-500', 'border-red-500', 'border-blue-500')
                        toast.classList.add('border-amber-500')
                        toastIcon.className = 'text-amber-500'
                        if (svgPath) svgPath.setAttribute('d', 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z')
                        toastTitle.textContent = 'Chú ý!'
                    }

                    toast.classList.remove('translate-x-full', 'opacity-0')
                    if (toastTimeout) clearTimeout(toastTimeout)
                    toastTimeout = setTimeout(() => {
                        toast.classList.add('translate-x-full', 'opacity-0')
                    }, 3000)
                }
            }
            if (toastClose) toastClose.onclick = () => toast.classList.add('translate-x-full', 'opacity-0')

            // ── Vibe Tools Member Management ──────────────────────────────────────
            async function fetchVibeToolsMembers() {
                const grid = document.getElementById('vibeToolsMemberGrid')
                if (!grid) return
                grid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400">Đang tải...</div>'
                try {
                    const res = await fetch('/api/admin/prompt-access?action=list', {
                        headers: { Authorization: `Bearer ${localStorage.getItem('auth_token')}` },
                    })
                    if (!res.ok) throw new Error('Lỗi tải danh sách')
                    const data = await res.json()
                    // Only members (not admins)
                    vibeAllMembers = (data.members || []).filter((m) => m.roles === 'member')
                    renderVibeToolsMemberGrid()
                } catch (err) {
                    grid.innerHTML = `<div class="col-span-full text-center py-12 text-red-400">${err.message}</div>`
                }
            }

            function renderVibeToolsMemberGrid() {
                const grid = document.getElementById('vibeToolsMemberGrid')
                if (!grid) return
                const vibePrompts = window.__VIBE_PROMPTS__ || []
                const totalVibe = vibePrompts.length
                const q = vibeSearchQuery.toLowerCase()
                const filtered = vibeAllMembers.filter(
                    (m) =>
                        (m.member || '').toLowerCase().includes(q) || (m.display_name || '').toLowerCase().includes(q),
                )

                if (filtered.length === 0) {
                    grid.innerHTML =
                        '<div class="col-span-full text-center py-12 text-slate-400 italic">Không tìm thấy thành viên nào.</div>'
                    return
                }

                grid.innerHTML = ''
                filtered.forEach((m) => {
                    const accessList = Array.isArray(m.prompt_access) ? m.prompt_access : []
                    const vibeCount = accessList.filter((id) => String(id).startsWith('vibe_')).length
                    const hasFullAccess = vibeCount >= totalVibe
                    const card = document.createElement('div')
                    card.className =
                        'bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition-all'
                    card.innerHTML = `
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-white text-sm flex-shrink-0" style="background: linear-gradient(135deg, #7c3aed, #ec4899);">
                            ${(m.display_name || m.member || '?').charAt(0).toUpperCase()}
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="font-bold text-slate-900 text-sm truncate">${m.display_name || m.member}</p>
                            <p class="text-xs text-slate-400 truncate">@${m.member}</p>
                        </div>
                        <span class="text-xs font-bold px-2 py-1 rounded-full ${hasFullAccess ? 'bg-purple-100 text-purple-700' : vibeCount > 0 ? 'bg-amber-50 text-amber-600' : 'bg-slate-100 text-slate-500'}">
                            ${vibeCount}/${totalVibe}
                        </span>
                    </div>
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex-1 bg-slate-100 rounded-full h-2 overflow-hidden">
                            <div class="h-2 rounded-full transition-all" style="width:${totalVibe > 0 ? Math.round((vibeCount / totalVibe) * 100) : 0}%; background: linear-gradient(90deg, #7c3aed, #ec4899);"></div>
                        </div>
                        <span class="text-xs text-slate-400 font-medium flex-shrink-0">${totalVibe > 0 ? Math.round((vibeCount / totalVibe) * 100) : 0}%</span>
                    </div>
                    <div class="flex gap-2 mt-4">
                        <button
                            onclick="window.vibeGrantAll(${m.id}, '${m.member.replace(/'/g, "\\'")}', '${(m.display_name || m.member).replace(/'/g, "\\'")}', ${JSON.stringify(accessList).replace(/"/g, '&quot;')})"
                            class="flex-1 py-2 rounded-xl text-xs font-bold transition-all hover:opacity-90 active:scale-95 cursor-pointer ${hasFullAccess ? 'bg-slate-100 text-slate-400 cursor-not-allowed' : 'text-white'}"
                            style="${hasFullAccess ? '' : 'background: linear-gradient(135deg, #7c3aed, #ec4899);'}"
                            ${hasFullAccess ? 'disabled' : ''}
                        >
                            ✦ Cấp tất cả
                        </button>
                        <button
                            onclick="window.vibeRevokeAll(${m.id}, '${m.member.replace(/'/g, "\\'")}', '${(m.display_name || m.member).replace(/'/g, "\\'")}', ${JSON.stringify(accessList).replace(/"/g, '&quot;')})"
                            class="flex-1 py-2 rounded-xl text-xs font-bold border border-slate-200 text-slate-600 hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition-all active:scale-95 cursor-pointer ${vibeCount === 0 ? 'opacity-40 cursor-not-allowed' : ''}"
                            ${vibeCount === 0 ? 'disabled' : ''}
                        >
                            ✕ Thu hồi tất cả
                        </button>
                        <button
                            onclick="window.openPromptAccessModal(${m.id}, '${m.member.replace(/'/g, "\\'")}', '${(m.display_name || m.member).replace(/'/g, "\\'")}', ${JSON.stringify(accessList).replace(/"/g, '&quot;')}); setTimeout(() => { const t = document.getElementById('tabVibeTools'); if(t) t.click(); }, 50);"
                            class="px-3 py-2 rounded-xl text-xs font-bold border border-purple-200 text-purple-600 bg-purple-50 hover:bg-purple-100 transition-all active:scale-95 cursor-pointer"
                            title="Chỉnh sửa chi tiết"
                        >
                            ✎
                        </button>
                    </div>
                `
                    grid.appendChild(card)
                })
            }

            // Grant all vibe prompts to a member
            window.vibeGrantAll = async (memberId, member, displayName, currentAccess) => {
                if (!Array.isArray(currentAccess)) currentAccess = []
                const vibePrompts = window.__VIBE_PROMPTS__ || []
                const vibeIds = vibePrompts.map((p) => String(p.id))
                // Merge with existing non-vibe access
                const nonVibeAccess = currentAccess.filter((id) => !String(id).startsWith('vibe_'))
                const newAccess = [
                    ...nonVibeAccess,
                    ...vibeIds,
                ]
                try {
                    const res = await fetch('/api/admin/prompt-access', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            Authorization: `Bearer ${localStorage.getItem('auth_token')}`,
                        },
                        body: JSON.stringify({ memberId, promptIds: newAccess, action: 'update' }),
                    })
                    if (res.ok) {
                        showToast(`Đã cấp ${vibeIds.length} Vibe prompts cho ${displayName}! 💜`, 'success')
                        fetchVibeToolsMembers()
                    } else {
                        const err = await res.json()
                        showToast(err.error || 'Lỗi thao tác', 'error')
                    }
                } catch {
                    showToast('Lỗi kết nối', 'error')
                }
            }

            // Revoke all vibe prompts from a member
            window.vibeRevokeAll = async (memberId, member, displayName, currentAccess) => {
                if (!Array.isArray(currentAccess)) currentAccess = []
                const newAccess = currentAccess.filter((id) => !String(id).startsWith('vibe_'))
                try {
                    const res = await fetch('/api/admin/prompt-access', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            Authorization: `Bearer ${localStorage.getItem('auth_token')}`,
                        },
                        body: JSON.stringify({ memberId, promptIds: newAccess, action: 'update' }),
                    })
                    if (res.ok) {
                        showToast(`Đã thu hồi Vibe prompts của ${displayName}`, 'success')
                        fetchVibeToolsMembers()
                    } else {
                        const err = await res.json()
                        showToast(err.error || 'Lỗi thao tác', 'error')
                    }
                } catch {
                    showToast('Lỗi kết nối', 'error')
                }
            }

            // Vibe Tools member search
            const vibeToolsMemberSearchInput = document.getElementById('vibeToolsMemberSearch')
            if (vibeToolsMemberSearchInput) {
                let vibeSearchTimeout
                vibeToolsMemberSearchInput.oninput = (e) => {
                    clearTimeout(vibeSearchTimeout)
                    vibeSearchTimeout = setTimeout(() => {
                        vibeSearchQuery = e.target.value
                        renderVibeToolsMemberGrid()
                    }, 200)
                }
            }

            loadPromptsData()

            // ─────────────────────────────────────────────────────────────────────
            // 4. IIFE — chạy sau khi tất cả biến, hàm và event listeners đã sẵn sàng
            // ─────────────────────────────────────────────────────────────────────
            ;(async function () {
                const token = localStorage.getItem('auth_token')
                const guard = document.getElementById('auth-guard')

                if (!token) {
                    window.location.href = '/?auth=required'
                    return
                }

                try {
                    const res = await fetch('/api/verify', {
                        headers: { Authorization: `Bearer ${token}` },
                    })
                    const data = await res.json()

                    if (!res.ok || !data.authenticated || data.user?.roles !== 'admin') {
                        if (data.error === 'Session invalid or expired') {
                            localStorage.removeItem('auth_token')
                            localStorage.removeItem('user_session')
                            localStorage.removeItem('user_roles')
                        }
                        window.location.href = '/?auth=required'
                        return
                    }

                    // Show content if verified
                    guard.classList.remove('hidden')
                    document.getElementById('page-skeleton')?.classList.add('hidden')

                    // Initialize User Info
                    const adminGreetingName = document.getElementById('adminGreetingName')
                    const sidebarUserName = document.getElementById('sidebarUserName')
                    const sidebarUserRole = document.getElementById('sidebarUserRole')
                    const sidebarUserAvatar = document.getElementById('sidebarUserAvatar')

                    const displayName = data.user?.display_name || data.user?.member || 'Admin'
                    const role = data.user?.roles === 'admin' ? 'Admin' : 'Member'
                    const avatar = displayName.charAt(0).toUpperCase()

                    if (adminGreetingName) adminGreetingName.textContent = displayName
                    if (sidebarUserName) sidebarUserName.textContent = displayName
                    if (sidebarUserRole) sidebarUserRole.textContent = role
                    if (sidebarUserAvatar) sidebarUserAvatar.textContent = avatar

                    // Initial load — đọc tab từ URL, mặc định là 'accounts'
                    const initialView = new URLSearchParams(window.location.search).get('view') || 'accounts'
                    switchView(initialView)
                } catch (err) {
                    console.error('Guard Error:', err)
                    window.location.href = '/?error=connection'
                }
            })()

            // ── Hamburger sidebar toggle ────────────────────────────────────────
            const sidebar = document.getElementById('sidebar')
            const overlay = document.getElementById('sidebarOverlay')
            const hamburgerBtn = document.getElementById('hamburgerBtn')

            function openSidebar() {
                if (sidebar) sidebar.classList.remove('-translate-x-full')
                if (overlay) { overlay.classList.remove('hidden'); overlay.classList.add('flex') }
                document.body.style.overflow = 'hidden'
            }

            function closeSidebar() {
                if (sidebar) sidebar.classList.add('-translate-x-full')
                if (overlay) { overlay.classList.add('hidden'); overlay.classList.remove('flex') }
                document.body.style.overflow = ''
            }

            if (hamburgerBtn) hamburgerBtn.onclick = openSidebar
            if (overlay) overlay.onclick = closeSidebar
        </script>
    </body>
</html>
