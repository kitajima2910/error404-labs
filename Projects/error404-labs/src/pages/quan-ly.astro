            async function fetchRoadmapGames() {
                if (!roadmapGameTableBody) return
                const offset = (roadmapGameCurrentPage - 1) * limit
                try {
                    const res = await fetch(`/api/admin/roadmap-games?search=${encodeURIComponent(roadmapGameSearchQuery)}&limit=${limit}&offset=${offset}`, {
                        headers: { Authorization: `Bearer ${localStorage.getItem('auth_token')}` },
                    })
                    if (!res.ok) throw new Error('Không thể tải danh sách roadmap game')
                    const data = await res.json()
                    roadmapGames = data.games || []
                    roadmapGameTotalCount = data.total || 0
                    renderRoadmapGames()
                    renderRoadmapGamePagination()
                } catch (err) {
                    roadmapGameTableBody.innerHTML = `<tr><td colspan="5" class="px-6 py-12 text-center text-red-500">${err.message}</td></tr>`
                }
            }

            function renderRoadmapGames() {
                roadmapGameTableBody.innerHTML = ''
                if (roadmapGames.length === 0) {
                    roadmapGameTableBody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-slate-400 italic">Không có game phù hợp.</td></tr>'
                    return
                }

                roadmapGames.forEach((game) => {
                    const tr = document.createElement('tr')
                    tr.className = 'hover:bg-slate-50 transition-colors'
                    tr.innerHTML = `
                        <td class="px-6 py-4 text-sm font-medium text-slate-600">#${game.id}</td>
                        <td class="px-6 py-4">
                            <div class="font-bold text-slate-900">${game.name}</div>
                            <div class="text-xs text-slate-400">${game.image_url || '-'}</div>
                        </td>
                        <td class="px-6 py-4 text-sm text-slate-600">${game.genre}</td>
                        <td class="px-6 py-4">
                            <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-bold ${game.is_verified ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-slate-50 text-slate-500 border border-slate-200'}">
                                ${game.is_verified ? 'Verified' : 'Draft'}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <button onclick="window.editRoadmapGame(${game.id})" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-xl transition-all cursor-pointer">Sửa</button>
                            <button onclick="window.deleteRoadmapGame(${game.id})" class="p-2 text-red-600 hover:bg-red-50 rounded-xl transition-all cursor-pointer">Xóa</button>
                        </td>
                    `
                    roadmapGameTableBody.appendChild(tr)
                })
            }

            function renderRoadmapGamePagination() {
                const totalPages = Math.ceil(roadmapGameTotalCount / limit)
                roadmapGameShowingStart.textContent = roadmapGameTotalCount === 0 ? 0 : (roadmapGameCurrentPage - 1) * limit + 1
                roadmapGameShowingEnd.textContent = Math.min(roadmapGameCurrentPage * limit, roadmapGameTotalCount)
                roadmapGameTotal.textContent = roadmapGameTotalCount
                roadmapGamePrevPage.disabled = roadmapGameCurrentPage === 1
                roadmapGameNextPage.disabled = roadmapGameCurrentPage === totalPages || totalPages === 0
                roadmapGamePageNumbers.innerHTML = ''
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button')
                    btn.textContent = i
                    btn.className = `w-8 h-8 rounded-lg text-sm font-bold transition-all cursor-pointer ${roadmapGameCurrentPage === i ? 'bg-indigo-600 text-white shadow-md shadow-indigo-100' : 'text-slate-500 hover:bg-white hover:shadow-sm'}`
                    btn.onclick = () => {
                        roadmapGameCurrentPage = i
                        fetchRoadmapGames()
                    }
                    roadmapGamePageNumbers.appendChild(btn)
                }
            }

