                }

                async function fetchAttendanceSummary() {
                    const month = document.getElementById('attendanceMonth').value || new Date().getMonth() + 1;
                    const year = document.getElementById('attendanceYear').value || new Date().getFullYear();
                    const filterStudentId = document.getElementById('attendanceStudentFilter').value;
                    const tbody = document.getElementById('attendanceTableBody');
                    const token = localStorage.getItem('auth_token');

                    try {
                        let url = `/api/admin/attendance?summary=true&year=${year}&month=${month}`;
                        if (filterStudentId) url += `&member_id=${filterStudentId}`;

                        const res = await fetch(url, {
                            headers: { Authorization: `Bearer ${token}` }
                        });
                        const data = await res.json();

                        if (data.attendance) {
                            const daysInMonth = new Date(year, month, 0).getDate();
                            let totalSessions = 0;
                            let totalPresent = 0;
                            let numberOfCheckedInStudents = 0;

                            let html = '';
                            data.attendance.forEach((student) => {
                                const days = student.total_days || 0;
                                if (days > 0) numberOfCheckedInStudents++;
                                totalSessions += daysInMonth;
                                totalPresent += days;

                                html += `<tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">`;
                                html += `<td class="px-4 py-2.5 font-medium text-slate-800">${student.display_name || student.member}</td>`;
                                                                const dates = student.dates || [];
                                for (let d = 1; d <= daysInMonth; d++) {
                                    const dateStr = `${year}-${String(month).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                                    const checkedIn = dates.includes(dateStr);
                                    
                                    const dayDate = new Date(year, month - 1, d);

                                    const dayOfWeek = dayDate.getDay();

                                    const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;

                                    const isToday = dayDate.toDateString() === new Date().toDateString();

                                    let tdClass = 'text-center';

                                    if (isWeekend) tdClass += ' weekend-col';

                                    if (isToday) tdClass += ' today-col';

                                    html += `<td class="${tdClass}" title="${dateStr}"><span class="checkmark ${checkedIn ? 'present' : 'absent'}">${checkedIn ? '✓' : '✕'}</span></td>`;
                                }
                                const rate = daysInMonth > 0 ? Math.round((days / daysInMonth) * 100) : 0;
                                html += `<td class="text-center px-4 py-2.5 font-bold text-indigo-600">${days}/${daysInMonth} (${rate}%)</td>`;
                                html += `</tr>`;
                            });

                            tbody.innerHTML = html || `<tr><td colspan="33" class="text-center px-4 py-8 text-slate-400">Không có dữ liệu</td></tr>`;

                            // Update stats
                            const studentCount = data.attendance.length || 1;
                            const avgPresent = Math.round(totalPresent / studentCount);
                            const avgAbsent = daysInMonth - avgPresent;
                            const rate = daysInMonth > 0 ? Math.round((avgPresent / daysInMonth) * 100) : 0;

                            document.getElementById('attTotalSessions').textContent = daysInMonth;
                            document.getElementById('attTotalPresent').textContent = avgPresent;
                            document.getElementById('attTotalAbsent').textContent = avgAbsent;
                            document.getElementById('attTotalRate').textContent = rate + '%';
                        }
                    } catch (err) {
                        console.error('Attendance fetch error:', err);
                        tbody.innerHTML = `<tr><td colspan="33" class="text-center px-4 py-8 text-red-400">Lỗi tải dữ liệu</td></tr>`;
                    }
                }
