---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'

const DATA_GAMES = [
    {
        name: 'Space Ship',
        link: '/thu-nghiem/game/space-ship/index.html',
        image: '/thu-nghiem/game/space-ship/space-ship.avif',
    },
    {
        name: 'Test Phaser Game',
        link: '/thu-nghiem/game/TestPhaserGame/index.html',
        image: '/thu-nghiem/game/TestPhaserGame/TestPhaserGame.avif',
    },
]

const DATA_WEBSITES = [
    {
        name: 'Pet404-Labs',
        link: '/thu-nghiem/web/pet404-labs/index.html',
        image: '/thu-nghiem/web/pet404-labs/pet404-labs.avif',
    },
    {
        name: 'Hoai-Link-Bio',
        link: '/thu-nghiem/web/hoai-link-bio/index.html',
        image: '/thu-nghiem/web/hoai-link-bio/hoai-link-bio.avif',
    },
    {
        name: 'Vibe Waitlist',
        link: '/thu-nghiem/web/vibe-waitlist/index.html',
        image: '/thu-nghiem/web/vibe-waitlist/vibe-waitlist.avif',
    },
    {
        name: 'Saas Directory',
        link: '/thu-nghiem/web/saas-directory/index.html',
        image: '/thu-nghiem/web/saas-directory/saas-directory.avif',
    },
]
---

<MainLayout title=`Thử nghiệm | ${TC_TITLE}`>
    <section class="demo h-[calc(100vh-64px)]">
        <h1 class="text-3xl font-bold mb-5 pt-10">Trò chơi</h1>
        <div class="customMarquee" id="m1">
            <div class="marqueeInner" style="gap: 10px;">
                {
                    DATA_GAMES.map((item) => (
                        <div class="marquee-item">
                            <a
                                href={item.link}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <img src={item.image} alt={item.name} />
                            </a>
                        </div>
                    ))
                }
            </div>
        </div>
        <h1 class="text-3xl font-bold mb-5 pt-10">Website</h1>
        <div class="customMarquee" id="m2">
            <div class="marqueeInner" style="gap: 10px;">
                {
                    DATA_WEBSITES.map((item) => (
                        <div class="marquee-item">
                            <a
                                href={item.link}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <img src={item.image} alt={item.name} />
                            </a>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</MainLayout>

<style>
    .demo {
        width: 100%;
        max-width: 1320px;
        margin: 0 auto;
    }

    .customMarquee {
        overflow: hidden;
        white-space: nowrap;
        padding: 12px;
        margin: 16px 0;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        transition: box-shadow 0.3s ease;
    }

    .customMarquee:hover {
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
    }

    .marqueeInner {
        display: inline-flex;
        align-items: center;
        will-change: transform;
    }

    .marquee-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        margin-right: 12px;
        white-space: nowrap;
        transition:
            transform 0.3s,
            background 0.3s;
        cursor: pointer;
        width: 350px;
        height: 190px;
    }

    .marquee-item img {
        width: 100%;
        height: 100%;
        aspect-ratio: 350 / 190;
        object-fit: cover;
        border-radius: 12px;
    }

    .marquee-item:hover {
        transform: scale(1.05);
    }
</style>

<script>
    // @ts-ignore
    window.gsapMarquee('#m1', {
        speed: 100,
        pauseOnHover: true,
        containerSelector: '.marqueeInner',
        itemsSelector: '.marquee-item',
    })

    // @ts-ignore
    window.gsapMarquee('#m2', {
        speed: 100,
        pauseOnHover: true,
        containerSelector: '.marqueeInner',
        itemsSelector: '.marquee-item',
    })

    // @ts-ignore
    window.gsapMarquee('#m3', {
        speed: 100,
        pauseOnHover: true,
        containerSelector: '.marqueeInner',
        itemsSelector: '.marquee-item',
    })
</script>
