---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'

const DATA_GAMES = [
    {
        name: 'Create Sanke 3D',
        link: '/thu-nghiem/game/CreateSanke3D/index.html',
        image: '/thu-nghiem/game/CreateSanke3D/CreateSanke3D.avif',
    },
    {
        name: 'Space Ship',
        link: '/thu-nghiem/game/space-ship/index.html',
        image: '/thu-nghiem/game/space-ship/space-ship.avif',
    },
    {
        name: 'Test Phaser Game',
        link: '/thu-nghiem/game/TestPhaserGame/index.html',
        image: '/thu-nghiem/game/TestPhaserGame/TestPhaserGame.avif',
    },
]

const DATA_WEBSITES = [
    {
        name: 'Pet404-Labs',
        link: '/thu-nghiem/web/pet404-labs/index.html',
        image: '/thu-nghiem/web/pet404-labs/pet404-labs.avif',
    },
    {
        name: 'Hoai-Link-Bio',
        link: '/thu-nghiem/web/hoai-link-bio/index.html',
        image: '/thu-nghiem/web/hoai-link-bio/hoai-link-bio.avif',
    },
    {
        name: 'Vibe Waitlist',
        link: '/thu-nghiem/web/vibe-waitlist/index.html',
        image: '/thu-nghiem/web/vibe-waitlist/vibe-waitlist.avif',
    },
    {
        name: 'Saas Directory',
        link: '/thu-nghiem/web/saas-directory/index.html',
        image: '/thu-nghiem/web/saas-directory/saas-directory.avif',
    },
    {
        name: 'Fox Robot Slider',
        link: '/thu-nghiem/web/FoxRobotSlider/index.html',
        image: '/thu-nghiem/web/FoxRobotSlider/FoxRobotSlider.avif',
    },
]

// Gộp data lại
const DATA = DATA_WEBSITES.concat(DATA_GAMES)
---

<MainLayout title=`Thử nghiệm | ${TC_TITLE}`>
    <section class="demo h-[calc(100vh)] pt-5 pb-5 flex justify-center">
        <div class="container" style="height: inherit; width: 100%;">
            <div
                style="overflow-y: scroll; box-shadow: inset 0px 0px 10px 0px rgba(0, 0, 0, 0.1);"
                class="demo-list flex justify-center flex-wrap gap-4 pt-5 pb-5 rounded-4xl"
            >
                {
                    DATA.map((item) => (
                        <div
                            class="demo-card w-79.5 h-43 overflow-hidden rounded-4xl scale-[.9] cursor-pointer"
                            data-link={item.link}
                        >
                            <p class="text-center">Click + Ctrl để mở tab mới</p>
                            {/* <a href={item.link} target="_blank" rel="noopener noreferrer"> */}
                            <img
                                src={item.image}
                                alt={item.name}
                                class="w-full h-full rounded-4xl hover:scale-105 transform duration-300"
                            />
                            {/* </a> */}
                        </div>
                    ))
                }
            </div>

            <iframe
                src={DATA[Math.floor(Math.random() * DATA.length)].link}
                frameborder="0"
                width="100%"
                height="90%"
                allow="demo"
                title="demo"
            >
            </iframe>
        </div>
    </section>
</MainLayout>

<script is:inline>
    document.querySelectorAll('.demo-card').forEach((card) => {
        card.addEventListener('click', () => {
            // console.log('link: ', card.dataset.link)
            document.querySelector('iframe').src = card.dataset.link
        })
    })

    // Nhấn click + ctrl để mở open tab mới
    document.querySelectorAll('.demo-card').forEach((card) => {
        card.addEventListener('click', (e) => {
            if (e.ctrlKey) {
                window.open(card.dataset.link, '_blank')
            }
        })
    })
</script>

<style>
    .container {
        display: grid;
        gap: 20px;
        grid-template-columns: 0.4fr 1fr;
        grid-template-areas: 'demo-list demo';
    }

    .demo-list {
        grid-area: 'demo-list';
        height: 600px;
    }

    iframe {
        grid-area: 'demo';
        height: 90% !important;
    }

    .demo {
        width: 100%;
        max-width: 1320px;
        margin: 0 auto;
    }

    @media (max-width: 1100px) {
        .container {
            /* grid-template-columns: 1fr;
            grid-template-areas:
                'demo-list'
                'demo'; */
            display: flex;
            flex-direction: column;
        }

        .demo-list {
            height: 210px;
        }

        iframe {
            height: 70% !important;
        }
    }

    .customMarquee {
        overflow: hidden;
        white-space: nowrap;
        padding: 12px;
        margin: 16px 0;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        transition: box-shadow 0.3s ease;
    }

    .customMarquee:hover {
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
    }

    .marqueeInner {
        display: inline-flex;
        align-items: center;
        will-change: transform;
    }

    .marquee-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        margin-right: 12px;
        white-space: nowrap;
        transition:
            transform 0.3s,
            background 0.3s;
        cursor: pointer;
        width: 350px;
        height: 190px;
    }

    .marquee-item img {
        width: 100%;
        height: 100%;
        aspect-ratio: 350 / 190;
        object-fit: cover;
        border-radius: 12px;
    }

    .marquee-item:hover {
        transform: scale(1.05);
    }
</style>

<script>
    // @ts-ignore
    window.gsapMarquee('#m1', {
        speed: 100,
        pauseOnHover: true,
        containerSelector: '.marqueeInner',
        itemsSelector: '.marquee-item',
    })

    // @ts-ignore
    window.gsapMarquee('#m2', {
        speed: 100,
        pauseOnHover: true,
        containerSelector: '.marqueeInner',
        itemsSelector: '.marquee-item',
    })

    // @ts-ignore
    window.gsapMarquee('#m3', {
        speed: 100,
        pauseOnHover: true,
        containerSelector: '.marqueeInner',
        itemsSelector: '.marquee-item',
    })
</script>
