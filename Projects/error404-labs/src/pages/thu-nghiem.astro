---
import MainLayout from '../layouts/MainLayout.astro'
import { TC_TITLE } from '../common/TextConst'

const DATA_GAMES = [
    {
        name: 'ChibiRunner',
        link: '/thu-nghiem/game/ChibiRunner/build/web-desktop/index.html',
        image: '/thu-nghiem/game/ChibiRunner/ChibiRunner.avif',
    },
    {
        name: 'Thay Đổi Màu Sắc',
        link: '/thu-nghiem/game/1-Thay-Doi-Mau-Sac/index.html',
        image: '/thu-nghiem/game/1-Thay-Doi-Mau-Sac/1-Thay-Doi-Mau-Sac.avif',
    },
    {
        name: 'Create Sanke 3D',
        link: '/thu-nghiem/game/CreateSanke3D/index.html',
        image: '/thu-nghiem/game/CreateSanke3D/CreateSanke3D.avif',
    },
    {
        name: 'Space Ship',
        link: '/thu-nghiem/game/space-ship/index.html',
        image: '/thu-nghiem/game/space-ship/space-ship.avif',
    },
    {
        name: 'Test Phaser Game',
        link: '/thu-nghiem/game/TestPhaserGame/index.html',
        image: '/thu-nghiem/game/TestPhaserGame/TestPhaserGame.avif',
    },
]

const DATA_WEBSITES = [
    {
        name: 'Pet404-Labs',
        link: '/thu-nghiem/web/pet404-labs/index.html',
        image: '/thu-nghiem/web/pet404-labs/pet404-labs.avif',
    },
    {
        name: 'Hoai-Link-Bio',
        link: '/thu-nghiem/web/hoai-link-bio/index.html',
        image: '/thu-nghiem/web/hoai-link-bio/hoai-link-bio.avif',
    },
    {
        name: 'Vibe Waitlist',
        link: '/thu-nghiem/web/vibe-waitlist/index.html',
        image: '/thu-nghiem/web/vibe-waitlist/vibe-waitlist.avif',
    },
    {
        name: 'Saas Directory',
        link: '/thu-nghiem/web/saas-directory/index.html',
        image: '/thu-nghiem/web/saas-directory/saas-directory.avif',
    },
    {
        name: 'Fox Robot Slider',
        link: '/thu-nghiem/web/FoxRobotSlider/index.html',
        image: '/thu-nghiem/web/FoxRobotSlider/FoxRobotSlider.avif',
    },
]

// Gộp data lại
const DATA = DATA_GAMES.concat(DATA_WEBSITES)
---

<MainLayout title={`Thử nghiệm | ${TC_TITLE}`}>
    <section class="min-h-screen bg-slate-50 py-8 px-4 md:px-8">
        <div class="max-w-[1600px] mx-auto h-[85vh]">
            <div class="flex flex-col md:flex-row gap-6 h-full">
                <!-- Sidebar: Demo List -->
                <aside class="w-full md:w-[350px] flex flex-col gap-4">
                    <div class="flex items-center justify-between px-2">
                        <h2 class="text-2xl font-black text-slate-800 tracking-tight">EXPERIMENTS</h2>
                        <span class="px-3 py-1 bg-blue-100 text-blue-600 rounded-full text-xs font-bold uppercase">
                            {DATA.length} Items
                        </span>
                    </div>

                    <div
                        class="demo-list-container flex-1 overflow-y-auto pr-2 custom-scrollbar flex flex-col gap-3"
                        style="scrollbar-gutter: stable;"
                    >
                        {
                            DATA.map((item, index) => (
                                <div
                                    class={`demo-card group relative overflow-hidden rounded-2xl bg-white border border-slate-200 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 cursor-pointer ${index === 0 ? 'ring-2 ring-blue-500 active-card' : ''}`}
                                    data-link={item.link}
                                    title="Click to view. Ctrl + Click to open in new tab."
                                >
                                    <div class="aspect-video overflow-hidden">
                                        <img
                                            src={item.image}
                                            alt={item.name}
                                            class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
                                        />
                                    </div>
                                    <div class="p-4 bg-white/90 backdrop-blur-sm absolute bottom-0 left-0 right-0 transform translate-y-full group-hover:translate-y-0 transition-transform duration-300">
                                        <h3 class="font-bold text-slate-800 text-sm truncate">{item.name}</h3>
                                        <p class="text-[10px] text-slate-500 font-medium">
                                            Click to Load • Ctrl+Click for New Tab
                                        </p>
                                    </div>
                                    <div class="absolute top-2 left-2 p-1.5 bg-white/80 backdrop-blur shadow-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity">
                                        <h3 class="font-bold text-slate-800 text-xs px-1">{item.name}</h3>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </aside>

                <!-- Main: Browser Mockup Iframe -->
                <main
                    class="flex-1 flex flex-col bg-white rounded-3xl overflow-hidden shadow-2xl border border-slate-200 relative"
                >
                    <!-- Browser Header -->
                    <div class="h-12 bg-slate-100 border-b border-slate-200 flex items-center px-4 gap-4">
                        <div class="flex gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-400"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                            <div class="w-3 h-3 rounded-full bg-green-400"></div>
                        </div>
                        <div
                            class="flex-1 bg-white rounded-md h-7 flex items-center px-4 border border-slate-200 shadow-sm overflow-hidden"
                        >
                            <span class="text-xs text-slate-400 font-mono truncate current-url-display">
                                {DATA[0].link}
                            </span>
                        </div>
                        <div class="flex gap-2">
                            <div class="w-2 h-2 rounded-full bg-slate-300"></div>
                            <div class="w-2 h-2 rounded-full bg-slate-300"></div>
                            <div class="w-2 h-2 rounded-full bg-slate-300"></div>
                        </div>
                    </div>

                    <!-- Loading Spinner Overlay -->
                    <div
                        id="iframe-loader"
                        class="absolute inset-0 top-12 bg-white flex items-center justify-center z-10 hidden"
                    >
                        <div class="animate-spin rounded-full h-12 w-12 border-4 border-blue-500 border-t-transparent">
                        </div>
                    </div>

                    <iframe
                        src={DATA[0].link}
                        frameborder="0"
                        class="flex-1 w-full bg-slate-50"
                        allow="fullscreen; autoplay"
                        title="Experiment Preview"
                        id="demo-iframe"
                    >
                    </iframe>
                </main>
            </div>
        </div>
    </section>
</MainLayout>

<script is:inline>
    const iframe = document.getElementById('demo-iframe')
    const cards = document.querySelectorAll('.demo-card')
    const urlDisplay = document.querySelector('.current-url-display')
    const loader = document.getElementById('iframe-loader')

    cards.forEach((card) => {
        card.addEventListener('click', (e) => {
            const link = card.dataset.link

            if (e.ctrlKey || e.metaKey) {
                window.open(link, '_blank')
                return
            }

            // Show loader
            loader.classList.remove('hidden')

            // Update Active State
            cards.forEach((c) => {
                c.classList.remove('ring-2', 'ring-blue-500', 'active-card')
                c.style.transform = ''
            })
            card.classList.add('ring-2', 'ring-blue-500', 'active-card')

            // Update Iframe & UI
            iframe.src = link
            urlDisplay.textContent = link

            // Wait for load to hide loader
            iframe.onload = () => {
                loader.classList.add('hidden')
            }
        })
    })

    // Auto-hide loader even if iframe doesn't fire onload (some external links might block)
    iframe.onload = () => {
        loader.classList.add('hidden')
    }
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .demo-list-container {
        mask-image: linear-gradient(to bottom, transparent, black 20px, black calc(100% - 20px), transparent);
    }

    .active-card {
        background-color: #f8fafc;
    }
</style>
