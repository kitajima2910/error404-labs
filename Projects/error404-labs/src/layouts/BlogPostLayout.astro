---
import { TC_TITLE } from '../common/TextConst'
import MainLayout from './MainLayout.astro'
import { slugify, formatDate } from '../js/utils'
import { Image } from 'astro:assets'

const { frontmatter } = Astro.props
console.log(frontmatter)

const { title, description, date, category, author, image } = frontmatter
---

<MainLayout title=`${title} | ${TC_TITLE}` {description}>
    <section class="flex flex-col items-center w-10/12 mx-auto h-full">
        <header class="my-15">
            <div class="text-center">
                <a href={`/danh-muc/${slugify(category)}`} class="block mb-5">
                    <span
                        class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 inset-ring inset-ring-blue-700/10"
                        >{category}</span
                    >
                </a>
                <h1 class="text-4xl font-semibold mb-5">{title}</h1>
                <p class="mb-15">
                    bởi <a
                        href={`/tac-gia/${slugify(author)}`}
                        class="underline font-medium">{author}</a
                    > - {formatDate(date, 'vi-VN')}
                </p>
            </div>
            <Image
                src={image.src}
                alt={image.alt}
                width={1200}
                height={600}
                format="avif"
                fit="cover"
                quality={80}
                class="rounded-4xl shadow-xl/30"
            />
        </header>
        <div class="mb-15">
            <div>
                <slot />
            </div>
            <div></div>
        </div>
    </section>
</MainLayout>
