---
import MainHead from './MainHead.astro'

interface Props {
    title?: string
    description?: string
}

const {
    title = 'Error404-Labs | Học lập trình C/C++, Web, Game, Mobile & AI - R&D Programmer',
    description = 'Error404-Labs là nơi học lập trình C/C++, C#, Java, Python, HTML, CSS, JS, JavaScript, Web, Game, Mobile và AI. Chia sẻ dự án, hướng dẫn và nghiên cứu phát triển công nghệ thực tế.',
} = Astro.props as Props
---

<html lang="vi">
    <MainHead {title} {description} />
    <body>
        <slot />
    </body>
</html>
