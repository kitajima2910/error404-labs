---
import '../styles/global.css'
import '@fontsource/montserrat/400.css'
import '@fontsource/montserrat/400-italic.css'

import MainHead from './MainHead.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Marquee from '../components/Marquee.astro'

import 'katex/dist/katex.min.css'

interface Props {
    title?: string
    description?: string
    searchable?: boolean
}

const {
    title = 'Error404-Labs | Học lập trình C/C++, Web, Game, Mobile & AI - R&D Programmer',
    description = 'Error404-Labs là nơi học lập trình C/C++, C#, Java, Python, HTML, CSS, JS, JavaScript, Web, Game, Mobile và AI. Chia sẻ dự án, hướng dẫn và nghiên cứu phát triển công nghệ thực tế.',
    searchable = true,
} = Astro.props as Props
---

<html lang="vi">
    <MainHead {title} {description} />
    <body class="pxh">
        <Nav />
        <div class="w-full h-26"></div>
        <!-- <div class="max-w-3xl mx-auto">
            <Marquee />
        </div> -->
        <main class="min-h-[70vh]" data-pagefind-body={searchable ? true : undefined} data-pagefind-ignore={searchable ? undefined : true}>
            <slot />
        </main>
        <Footer />
        <div class="pxhBackToTop pxhCursorPointer"></div>
    </body>
</html>

<script>
    document.addEventListener('keydown', function (e) {
        // Ctrl + U
        if (e.ctrlKey && e.key.toLowerCase() === 'u') {
            e.preventDefault()
            return false
        }

        // F12
        if (e.key === 'F12') {
            e.preventDefault()
            return false
        }

        // Ctrl + Shift + I (DevTools)
        if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 'i') {
            e.preventDefault()
            return false
        }

        // Ctrl + Shift + J (Console)
        if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 'j') {
            e.preventDefault()
            return false
        }

        // Tab
        if (e.key === 'Tab') {
            e.preventDefault()
            return false
        }
    })

    // document.addEventListener('contextmenu', function (e) {
    //     e.preventDefault() // Prevents the default right-click menu
    //     // You can add your custom action here, such as showing a custom menu
    //     console.log('Right-click action prevented; custom action goes here.')
    // })

    // https://www.jqueryscript.net/menu/simple-dynamic-context-menu.html
    // @ts-ignore
    $('body').simpleContextMenu({
        class: null,
        onShow: function () {
            // console.log('context menu shown')
        },
        onHide: function () {
            // console.log('context menu hide')
        },
        options: [
            {
                label: 'Algorithms Basic',
                icon: '<i class="fa fa-cog" aria-hidden="true"></i>',
                action: () => (window.location.href = '/bai-viet/kh-tt-cb-2026-01-thuat-toan-co-ban'),
            },
            {
                label: 'Algorithms Advanced',
                icon: '<i class="fa fa-rocket" aria-hidden="true"></i>',
                action: () => alert('Algorithms Advanced'),
            },
            {
                label: 'DSA - C',
                icon: '<i class="fa fa-code" aria-hidden="true"></i>',
                action: () => (window.location.href = '/bai-viet/kh-dsa-c-2026-01-cau-truc-du-lieu-va-giai-thuat'),
            },
            {
                label: 'UI với HTML + CSS',
                icon: '<i class="fa fa-snowflake-o" aria-hidden="true"></i>',
                action: () =>
                    (window.location.href = '/bai-viet/kh-web-cb-2026-01-khoa-hoc-website-co-ban-xay-dung-ui-html-css'),
            },
            {
                label: 'Thử Nghiệm',
                icon: '<i class="fa fa-star" aria-hidden="true"></i>',
                action: () => (window.location.href = '/thu-nghiem'),
            },
            {
                label: 'Prompts Game H5',
                icon: '<i class="fa fa-gamepad" aria-hidden="true"></i>',
                action: () => {
                    if (localStorage.getItem('auth_token')) {
                        window.location.href = '/cau-lenh-prompts-game'
                    } else {
                        // @ts-ignore
                        if (window.showToast) {
                            // @ts-ignore
                            window.showToast('Vui lòng đăng nhập để truy cập trang này!', 'warning')
                        } else {
                            alert('Vui lòng đăng nhập để truy cập trang này!')
                        }
                        document.getElementById('openLoginModal')?.click()
                    }
                },
            },
            {
                label: 'Tư duy Sáng tạo Game',
                icon: '<i class="fa fa-road" aria-hidden="true"></i>',
                action: () => (window.location.href = '/game-roadmap'),
            },
            {
                label: 'Công cụ',
                icon: '<i class="fa fa-wrench" aria-hidden="true"></i>',
                action: () => (window.location.href = '/tools'),
            },
            {
                label: 'Khóa Học',
                icon: '<i class="fa fa-book" aria-hidden="true"></i>',
                action: () => (window.location.href = '/khoa-hoc'),
            },
        ],
    })
</script>
