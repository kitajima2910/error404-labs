---
const { title, description } = Astro.props
---

<head>
    <!-- Google tag (gtag.js) -->
    <script
        is:inline
        async
        src="https://www.googletagmanager.com/gtag/js?id=G-KSWVM2K976"></script>
    <script is:inline define:vars={{}}>
        window.dataLayer = window.dataLayer || []
        function gtag() {
            dataLayer.push(arguments)
        }
        gtag('js', new Date())

        gtag('config', 'G-KSWVM2K976')
    </script>

    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- ✅ Cấu hình SEO cơ bản -->
    <meta name="description" content={description} />
    <meta
        name="keywords"
        content="Error404-Labs, học lập trình, C++, C, C#, Java, Python, HTML, CSS, JS, JavaScript, Web Developer, Game Developer, AI, R&D, Phạm Xuân Hoài, kitajima2910, pxh2910"
    />
    <meta name="robots" content="index, follow" />

    <!-- ✅ Open Graph (Facebook, Zalo, LinkedIn, Messenger...) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.error404-labs.info.vn/" />
    <meta
        property="og:title"
        content="Error404-Labs | R&D Web, Game, Mobile và AI Programmer / Developer"
    />
    <meta
        property="og:description"
        content="Nơi nghiên cứu và phát triển Web, Game, Mobile và AI."
    />
    <meta
        property="og:image"
        content="https://www.error404-labs.info.vn/og-image.jpg"
    />
    <meta property="og:image:alt" content="Error404-Labs Thumbnail" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Error404-Labs" />

    <!-- ✅ Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
        name="twitter:title"
        content="Error404-Labs | R&D Web, Game, Mobile, AI Programmer / Developer"
    />
    <meta
        name="twitter:description"
        content="Error404-Labs là nơi nghiên cứu và phát triển Web, Game, Mobile và AI."
    />
    <meta
        name="twitter:image"
        content="https://www.error404-labs.info.vn/og-image.jpg"
    />

    <!-- ✅ Icon + Theme -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Error404-Labs" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "EducationalOrganization",
            "name": "Error404-Labs",
            "url": "https://www.error404-labs.info.vn/",
            "logo": "https://www.error404-labs.info.vn/favicon-96x96.png",
            "description": "RnD và học lập trình C/C++, C#, Java, Python, HTML, CSS, JS, JavaScript, Web, Game, Mobile, AI.",
            "sameAs": [
                "https://www.facebook.com/kitajima2910",
                "https://github.com/kitajima2910/error404-labs",
                "https://github.com/kitajima2910"
            ],
            "knowsAbout": [
                "C/C++",
                "C#",
                "Java",
                "Python",
                "HTML",
                "CSS",
                "JS",
                "JavaScript",
                "Web Development",
                "Game Development",
                "AI",
                "Mobile App"
            ],
            "founder": {
                "@type": "Person",
                "name": "Phạm Xuân Hoài",
                "jobTitle": "Research & Developer",
                "url": "https://www.error404-labs.info.vn/"
            }
        }
    </script>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script is:inline src="/pagefind/pagefind-ui.js"></script>

    <!-- ✅ CSS + JS -->
    <link href="/pxh-ui.css" rel="stylesheet" />
    <script is:inline src="/pxh-ui.js"></script>
</head>
