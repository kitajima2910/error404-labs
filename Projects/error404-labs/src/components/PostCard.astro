---
import { Image } from 'astro:assets'
import { formatDate, slugify } from '../js/utils'
import { getCategoryMeta } from '../data/categoryMeta'

const { frontmatter, url, tagType = 'h3' } = Astro.props

const Tag = tagType

const { title, description, date, category, author, image } = frontmatter
const meta = getCategoryMeta(category)
// Chữ cái đầu của tên tác giả (vd: "Phạm Xuân Hoài" → "PH")
const authorWords = String(author || '')
    .trim()
    .split(/\s+/)
const authorInitials =
    (authorWords[0]?.[0] || '') + (authorWords.length > 1 ? authorWords[authorWords.length - 1][0] : '')
---

<article
    class="group relative flex flex-col w-full h-full bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-blue-200 transition-all duration-300"
>
    <!-- Ảnh bìa -->
    <div class={`relative aspect-[16/9] overflow-hidden bg-gradient-to-br ${meta.gradient}`}>
        {
            image?.src && (
                <Image
                    src={image.src}
                    alt={image.alt || title}
                    width={960}
                    height={540}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
            )
        }
    </div>

    <div class="flex flex-col flex-1 p-5">
        <div class="flex items-center gap-2 mb-3">
            <a
                href={`/danh-muc/${slugify(category)}`}
                class={`chip relative z-10 hover:brightness-95 no-underline ${meta.chip}`}
                title={`Xem danh mục ${meta.label}`}
            >
                <span aria-hidden="true">{meta.icon}</span>
                {meta.label}
            </a>
            <time datetime={new Date(date).toISOString()} class="text-xs font-medium text-slate-400">
                {formatDate(date, 'vi-VN')}
            </time>
        </div>

        <Tag
            class="text-lg font-bold leading-snug text-slate-900 line-clamp-2 group-hover:text-blue-700 transition-colors"
        >
            <a href={url} class="no-underline after:absolute after:inset-0 after:content-['']">{title}</a>
        </Tag>

        <p class="mt-2 text-sm text-slate-500 leading-relaxed line-clamp-3">{description}</p>

        <div class="mt-auto pt-4 flex items-center justify-between gap-3">
            <a
                href={`/tac-gia/${slugify(author)}`}
                class="relative z-10 inline-flex items-center gap-2 text-xs font-semibold text-slate-600 hover:text-blue-700 no-underline"
            >
                <span
                    class="w-6 h-6 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 text-white text-[10px] font-bold flex items-center justify-center"
                    aria-hidden="true"
                >
                    {authorInitials}
                </span>
                {author}
            </a>
            <span
                class="text-sm font-bold text-blue-600 inline-flex items-center gap-1 group-hover:gap-2 transition-all"
            >
                Đọc bài <span aria-hidden="true">→</span>
            </span>
        </div>
    </div>
</article>
