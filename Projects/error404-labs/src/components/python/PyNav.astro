---
import '@fontsource/montserrat/500.css'
import '@fontsource/montserrat/600.css'
import '@fontsource/montserrat/700.css'
import '@fontsource/montserrat/800.css'
import IconPython from '../../icons/IconPython.astro'

interface Props {
    active?: 'home' | 'courses' | 'leaderboard' | 'profile'
}

const { active = 'home' } = Astro.props

const items = [
    { key: 'home', label: 'Tổng quan', href: '/hoc-python' },
    { key: 'courses', label: 'Khóa học', href: '/hoc-python/khoa-hoc' },
    { key: 'leaderboard', label: 'Bảng xếp hạng', href: '/hoc-python/bang-xep-hang' },
    { key: 'profile', label: 'Cá nhân', href: '/hoc-python/ca-nhan' },
]
---

<!-- Thanh điều hướng con của mục Học Python -->
<div class="sticky top-26 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 flex items-center gap-4 h-14">
        <a href="/hoc-python" class="flex items-center gap-2 shrink-0 group">
            <span
                class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#3776AB] to-[#1E4D73] text-[#FFD43B] flex items-center justify-center shadow-sm"
            >
                <IconPython class="w-5 h-5" />
            </span>
            <span
                class="hidden sm:block font-extrabold text-slate-800 text-sm tracking-tight group-hover:text-[#3776AB] transition-colors"
            >
                Học Python
            </span>
        </a>

        <span class="hidden sm:block w-px h-6 bg-slate-200"></span>

        <nav class="flex-1 min-w-0 overflow-x-auto py-nav-scroll" aria-label="Điều hướng Học Python">
            <ul class="flex items-center gap-1 h-14">
                {
                    items.map((item) => (
                        <li class="h-full">
                            <a
                                href={item.href}
                                class:list={[
                                    'relative h-full flex items-center px-3 text-sm font-semibold whitespace-nowrap transition-colors no-underline',
                                    item.key === active
                                        ? 'text-[#3776AB] after:absolute after:left-3 after:right-3 after:bottom-0 after:h-[3px] after:rounded-t after:bg-[#3776AB]'
                                        : 'text-slate-500 hover:text-slate-800',
                                ]}
                                aria-current={item.key === active ? 'page' : undefined}
                            >
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <a
            href="/hoc-python/khoa-hoc"
            class="hidden md:inline-flex items-center gap-2 shrink-0 bg-[#3776AB] hover:bg-[#2B5E8A] text-white text-sm font-bold px-4 py-2 rounded-lg transition-colors no-underline"
        >
            Vào học
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                    clip-rule="evenodd"></path>
            </svg>
        </a>
    </div>
</div>

<style>
    .py-nav-scroll {
        scrollbar-width: none;
    }
    .py-nav-scroll::-webkit-scrollbar {
        display: none;
    }
    /* Tắt gạch chân mặc định của global.css cho link trang hiện tại */
    a[aria-current='page'] {
        text-decoration: none;
    }
</style>
