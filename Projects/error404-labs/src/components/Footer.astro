        'Tú',
        'Hiếu',
        'Khang',
        'Khánh',
        'Long',
        'Phương',
        'Trang',
        'Vy',
        'Ngọc',
        'Hương',
        'Tâm',
        'Tùng',
        'Bảo',
        'Sơn',
        'Hà',
        'Yến',
        'Thành',
        'Tiến',
        'Quỳnh',
        'Mai',
        'Thu',
        'Giang',
        'Kiên',
        'Trung',
        'An',
        'Nhung',
        'Vân',
        'Lộc',
        'Phú',
        'Hòa',
        'Bình',
        'Tấn',
        'Nghĩa',
        'Thanh',
        'Trí',
        'Thiện',
        'Duy',
    ]

    const cities = [
        'Hà Nội',
        'TP.HCM',
        'Đà Nẵng',
        'Cần Thơ',
        'Huế',
        'Hải Phòng',
        'Quảng Ninh',
        'Bắc Ninh',
        'Bắc Giang',
        'Thái Nguyên',
        'Nam Định',
        'Ninh Bình',
        'Thanh Hóa',
        'Nghệ An',
        'Hà Tĩnh',
        'Quảng Bình',
        'Quảng Trị',
        'Quảng Nam',
        'Quảng Ngãi',
        'Bình Định',
        'Phú Yên',
        'Khánh Hòa',
        'Ninh Thuận',
        'Bình Thuận',
        'Kon Tum',
        'Gia Lai',
        'Đắk Lắk',
        'Đắk Nông',
        'Lâm Đồng',
        'Bình Phước',
        'Bình Dương',
        'Đồng Nai',
        'Tây Ninh',
        'Bà Rịa - Vũng Tàu',
        'Long An',
        'Tiền Giang',
        'Bến Tre',
        'Trà Vinh',
        'Vĩnh Long',
        'Đồng Tháp',
        'An Giang',
        'Kiên Giang',
        'Hậu Giang',
        'Sóc Trăng',
        'Bạc Liêu',
        'Cà Mau',
    ]

    const icons = [
        '👨‍💻',
        '🧑‍💻',
        '👩‍💻',
        '📚',
        '💻',
        '🧠',
    ]

    const actions = [
        'đang học',
        'đang đọc',
        'vừa xem',
        'vừa truy cập',
        'đang tìm hiểu',
    ]

    const devices = [
        '💻',
        '📱',
    ]

    let lastTitle = null
    let disabled = false

    function randomItem(arr) {
        return arr[Math.floor(Math.random() * arr.length)]
    }

    function randomTime() {
        return Math.floor(Math.random() * 5) + 1
    }

    function getRandomTitle() {
        let lesson = randomItem(titles)

        while (lesson === lastTitle) {
            lesson = randomItem(titles)
        }

        lastTitle = lesson
        return lesson
    }

    function showNotify() {
        if (disabled) return

        const box = document.getElementById('notifyBox')
        if (!box) return

        const name = randomItem(names)
        const city = randomItem(cities)
        const lesson = getRandomTitle()
        const time = randomTime()
        const icon = randomItem(icons)
        const action = randomItem(actions)
        const device = randomItem(devices)

        box.classList.remove('show')

        setTimeout(() => {
            box.innerHTML = `
                <div style="display: flex; justify-content: space-between;">
                    <div>
                        ${device} ${icon} <b>${name}</b> (${city}) ${action}
                    </div>
                    <div class="notify-close" title="Tắt thông báo" style="margin-left: 6px; cursor: pointer;">✕</div>

                </div>

                <div class="notify-title" style="margin-top: 6px;">
                    <a href="${titles_and_urls.find((p) => lesson.includes(p.title))?.url}">${lesson}</a>
                </div>

                <div class="notify-time" style="margin-top: 6px;">${time} phút trước</div>

                <div class="notify-progress"></div>
            `

            box.classList.add('show')

            box.querySelector('.notify-close').onclick = () => {
                disabled = true
                box.style.display = 'none'
            }
        }, 400)
    }

    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(showNotify, 3000)

        setInterval(showNotify, 9000)
    })
</script>
