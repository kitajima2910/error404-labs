---
import { formatBlogPost } from '../js/utils'
import IconPython from '../icons/IconPython.astro'

const allPosts = Object.values(import.meta.glob('../pages/bai-viet/*.md', { eager: true }))

const blog = formatBlogPost(allPosts, {
    limit: 20,
    filterOutDrafts: true,
    sortByDate: !true,
})

const titles_and_urls = blog.map((post: any) => ({
    title: post.frontmatter.title,
    url: post.url,
}))

// Các trang đã có lời kêu gọi riêng thì không lặp lại dải CTA ở footer
const pathname = Astro.url.pathname
const showCta = !(pathname.startsWith('/khoa-hoc') || pathname.startsWith('/hoc-python'))

const columns = [
    {
        title: 'Học tập',
        links: [
            { label: 'Lớp Web & Game sáng tạo', href: '/khoa-hoc' },
            { label: 'Học Python miễn phí', href: '/hoc-python' },
            { label: 'Bảng xếp hạng Python', href: '/hoc-python/bang-xep-hang' },
            { label: 'Bài viết', href: '/bai-viet' },
        ],
    },
    {
        title: 'Công cụ',
        links: [
            { label: 'Công cụ', href: '/tools' },
            { label: 'HTML5 Editor', href: '/html5-editor' },
            { label: 'Thử nghiệm', href: '/thu-nghiem' },
            { label: 'Prompts Game H5', href: '/cau-lenh-prompts-game' },
        ],
    },
]
---

