---
import IconPython from '../../icons/IconPython.astro'

// Ảnh thật dùng cho cụm hình minh họa bên phải hero
interface CollageImage {
    src: string
    alt: string
    label: string
    icon?: string
}

interface Props {
    demo?: CollageImage
    covers: CollageImage[]
}

const { demo, covers } = Astro.props
const [
    coverA,
    coverB,
] = covers

const trustPoints = [
    'Lớp nhỏ 3–5 học sinh',
    'Online 1 kèm 1',
    'Chấm bài tự động',
]
---

<section class="relative overflow-hidden bg-navy-950 text-white" aria-labelledby="home-hero-title">
    <div class="absolute inset-0 bg-grid-dark opacity-70 pointer-events-none" aria-hidden="true"></div>
    <div
        class="absolute -top-40 -right-32 w-[560px] h-[560px] rounded-full bg-blue-600/30 blur-[130px] pointer-events-none"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute -bottom-56 -left-32 w-[460px] h-[460px] rounded-full bg-sun-400/10 blur-[140px] pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div
        class="relative container-site pt-10 pb-28 md:pt-16 md:pb-36 lg:pt-20 lg:pb-40 grid lg:grid-cols-[1.1fr_1fr] gap-12 items-center"
    >
        {/* Nội dung chính */}
        <div class="max-w-2xl">
            <p
                class="chip bg-white/10 border-white/15 text-sun-400 uppercase tracking-wider px-3 py-1.5 mb-6 whitespace-normal"
            >
                <span class="w-1.5 h-1.5 rounded-full bg-sun-400 animate-pulse" aria-hidden="true"></span>
                Lập trình cho học sinh THCS · THPT
            </p>

            <h1
                id="home-hero-title"
                class="text-[2rem] leading-[1.18] sm:text-5xl lg:text-[2.75rem] xl:text-5xl sm:leading-[1.12] font-extrabold tracking-tight"
            >
                <span class="block text-balance">Học lập trình từ con số 0,</span>
                <span class="block text-balance text-sun-400">
                    tự tay làm
                    <span class="relative inline-block whitespace-nowrap">
                        Web & Game
                        <svg
                            class="absolute left-0 -bottom-2 w-full h-3"
                            viewBox="0 0 200 12"
                            fill="none"
                            preserveAspectRatio="none"
                            aria-hidden="true"
                        >
                            <path
                                d="M3 9C50 3 150 3 197 9"
                                stroke="currentColor"
                                stroke-width="4"
                                stroke-linecap="round"
                                opacity=".55"></path>
                        </svg>
                    </span>
                </span>
            </h1>

            <p class="mt-6 text-base md:text-lg text-slate-300 leading-relaxed max-w-xl text-pretty">
                Lớp học nhỏ kèm sát, học qua dự án thực tế để làm ra sản phẩm chạy được thật. Luyện Python thi
                <strong class="text-white font-semibold">Tin học trẻ Bảng B (THCS) & Bảng C (THPT)</strong> — viết code và
                chấm điểm ngay trên trình duyệt.
            </p>

            <div class="mt-8 flex flex-col sm:flex-row sm:flex-wrap gap-3">
                <a href="/hoc-python" class="btn btn-sun btn-lg w-full sm:w-auto">
                    <IconPython class="w-5 h-5" aria-hidden="true" />
                    Học Python miễn phí
                </a>
                <a href="/khoa-hoc" class="btn btn-ghost-light btn-lg w-full sm:w-auto">
                    Đăng ký lớp Web & Game
                    <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path
                            fill-rule="evenodd"
                            d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                            clip-rule="evenodd"></path>
                    </svg>
                </a>
            </div>

            <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-slate-300">
                {
                    trustPoints.map((point) => (
                        <li class="flex items-center gap-2">
                            <span class="w-5 h-5 rounded-full bg-emerald-400/15 text-emerald-400 flex items-center justify-center shrink-0">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path
                                        fill-rule="evenodd"
                                        d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                                        clip-rule="evenodd"
                                    />
                                </svg>
                            </span>
                            {point}
                        </li>
                    ))
                }
            </ul>
        </div>

        {/* Cụm ảnh minh họa: demo game thật + ảnh bìa bài viết + thẻ giáo viên */}
        <div class="relative w-full max-w-[600px] mx-auto lg:max-w-none">
            <div class="relative aspect-square sm:aspect-[10/9]">
                {
                    demo && (
                        <figure class="absolute top-[7%] right-0 w-[88%] m-0 rounded-2xl bg-navy-900 border border-white/10 shadow-[0_30px_80px_rgba(0,0,0,0.55)] overflow-hidden">
                            <div class="flex items-center gap-1.5 px-3 py-2 sm:py-2.5 bg-white/5 border-b border-white/10">
                                <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]" aria-hidden="true" />
                                <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]" aria-hidden="true" />
                                <span class="w-2.5 h-2.5 rounded-full bg-[#28c840]" aria-hidden="true" />
                                {/* Thanh địa chỉ để trống: thẻ giáo viên che góc trái nên không hiện URL (tránh trông như bị cắt) */}
                                <span class="ml-2 h-4 sm:h-[18px] flex-1 rounded-md bg-white/5" aria-hidden="true" />
                            </div>
                            <div class="relative aspect-[16/9]">
                                <img
                                    src={demo.src}
                                    alt={demo.alt}
                                    width="800"
                                    height="450"
                                    loading="eager"
                                    fetchpriority="high"
                                    decoding="async"
                                    class="absolute inset-0 w-full h-full object-cover"
                                />
                                <figcaption class="absolute left-3 top-3 hidden sm:inline-flex chip bg-navy-950/80 border-white/15 text-white backdrop-blur-sm">
                                    <span aria-hidden="true">🎮</span>
                                    {demo.label}
                                </figcaption>
                            </div>
                        </figure>
                    )
                }

                {
                    coverA && (
                        <figure class="home-float absolute left-0 bottom-[3%] w-[52%] m-0 -rotate-[5deg] bg-white p-1.5 rounded-2xl shadow-[0_24px_50px_-12px_rgba(0,0,0,0.6)] z-10">
                            <img
                                src={coverA.src}
                                alt={coverA.alt}
                                width="600"
                                height="343"
                                loading="eager"
                                decoding="async"
                                class="w-full aspect-[16/9] object-cover rounded-xl"
                            />
                            <figcaption class="flex items-center gap-1.5 px-1.5 pt-2 pb-1 text-[10px] sm:text-xs font-bold text-slate-700 truncate">
                                {coverA.icon && <span aria-hidden="true">{coverA.icon}</span>}
                                {coverA.label}
                            </figcaption>
                        </figure>
                    )
                }

                {
                    coverB && (
                        <figure class="home-float home-float-delay absolute right-[2%] bottom-0 w-[42%] m-0 rotate-[4deg] bg-white p-1.5 rounded-2xl shadow-[0_24px_50px_-12px_rgba(0,0,0,0.6)] z-20">
                            <img
                                src={coverB.src}
                                alt={coverB.alt}
                                width="600"
                                height="343"
                                loading="eager"
                                decoding="async"
                                class="w-full aspect-[16/9] object-cover rounded-xl"
                            />
                            <figcaption class="flex items-center gap-1.5 px-1.5 pt-2 pb-1 text-[10px] sm:text-xs font-bold text-slate-700 truncate">
                                {coverB.icon && <span aria-hidden="true">{coverB.icon}</span>}
                                {coverB.label}
                            </figcaption>
                        </figure>
                    )
                }

                {/* Thẻ giáo viên */}
                <div
                    class="home-float home-float-delay absolute left-0 top-0 z-30 flex items-center gap-2.5 sm:gap-3 rounded-2xl bg-white text-slate-800 shadow-xl pl-2 pr-3 py-2 sm:pl-2.5 sm:pr-4 sm:py-2.5"
                >
                    <img
                        src="/avatar_v2.avif"
                        alt="Phạm Xuân Hoài"
                        width="48"
                        height="48"
                        class="w-9 h-9 sm:w-11 sm:h-11 rounded-full ring-2 ring-blue-100 shrink-0"
                    />
                    <div class="leading-tight">
                        <p class="text-xs sm:text-sm font-extrabold text-slate-900">Phạm Xuân Hoài</p>
                        <p class="text-[10px] sm:text-xs font-medium text-slate-500">Research & Developer</p>
                    </div>
                </div>

                {/* Nhãn công nghệ */}
                <div
                    class="home-float absolute right-0 sm:-right-3 top-[50%] z-30 rounded-xl bg-sun-400 text-navy-950 shadow-xl px-2.5 py-1.5 sm:px-3.5 sm:py-2 text-[11px] sm:text-sm font-extrabold font-mono"
                    aria-hidden="true"
                >
                    &lt;/&gt; HTML · CSS · JS
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .home-float {
        animation: home-float 5s ease-in-out infinite;
    }
    .home-float-delay {
        animation-delay: 1.4s;
    }
    @keyframes home-float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-8px);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .home-float {
            animation: none;
        }
    }
</style>
