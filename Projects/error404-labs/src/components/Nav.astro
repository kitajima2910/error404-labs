---
import navData from '../data/navData'
import Link from './Link.astro'
import IconBlog from '../icons/IconBlog.astro'
import IconAbout from '../icons/IconAbout.astro'
import IconRSS from '../icons/IconRSS.astro'
import IconSearch from '../icons/IconSearch.astro'
import IconTools from '../icons/IconTools.astro'
import ScrollProgress from './ScrollProgress.astro'

const onIcons = (name: string) => {
    switch (name) {
        case 'Giới Thiệu':
            return { component: IconAbout }
        case 'Bài Viết':
            return { component: IconBlog }
        case 'RSS':
            return { component: IconRSS }
        case 'Tools':
            return { component: IconTools }
    }
}

const pathname = Astro.url.pathname
const isPost = pathname.startsWith('/bai-viet/')
---

<nav class="fixed top-0 left-0 w-full z-50
    bg-[#FBFBFB]
    shadow-[0_4px_12px_rgba(0,0,0,0.06)]
    py-5">
    {isPost && <ScrollProgress />}

    <div class="mx-auto w-[95%] md:w-10/12 px-0 sm:px-0 lg:px-0">
        <div class="flex h-16 items-center justify-between">
            <!-- Logo -->
            <div class="flex items-center flex-shrink-0">
                <a href="/" class="logomark" arial-label="Go Home">
                    <img src="/avatar_v2.avif" alt="Avatar" class="rounded-full w-10 lg:w-16" />
                </a>
            </div>

            <!-- Right side Navigation & Actions -->
            <div class="flex items-center gap-2">
                <!-- Desktop Menu -->
                <div class="hidden lg:flex items-center">
                    <ul class="flex">
                        {
                            navData.map((item) => (
                                <li class="ml-2">
                                    <Link
                                        text={item.name}
                                        href={item.path}
                                        style="primary"
                                        isFilled={false}
                                        borderVisible={true}
                                        data-navLink
                                        classes="text-xs xl:text-sm px-3 xl:px-4 h-[38px] xl:h-[42px] flex items-center justify-center"
                                        icon={{
                                            component: onIcons(item.name)?.component,
                                            side: 'left',
                                        }}
                                        target={item.name === 'RSS' ? '_blank' : '_self'}
                                    />
                                </li>
                    ))
                }
            </ul>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2">
            <!-- Search button -->
            <button id="openModal" class="p-0 border-none bg-transparent cursor-pointer">
                <!-- Desktop/Tablet Text + Icon -->
                <div class="hidden sm:block">
                    <Link
                        text="Tìm"
                        href="#/tim"
                        style="primary"
                        isFilled={false}
                        borderVisible={true}
                        classes="text-xs xl:text-sm px-3 xl:px-4 h-[38px] xl:h-[42px] flex items-center justify-center"
                        icon={{
                            component: IconSearch,
                            side: 'left',
                        }}
                    />
                </div>
                <!-- Mobile Icon Only -->
                <div
                    class="cursor-pointer sm:hidden text-blue-600 border border-blue-600 rounded-lg p-2 hover:bg-blue-50 transition-colors flex items-center justify-center h-[38px] w-[38px]"
                >
                    <IconSearch class="w-5 h-5" />
                </div>
            </button>

            <!-- Login Component -->
            <div id="authContainer" class="flex items-center">
                <button id="openLoginModal" class="block p-0 border-none bg-transparent cursor-pointer">
                    <Link
                        text="Đăng Nhập"
                        href="#/login"
                        style="primary"
                        classes="text-xs xl:text-sm px-3 xl:px-4 h-[38px] xl:h-[42px] flex items-center justify-center"
                        isFilled={true}
                        borderVisible={true}
                    />
                </button>
                        <div
                            id="userProfileStatus"
                            class="hidden text-sm md:text-base font-bold text-blue-600 items-center gap-4 relative"
                        >
                            <div class="flex items-center gap-1 cursor-pointer group" id="userProfileTrigger">
                                <span>Xin chào, <span id="memberName" class="text-red-600 hover:underline"></span></span
                                >
                            </div>

                            <!-- User Info Popover -->
                            <div
                                id="userInfoPopover"
                                class="absolute top-full right-0 mt-2 w-64 bg-white rounded-2xl shadow-2xl border border-slate-100 p-4 hidden z-[110] animate-in fade-in slide-in-from-top-2 duration-200"
                            >
                                <div class="flex flex-col gap-3">
                                    <div class="flex items-center justify-between border-b border-slate-50 pb-2">
                                        <span class="text-xs text-slate-500 font-medium">Tài khoản:</span>
                                        <span id="popoverName" class="text-xs font-bold text-slate-800"></span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <div class="p-1.5 bg-amber-100 rounded-lg text-amber-600">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="h-4 w-4"
                                                    viewBox="0 0 20 20"
                                                    fill="currentColor"
                                                >
                                                    <path
                                                        fill-rule="evenodd"
                                                        d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05l-3.293 3.293a1 1 0 01-1.414 0l-3.293-3.293a1 1 0 01-.285-1.05l1.738-5.42-1.233-.616a1 1 0 01.894-1.79l1.599.8L9 4.323V3a1 1 0 011-1z"
                                                        clip-rule="evenodd"></path>
                                                </svg>
                                            </div>
                                            <span class="text-sm text-slate-600 font-medium">Điểm cộng:</span>
                                        </div>
                                        <span id="userPoints" class="text-sm font-bold text-amber-600">0</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <div class="p-1.5 bg-blue-100 rounded-lg text-blue-600">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="h-4 w-4"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                    ></path>
                                                </svg>
                                            </div>
                                            <span class="text-sm text-slate-600 font-medium">Tham gia:</span>
                                        </div>
                                        <span id="userJoinDate" class="text-xs font-bold text-slate-800"
                                            >--/--/----</span
                                        >
                                    </div>
                                    <div class="pt-2 border-t border-slate-50 space-y-2">
                                        <a
                                            id="popoverAdminLink"
                                            href="/quan-ly-tai-khoan"
                                            class="hidden flex items-center gap-2 p-2 rounded-xl hover:bg-slate-50 text-indigo-600 transition-colors"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                                                ></path>
                                            </svg>
                                            <span class="text-sm font-bold">Quản lý tài khoản</span>
                                        </a>
                                        <button
                                            id="logoutBtn"
                                            class="flex items-center gap-2 w-full p-2 rounded-xl hover:bg-red-50 text-red-500 transition-colors text-left cursor-pointer"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                                                ></path>
                                            </svg>
                                            <span class="text-sm font-bold">Đăng xuất</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Mobile Hamburger -->
                    <button
                        id="menuBtn"
                        class="cursor-pointer lg:hidden inline-flex items-center justify-center rounded-md p-1.5 text-blue-700 hover:bg-gray-100 focus:outline-none transition-transform duration-200"
                    >
                        <!-- Menu Icon (Hamburger) -->
                        <svg
                            id="menuIcon"
                            class="h-6 w-6 block transition-transform duration-300"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                        <!-- Close Icon (X) -->
                        <svg
                            id="closeIcon"
                            class="h-6 w-6 hidden transition-transform duration-300 transform rotate-90"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="lg:hidden hidden border-t border-gray-200 mt-3.75">
        <div class="space-y-1 px-4 py-4">
            <ul class="flex flex-col">
                {
                    navData.map((item) => (
                        <li class="mr-5">
                            <Link
                                text={item.name}
                                href={item.path}
                                style="primary"
                                isFilled={false}
                                borderVisible={!true}
                                data-navLink
                                icon={{
                                    component: onIcons(item.name)?.component,
                                    side: 'left',
                                }}
                                target={item.name === 'RSS' ? '_blank' : '_self'}
                            />
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</nav>

<!-- Toast Notification -->
<div
    id="toastNotification"
    class="fixed top-24 right-5 z-[120] transform transition-all duration-300 translate-x-full opacity-0 flex items-center gap-3 bg-white px-4 py-3 rounded-xl shadow-2xl border-l-[6px] border-emerald-500"
>
    <div id="toastIcon" class="text-emerald-500">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
        >
    </div>
    <div class="flex flex-col">
        <span id="toastTitle" class="font-bold text-gray-800 text-sm">Thành công!</span>
        <span id="toastMessage" class="text-xs text-gray-500 font-medium">Đăng nhập thành công.</span>
    </div>
    <button id="toastClose" class="ml-4 text-gray-400 hover:text-gray-600 outline-none pxhCursorPointer"> ✕ </button>
</div>

<!-- Overlay -->
<div id="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <!-- Modal box -->
    <div
        class="w-full max-w-3xl m-10 rounded-2xl bg-white p-6 shadow-xl
           animate-in fade-in zoom-in duration-200"
    >
        <!-- Header -->
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold">Mọi Thứ Trong Website Ở Đây :D</h2>
            <button id="closeModal" class="text-gray-400 hover:text-gray-600 pxhCursorPointer"> ✕ </button>
        </div>

        <!-- Content -->
        <p class="mt-4 text-gray-600">
            <div class="max-h-[50vh] overflow-y-auto">
                <div id="search"></div>
            </div>
            <script>
                window.addEventListener('DOMContentLoaded', () => {
                    // @ts-ignore
                    new PagefindUI({
                        element: '#search',
                        debounceTimeoutMs: 300,
                        resetStyles: false,
                        showEmptyFilters: false,
                        excerptLength: 15,
                        showImages: !true,
                        showSubResults: true,
                        pageSize: 3,
                    })
                })
            </script>
        </p>

        <!-- Actions -->
        <div class="mt-6 flex justify-end gap-3 hidden">
            <button id="cancelModal" class="rounded-lg border px-4 py-2 hover:bg-gray-100"> Cancel </button>
            <button class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700"> Confirm </button>
        </div>
    </div>
</div>

<!-- Login Overlay -->
<div id="loginModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <div class="w-full max-w-md m-10 rounded-2xl bg-white p-6 shadow-xl animate-in fade-in zoom-in duration-200">
        <!-- Header -->
        <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold">Đăng Nhập</h2>
            <button id="closeLoginModal" class="text-gray-400 hover:text-gray-600 pxhCursorPointer text-lg font-bold">
                ✕
            </button>
        </div>

        <!-- Content -->
        <form id="loginForm" class="mt-6 space-y-4" onsubmit="event.preventDefault();">
            <div>
                <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Tài khoản</label>
                <input
                    type="text"
                    id="username"
                    name="username"
                    class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-3 border"
                    placeholder="Nhập tài khoản của bạn"
                />
            </div>
            <div>
                <label for="code" class="block text-sm font-medium text-gray-700 mb-1">Mã xác nhận</label>
                <input
                    type="password"
                    id="code"
                    name="code"
                    class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-3 border"
                    placeholder="Nhập mã truy cập"
                />
            </div>
            <div class="mt-8">
                <button
                    id="submitLoginBtn"
                    type="submit"
                    class="capitalize cursor-pointer w-full rounded-lg bg-indigo-600 px-4 py-3 text-white hover:bg-indigo-700 font-medium transition-colors"
                    >Đăng nhập ngay</button
                >
            </div>
        </form>
    </div>
</div>

<script is:inline>
    // Config Toast Notification
    const toast = document.getElementById('toastNotification')
    const toastMessage = document.getElementById('toastMessage')
    const toastTitle = document.getElementById('toastTitle')
    const toastIcon = document.getElementById('toastIcon')
    const toastClose = document.getElementById('toastClose')
    let toastTimeout

    const showToast = (msg, type = 'success') => {
        if (toast) {
            toastMessage.innerHTML = msg.replace(/\n/g, '<br>')

            const svgPath = toastIcon.querySelector('path')

            if (type === 'success') {
                toast.classList.remove('border-red-500', 'border-blue-500', 'border-amber-500')
                toast.classList.add('border-emerald-500')
                toastIcon.className = 'text-emerald-500'
                if (svgPath) svgPath.setAttribute('d', 'M5 13l4 4L19 7')
                toastTitle.textContent = 'Thành công!'
            } else if (type === 'error') {
                toast.classList.remove('border-emerald-500', 'border-blue-500', 'border-amber-500')
                toast.classList.add('border-red-500')
                toastIcon.className = 'text-red-500'
                if (svgPath) svgPath.setAttribute('d', 'M6 18L18 6M6 6l12 12')
                toastTitle.textContent = 'Lỗi!'
            } else if (type === 'info') {
                toast.classList.remove('border-emerald-500', 'border-red-500', 'border-amber-500')
                toast.classList.add('border-blue-500')
                toastIcon.className = 'text-blue-500'
                if (svgPath) svgPath.setAttribute('d', 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z')
                toastTitle.textContent = 'Thông báo'
            } else if (type === 'warning') {
                toast.classList.remove('border-emerald-500', 'border-red-500', 'border-blue-500')
                toast.classList.add('border-amber-500')
                toastIcon.className = 'text-amber-500'
                if (svgPath) svgPath.setAttribute('d', 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z')
                toastTitle.textContent = 'Chú ý!'
            }

            toast.classList.remove('translate-x-full', 'opacity-0')

            if (toastTimeout) clearTimeout(toastTimeout)
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-x-full', 'opacity-0')
            }, 3000)
        } else {
            alert(msg)
        }
    }

    if (toastClose) {
        toastClose.onclick = () => toast.classList.add('translate-x-full', 'opacity-0')
    }

    window.showToast = showToast
</script>

<script>
    const btn = document.getElementById('menuBtn')
    const menu = document.getElementById('mobileMenu')
    const menuIcon = document.getElementById('menuIcon')
    const closeIcon = document.getElementById('closeIcon')

    if (btn && menu) {
        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden')
            btn.classList.toggle('rotate-90')

            if (menuIcon && closeIcon) {
                if (menu.classList.contains('hidden')) {
                    menuIcon.classList.remove('hidden')
                    menuIcon.classList.add('block')
                    closeIcon.classList.remove('block')
                    closeIcon.classList.add('hidden')
                    closeIcon.classList.add('rotate-90')
                } else {
                    menuIcon.classList.remove('block')
                    menuIcon.classList.add('hidden')
                    closeIcon.classList.remove('hidden')
                    closeIcon.classList.remove('rotate-90')
                    closeIcon.classList.add('block')
                }
            }
        })
    }
</script>

<script is:inline>
    try {
        const modal = document.getElementById('modal')
        const openBtn = document.getElementById('openModal')
        const closeBtn = document.getElementById('closeModal')
        const cancelBtn = document.getElementById('cancelModal')

        const openModal = () => {
            modal.classList.remove('hidden')
            modal.classList.add('flex')
            document.body.classList.add('overflow-hidden')

            const search = document.querySelector('.pagefind-ui__search-input')
            const btnClear = document.querySelector('.pagefind-ui__search-clear')
            // console.log('search: ', search)
            if (search) {
                search.value = ''
            }

            if (btnClear) {
                btnClear.click()
            }
        }

        const closeModal = () => {
            modal.classList.add('hidden')
            modal.classList.remove('flex')
            document.body.classList.remove('overflow-hidden')
        }

        openBtn.onclick = openModal
        closeBtn.onclick = closeModal
        cancelBtn.onclick = closeModal

        modal.onclick = (e) => {
            if (e.target === modal) closeModal()
        }

        const loginModal = document.getElementById('loginModal')
        const openLoginBtn = document.getElementById('openLoginModal')
        const closeLoginBtn = document.getElementById('closeLoginModal')

        const openLogin = () => {
            if (loginModal) {
                loginModal.classList.remove('hidden')
                loginModal.classList.add('flex')
                document.body.classList.add('overflow-hidden')
            }
        }

        const closeLogin = () => {
            if (loginModal) {
                loginModal.classList.add('hidden')
                loginModal.classList.remove('flex')
                document.body.classList.remove('overflow-hidden')
            }
        }

        if (openLoginBtn) openLoginBtn.onclick = openLogin
        if (closeLoginBtn) closeLoginBtn.onclick = closeLogin

        if (loginModal) {
            loginModal.onclick = (e) => {
                if (e.target === loginModal) closeLogin()
            }
        }

        const loginForm = document.getElementById('loginForm')
        const userProfileStatus = document.getElementById('userProfileStatus')
        const memberName = document.getElementById('memberName')
        const logoutBtn = document.getElementById('logoutBtn')

        const checkSession = () => {
            const user = localStorage.getItem('user_session')
            const displayName = localStorage.getItem('user_displayName')
            const roles = localStorage.getItem('user_roles')
            const points = localStorage.getItem('user_points')
            const joinDate = localStorage.getItem('user_join_date')

            const popoverAdminLink = document.getElementById('popoverAdminLink')
            const userPoints = document.getElementById('userPoints')
            const userJoinDate = document.getElementById('userJoinDate')
            const popoverName = document.getElementById('popoverName')

            if (user) {
                const shownName = displayName && displayName !== 'null' ? displayName : user
                if (openLoginBtn) openLoginBtn.classList.add('hidden')
                if (userProfileStatus) {
                    userProfileStatus.classList.remove('hidden')
                    userProfileStatus.classList.add('flex')
                    if (memberName) memberName.textContent = shownName
                    if (popoverName) popoverName.textContent = shownName
                }

                if (userPoints) userPoints.textContent = points || '0'
                if (userJoinDate && joinDate && joinDate !== 'null') {
                    const date = new Date(joinDate)
                    userJoinDate.textContent = date.toLocaleDateString('vi-VN')
                }

                if (popoverAdminLink) {
                    if (roles === 'admin') popoverAdminLink.classList.remove('hidden')
                    else popoverAdminLink.classList.add('hidden')
                }
            } else {
                if (openLoginBtn) openLoginBtn.classList.remove('hidden')
                if (userProfileStatus) {
                    userProfileStatus.classList.add('hidden')
                    userProfileStatus.classList.remove('flex')
                }
            }

            // Expose to window for external updates
            window.refreshUserSession = checkSession
        }

        // Toggle user info popover
        const trigger = document.getElementById('userProfileTrigger')
        const popover = document.getElementById('userInfoPopover')

        if (trigger && popover) {
            trigger.onclick = (e) => {
                e.stopPropagation()
                popover.classList.toggle('hidden')
            }
            document.addEventListener('click', (e) => {
                if (!popover.contains(e.target)) popover.classList.add('hidden')
            })
        }

        // Khởi tạo kiểm tra session khi load trang
        checkSession()

        // Kiểm tra xem có bị đá ra từ trang bảo mật không
        if (window.location.search.includes('auth=required')) {
            window.showToast('Vui lòng đăng nhập để truy cập trang này!', 'warning')
            setTimeout(() => {
                const loginModal = document.querySelector('#login-modal')
                if (loginModal) loginModal.classList.remove('hidden')
            }, 600)
            window.history.replaceState({}, document.title, window.location.pathname)
        }

        // Xác định token từ localStorage
        const authToken = localStorage.getItem('auth_token')

        // Xác thực session với server bằng Authorization header
        if (authToken && !localStorage.getItem('logout_in_progress')) {
            fetch(`/api/verify?t=${Date.now()}`, {
                cache: 'no-store',
                headers: { Authorization: `Bearer ${authToken}` },
            })
                .then((r) => r.json())
                .then((data) => {
                    if (data.authenticated) {
                        localStorage.setItem('user_session', data.user.member)
                        localStorage.setItem('user_displayName', data.user.display_name || data.user.member)
                        localStorage.setItem('user_roles', data.user.roles)
                        localStorage.setItem('user_points', data.user.points)
                        localStorage.setItem('user_join_date', data.user.created_at)
                    } else {
                        localStorage.removeItem('auth_token')
                        localStorage.removeItem('user_session')
                        localStorage.removeItem('user_displayName')
                        localStorage.removeItem('user_roles')
                        localStorage.removeItem('user_points')
                        localStorage.removeItem('user_join_date')
                        window.dispatchEvent(new Event('user-logout'))
                    }
                    checkSession()
                })
                .catch(() => {
                    // Xử lý lỗi network nếu cần
                })
        } else {
            localStorage.removeItem('logout_in_progress')
        }

        if (logoutBtn) {
            logoutBtn.onclick = async () => {
                const currentToken = localStorage.getItem('auth_token')
                const logoutSpan = logoutBtn.querySelector('span')
                const originalText = logoutSpan ? logoutSpan.textContent : 'Đăng xuất'

                if (logoutSpan) {
                    logoutSpan.textContent = 'Đang đăng xuất...'
                    logoutBtn.classList.add('opacity-50', 'pointer-events-none')
                }

                // Clear localStorage ngay lập tức để UI update nhanh
                localStorage.removeItem('auth_token')
                localStorage.removeItem('user_session')
                localStorage.removeItem('user_displayName')
                localStorage.removeItem('user_roles')
                localStorage.removeItem('user_points')
                localStorage.removeItem('user_join_date')
                localStorage.setItem('logout_in_progress', 'true')

                try {
                    const response = await fetch('/api/logout', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            Authorization: `Bearer ${currentToken}`,
                        },
                        keepalive: true,
                    })
                    const result = await response.json()
                    console.log('PXH2910: Logout API Result:', result)

                    if (result.success && result.verified) {
                        window.location.href = '/'
                    } else {
                        // Nếu verify fail, vẫn redirect nhưng có thể log lại
                        window.location.href = '/'
                    }
                } catch (e) {
                    console.error('Logout error:', e)
                    window.location.href = '/'
                }
            }
        }

        if (loginForm) {
            const submitBtn = document.getElementById('submitLoginBtn')

            loginForm.onsubmit = async (e) => {
                e.preventDefault()
                const username = document.getElementById('username').value
                const code = document.getElementById('code').value

                if (!username || !code) {
                    window.showToast('Vui lòng nhập đầy đủ Tài khoản và Mã!', 'info')
                    return
                }

                if (submitBtn) {
                    submitBtn.disabled = true
                    submitBtn.textContent = 'Đang xử lý...'
                    submitBtn.classList.add('opacity-50', 'cursor-not-allowed')
                    submitBtn.classList.remove('hover:bg-indigo-700', 'cursor-pointer')
                }

                try {
                    const response = await fetch('/api/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username, code }),
                    })

                    const data = await response.json()

                    if (response.ok) {
                        window.showToast('Đăng nhập thành công!', 'success')

                        localStorage.setItem('auth_token', data.token)
                        localStorage.setItem('user_session', data.user.member)
                        localStorage.setItem('user_displayName', data.user.display_name || data.user.member)
                        localStorage.setItem('user_roles', data.user.roles)
                        localStorage.setItem('user_points', data.user.points)
                        localStorage.setItem('user_join_date', data.user.created_at)

                        if (data.user.pointsAdded > 0) {
                            setTimeout(() => {
                                window.showToast(
                                    `Chúc mừng! +${data.user.pointsAdded} điểm login ngày mới! 🎁`,
                                    'success',
                                )
                            }, 1000)
                        }

                        window.dispatchEvent(new Event('user-login'))
                        closeLogin()
                        checkSession()
                        loginForm.reset()
                    } else {
                        window.showToast(data.error || 'Đăng nhập thất bại!', 'error')
                    }
                } catch (error) {
                    window.showToast('Lỗi hệ thống. Vui lòng thử lại sau.', 'error')
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false
                        submitBtn.textContent = 'Đăng nhập ngay'
                        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed')
                        submitBtn.classList.add('hover:bg-indigo-700', 'cursor-pointer')
                    }
                }
            }
        }
        // Heartbeat logic: Gửi ping mỗi 60 giây để tích lũy điểm online
        let heartbeatInterval = null
        const startHeartbeat = () => {
            if (heartbeatInterval) return

            // Chỉ bắt đầu interval, không gọi heartbeat ngay để tránh cộng điểm khi F5
            heartbeatInterval = setInterval(async () => {
                // Chỉ gửi ping nếu tab đang active (giảm tải và chống "treo" ảo)
                if (document.visibilityState === 'visible') {
                    try {
                        const authToken = localStorage.getItem('auth_token')
                        const res = await fetch('/api/user/heartbeat', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                Authorization: `Bearer ${authToken}`,
                            },
                        })
                        const data = await res.json()
                        if (data.pointsEarned > 0) {
                            window.showToast(`Tuyệt vời! +${data.pointsEarned} điểm online bền bỉ! 🏆`, 'success')
                            // Cập nhật lại điểm trên UI ngay lập tức
                            const points = parseInt(localStorage.getItem('user_points') || '0')
                            localStorage.setItem('user_points', (points + data.pointsEarned).toString())
                            checkSession()
                        }
                    } catch (e) {}
                }
            }, 60000)
        }

        const stopHeartbeat = () => {
            if (heartbeatInterval) {
                clearInterval(heartbeatInterval)
                heartbeatInterval = null
            }
        }

        // Tự động start/stop heartbeat dựa trên login status
        if (localStorage.getItem('user_session')) startHeartbeat()

        window.addEventListener('user-login', startHeartbeat)
        window.addEventListener('user-logout', stopHeartbeat)
        window.addEventListener('user-config-update', checkSession)

        checkSession()
    } catch (error) {
        console.error(error)
    }
</script>
