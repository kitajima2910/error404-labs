---
import navData from '../data/navData'
import Link from './Link.astro'
import IconBlog from '../icons/IconBlog.astro'
import IconAbout from '../icons/IconAbout.astro'
import IconRSS from '../icons/IconRSS.astro'
import IconSearch from '../icons/IconSearch.astro'
import ScrollProgress from './ScrollProgress.astro'

const onIcons = (name: string) => {
    switch (name) {
        case 'Giới Thiệu':
            return { component: IconAbout }
        case 'Bài Viết':
            return { component: IconBlog }
        case 'RSS':
            return { component: IconRSS }
    }
}

const pathname = Astro.url.pathname
const isPost = pathname.startsWith('/bai-viet/')
---

<nav class="fixed top-0 left-0 w-full z-50
    bg-[#FBFBFB]
    shadow-[0_4px_12px_rgba(0,0,0,0.06)]
    py-5">
    {isPost && <ScrollProgress />}

    <div class="mx-auto w-[95%] md:w-10/12 px-0 sm:px-0 lg:px-0">
        <div class="flex h-16 items-center justify-between">
            <!-- Logo -->
            <div class="flex items-center flex-shrink-0">
                <a href="/" class="logomark" arial-label="Go Home">
                    <img src="/avatar_v2.avif" alt="Avatar" class="rounded-full w-12 lg:w-20" />
                </a>
            </div>

            <!-- Right side Navigation & Actions -->
            <div class="flex items-center gap-2 md:gap-4 ml-4">
                <!-- Desktop Menu -->
                <div class="hidden lg:flex items-center">
                    <ul class="flex">
                        {
                            navData.map((item) => (
                                <li class="ml-4">
                                    <Link
                                        text={item.name}
                                        href={item.path}
                                        style="primary"
                                        isFilled={false}
                                        borderVisible={true}
                                        data-navLink
                                        icon={{
                                            component: onIcons(item.name)?.component,
                                            side: 'left',
                                        }}
                                        target={item.name === 'RSS' ? '_blank' : '_self'}
                                    />
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-4">
                    <!-- Search button -->
                    <button id="openModal">
                        <!-- Desktop/Tablet Text + Icon -->
                        <div class="hidden sm:block">
                            <Link
                                text="Tìm"
                                href="#/tim"
                                style="primary"
                                isFilled={false}
                                borderVisible={true}
                                icon={{
                                    component: IconSearch,
                                    side: 'left',
                                }}
                            />
                        </div>
                        <!-- Mobile Icon Only -->
                        <div
                            class="cursor-pointer sm:hidden text-blue-600 border border-blue-600 rounded-lg p-2.5 hover:bg-blue-50 transition-colors"
                        >
                            <IconSearch class="w-5 h-5" />
                        </div>
                    </button>

                    <!-- Login Component -->
                    <div id="authContainer" class="flex items-center">
                        <button id="openLoginModal" class="block">
                            <Link
                                text="Đăng Nhập"
                                href="#/login"
                                style="primary"
                                isFilled={true}
                                borderVisible={true}
                            />
                        </button>
                        <div
                            id="userProfileStatus"
                            class="hidden text-sm md:text-base font-bold text-blue-600 items-center gap-2"
                        >
                            <span>Xin chào, <span id="memberName" class="text-red-600"></span>!</span>
                            <button
                                id="logoutBtn"
                                class="text-xs text-red-500 hover:text-red-600 underline cursor-pointer font-medium ml-1"
                                >(Thoát)</button
                            >
                        </div>
                    </div>

                    <!-- Mobile Hamburger -->
                    <button
                        id="menuBtn"
                        class="cursor-pointer lg:hidden inline-flex items-center justify-center rounded-md p-1.5 text-blue-700 hover:bg-gray-100 focus:outline-none transition-transform duration-200"
                    >
                        <!-- Menu Icon (Hamburger) -->
                        <svg
                            id="menuIcon"
                            class="h-6 w-6 block transition-transform duration-300"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                        <!-- Close Icon (X) -->
                        <svg
                            id="closeIcon"
                            class="h-6 w-6 hidden transition-transform duration-300 transform rotate-90"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="lg:hidden hidden border-t border-gray-200 mt-3.75">
        <div class="space-y-1 px-4 py-4">
            <ul class="flex flex-col">
                {
                    navData.map((item) => (
                        <li class="mr-5">
                            <Link
                                text={item.name}
                                href={item.path}
                                style="primary"
                                isFilled={false}
                                borderVisible={!true}
                                data-navLink
                                icon={{
                                    component: onIcons(item.name)?.component,
                                    side: 'left',
                                }}
                                target={item.name === 'RSS' ? '_blank' : '_self'}
                            />
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</nav>

<!-- Toast Notification -->
<div id="toastNotification" class="fixed top-5 right-5 z-[120] transform transition-all duration-300 translate-x-full opacity-0 flex items-center gap-3 bg-white px-4 py-3 rounded-xl shadow-2xl border-l-[6px] border-emerald-500">
    <div id="toastIcon" class="text-emerald-500">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
    </div>
    <div class="flex flex-col">
        <span id="toastTitle" class="font-bold text-gray-800 text-sm">Thành công!</span>
        <span id="toastMessage" class="text-xs text-gray-500 font-medium">Đăng nhập thành công.</span>
    </div>
    <button id="toastClose" class="ml-4 text-gray-400 hover:text-gray-600 outline-none pxhCursorPointer">
        ✕
    </button>
</div>

<!-- Overlay -->
<div id="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <!-- Modal box -->
    <div
        class="w-full max-w-3xl m-10 rounded-2xl bg-white p-6 shadow-xl
           animate-in fade-in zoom-in duration-200"
    >
        <!-- Header -->
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold">Mọi Thứ Trong Website Ở Đây :D</h2>
            <button id="closeModal" class="text-gray-400 hover:text-gray-600 pxhCursorPointer"> ✕ </button>
        </div>

        <!-- Content -->
        <p class="mt-4 text-gray-600">
            <div class="max-h-[50vh] overflow-y-auto">
                <div id="search"></div>
            </div>
            <script>
                window.addEventListener('DOMContentLoaded', () => {
                    // @ts-ignore
                    new PagefindUI({
                        element: '#search',
                        debounceTimeoutMs: 300,
                        resetStyles: false,
                        showEmptyFilters: false,
                        excerptLength: 15,
                        showImages: !true,
                        showSubResults: true,
                        pageSize: 3,
                    })
                })
            </script>
        </p>

        <!-- Actions -->
        <div class="mt-6 flex justify-end gap-3 hidden">
            <button id="cancelModal" class="rounded-lg border px-4 py-2 hover:bg-gray-100"> Cancel </button>
            <button class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700"> Confirm </button>
        </div>
    </div>
</div>

<!-- Login Overlay -->
<div id="loginModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <div class="w-full max-w-md m-10 rounded-2xl bg-white p-6 shadow-xl animate-in fade-in zoom-in duration-200">
        <!-- Header -->
        <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold">Đăng Nhập</h2>
            <button id="closeLoginModal" class="text-gray-400 hover:text-gray-600 pxhCursorPointer text-lg font-bold">
                ✕
            </button>
        </div>

        <!-- Content -->
        <form id="loginForm" class="mt-6 space-y-4" onsubmit="event.preventDefault();">
            <div>
                <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Tài khoản</label>
                <input
                    type="text"
                    id="username"
                    name="username"
                    class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-3 border"
                    placeholder="Nhập tài khoản của bạn"
                />
            </div>
            <div>
                <label for="code" class="block text-sm font-medium text-gray-700 mb-1">Mã xác nhận</label>
                <input
                    type="password"
                    id="code"
                    name="code"
                    class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-3 border"
                    placeholder="Nhập mã truy cập"
                />
            </div>
            <div class="mt-8">
                <button
                    type="submit"
                    class="capitalize cursor-pointer w-full rounded-lg bg-indigo-600 px-4 py-3 text-white hover:bg-indigo-700 font-medium transition-colors"
                    >Đăng nhập ngay</button
                >
            </div>
        </form>
    </div>
</div>

<script is:inline>
    // Config Toast Notification
    const toast = document.getElementById('toastNotification')
    const toastMessage = document.getElementById('toastMessage')
    const toastTitle = document.getElementById('toastTitle')
    const toastIcon = document.getElementById('toastIcon')
    const toastClose = document.getElementById('toastClose')
    let toastTimeout;

    const showToast = (msg, type = 'success') => {
        if (toast) {
            toastMessage.textContent = msg
            
            if (type === 'success') {
                toast.classList.remove('border-red-500', 'border-blue-500')
                toast.classList.add('border-emerald-500')
                toastIcon.className = 'text-emerald-500'
                toastIcon.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>'
                toastTitle.textContent = 'Thành công!'
            } else if (type === 'error') {
                toast.classList.remove('border-emerald-500', 'border-blue-500')
                toast.classList.add('border-red-500')
                toastIcon.className = 'text-red-500'
                toastIcon.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>'
                toastTitle.textContent = 'Lỗi!'
            } else if (type === 'info') {
                toast.classList.remove('border-emerald-500', 'border-red-500')
                toast.classList.add('border-blue-500')
                toastIcon.className = 'text-blue-500'
                toastIcon.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>'
                toastTitle.textContent = 'Thông báo'
            }

            toast.classList.remove('translate-x-full', 'opacity-0')
            
            if (toastTimeout) clearTimeout(toastTimeout)
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-x-full', 'opacity-0')
            }, 3000)
        } else {
            alert(msg)
        }
    }

    if (toastClose) {
        toastClose.onclick = () => toast.classList.add('translate-x-full', 'opacity-0')
    }
    
    window.showToast = showToast
</script>

<script>
    const btn = document.getElementById('menuBtn')
    const menu = document.getElementById('mobileMenu')
    const menuIcon = document.getElementById('menuIcon')
    const closeIcon = document.getElementById('closeIcon')

    if (btn && menu) {
        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden')
            btn.classList.toggle('rotate-90')

            if (menuIcon && closeIcon) {
                if (menu.classList.contains('hidden')) {
                    menuIcon.classList.remove('hidden')
                    menuIcon.classList.add('block')
                    closeIcon.classList.remove('block')
                    closeIcon.classList.add('hidden')
                    closeIcon.classList.add('rotate-90')
                } else {
                    menuIcon.classList.remove('block')
                    menuIcon.classList.add('hidden')
                    closeIcon.classList.remove('hidden')
                    closeIcon.classList.remove('rotate-90')
                    closeIcon.classList.add('block')
                }
            }
        })
    }
</script>

<script is:inline>
    try {
        const modal = document.getElementById('modal')
        const openBtn = document.getElementById('openModal')
        const closeBtn = document.getElementById('closeModal')
        const cancelBtn = document.getElementById('cancelModal')

        const openModal = () => {
            modal.classList.remove('hidden')
            modal.classList.add('flex')
            document.body.classList.add('overflow-hidden')

            const search = document.querySelector('.pagefind-ui__search-input')
            const btnClear = document.querySelector('.pagefind-ui__search-clear')
            // console.log('search: ', search)
            if (search) {
                search.value = ''
            }

            if (btnClear) {
                btnClear.click()
            }
        }

        const closeModal = () => {
            modal.classList.add('hidden')
            modal.classList.remove('flex')
            document.body.classList.remove('overflow-hidden')
        }

        openBtn.onclick = openModal
        closeBtn.onclick = closeModal
        cancelBtn.onclick = closeModal

        modal.onclick = (e) => {
            if (e.target === modal) closeModal()
        }

        const loginModal = document.getElementById('loginModal')
        const openLoginBtn = document.getElementById('openLoginModal')
        const closeLoginBtn = document.getElementById('closeLoginModal')

        const openLogin = () => {
            if (loginModal) {
                loginModal.classList.remove('hidden')
                loginModal.classList.add('flex')
                document.body.classList.add('overflow-hidden')
            }
        }

        const closeLogin = () => {
            if (loginModal) {
                loginModal.classList.add('hidden')
                loginModal.classList.remove('flex')
                document.body.classList.remove('overflow-hidden')
            }
        }

        if (openLoginBtn) openLoginBtn.onclick = openLogin
        if (closeLoginBtn) closeLoginBtn.onclick = closeLogin

        if (loginModal) {
            loginModal.onclick = (e) => {
                if (e.target === loginModal) closeLogin()
            }
        }

        const loginForm = document.getElementById('loginForm')
        const userProfileStatus = document.getElementById('userProfileStatus')
        const memberName = document.getElementById('memberName')
        const logoutBtn = document.getElementById('logoutBtn')

        const checkSession = () => {
            const user = localStorage.getItem('user_session')
            if (user) {
                if (openLoginBtn) openLoginBtn.classList.add('hidden')
                if (userProfileStatus) {
                    userProfileStatus.classList.remove('hidden')
                    userProfileStatus.classList.add('flex')
                    if (memberName) memberName.textContent = user
                }
            } else {
                if (openLoginBtn) openLoginBtn.classList.remove('hidden')
                if (userProfileStatus) {
                    userProfileStatus.classList.add('hidden')
                    userProfileStatus.classList.remove('flex')
                }
            }
        }

        // Khởi tạo kiểm tra session khi load trang
        checkSession()

        if (logoutBtn) {
            logoutBtn.onclick = () => {
                localStorage.removeItem('user_session')
                checkSession()
            }
        }

        if (loginForm) {
            loginForm.onsubmit = async (e) => {
                e.preventDefault()
                const username = document.getElementById('username').value
                const code = document.getElementById('code').value

                if (!username || !code) {
                    window.showToast('Vui lòng nhập đầy đủ Tài khoản và Mã!', 'info')
                    return
                }

                try {
                    const response = await fetch('/api/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username, code }),
                    })

                    const data = await response.json()

                    if (response.ok) {
                        window.showToast('Đăng nhập thành công!', 'success')
                        localStorage.setItem('user_session', data.user.member)
                        closeLogin()
                        checkSession()
                        loginForm.reset()
                    } else {
                        window.showToast(data.error || 'Đăng nhập thất bại!', 'error')
                    }
                } catch (error) {
                    window.showToast('Lỗi hệ thống. Vui lòng thử lại sau.', 'error')
                }
            }
        }
    } catch (error) {
        console.error(error)
    }
</script>
