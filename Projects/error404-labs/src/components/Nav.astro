---
import navData from '../data/navData'
import IconPython from '../icons/IconPython.astro'
import ScrollProgress from './ScrollProgress.astro'

// Icon outline 24px (Heroicons) cho từng mục menu
const ICONS: Record<string, string> = {
    cap: 'M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5',
    book: 'M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25',
    wrench: 'M21.75 6.75a4.5 4.5 0 0 1-4.884 4.484c-1.076-.091-2.264.071-2.95.904l-7.152 8.684a2.548 2.548 0 1 1-3.586-3.586l8.684-7.152c.833-.686.995-1.874.904-2.95a4.5 4.5 0 0 1 6.336-4.486l-3.276 3.276a3.004 3.004 0 0 0 2.25 2.25l3.276-3.276c.256.565.398 1.192.398 1.852Z',
    code: 'M14.25 9.75 16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z',
    user: 'M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z',
}

const pathname = Astro.url.pathname
// Thanh tiến độ đọc chỉ hiện ở trang bài viết, không hiện ở trang danh sách /bai-viet/N
const isPost = pathname.startsWith('/bai-viet/') && !/^\/bai-viet\/\d+\/?$/.test(pathname)
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID

// Mục menu đang active (khớp đường dẫn hoặc trang con)
const isActive = (path: string, match: string[] = []) =>
    [path, ...match].some((p) => pathname === p || pathname.startsWith(p + '/'))
---

<nav
    id="siteNav"
    class="fixed top-0 left-0 w-full z-[60] bg-white/90 backdrop-blur-md border-b border-slate-200/80 shadow-[0_1px_12px_rgba(15,23,42,0.04)]"
    aria-label="Điều hướng chính"
>
    {isPost && <ScrollProgress />}

    <div class="container-site h-[var(--nav-h)] flex items-center gap-3">
        <!-- Logo -->
        <a href="/" class="logomark flex items-center gap-2.5 shrink-0 no-underline group" aria-label="Error404 Labs - Trang chủ">
            <img
                src="/avatar_v2.avif"
                alt="Error404 Labs"
                width="40"
                height="40"
                class="w-9 h-9 lg:w-10 lg:h-10 rounded-full ring-2 ring-blue-100 group-hover:ring-blue-300 transition"
            />
            <span class="leading-tight whitespace-nowrap max-[379px]:hidden lg:hidden xl:block">
                <span class="block font-extrabold text-slate-900 text-[15px] tracking-tight">Error404 Labs</span>
                <span class="hidden sm:block text-[11px] text-slate-500 font-medium">Học lập trình từ con số 0</span>
            </span>
        </a>

        <!-- Desktop Menu -->
        <ul class="hidden lg:flex items-center gap-0.5 ml-2 xl:ml-6 shrink-0">
            {
                navData.map((item) => {
                    const active = isActive(item.path, item.match)
                    return (
                        <li>
                            <a
                                href={item.path}
                                data-navLink
                                aria-current={active ? 'page' : undefined}
                                class:list={[
                                    'relative inline-flex items-center gap-1.5 h-10 px-2.5 xl:px-3 rounded-xl text-[13.5px] font-semibold whitespace-nowrap no-underline transition-colors',
                                    active
                                        ? 'text-blue-700 bg-blue-50'
                                        : item.highlight
                                          ? 'text-slate-800 hover:bg-amber-50 hover:text-amber-700'
                                          : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100',
                                ]}
                            >
                                {item.icon === 'python' ? (
                                    <IconPython class="w-4 h-4 text-[#3776AB] hidden xl:block" />
                                ) : (
                                    <svg class="w-4 h-4 hidden xl:block" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d={ICONS[item.icon]} />
                                    </svg>
                                )}
                                {item.name}
                                {item.highlight && !active && (
                                    <span class="absolute -top-0.5 right-0.5 w-2 h-2 rounded-full bg-amber-400 ring-2 ring-white" aria-hidden="true" />
                                )}
                            </a>
                        </li>
                    )
                })
            }
        </ul>

        <!-- Action Buttons -->
        <div class="ml-auto flex items-center gap-2">
            <!-- Search button -->
            <button
                id="openModal"
                type="button"
                class="cursor-pointer inline-flex items-center gap-2 h-10 px-2.5 sm:px-3 rounded-xl border border-slate-200 bg-white text-slate-500 hover:text-blue-700 hover:border-blue-300 transition-colors"
                aria-label="Tìm kiếm bài viết"
                title="Tìm kiếm"
            >
                <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
                </svg>
                <span class="hidden 2xl:inline text-sm font-medium pr-1">Tìm kiếm...</span>
            </button>

            <!-- Login Component -->
            <div id="authContainer" class="flex items-center">
                <button
                    id="openLoginModal"
                    type="button"
                    class="cursor-pointer h-10 px-3 sm:px-4 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold whitespace-nowrap shadow-[0_8px_20px_-8px_rgba(37,99,235,0.7)] transition-colors"
                >
                    <span class="inline-flex items-center gap-2">
                        <svg class="w-4 h-4 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"></path>
                        </svg>
                        Đăng nhập
                    </span>
                </button>
                <div id="userProfileStatus" class="hidden items-center relative">
                    <div
                        class="flex items-center gap-2 cursor-pointer group h-10 pl-1 pr-2.5 rounded-full border border-slate-200 bg-white hover:border-blue-300 transition-colors"
                        id="userProfileTrigger"
                        role="button"
                        tabindex="0"
                        aria-label="Thông tin tài khoản"
                    >
                        <span
                            class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 text-white flex items-center justify-center text-sm"
                            aria-hidden="true">👋</span
                        >
                        <span class="hidden sm:inline text-sm font-semibold text-slate-600 max-w-[10rem] truncate">
                            Chào, <span id="memberName" class="font-bold text-blue-700"></span>
                        </span>
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
                        </svg>
                    </div>

                    <!-- User Info Popover -->
                    <div
                        id="userInfoPopover"
                        class="absolute top-full right-0 mt-2 w-72 bg-white rounded-2xl shadow-2xl border border-slate-100 p-4 hidden z-[110]"
                    >
                        <div class="flex flex-col gap-3">
                            <!-- Avatar Section (Member Only) -->
                            <div id="avatarSection" class="hidden flex-col items-center gap-2 pb-3 border-b border-slate-100">
                                <div class="w-20 h-20 rounded-full overflow-hidden ring-4 ring-blue-50 shadow-md">
                                    <img
                                        id="popoverAvatar"
                                        src="/avatar_v2.avif"
                                        alt="Avatar"
                                        referrerpolicy="no-referrer"
                                        class="w-full h-full object-cover"
                                    />
                                </div>
                                <label
                                    class="flex items-center gap-2 px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-lg cursor-pointer transition-colors text-xs font-semibold"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                    <span>Đổi ảnh đại diện</span>
                                    <input id="avatarInput" type="file" accept="image/*" class="hidden" />
                                </label>
                            </div>

                            <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                                <span class="text-xs text-slate-500 font-medium">Tài khoản</span>
                                <span id="popoverName" class="text-xs font-bold text-slate-800"></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="p-1.5 bg-amber-100 rounded-lg text-amber-600">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path
                                                fill-rule="evenodd"
                                                d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05l-3.293 3.293a1 1 0 01-1.414 0l-3.293-3.293a1 1 0 01-.285-1.05l1.738-5.42-1.233-.616a1 1 0 01.894-1.79l1.599.8L9 4.323V3a1 1 0 011-1z"
                                                clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <span class="text-sm text-slate-600 font-medium">Điểm cộng</span>
                                </div>
                                <span id="userPoints" class="text-sm font-bold text-amber-600">0</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="p-1.5 bg-blue-100 rounded-lg text-blue-600">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <span class="text-sm text-slate-600 font-medium">Tham gia</span>
                                </div>
                                <span id="userJoinDate" class="text-xs font-bold text-slate-800">--/--/----</span>
                            </div>
                            <div class="pt-2 border-t border-slate-100 space-y-1">
                                <a
                                    id="popoverMemberLink"
                                    href="#"
                                    class="hidden flex items-center gap-2 p-2 rounded-xl hover:bg-slate-50 text-blue-600 transition-colors no-underline"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                        ></path>
                                    </svg>
                                    <span class="text-sm font-bold">Đến trang cá nhân</span>
                                </a>
                                <a
                                    href="/hoc-python/ca-nhan"
                                    class="flex items-center gap-2 p-2 rounded-xl hover:bg-slate-50 text-slate-700 transition-colors no-underline"
                                >
                                    <IconPython class="h-4 w-4 text-[#3776AB]" />
                                    <span class="text-sm font-bold">Tiến độ học Python</span>
                                </a>
                                <a
                                    id="popoverAdminLink"
                                    href="/quan-ly"
                                    class="hidden flex items-center gap-2 p-2 rounded-xl hover:bg-slate-50 text-indigo-600 transition-colors no-underline"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                                        ></path>
                                    </svg>
                                    <span class="text-sm font-bold">Quản lý</span>
                                </a>
                                <button
                                    id="logoutBtn"
                                    type="button"
                                    class="flex items-center gap-2 w-full p-2 rounded-xl hover:bg-red-50 text-red-500 transition-colors text-left cursor-pointer"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                                        ></path>
                                    </svg>
                                    <span class="text-sm font-bold">Đăng xuất</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Hamburger -->
            <button
                id="menuBtn"
                type="button"
                class="cursor-pointer lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-xl text-slate-700 hover:bg-slate-100 focus:outline-none transition-transform duration-200"
                aria-label="Mở menu"
                aria-controls="mobileMenu"
            >
                <!-- Menu Icon (Hamburger) -->
                <svg id="menuIcon" class="h-6 w-6 block transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
                <!-- Close Icon (X) -->
                <svg
                    id="closeIcon"
                    class="h-6 w-6 hidden transition-transform duration-300 transform rotate-90"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="lg:hidden hidden border-t border-slate-200 bg-white max-h-[calc(100dvh-var(--nav-h))] overflow-y-auto">
        <ul class="container-site py-3 grid gap-1">
            {
                navData.map((item) => {
                    const active = isActive(item.path, item.match)
                    return (
                        <li>
                            <a
                                href={item.path}
                                data-navLink
                                aria-current={active ? 'page' : undefined}
                                class:list={[
                                    'flex items-center gap-3 px-3 py-3 rounded-xl text-[15px] font-semibold no-underline',
                                    active ? 'bg-blue-50 text-blue-700' : 'text-slate-700 hover:bg-slate-50',
                                ]}
                            >
                                <span
                                    class:list={[
                                        'w-9 h-9 rounded-lg flex items-center justify-center shrink-0',
                                        active ? 'bg-white text-blue-700' : 'bg-slate-100 text-slate-500',
                                    ]}
                                >
                                    {item.icon === 'python' ? (
                                        <IconPython class="w-5 h-5 text-[#3776AB]" />
                                    ) : (
                                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d={ICONS[item.icon]} />
                                        </svg>
                                    )}
                                </span>
                                {item.name}
                                {item.highlight && <span class="chip bg-amber-50 text-amber-700 border-amber-200 ml-auto">Miễn phí</span>}
                            </a>
                        </li>
                    )
                })
            }
        </ul>
    </div>
</nav>

<!-- Toast Notification -->
<div
    id="toastNotification"
    class="fixed top-[calc(var(--nav-h)+12px)] right-5 z-[99999] transform transition-all duration-300 translate-x-full opacity-0 flex items-center gap-3 bg-white px-4 py-3 rounded-xl shadow-2xl border-l-[6px] border-emerald-500"
    role="status"
    aria-live="polite"
>
    <div id="toastIcon" class="text-emerald-500">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
        >
    </div>
    <div class="flex flex-col">
        <span id="toastTitle" class="font-bold text-gray-800 text-sm">Thành công!</span>
        <span id="toastMessage" class="text-xs text-gray-500 font-medium">Đăng nhập thành công.</span>
    </div>
    <button id="toastClose" type="button" class="ml-4 text-gray-400 hover:text-gray-600 outline-none cursor-pointer" aria-label="Đóng">
        ✕
    </button>
</div>

<!-- Overlay: Tìm kiếm -->
<div id="modal" class="fixed inset-0 z-[70] hidden items-start justify-center bg-slate-900/50 backdrop-blur-sm pt-[10vh] px-4">
    <!-- Modal box -->
    <div class="w-full max-w-2xl rounded-2xl bg-white shadow-2xl overflow-hidden">
        <!-- Header -->
        <div class="flex items-center justify-between gap-4 px-6 py-4 border-b border-slate-100">
            <div>
                <h2 class="text-lg font-extrabold text-slate-900">Tìm kiếm trên Error404 Labs</h2>
                <p class="text-sm text-slate-500">Gõ từ khóa để tìm bài viết, ví dụ: “mảng”, “số nguyên tố”, “HTML”.</p>
            </div>
            <button
                id="closeModal"
                type="button"
                class="w-9 h-9 shrink-0 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-800 cursor-pointer flex items-center justify-center"
                aria-label="Đóng"
            >
                ✕
            </button>
        </div>

        <!-- Content -->
        <div class="px-6 py-5">
            <div class="max-h-[55vh] overflow-y-auto">
                <div id="search"></div>
            </div>
            <script>
                window.addEventListener('DOMContentLoaded', () => {
                    // @ts-ignore
                    new PagefindUI({
                        element: '#search',
                        debounceTimeoutMs: 300,
                        resetStyles: false,
                        showEmptyFilters: false,
                        excerptLength: 15,
                        showImages: !true,
                        showSubResults: true,
                        pageSize: 3,
                    })
                })
            </script>
        </div>

        <!-- Actions -->
        <div class="mt-6 flex justify-end gap-3 hidden">
            <button id="cancelModal" class="rounded-lg border px-4 py-2 hover:bg-gray-100"> Cancel </button>
            <button class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700"> Confirm </button>
        </div>
    </div>
</div>

<!-- Login Overlay -->
<div id="loginModal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
    <div class="w-full max-w-md rounded-3xl bg-white shadow-2xl overflow-hidden">
        <!-- Header -->
        <div class="relative bg-gradient-to-br from-blue-600 to-indigo-700 px-6 pt-6 pb-8 text-white">
            <button
                id="closeLoginModal"
                type="button"
                class="absolute top-4 right-4 w-9 h-9 rounded-lg hover:bg-white/15 text-white/80 hover:text-white cursor-pointer flex items-center justify-center text-lg font-bold"
                aria-label="Đóng"
            >
                ✕
            </button>
            <img src="/avatar_v2.avif" alt="" width="48" height="48" class="w-12 h-12 rounded-full ring-4 ring-white/20 mb-3" />
            <h2 class="text-2xl font-extrabold">Đăng nhập</h2>
            <p class="text-sm text-blue-100 mt-1">Lưu tiến độ học, nhận điểm XP và mở khóa các công cụ dành cho học viên.</p>
        </div>

        <div class="px-6 pb-6 pt-5">
            <!-- Content -->
            <form id="loginForm" class="space-y-4" onsubmit="event.preventDefault();">
                <div>
                    <label for="username" class="block text-sm font-semibold text-slate-700 mb-1.5">Tài khoản</label>
                    <input
                        type="text"
                        id="username"
                        name="username"
                        class="block w-full rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none text-sm px-4 py-3 transition"
                        placeholder="Nhập tài khoản của bạn"
                        autocomplete="username"
                    />
                </div>
                <div>
                    <label for="code" class="block text-sm font-semibold text-slate-700 mb-1.5">Mã xác nhận</label>
                    <input
                        type="password"
                        id="code"
                        name="code"
                        class="block w-full rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none text-sm px-4 py-3 transition"
                        placeholder="Nhập mã truy cập"
                        autocomplete="current-password"
                    />
                </div>
                <div class="pt-2">
                    <button
                        id="submitLoginBtn"
                        type="submit"
                        class="cursor-pointer w-full rounded-xl bg-blue-600 px-4 py-3 text-white hover:bg-blue-700 font-bold transition-colors"
                        >Đăng nhập ngay</button
                    >
                </div>
            </form>
            {
                googleClientId && (
                    <div class="mt-5">
                        <div class="mb-4 flex items-center gap-3 text-xs text-slate-400">
                            <span class="h-px flex-1 bg-slate-200" />
                            <span>hoặc</span>
                            <span class="h-px flex-1 bg-slate-200" />
                        </div>
                        <div id="googleLoginButton" class="flex justify-center" />
                    </div>
                )
            }
        </div>
    </div>
</div>

{googleClientId && <script id="googleIdentityScript" is:inline src="https://accounts.google.com/gsi/client" async defer></script>}
{googleClientId && <meta id="googleClientId" content={googleClientId} />}

