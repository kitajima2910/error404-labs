---
import { Image } from 'astro:assets'
import logomark from '../icons/logomark.svg'
import navData from '../data/navData'
import Link from './Link.astro'
import IconBlog from '../icons/IconBlog.astro'
import IconAbout from '../icons/IconAbout.astro'
import IconRSS from '../icons/IconRSS.astro'

const onIcons = (name: string) => {
    switch (name) {
        case 'Giới Thiệu':
            return { component: IconAbout }
        case 'Bài Viết':
            return { component: IconBlog }
        case 'RSS':
            return { component: IconRSS }
    }
}
