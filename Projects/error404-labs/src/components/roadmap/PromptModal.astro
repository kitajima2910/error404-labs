<div
    id="roadmapPromptModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/75 px-4 py-6 backdrop-blur-sm"
    aria-hidden="true"
>
    <div class="w-full max-w-3xl overflow-hidden rounded-xl border border-indigo-200 bg-white shadow-2xl shadow-indigo-950/30">
        <div class="bg-gradient-to-br from-slate-950 via-indigo-950 to-indigo-700 px-5 py-5 text-white">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p id="roadmapPromptMeta" class="text-xs font-black uppercase tracking-[0.18em] text-emerald-200"></p>
                    <h2 id="roadmapPromptTitle" class="mt-2 text-2xl font-black leading-tight"></h2>
                </div>
                <button
                    type="button"
                    class="roadmap-modal-close rounded-md border border-white/20 bg-white/10 px-3 py-2 text-sm font-black text-white transition hover:bg-white hover:text-indigo-700"
                    aria-label="Đóng"
                >
                    Đóng
                </button>
            </div>
        </div>

        <div class="bg-slate-100 p-5">
            <div class="mb-3 flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-2">
                <span class="text-xs font-black uppercase tracking-[0.16em] text-slate-500">Prompt mẫu</span>
                <span class="grid h-6 w-6 place-items-center rounded bg-emerald-100 text-xs font-black text-emerald-700">AI</span>
            </div>
            <pre
                id="roadmapPromptContent"
                class="max-h-[55vh] overflow-auto whitespace-pre-wrap rounded-lg border border-slate-800 bg-slate-950 p-5 font-mono text-sm font-semibold leading-7 text-emerald-100 shadow-inner"
            ></pre>
            <button
                type="button"
                id="roadmapCopyPrompt"
                class="mt-4 w-full rounded-lg bg-gradient-to-r from-indigo-600 to-emerald-500 px-4 py-3 text-sm font-black uppercase tracking-[0.12em] text-white shadow-lg shadow-indigo-300/50 transition hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-emerald-400"
            >
                Sao chép câu lệnh
            </button>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById('roadmapPromptModal')
    const title = document.getElementById('roadmapPromptTitle')
    const meta = document.getElementById('roadmapPromptMeta')
    const content = document.getElementById('roadmapPromptContent')
    let currentPrompt = ''

    const openModal = async (button: HTMLElement) => {
        const gameName = button.dataset.game || ''
        const permissionId = button.dataset.permission || ''
        if (title) title.textContent = gameName
        if (meta) {
            meta.textContent = `${button.dataset.genre || ''} - Tháng ${button.dataset.month || ''} - Tuần ${button.dataset.week || ''}`
        }
        modal?.classList.remove('hidden')
        modal?.classList.add('flex')
        modal?.setAttribute('aria-hidden', 'false')

        const user = window.user
        const hasAccess = user?.roles === 'admin' || user?.prompt_access?.includes(permissionId)

        if (!hasAccess) {
            currentPrompt = ''
            if (content) {
                content.textContent = "Cần có quyền cho phép hãy liên hệ Admin"
                content.classList.add('text-center', 'italic', 'text-slate-400')
            }
            const copyBtn = document.getElementById('roadmapCopyPrompt')
            if (copyBtn) {
                copyBtn.textContent = "Nội dung bị khóa"
                copyBtn.classList.add('opacity-50', 'cursor-not-allowed', 'pointer-events-none')
            }
            return
        }

        if (content) content.textContent = "Đang tải..."

        try {
            const token = localStorage.getItem('auth_token')
            if (!token) {
                throw new Error('No auth token')
            }

            const response = await fetch(`/api/get-game-prompt?gameName=${encodeURIComponent(gameName)}&permissionId=${encodeURIComponent(permissionId)}`, {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            })
            const data = await response.json()

            currentPrompt = data.content || ''
            if (content) {
                if (!currentPrompt || currentPrompt === 'Đang tải...') {
                    content.innerHTML = `
                        <div class="flex flex-col items-center justify-center py-8 text-slate-400">
                            <svg class="w-12 h-12 mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            <p class="text-lg font-medium">Nội dung đang được cập nhật...</p>
                            <p class="text-sm mt-1">Chưa có prompt cho game này</p>
                        </div>
                    `
                    content.classList.remove('text-center', 'italic', 'text-slate-400', 'text-red-400')
                    const copyBtn = document.getElementById('roadmapCopyPrompt')
                    if (copyBtn) {
                        copyBtn.textContent = "Nội dung trống"
                        copyBtn.classList.add('opacity-50', 'cursor-not-allowed', 'pointer-events-none')
                    }
                } else {
                    content.textContent = currentPrompt
                    content.classList.remove('text-center', 'italic', 'text-slate-400', 'text-red-400')
                    const copyBtn = document.getElementById('roadmapCopyPrompt')
                    if (copyBtn) {
                        copyBtn.textContent = "Sao chép câu lệnh"
                        copyBtn.classList.remove('opacity-50', 'cursor-not-allowed', 'pointer-events-none')
                    }
                }
            }
        } catch (error) {
            console.error('Failed to load prompt:', error)
            if (content) {
                content.textContent = "Lỗi tải nội dung"
                content.classList.add('text-center', 'italic', 'text-red-400')
            }
        }
    }

    const closeModal = () => {
        modal?.classList.add('hidden')
        modal?.classList.remove('flex')
        modal?.setAttribute('aria-hidden', 'true')
    }

    document.addEventListener('click', async (event) => {
        const target = event.target as HTMLElement
        const gameButton = target.closest<HTMLElement>('.roadmap-game-cell')
        if (gameButton) {
            openModal(gameButton)
            return
        }

        if (target.closest('.roadmap-modal-close') || target === modal) {
            closeModal()
            return
        }

        if (target.closest('#roadmapCopyPrompt') && currentPrompt) {
            await navigator.clipboard.writeText(currentPrompt)
            window.showToast?.('Đã sao chép prompt!', 'success')
        }
    })

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeModal()
    })
</script>
