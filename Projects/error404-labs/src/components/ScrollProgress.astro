---
// Thanh tiến độ đọc ở mép trên màn hình (Nav chỉ hiển thị trên các trang /bai-viet/*).
---

<div id="scroll-progress" aria-hidden="true"></div>

<style>
    #scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        z-index: 9999;
        pointer-events: none;

        /* màu thương hiệu: xanh blue-600 → vàng sun-400 */
        background: linear-gradient(90deg, #2563eb, #3b82f6 60%, #ffd43b);
        box-shadow: 0 0 10px rgba(37, 99, 235, 0.45);

        /* co giãn bằng transform để mượt, không gây reflow */
        transform: scaleX(0);
        transform-origin: 0 50%;
        transition: transform 0.12s linear;
    }

    @media (prefers-reduced-motion: reduce) {
        #scroll-progress {
            transition: none;
        }
    }
</style>

<script>
    const bar = document.getElementById('scroll-progress')

    if (bar) {
        let ticking = false

        const update = () => {
            ticking = false
            const doc = document.documentElement
            const max = doc.scrollHeight - doc.clientHeight
            // Trang không cuộn được → giữ 0 (tránh chia cho 0 ra NaN)
            const ratio = max > 0 ? Math.min(1, Math.max(0, doc.scrollTop / max)) : 0
            bar.style.transform = `scaleX(${ratio})`
        }

        const requestUpdate = () => {
            if (ticking) return
            ticking = true
            requestAnimationFrame(update)
        }

        window.addEventListener('scroll', requestUpdate, { passive: true })
        window.addEventListener('resize', requestUpdate, { passive: true })
        update()
    }
</script>
