---
import { formatDate, slugify } from '../js/utils'

interface Props {
    relatedPosts: any[]
}

const { relatedPosts } = Astro.props

// console.log('frontmatter: ', relatedPosts)
---

<div class="">
    <h3 class="text-left text-xl font-semibold">Bài Viết Liên Quan</h3>
    {
        relatedPosts &&
            relatedPosts.map((post) => (
                <div class="my-3 bg-[#fbfbfb] p-2 shadow-[1px_1px_1px_3px_rgba(0,0,0,0.06)]">
                    <h4 class="font-semibold">
                        <a href={slugify(post.url)}>
                            <h4>{post.frontmatter.title}</h4>
                        </a>
                    </h4>
                    <small>
                        <a
                            href={`/tac-gia/${slugify(post.frontmatter.author)}`}
                        >
                            {post.frontmatter.author}
                        </a>{' '}
                        - {formatDate(post.frontmatter.date, 'vi-VN')}
                    </small>
                </div>
            ))
    }
</div>
