{
    "manifest_version": 2,
    "name": "Error404-Labs Launcher",
    "description": "Quick launch Error404-Labs",
    "version": "1.0.0",
    "icons": {
        "128": "icon128.png"
    },
    "browser_action": {
        "default_icon": "icon48.png",
        "default_popup": "popup.html"
    },
    "permissions": ["activeTab"]
}
