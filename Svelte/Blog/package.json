		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.14",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.0.2",
		"@tiptap/core": "^3.10.5",
		"@tiptap/extension-file-handler": "^3.10.5",
		"@tiptap/extension-image": "^3.10.5",
		"@tiptap/extension-link": "^3.10.5",
		"@tiptap/extension-underline": "^3.10.5",
