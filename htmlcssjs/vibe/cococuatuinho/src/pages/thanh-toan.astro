---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Thanh Toán - Cô Cỏ Của Tụi Nhỏ">
    <main class="pt-32 pb-20 max-w-7xl mx-auto px-6">
        <h1 class="text-3xl font-bold mb-12 text-center">
            Hoàn Thành Đặt Hàng
        </h1>
        <div class="flex flex-col lg:flex-row gap-12">
            <div class="flex-[2] space-y-8">
                <section
                    class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100"
                >
                    <h2 class="text-xl font-bold mb-6">Thông Tin Giao Hàng</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-sm font-medium text-slate-700"
                                >Họ và tên</label
                            >
                            <input
                                type="text"
                                placeholder="Nguyễn Văn A"
                                class="w-full px-4 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
                            />
                        </div>
                        <div class="space-y-2">
                            <label class="text-sm font-medium text-slate-700"
                                >Số điện thoại</label
                            >
                            <input
                                type="tel"
                                placeholder="0123 456 789"
                                class="w-full px-4 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
                            />
                        </div>
                        <div class="md:col-span-2 space-y-2">
                            <label class="text-sm font-medium text-slate-700"
                                >Địa chỉ nhận hàng</label
                            >
                            <input
                                type="text"
                                placeholder="Số nhà, tên đường, quận/huyện..."
                                class="w-full px-4 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
                            />
                        </div>
                    </div>
                </section>
            </div>
            <div class="flex-1">
                <section
                    class="bg-primary/5 p-8 rounded-2xl border border-primary/10 sticky top-32"
                >
                    <h2 class="text-xl font-bold mb-6">Tóm Tắt Đơn Hàng</h2>
                    <div class="space-y-4 mb-8">
                        <div class="flex justify-between text-slate-600">
                            <span>Tạm tính</span>
                            <span>250.000đ</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>Phí vận chuyển</span>
                            <span>30.000đ</span>
                        </div>
                        <div
                            class="flex justify-between text-xl font-bold text-slate-900 pt-4 border-t border-primary/10"
                        >
                            <span>Tổng cộng</span>
                            <span class="text-primary">280.000đ</span>
                        </div>
                    </div>
                    <button
                        class="w-full bg-primary text-white py-4 rounded-xl font-bold hover:bg-primary/90 hover:scale-[1.02] active:scale-95 transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2 group"
                    >
                        <span>Đặt Hàng Ngay</span>
                        <span
                            class="material-symbols-outlined text-xl group-hover:translate-x-1 transition-transform"
                            >arrow_forward</span
                        >
                    </button>
                </section>
            </div>
        </div>
    </main>
</Layout>
