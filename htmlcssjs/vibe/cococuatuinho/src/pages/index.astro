---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cô Cỏ Của Tụi Nhỏ - Tranh Dịu Dàng Cho Bé">
    <main class="pt-24 lg:pt-32 paper-texture">
        <div class="max-w-7xl mx-auto px-6 lg:px-20">
            <!-- Hero Section -->
            <section
                class="flex flex-col lg:flex-row items-center gap-12 py-10 lg:py-20"
            >
                <div class="flex-1 space-y-8 text-center lg:text-left">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider"
                    >
                        <span class="material-symbols-outlined text-sm"
                            >favorite</span
                        >
                        Nghệ thuật thủ công từ tâm hồn
                    </div>
                    <h1
                        class="text-5xl lg:text-7xl font-extrabold text-slate-900 leading-[1.1] tracking-tight"
                    >
                        Những bức tranh <span class="text-primary italic"
                            >dịu dàng</span
                        > nuôi dưỡng tâm hồn trẻ thơ
                    </h1>
                    <p
                        class="text-lg text-slate-600 dark:text-slate-400 max-w-xl mx-auto lg:mx-0 leading-relaxed"
                    >
                        Khám phá thế giới nghệ thuật đầy màu sắc và tình yêu qua
                        những nét vẽ tay tỉ mỉ, giúp bé yêu phát triển trí tưởng
                        tượng và cảm xúc.
                    </p>
                    <div
                        class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4"
                    >
                        <a
                            href="/cua-hang"
                            class="w-full sm:w-auto px-10 py-4 bg-primary text-white text-center font-bold rounded-xl hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 transition-all active:scale-95"
                        >
                            Khám phá ngay
                        </a>
                        <button
                            class="w-full sm:w-auto px-10 py-4 bg-accent-pink/30 text-slate-800 font-bold rounded-xl border border-accent-pink hover:bg-accent-pink/50 transition-all"
                        >
                            Xem bộ sưu tập
                        </button>
                    </div>
                </div>
                <div class="flex-1 relative w-full aspect-square max-w-[500px]">
                    <div
                        class="absolute inset-0 bg-primary/5 rounded-[2rem] rotate-3 -z-10 blur-2xl opacity-50"
                    >
                    </div>
                    <div
                        class="relative w-full h-full bg-white dark:bg-slate-800 p-4 rounded-3xl shadow-2xl rotate-[-2deg] hover:rotate-0 transition-transform duration-700 overflow-hidden group"
                    >
                        <img
                            class="w-full h-full object-cover rounded-2xl group-hover:scale-105 transition-transform duration-700"
                            alt="Mùa Hè Của Bé"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuA54uXczp0uaS2lum9-Q37SI0wcksVFZnb5vHG2djCYMyQRdJTZHcVOu4_KkzcLvkVt3RUpZX2uvEekZzQWdSXMImMSo3E563oOLGR0DBc_0unQpYCwr6VKdYGOvEJRmom5NtaKwrHAqEs2xdv2Ln6dHxg6fbKKkmvozg3ltmdyMIjN8gydfqtMiDZlD6jmMVR3_yjsrWs3rJY3zDvIEmhtcFrsBkQHgpIeEG5Hh5WmjYiLi8ImcQT-SpLM-3RhF0Y-UdffV3Qi7B4"
                        />
                        <div
                            class="absolute bottom-8 left-8 right-8 bg-white/90 backdrop-blur-md p-6 rounded-2xl shadow-xl border border-white/50"
                        >
                            <h3 class="font-bold text-lg text-slate-800">
                                Mùa Hè Của Bé
                            </h3>
                            <p class="text-sm text-slate-500">
                                Tranh vẽ tay nguyên bản • 2024
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Bento Grid Categories -->
            <section class="py-20">
                <div
                    class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12"
                >
                    <div class="space-y-2">
                        <h2
                            class="text-3xl font-bold text-slate-900 tracking-tight"
                        >
                            Danh mục nghệ thuật
                        </h2>
                        <p class="text-slate-500">
                            Lựa chọn cách bạn muốn mang nghệ thuật vào không
                            gian sống
                        </p>
                    </div>
                    <a
                        class="text-primary font-bold flex items-center gap-1 hover:gap-2 transition-all"
                        href="/cua-hang"
                    >
                        Tất cả sản phẩm <span class="material-symbols-outlined"
                            >arrow_forward</span
                        >
                    </a>
                </div>
                <div
                    class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-4 md:gap-6 h-auto md:h-[600px]"
                >
                    <!-- Large Feature: Tranh In -->
                    <div
                        class="md:col-span-2 md:row-span-2 relative group overflow-hidden rounded-3xl shadow-sm hover:shadow-xl transition-all h-[400px] md:h-auto"
                    >
                        <img
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                            alt="Tranh In Cao Cấp"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuAdt1uY4VfNWo5OhfQLlqvPGc60B2-OiGNI4pXQ0CRJnIJLitXQByWegqipOT__K9hU38sx6Y08qasLJpioQS_D63IuFzRTIBNiAnCHk2gzmOw7pixMkJEkmmLMK8Au87ImsZM_UDAqmSTWIBiXo3Kk4pG86qeEvTdcThC-oOlj4xpasaebM-SPoBfjuu58fnwvZKERdfsjLwNpg3Y5BbiWofLlQ08rTiEM90lBJnYBztIuTuiuMYQ_cQb5DPQOkH3YfbWym-m49rs"
                        />
                        <div class="absolute inset-0 bento-card-gradient"></div>
                        <div
                            class="absolute bottom-0 left-0 p-6 md:p-8 text-white"
                        >
                            <span
                                class="bg-primary/90 text-[10px] md:text-xs font-bold px-3 py-1 rounded-full uppercase mb-3 md:mb-4 inline-block tracking-wider"
                                >Bestseller</span
                            >
                            <h3 class="text-2xl md:text-3xl font-bold mb-2">
                                Tranh In Cao Cấp
                            </h3>
                            <p
                                class="text-white/80 max-w-xs mb-4 md:mb-6 text-sm md:text-base"
                            >
                                Chất liệu giấy mỹ thuật nhập khẩu, bền màu hơn
                                50 năm.
                            </p>
                            <button
                                class="px-6 py-2.5 bg-white text-slate-900 font-bold rounded-lg text-sm hover:bg-slate-100 transition-colors shadow-lg"
                                >Tìm hiểu thêm</button
                            >
                        </div>
                    </div>
                    <!-- Digital Arts -->
                    <div
                        class="md:col-span-2 relative group overflow-hidden rounded-3xl shadow-sm hover:shadow-xl transition-all h-[250px] md:h-auto"
                    >
                        <img
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                            alt="Nghệ thuật Digital"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuCkblRoKQyT8KpXbnEdmMXLsoolEb65tQA5SRiMgmMe5Ql4goHMkl1hJihMNtR9BVL9m2kjySFANCo0n9iAW0GQY5jyw0UvP9GMbpwjjBa5XPZa-UTel3inhxu_wwT_hjIAEOuyYKghCtuq4Z_33zl8vFQ7bzOHS80O8FzznoRZmWPYx86TEbs4g22YYzv8a9JtuUB5Z_Vvj7-GG833oHBMo2lqxY-jbdXlSW2OsKyWsoyT7ordBrbtv-GyIpC3_DB_sGCZYJy_35M"
                        />
                        <div
                            class="absolute inset-0 bento-card-gradient opacity-60"
                        >
                        </div>
                        <div
                            class="absolute bottom-0 left-0 p-6 md:p-8 text-white"
                        >
                            <h3 class="text-xl md:text-2xl font-bold mb-1">
                                Nghệ thuật Digital
                            </h3>
                            <p class="text-white/80 text-xs md:text-sm">
                                Tải về tức thì, in ấn linh hoạt tại nhà.
                            </p>
                        </div>
                    </div>
                    <!-- Custom Order -->
                    <div
                        class="md:col-span-2 relative group overflow-hidden rounded-3xl shadow-sm hover:shadow-xl transition-all h-[250px] md:h-auto"
                    >
                        <img
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                            alt="Đặt theo yêu cầu"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuCENVNFAb60znKIDRfL4zqSqFN4yU25OEl8IXiS7hps3mQnjYEfqn5hC1bNMEW1b6vcahdM_F-2ShfxYJD5sVPV5aT7O9uR7HPWpW1PqyUMTvT_BjqZcKIqkzS1PrT4p_y7q5W8QTOobGlZoESzHaGfnKtv-h4AlJbQgPsVf7ux1aNgL5uso9Ek9RrBetahSW0Wyf626kDNa1bKM4HkGLObHU_R42nJe0TbDRbkycdqSk7tfVIMFSL7JLeGjoZdt8YwfAIgchMrSq4"
                        />
                        <div
                            class="absolute inset-0 bento-card-gradient opacity-60"
                        >
                        </div>
                        <div
                            class="absolute bottom-0 left-0 p-6 md:p-8 text-white"
                        >
                            <h3 class="text-xl md:text-2xl font-bold mb-1">
                                Đặt theo yêu cầu
                            </h3>
                            <p class="text-white/80 text-xs md:text-sm">
                                Gửi gắm câu chuyện riêng của bé vào từng nét vẽ.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Features Section -->
            <section class="py-20 border-t border-primary/10">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
                    <div
                        class="flex flex-col items-center text-center space-y-4 group"
                    >
                        <div
                            class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all duration-300"
                        >
                            <span class="material-symbols-outlined text-3xl"
                                >brush</span
                            >
                        </div>
                        <h4 class="text-xl font-bold text-slate-800">
                            Thiết kế độc bản
                        </h4>
                        <p class="text-slate-500 text-sm leading-relaxed">
                            Mỗi sản phẩm đều mang tâm huyết và dấu ấn nghệ thuật
                            riêng biệt của Cô Cỏ.
                        </p>
                    </div>
                    <div
                        class="flex flex-col items-center text-center space-y-4 group"
                    >
                        <div
                            class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all duration-300"
                        >
                            <span class="material-symbols-outlined text-3xl"
                                >eco</span
                            >
                        </div>
                        <h4 class="text-xl font-bold text-slate-800">
                            Chất liệu thân thiện
                        </h4>
                        <p class="text-slate-500 text-sm leading-relaxed">
                            Sử dụng mực in sinh học và giấy đạt chuẩn quốc tế,
                            an toàn cho không gian của bé.
                        </p>
                    </div>
                    <div
                        class="flex flex-col items-center text-center space-y-4 group"
                    >
                        <div
                            class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all duration-300"
                        >
                            <span class="material-symbols-outlined text-3xl"
                                >redeem</span
                            >
                        </div>
                        <h4 class="text-xl font-bold text-slate-800">
                            Đóng gói tâm huyết
                        </h4>
                        <p class="text-slate-500 text-sm leading-relaxed">
                            Mỗi đơn hàng được đóng gói thủ công như một món quà
                            xinh xắn gửi tặng bé.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Newsletter Section -->
            <section
                class="py-20 mb-20 bg-primary/5 rounded-[3rem] px-8 md:px-20 overflow-hidden relative"
            >
                <div
                    class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-96 h-96 bg-accent-pink/20 rounded-full blur-3xl"
                >
                </div>
                <div
                    class="relative z-10 flex flex-col md:flex-row items-center gap-10"
                >
                    <div class="flex-1 text-center md:text-left">
                        <h2 class="text-3xl font-bold text-slate-900 mb-4">
                            Gia nhập cộng đồng yêu nghệ thuật
                        </h2>
                        <p class="text-slate-600">
                            Đăng ký để nhận ưu đãi sớm nhất và những câu chuyện
                            sáng tác hàng tuần.
                        </p>
                    </div>
                    <div class="flex-1 w-full max-w-md">
                        <div
                            class="flex gap-2 p-2 bg-white rounded-2xl shadow-sm border border-primary/10"
                        >
                            <input
                                class="flex-1 bg-transparent border-none focus:ring-0 px-4 text-sm"
                                placeholder="Email của bạn..."
                                type="email"
                            />
                            <button
                                class="bg-primary text-white px-6 py-3 rounded-xl font-bold hover:bg-primary/90 transition-all shadow-md active:scale-95"
                                >Đăng ký</button
                            >
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
</Layout>
