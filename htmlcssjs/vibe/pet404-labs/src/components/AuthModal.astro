<!-- Auth Modal -->
<div class="modal-overlay" id="auth-modal">
    <div class="modal-content auth-modal">
        <button class="modal-close" id="auth-modal-close">
            <i class="bx bx-x"></i>
        </button>

        <div class="auth-header-bg">
            <i class="bx bxs-dog"></i>
            <h2>Chào mừng bạn!</h2>
        </div>

        <div class="modal-body auth-body">
            <div class="auth-tabs">
                <button class="auth-tab active" data-tab="login"
                    >Đăng nhập</button
                >
                <button class="auth-tab" data-tab="register">Đăng ký</button>
            </div>

            <div class="auth-forms">
                <form id="login-form" class="auth-form active">
                    <div class="input-groups">
                        <div class="input-field">
                            <i class="bx bx-envelope"></i>
                            <input
                                type="email"
                                id="login-email"
                                placeholder="Email của bạn"
                                required
                            />
                        </div>
                        <div class="input-field">
                            <i class="bx bx-lock-alt"></i>
                            <input
                                type="password"
                                id="login-password"
                                placeholder="Mật khẩu"
                                required
                                minlength="6"
                            />
                        </div>
                    </div>
                    <button class="btn btn-primary" id="login-submit"
                        >Đăng nhập</button
                    >

                    <div class="auth-divider">hoặc đăng nhập bằng</div>

                    <div class="social-btns">
                        <button type="button" class="social-btn fb"
                            ><i class="bx bxl-facebook-circle"></i> Facebook</button
                        >
                        <button type="button" class="social-btn gg"
                            ><i class="bx bxl-google"></i> Google</button
                        >
                    </div>
                </form>

                <form id="register-form" class="auth-form">
                    <div class="input-groups">
                        <div class="input-field">
                            <i class="bx bx-user"></i>
                            <input
                                type="text"
                                id="register-name"
                                placeholder="Họ và tên"
                                required
                            />
                        </div>
                        <div class="input-field">
                            <i class="bx bx-envelope"></i>
                            <input
                                type="email"
                                id="register-email"
                                placeholder="Email"
                                required
                            />
                        </div>
                        <div class="input-field">
                            <i class="bx bx-lock-alt"></i>
                            <input
                                type="password"
                                id="register-password"
                                placeholder="Mật khẩu (tối thiểu 6 ký tự)"
                                required
                                minlength="6"
                            />
                        </div>
                    </div>
                    <button class="btn btn-primary" id="register-submit"
                        >Tạo tài khoản</button
                    >
                </form>
            </div>

            <div class="auth-footer">
                Bằng việc tiếp tục, bạn đồng ý với <a href="#"
                    >Điều khoản dịch vụ</a
                > của chúng tôi.
            </div>
        </div>
    </div>
</div>
